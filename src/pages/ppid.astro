        Detail Informasi
      </h3>


      <div
        id="modalContent"
        class="modal-content"
      ></div>

    </div>

  </div>


  <!-- =====================================================
       SCRIPT
  ====================================================== -->

  <script>

    const modal =
      document.getElementById(
        "ppidModal"
      );


    const modalTitle =
      document.getElementById(
        "modalTitle"
      );


    const modalContent =
      document.getElementById(
        "modalContent"
      );


    const detailButtons =
      document.querySelectorAll(
        ".detail-button"
      );


    /* =====================================================
       CLOSE
    ====================================================== */

    const closeModal = () => {

      modal?.classList.remove(
        "show"
      );


      modal?.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.classList.remove(
        "modal-open"
      );

    };


    /* =====================================================
       DETAIL BUTTON
    ====================================================== */

    detailButtons.forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const title =
              button.dataset.title ||
              "Detail Informasi";


            const id =
              button.dataset.id ||
              "";


            const template =
              document.getElementById(
                `ppid-content-${id}`
              );


            if (modalTitle) {

              modalTitle.textContent =
                title;

            }


            if (modalContent) {

              if (template) {

                modalContent.innerHTML =
                  template.innerHTML;

              } else {

                modalContent.innerHTML =
                  `
                    <p>
                      Informasi belum tersedia.
                    </p>
                  `;

              }

            }


            modal?.classList.add(
              "show"
            );


            modal?.setAttribute(
              "aria-hidden",
              "false"
            );


            document.body.classList.add(
              "modal-open"
            );

          }
        );

      }
    );


    /* =====================================================
       CLOSE BUTTON
    ====================================================== */

    document
      .querySelectorAll(
        "[data-close-modal]"
      )
      .forEach(
        (element) => {

          element.addEventListener(
            "click",
            closeModal
          );

        }
      );


    /* =====================================================
       ESC
    ====================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          modal?.classList.contains(
            "show"
          )
        ) {

          closeModal();

        }

      }
    );

  </script>


  <!-- =====================================================
       STYLE
  ====================================================== -->

  <style>

    :global(*) {
      box-sizing: border-box;
    }


    :global(html) {
      scroll-behavior: smooth;
    }


