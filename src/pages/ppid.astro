            </h1>


            <p class="hero-description">

              Akses informasi publik DPMPTSP Kota Surabaya
              dengan mudah, cepat, transparan, dan dapat
              dipertanggungjawabkan.

            </p>


            <div class="hero-actions">

              <a
                href="#informasi"
                class="hero-button primary"
              >

                <i class="fa-solid fa-folder-open"></i>

                Jelajahi Informasi

              </a>


              <a
                href="#kontak"
                class="hero-button secondary"
              >

                <i class="fa-solid fa-phone"></i>

                Hubungi PPID

              </a>

            </div>

          </div>


          <div class="hero-card">

            <div class="hero-card-icon">

              <i class="fa-solid fa-building-columns"></i>

            </div>

            <strong>
              PPID DPMPTSP
            </strong>

            <span>
              Pejabat Pengelola Informasi dan Dokumentasi
            </span>

            <div class="hero-card-line"></div>

            <small>
              Melayani kebutuhan informasi publik
              masyarakat Kota Surabaya.
            </small>

          </div>

        </div>

      </div>

    </section>



    <!-- =====================================================
         ERROR
    ====================================================== -->

    {apiError && (

      <section class="api-error">

        <div class="container">

          <div class="error-box">

            <i class="fa-solid fa-triangle-exclamation"></i>

            <div>

              <strong>
                Data PPID belum dapat dimuat
              </strong>

              <p>
                {apiError}
              </p>

            </div>

          </div>

        </div>

      </section>

    )}



    <!-- =====================================================
         INFORMASI
    ====================================================== -->

    <section
      id="informasi"
      class="category-section"
    >

      <div class="container">

        <div class="section-heading">

          <div>

            <span class="section-eyebrow">

              INFORMASI PUBLIK

            </span>


            <h2>

              Temukan informasi
              <span>yang Anda butuhkan</span>

            </h2>

          </div>


          <p>

            Pilih kategori informasi publik
            untuk melihat dokumen dan informasi
            yang tersedia.

          </p>

        </div>


        <div class="information-guide">

          <span class="guide-icon">

            <i class="fa-solid fa-hand-pointer"></i>

          </span>

          <span>

            Silakan pilih salah satu kategori
            informasi di bawah.

          </span>

        </div>


        <div class="category-scroll">

          <div class="category-grid">

            {
              kategori.map((kat) => (

                <a
                  href={`#kategori-${kat.slug}`}
                  class="category-card"
                >

                  <div class="category-top-line"></div>


                  <div class="category-icon">

                    <i
                      class={`fa-solid ${getIcon(kat.slug)}`}
                    ></i>

                  </div>


                  <div class="category-content">

                    <h3>
                      {kat.nama_kategori}
                    </h3>


                    <p>
                      {getDescription(kat.slug)}
                    </p>


                    <div class="category-bottom">

                      <span>

                        <strong>
                          {getKategoriCount(kat.id)}
                        </strong>

                        informasi

                      </span>


                      <span class="category-cta">

                        Lihat

                        <i class="fa-solid fa-arrow-right"></i>

                      </span>

                    </div>

                  </div>

                </a>

              ))
            }

          </div>

        </div>

      </div>

    </section>



    <!-- =====================================================
         CONTENT
    ====================================================== -->

    <section class="information-section">

      <div class="container">

        <div class="information-layout">


          <!-- MAIN -->

          <div class="information-main">

            {

              kategori.map((kat) => {

                const categoryItems =
                  getItems(kat.id);

                return (

                  <section
                    id={`kategori-${kat.slug}`}
                    class="db-category"
                  >

                    <div class="db-category-heading">

                      <div class="db-category-icon">

                        <i
                          class={`fa-solid ${getIcon(kat.slug)}`}
                        ></i>

                      </div>


                      <div>

                        <span>
                          INFORMASI PUBLIK
                        </span>

                        <h2>
                          {kat.nama_kategori}
                        </h2>

                        <p>
                          {getDescription(kat.slug)}
                        </p>

                      </div>

                    </div>


                    {
                      categoryItems.length > 0 ? (

                        <div class="db-list">

                          {

                            categoryItems.map(
                              (item) => (

                                <article
                                  class="db-item"
                                >

                                  <div class="db-item-icon">

                                    <i class="fa-solid fa-file-lines"></i>

                                  </div>


                                  <div class="db-item-content">

                                    <small>

                                      {item.nama_kategori ||
                                        kat.nama_kategori}

                                    </small>


                                    <h3>
                                      {item.judul}
                                    </h3>


                                    {
                                      item.isi && (

                                        <p class="db-item-description">

                                          {getExcerpt(
                                            item.isi
                                          )}

                                          {getExcerpt(
                                            item.isi
                                          ).length >= 180
                                            ? "..."
                                            : ""}

                                        </p>

                                      )
                                    }

                                  </div>


                                  <div class="db-item-action">

                                    {

                                      item.file_url ? (

                                        <a
                                          href={item.file_url}
                                          target="_blank"
                                          rel="noopener noreferrer"
                                          class="download-button"
                                        >

                                          <span>
                                            Unduh
                                          </span>

                                          <i class="fa-solid fa-download"></i>

                                        </a>

                                      ) : (

                                        <button
                                          type="button"
                                          class="detail-button"
                                          data-title={item.judul}
                                          data-id={item.id}
                                        >

                                          <span>
                                            Detail
                                          </span>

                                          <i class="fa-solid fa-arrow-right"></i>

                                        </button>

                                      )

                                    }

                                  </div>


                                  {

                                    !item.file_url && (

                                      <template
                                        id={`ppid-content-${item.id}`}
                                      >

                                        <Fragment
                                          set:html={
                                            item.isi || ""
                                          }
                                        />

                                      </template>

                                    )

                                  }

                                </article>

                              )
                            )

                          }

                        </div>

                      ) : (

                        <div class="empty-state">

                          <i class="fa-solid fa-folder-open"></i>

                          <strong>
                            Belum ada informasi
                          </strong>

                          <span>
                            Informasi pada kategori ini
                            belum tersedia.
                          </span>

                        </div>

                      )

                    }

                  </section>

                );

              })

            }

          </div>



          <!-- SIDEBAR -->

          <aside
            id="kontak"
            class="information-sidebar"
          >

            <div class="contact-card">

              <div class="contact-card-header">

                <span class="contact-icon">

                  <i class="fa-solid fa-headset"></i>

                </span>


                <div>

                  <small>
                    LAYANAN PPID
                  </small>

                  <h3>
                    Hubungi PPID
                  </h3>

                </div>

              </div>


              <div class="contact-list">


                <div class="contact-item">

                  <span>

                    <i class="fa-solid fa-location-dot"></i>

                  </span>

                  <div>

                    <strong>
                      Alamat
                    </strong>

                    <p>
                      Jl. Tunjungan No. 1-3
                      Kota Surabaya
                    </p>

                  </div>

                </div>


                <div class="contact-item">

                  <span>

                    <i class="fa-solid fa-phone"></i>

                  </span>

                  <div>

                    <strong>
                      Telepon
                    </strong>

                    <a href="tel:03199000000">
                      (031) 99000000
                    </a>

                  </div>

                </div>


                <div class="contact-item">

                  <span>

                    <i class="fa-solid fa-envelope"></i>

                  </span>

                  <div>

                    <strong>
                      Email
                    </strong>

                    <a href="mailto:ppid@dpmptsp.surabaya.go.id">
                      ppid@dpmptsp.surabaya.go.id
                    </a>

                  </div>

                </div>


                <div class="contact-item">

                  <span>

                    <i class="fa-solid fa-globe"></i>

                  </span>

                  <div>

                    <strong>
                      Website
                    </strong>

                    <a
                      href="https://dpm-ptsp.surabaya.go.id"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      dpm-ptsp.surabaya.go.id
                    </a>

                  </div>

                </div>

              </div>


              <div class="social-title">
                Ikuti kami
              </div>


              <div class="social-links">

                <a
                  href="#"
                  aria-label="YouTube"
                >
                  <i class="fa-brands fa-youtube"></i>
                </a>

                <a
                  href="#"
                  aria-label="WhatsApp"
                >
                  <i class="fa-brands fa-whatsapp"></i>
                </a>

                <a
                  href="#"
                  aria-label="Facebook"
                >
                  <i class="fa-brands fa-facebook-f"></i>
                </a>

                <a
                  href="#"
                  aria-label="Instagram"
                >
                  <i class="fa-brands fa-instagram"></i>
                </a>

              </div>

            </div>



            <div class="request-card">

              <div class="request-icon">

                <i class="fa-solid fa-file-circle-plus"></i>

              </div>


              <h3>
                Butuh Informasi?
              </h3>


              <p>

                Sampaikan permohonan informasi
                kepada PPID DPMPTSP Kota Surabaya.

              </p>


              <a
                href="#"
                class="request-button"
              >

                Ajukan Permohonan

                <i class="fa-solid fa-arrow-right"></i>

              </a>

            </div>

          </aside>

        </div>

      </div>

    </section>



    <!-- =====================================================
         COMMITMENT
    ====================================================== -->

    <section class="commitment-section">

      <div class="container">

        <div class="commitment-box">

          <div class="commitment-icon">

            <i class="fa-solid fa-shield-halved"></i>

          </div>


          <div>

            <span>
              KOMITMEN KETERBUKAAN
            </span>

            <h2>
              Informasi publik untuk masyarakat
            </h2>

            <p>

              DPMPTSP Kota Surabaya berkomitmen
              memberikan layanan informasi publik
              yang transparan, mudah diakses,
              dan sesuai dengan ketentuan
              peraturan perundang-undangan.

            </p>

          </div>

        </div>

      </div>

    </section>

  </main>



  <!-- =======================================================
       DETAIL MODAL
  ======================================================== -->

  <div
    id="ppidModal"
    class="ppid-modal"
    aria-hidden="true"
  >

    <div class="ppid-modal-backdrop"></div>


    <div
      class="ppid-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ppidModalTitle"
    >

      <div class="ppid-modal-header">

        <div>

          <span>
            INFORMASI PUBLIK
          </span>

          <h2 id="ppidModalTitle">
            Detail Informasi
          </h2>

        </div>


        <button
          type="button"
          id="ppidModalClose"
          class="ppid-modal-close"
          aria-label="Tutup"
        >

          <i class="fa-solid fa-xmark"></i>

        </button>

      </div>


      <div
        id="modalContent"
        class="ppid-modal-content"
      ></div>

    </div>

  </div>



  <!-- =======================================================
       ACCESSIBILITY WIDGET
  ======================================================== -->

  <div class="accessibility-widget">


    <!-- FLOATING BUTTON -->

    <button
      type="button"
      id="accessibilityToggle"
      class="accessibility-toggle"
      aria-label="Pilih mode tampilan"
      aria-expanded="false"
    >

      <span class="accessibility-toggle-icon">

        <i class="fa-solid fa-universal-access"></i>

      </span>

      <span>
        Pilih Mode
      </span>

    </button>



    <!-- PANEL -->

    <div
      id="accessibilityPanel"
      class="accessibility-panel"
      aria-hidden="true"
    >

      <div class="accessibility-header">

        <div class="accessibility-brand">

          <strong>
            DPMPTSP
          </strong>

          <small>
            KOTA SURABAYA
          </small>

        </div>


        <button
          type="button"
          id="accessibilityClose"
          class="accessibility-close"
        >
          Tutup
        </button>

      </div>


      <div class="accessibility-intro">

        <div class="accessibility-info-icon">

          <i class="fa-solid fa-info"></i>

        </div>


        <p>

          Untuk memudahkan Anda menggunakan
          situs ini, atur situs dengan mode
          sesuai persona diri Anda!

        </p>

      </div>


      <div class="accessibility-options">


        <button
          type="button"
          class="accessibility-option active"
          data-mode="normal"
        >

          <span class="option-check">

            <i class="fa-solid fa-check"></i>

          </span>

          <span class="option-emoji">
            👨🏻
          </span>

          <span class="option-title">
            Normal
          </span>

        </button>


        <button
          type="button"
          class="accessibility-option"
          data-mode="colorblind"
        >

          <span class="option-check">

            <i class="fa-solid fa-check"></i>

          </span>

          <span class="option-emoji">
            👀
          </span>

          <span class="option-title">
            Buta Warna
          </span>

        </button>


        <button
          type="button"
          class="accessibility-option"
          data-mode="elderly"
        >

          <span class="option-check">

            <i class="fa-solid fa-check"></i>

          </span>

          <span class="option-emoji">
            👴🏻
          </span>

          <span class="option-title">
            Lansia
          </span>

        </button>


      </div>

    </div>

  </div>



  <!-- =======================================================
       SCRIPT
  ======================================================== -->

  <script>

    /* =======================================================
       PPID DETAIL MODAL
    ======================================================== */

    const ppidModal =
      document.getElementById(
        "ppidModal"
      );

    const ppidModalClose =
      document.getElementById(
        "ppidModalClose"
      );

    const modalContent =
      document.getElementById(
        "modalContent"
      );

    const modalTitle =
      document.getElementById(
        "ppidModalTitle"
      );


    const closePPIDModal = () => {

      ppidModal?.classList.remove(
        "show"
      );

      ppidModal?.setAttribute(
        "aria-hidden",
        "true"
      );

      document.body.classList.remove(
        "modal-open"
      );

      if (modalContent) {
        modalContent.innerHTML = "";
      }

    };


    const openPPIDModal = (
      title,
      id
    ) => {

      const template =
        document.getElementById(
          `ppid-content-${id}`
        );

      if (!template) {
        return;
      }


      if (modalTitle) {
        modalTitle.textContent =
          title ||
          "Detail Informasi";
      }


      if (modalContent) {

        modalContent.innerHTML =
          template.innerHTML;

      }


      ppidModal?.classList.add(
        "show"
      );

      ppidModal?.setAttribute(
        "aria-hidden",
        "false"
      );

      document.body.classList.add(
        "modal-open"
      );

    };


    document
      .querySelectorAll(
        ".detail-button"
      )
      .forEach((button) => {

        button.addEventListener(
          "click",
          () => {

            openPPIDModal(
              button.dataset.title,
              button.dataset.id
            );

          }
        );

      });


    ppidModalClose?.addEventListener(
      "click",
      closePPIDModal
    );


    document
      .querySelector(
        ".ppid-modal-backdrop"
      )
      ?.addEventListener(
        "click",
        closePPIDModal
      );



    /* =======================================================
       ACCESSIBILITY
    ======================================================== */

    const accessibilityToggle =
      document.getElementById(
        "accessibilityToggle"
      );

    const accessibilityPanel =
      document.getElementById(
        "accessibilityPanel"
      );

    const accessibilityClose =
      document.getElementById(
        "accessibilityClose"
      );

    const accessibilityOptions =
      document.querySelectorAll(
        ".accessibility-option"
      );


    const openAccessibility = () => {

      accessibilityPanel?.classList.add(
        "show"
      );

      accessibilityPanel?.setAttribute(
        "aria-hidden",
        "false"
      );

      accessibilityToggle?.setAttribute(
        "aria-expanded",
        "true"
      );

    };


    const closeAccessibility = () => {

      accessibilityPanel?.classList.remove(
        "show"
      );

      accessibilityPanel?.setAttribute(
        "aria-hidden",
        "true"
      );

      accessibilityToggle?.setAttribute(
        "aria-expanded",
        "false"
      );

    };


    accessibilityToggle?.addEventListener(
      "click",
      () => {

        if (
          accessibilityPanel?.classList.contains(
            "show"
          )
        ) {

          closeAccessibility();

        } else {

          openAccessibility();

        }

      }
    );


    accessibilityClose?.addEventListener(
      "click",
      closeAccessibility
    );


    /* =======================================================
       APPLY MODE
    ======================================================== */

    const applyAccessibilityMode =
      (mode) => {

        document.documentElement.classList.remove(
          "access-normal",
          "access-colorblind",
          "access-elderly"
        );


        if (
          mode === "colorblind"
        ) {

          document.documentElement.classList.add(
            "access-colorblind"
          );

        }


        if (
          mode === "elderly"
        ) {

          document.documentElement.classList.add(
            "access-elderly"
          );

        }


        accessibilityOptions.forEach(
          (option) => {

            option.classList.toggle(
              "active",
              option.dataset.mode === mode
            );

          }
        );


        try {

          localStorage.setItem(
            "dpmptsp-accessibility-mode",
            mode
          );

        } catch {}

      };


    accessibilityOptions.forEach(
      (option) => {

        option.addEventListener(
          "click",
          () => {

            const mode =
              option.dataset.mode ||
              "normal";

            applyAccessibilityMode(
              mode
            );

          }
        );

      }
    );


    /* =======================================================
       LOAD SAVED MODE
    ======================================================== */

    let savedMode = "normal";

    try {

      savedMode =
        localStorage.getItem(
          "dpmptsp-accessibility-mode"
        ) ||
        "normal";

    } catch {}


    applyAccessibilityMode(
      savedMode
    );


    /* =======================================================
       ESC
    ======================================================== */

    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape"
        ) {

          closeAccessibility();

          closePPIDModal();

        }

      }
    );

  </script>

</MainLayout>


