      class="modal-box"
      role="dialog"
      aria-modal="true"
      aria-labelledby="modalTitle"
    >

      <button
        type="button"
        class="modal-close"
        data-close-modal
        aria-label="Tutup"
      >

        <i class="fa-solid fa-xmark"></i>

      </button>


