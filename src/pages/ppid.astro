      background: #fff;

      color: #9a3412;

    }


    .api-error > i {

      margin-top: 2px;

      font-size: 16px;

    }


    .api-error strong {

      display: block;

      margin-bottom: 3px;

      font-size: 13px;

    }


    .api-error p {

      margin: 0;

      font-size: 11px;

      line-height: 1.5;

    }


    /* =====================================================
       HERO
    ====================================================== */

    .ppid-hero {

      position: relative;

      overflow: hidden;

      padding:
        78px 0 82px;

      background:
        linear-gradient(
          135deg,
          #eff6ff 0%,
          #ffffff 62%,
          #f8fafc 100%
        );

    }


    .ppid-hero::before {

      content: "";

      position: absolute;

      width: 520px;

      height: 520px;

      top: -310px;

      right: -110px;

      border-radius: 50%;

      background:
        rgba(
          37,
          99,
          235,
          .065
        );

    }


    .hero-grid {

      position: relative;

      z-index: 2;

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        350px;

      align-items: center;

      gap: 70px;

    }


    .hero-badge {

      display: inline-flex;

      align-items: center;

      gap: 9px;

      margin-bottom: 18px;

      color: #2563eb;

      font-size: 12px;

      font-weight: 900;

      letter-spacing: .12em;

    }


    .hero-badge-icon {

      width: 29px;

      height: 29px;

      display: grid;

      place-items: center;

      border-radius: 8px;

      background: #dbeafe;

      font-size: 13px;

    }


    .hero-content h1 {

      max-width: 700px;

      margin: 0;

      color: #172554;

      font-size:
        clamp(
          40px,
          6vw,
          64px
        );

      line-height: 1.02;

      letter-spacing: -.045em;

      font-weight: 900;

    }


    .hero-content h1 span {

      display: block;

      color: #2563eb;

    }


    .hero-content > p {

      max-width: 680px;

      margin:
        23px 0 0;

      color: #64748b;

      font-size: 16px;

      line-height: 1.8;

    }


    .hero-actions {

      display: flex;

      flex-wrap: wrap;

      gap: 10px;

      margin-top: 27px;

    }


    .hero-button {

      min-height: 45px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 8px;

      padding:
        0 17px;

      border-radius: 10px;

      font-size: 12px;

      font-weight: 800;

      transition: .2s ease;

    }


    .hero-button.primary {

      background: #2563eb;

      color: #fff;

    }


    .hero-button.primary:hover {

      background: #1d4ed8;

      transform:
        translateY(-2px);

    }


    .hero-button.secondary {

      background: #fff;

      color: #2563eb;

      border:
        1px solid #dbeafe;

    }


    .hero-button.secondary:hover {

      background: #eff6ff;

    }


    .hero-information {

      display: flex;

      align-items: flex-start;

      gap: 16px;

      padding: 24px;

      border:
        1px solid #dbeafe;

      border-radius: 18px;

      background:
        rgba(
          255,
          255,
          255,
          .82
        );

      box-shadow:
        0 18px 50px
        rgba(
          15,
          23,
          42,
          .06
        );

    }


    .hero-information-icon {

      width: 48px;

      height: 48px;

      flex-shrink: 0;

      display: grid;

      place-items: center;

      border-radius: 13px;

      background: #dbeafe;

      color: #2563eb;

      font-size: 20px;

    }


    .hero-information span {

      display: block;

      margin-bottom: 4px;

      color: #64748b;

      font-size: 11px;

      line-height: 1.5;

    }


    .hero-information strong {

      display: block;

      color: #172554;

      font-size: 19px;

      font-weight: 900;

    }


    .hero-information p {

      margin:
        6px 0 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.6;

    }


    /* =====================================================
       SECTION
    ====================================================== */

    .category-section {

      padding:
        75px 0 80px;

      background: #fff;

    }


    .section-heading {

      display: flex;

      align-items: flex-end;

      justify-content: space-between;

      gap: 40px;

      margin-bottom: 35px;

    }


    .section-heading.left {

      display: block;

      margin-bottom: 28px;

    }


    .section-eyebrow {

      display: block;

      margin-bottom: 9px;

      color: #2563eb;

      font-size: 12px;

      font-weight: 900;

      letter-spacing: .13em;

    }


    .section-heading h2 {

      margin: 0;

      color: #172554;

      font-size:
        clamp(
          29px,
          4vw,
          40px
        );

      line-height: 1.15;

      letter-spacing: -.035em;

      font-weight: 900;

    }


    .section-heading h2 span {

      color: #2563eb;

    }


    .section-heading > p {

      max-width: 360px;

      margin: 0;

      color: #64748b;

      font-size: 13px;

      line-height: 1.7;

    }


    /* =====================================================
       CATEGORY
    ====================================================== */

    .category-grid {

      display: grid;

      grid-template-columns:
        repeat(
          4,
          minmax(0, 1fr)
        );

      gap: 16px;

    }


    .category-card {

      position: relative;

      display: block;

      padding: 22px;

      overflow: hidden;

      border:
        1px solid #e5e7eb;

      border-radius: 15px;

      background: #fff;

      transition: .25s ease;

    }


    .category-card:hover {

      border-color: #bfdbfe;

      transform:
        translateY(-4px);

      box-shadow:
        0 15px 35px
        rgba(
          15,
          23,
          42,
          .07
        );

    }


    .category-icon {

      width: 46px;

      height: 46px;

      display: grid;

      place-items: center;

      margin-bottom: 18px;

      border-radius: 11px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 18px;

    }


    .category-content h3 {

      margin: 0;

      color: #172554;

      font-size: 17px;

      line-height: 1.35;

      font-weight: 900;

    }


    .category-content p {

      min-height: 64px;

      margin:
        9px 0 20px;

      color: #64748b;

      font-size: 13px;

      line-height: 1.7;

    }


    .category-bottom {

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding-top: 13px;

      border-top:
        1px solid #f1f5f9;

      color: #2563eb;

      font-size: 12px;

      font-weight: 800;

    }


    .category-bottom i {

      font-size: 12px;

    }


    /* =====================================================
       INFORMATION
    ====================================================== */

    .information-section {

      padding:
        75px 0 85px;

      background: #f8fafc;

    }


    .information-layout {

      display: grid;

      grid-template-columns:
        minmax(0, 1fr)
        330px;

      align-items: start;

      gap: 45px;

    }


    /* =====================================================
       DATABASE CATEGORY
    ====================================================== */

    .db-category {

      margin-bottom: 22px;

      padding: 20px;

      border:
        1px solid #e2e8f0;

      border-radius: 16px;

      background: #fff;

    }


    .db-category-header {

      display: flex;

      align-items: center;

      gap: 13px;

      margin-bottom: 16px;

      padding-bottom: 15px;

      border-bottom:
        1px solid #f1f5f9;

    }


    .db-category-icon {

      width: 44px;

      height: 44px;

      display: grid;

      place-items: center;

      flex-shrink: 0;

      border-radius: 11px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 16px;

    }


    .db-category-header span {

      display: block;

      margin-bottom: 3px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: .1em;

    }


    .db-category-header h3 {

      margin: 0;

      color: #172554;

      font-size: 19px;

      line-height: 1.35;

      font-weight: 900;

    }


    /* =====================================================
       ITEM
    ====================================================== */

    .db-item-list {

      display: flex;

      flex-direction: column;

      gap: 8px;

    }


    .db-item {

      position: relative;

      display: flex;

      align-items: center;

      gap: 12px;

      padding: 12px;

      border:
        1px solid #f1f5f9;

      border-radius: 11px;

      background: #fff;

      transition: .2s ease;

    }


    .db-item:hover {

      border-color: #dbeafe;

      background: #f8fbff;

    }


    .db-item-icon {

      width: 40px;

      height: 40px;

      display: grid;

      place-items: center;

      flex-shrink: 0;

      border-radius: 9px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 14px;

    }


    .db-item-content {

      min-width: 0;

      flex: 1;

    }


    .db-item-content h4 {

      margin: 0;

      color: #172554;

      font-size: 14px;

      line-height: 1.45;

      font-weight: 900;

    }


    /* =====================================================
       PREVIEW TEXT
    ====================================================== */

    .db-item-description {

      margin-top: 5px;

      color: #64748b;

      font-size: 12px;

      line-height: 1.6;

      display: -webkit-box;

      -webkit-line-clamp: 2;

      -webkit-box-orient: vertical;

      overflow: hidden;

    }


    .db-item-content small {

      display: block;

      margin-top: 4px;

      color: #94a3b8;

      font-size: 10px;

    }


    /* =====================================================
       BUTTON
    ====================================================== */

    .download-button,
    .detail-button {

      min-width: 78px;

      height: 36px;

      display: inline-flex;

      align-items: center;

      justify-content: center;

      gap: 6px;

      flex-shrink: 0;

      border: 0;

      border-radius: 8px;

      background: #eff6ff;

      color: #2563eb;

      font-family: inherit;

      font-size: 10px;

      font-weight: 900;

      cursor: pointer;

      transition: .2s ease;

    }


    .download-button:hover,
    .detail-button:hover {

      background: #2563eb;

      color: #fff;

    }


    /* =====================================================
       EMPTY
    ====================================================== */

    .empty-data {

      padding: 28px;

      text-align: center;

      color: #94a3b8;

    }


    .empty-data i {

      display: block;

      margin-bottom: 8px;

      font-size: 27px;

    }


    .empty-data p {

      margin: 0;

      font-size: 12px;

    }


    /* =====================================================
       SIDEBAR
    ====================================================== */

    .ppid-sidebar {

      position: sticky;

      top: 25px;

      display: flex;

      flex-direction: column;

      gap: 15px;

    }


    .contact-card {

      overflow: hidden;

      border:
        1px solid #e2e8f0;

      border-radius: 16px;

      background: #fff;

      box-shadow:
        0 10px 30px
        rgba(
          15,
          23,
          42,
          .045
        );

    }


    .contact-card-header {

      display: flex;

      align-items: center;

      gap: 13px;

      padding: 20px;

      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #fff
        );

      border-bottom:
        1px solid #e5e7eb;

    }


    .contact-icon {

      width: 44px;

      height: 44px;

      display: grid;

      place-items: center;

      border-radius: 11px;

      background: #dbeafe;

      color: #2563eb;

      font-size: 16px;

    }


    .contact-card-header span {

      display: block;

      margin-bottom: 3px;

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

    }


    .contact-card-header h3 {

      margin: 0;

      color: #172554;

      font-size: 19px;

      font-weight: 900;

    }


    .contact-list {

      padding:
        7px 20px 12px;

    }


    .contact-item {

      display: flex;

      align-items: flex-start;

      gap: 11px;

      padding:
        13px 0;

      border-bottom:
        1px solid #f1f5f9;

    }


    .contact-item:last-child {

      border-bottom: 0;

    }


    .contact-item > div {

      width: 29px;

      height: 29px;

      flex-shrink: 0;

      display: grid;

      place-items: center;

      border-radius: 7px;

      background: #f8fafc;

      color: #2563eb;

      font-size: 11px;

    }


    .contact-item section {

      min-width: 0;

    }


    .contact-item small {

      display: block;

      margin-bottom: 3px;

      color: #94a3b8;

      font-size: 9px;

      font-weight: 800;

      text-transform: uppercase;

    }


    .contact-item p,
    .contact-item a {

      display: block;

      margin: 0;

      color: #475569;

      font-size: 11px;

      line-height: 1.6;

      word-break: break-word;

    }


    .contact-item a:hover {

      color: #2563eb;

    }


    /* =====================================================
       SOCIAL
    ====================================================== */

    .social-section {

      padding:
        17px 20px 20px;

      border-top:
        1px solid #e5e7eb;

    }


    .social-section > span {

      display: block;

      margin-bottom: 10px;

      color: #64748b;

      font-size: 10px;

      font-weight: 900;

      text-transform: uppercase;

    }


    .social-list {

      display: flex;

      gap: 7px;

    }


    .social-list a {

      width: 34px;

      height: 34px;

      display: grid;

      place-items: center;

      border-radius: 8px;

      background: #f1f5f9;

      color: #475569;

      font-size: 13px;

      transition: .2s ease;

    }


    .social-list a:hover {

      background: #2563eb;

      color: #fff;

      transform:
        translateY(-2px);

    }


    .social-names {

      margin-top: 12px;

    }


    .social-names p {

      margin: 5px 0;

      color: #64748b;

      font-size: 10px;

    }


    .social-names strong {

      margin-right: 5px;

      color: #334155;

    }


    /* =====================================================
       REQUEST
    ====================================================== */

    .request-card {

      padding: 22px;

      border-radius: 16px;

      background:
        linear-gradient(
          135deg,
          #172554,
          #1e40af
        );

      color: #fff;

    }


    .request-icon {

      width: 44px;

      height: 44px;

      display: grid;

      place-items: center;

      margin-bottom: 16px;

      border-radius: 11px;

      background:
        rgba(
          255,
          255,
          255,
          .12
        );

      font-size: 16px;

    }


    .request-card h3 {

      margin: 0;

      font-size: 19px;

      font-weight: 900;

    }


    .request-card p {

      margin:
        8px 0 18px;

      color:
        rgba(
          255,
          255,
          255,
          .72
        );

      font-size: 12px;

      line-height: 1.7;

    }


    .request-card a {

      display: flex;

      align-items: center;

      justify-content: space-between;

      min-height: 40px;

      padding:
        0 12px;

      border-radius: 8px;

      background: #fff;

      color: #1e40af;

      font-size: 11px;

      font-weight: 900;

    }


    .request-card a:hover {

      background: #eff6ff;

    }


    /* =====================================================
       BOTTOM
    ====================================================== */

    .bottom-section {

      padding:
        60px 0;

      background: #fff;

    }


    .bottom-card {

      display: flex;

      align-items: flex-start;

      gap: 20px;

      padding: 30px;

      border:
        1px solid #dbeafe;

      border-radius: 18px;

      background:
        linear-gradient(
          135deg,
          #eff6ff,
          #fff
        );

    }


    .bottom-icon {

      width: 50px;

      height: 50px;

      flex-shrink: 0;

      display: grid;

      place-items: center;

      border-radius: 12px;

      background: #dbeafe;

      color: #2563eb;

      font-size: 18px;

    }


    .bottom-card span {

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: .12em;

    }


    .bottom-card h2 {

      margin:
        6px 0 7px;

      color: #172554;

      font-size: 26px;

      line-height: 1.25;

      font-weight: 900;

    }


    .bottom-card p {

      max-width: 760px;

      margin: 0;

      color: #64748b;

      font-size: 12px;

      line-height: 1.7;

    }


    /* =====================================================
       MODAL
    ====================================================== */

    .ppid-modal {

      position: fixed;

      inset: 0;

      z-index: 99999;

      display: flex;

      align-items: center;

      justify-content: center;

      padding: 20px;

      visibility: hidden;

      opacity: 0;

      transition:
        opacity .2s ease,
        visibility .2s ease;

    }


    .ppid-modal.show {

      visibility: visible;

      opacity: 1;

    }


    .modal-backdrop {

      position: absolute;

      inset: 0;

      background:
        rgba(
          15,
          23,
          42,
          .65
        );

      backdrop-filter:
        blur(4px);

    }


    .modal-box {

      position: relative;

      z-index: 2;

      width:
        min(
          700px,
          100%
        );

      max-height:
        min(
          750px,
          calc(
            100vh - 40px
          )
        );

      overflow-y: auto;

      padding: 30px;

      border-radius: 20px;

      background: #fff;

      box-shadow:
        0 30px 80px
        rgba(
          0,
          0,
          0,
          .25
        );

      transform:
        translateY(12px)
        scale(.98);

      transition:
        transform .2s ease;

    }


    .ppid-modal.show
    .modal-box {

      transform:
        translateY(0)
        scale(1);

    }


    .modal-close {

      position: absolute;

      top: 15px;

      right: 15px;

      width: 38px;

      height: 38px;

      display: grid;

      place-items: center;

      border: 0;

      border-radius: 9px;

      background: #f1f5f9;

      color: #64748b;

      cursor: pointer;

      transition: .2s ease;

    }


    .modal-close:hover {

      background: #fee2e2;

      color: #dc2626;

    }


    .modal-icon {

      width: 50px;

      height: 50px;

      display: grid;

      place-items: center;

      margin-bottom: 13px;

      border-radius: 12px;

      background: #eff6ff;

      color: #2563eb;

      font-size: 19px;

    }


    .modal-label {

      color: #2563eb;

      font-size: 10px;

      font-weight: 900;

      letter-spacing: .12em;

    }


    .modal-box h3 {

      max-width: 90%;

      margin:
        6px 0 18px;

      color: #172554;

      font-size: 26px;

      line-height: 1.3;

      font-weight: 900;

    }


    .modal-content {

      padding: 20px;

      border:
        1px solid #e2e8f0;

      border-radius: 12px;

      background: #f8fafc;

      color: #475569;

      font-size: 14px;

      line-height: 1.8;

    }


    /* =====================================================
       HTML API CONTENT
    ====================================================== */

    .modal-content :global(.inner) {

      width: 100%;

    }


    .modal-content :global(ol) {

      margin:
        0 0 10px;

      padding-left: 24px;

    }


    .modal-content :global(ul) {

      margin:
        8px 0;

      padding-left: 24px;

    }


    .modal-content :global(li) {

      margin-bottom: 8px;

    }


    .modal-content :global(li:last-child) {

      margin-bottom: 0;

    }


    .modal-content :global(a) {

      color: #2563eb;

      font-weight: 700;

      text-decoration: underline;

      overflow-wrap: anywhere;

    }


    .modal-content :global(a:hover) {

      color: #1d4ed8;

    }


    .modal-content :global(strong) {

      color: #172554;

    }


    .modal-content :global(h1),
    .modal-content :global(h2),
    .modal-content :global(h3),
    .modal-content :global(h4) {

      margin:
        15px 0 8px;

      color: #172554;

    }


    .modal-content :global(p) {

      margin:
        7px 0;

    }


    .modal-content :global(table) {

      width: 100%;

      border-collapse: collapse;

      margin:
        15px 0;

      font-size: 13px;

    }


    .modal-content :global(th),
    .modal-content :global(td) {

      padding: 8px;

      border:
        1px solid #dbeafe;

      text-align: left;

    }


    .modal-content :global(th) {

      background: #eff6ff;

      color: #172554;

    }


    /* =====================================================
       RESPONSIVE 1000
    ====================================================== */

    @media (max-width: 1000px) {

      .hero-grid {

        grid-template-columns: 1fr;

        gap: 30px;

      }


      .hero-information {

        max-width: 500px;

      }


      .category-grid {

        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          );

      }


      .information-layout {

        grid-template-columns: 1fr;

      }


      .ppid-sidebar {

        position: static;

        display: grid;

        grid-template-columns:
          repeat(
            2,
            minmax(0, 1fr)
          );

      }


      .contact-card {

        grid-column:
          span 2;

      }

    }


    /* =====================================================
       RESPONSIVE 650
    ====================================================== */

    @media (max-width: 650px) {

      .container {

        width:
          calc(
            100% - 30px
          );

      }


      .ppid-hero {

        padding:
          55px 0 60px;

      }


      .hero-content h1 {

        font-size: 40px;

      }


      .hero-content > p {

        font-size: 14px;

      }


      .hero-actions {

        flex-direction: column;

      }


      .hero-button {

        width: 100%;

      }


      .category-section,
      .information-section {

        padding:
          55px 0;

      }


      .section-heading {

        display: block;

      }


      .section-heading > p {

        margin-top: 12px;

      }


      .section-heading h2 {

        font-size: 30px;

      }


      .category-grid {

        grid-template-columns: 1fr;

      }


      .category-content h3 {

        font-size: 17px;

      }


      .category-content p {

        font-size: 13px;

      }


      .category-bottom {

        font-size: 12px;

