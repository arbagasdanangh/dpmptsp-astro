---
import MainLayout from "../layouts/MainLayout.astro";

export const prerender = false;

const title = "PPID - DPMPTSP Kota Surabaya";

const API_KATEGORI =
  "https://dpm-ptsp.surabaya.go.id/sso/apippid.php";

const API_ITEM =
  "https://dpm-ptsp.surabaya.go.id/sso/apippid_view.php";

const API_USERNAME =
  import.meta.env.API_BERITA_USERNAME;

const API_PASSWORD =
  import.meta.env.API_BERITA_PASSWORD;

const API_HEADERS = {
  username: API_USERNAME,
  password: API_PASSWORD,
  Accept: "application/json",
  "Content-Type":
    "application/x-www-form-urlencoded",
};

let kategori = [];
let items = [];
let apiError = "";

/* =========================================================
   API KATEGORI
========================================================= */

try {
  const response = await fetch(API_KATEGORI, {
    method: "POST",
    headers: API_HEADERS,
    body: new URLSearchParams(),
  });

  const result = await response.json();

  console.log("API PPID KATEGORI:", result);

  if (!response.ok) {
    throw new Error(
      result?.message ||
      `HTTP ${response.status}`
    );
  }

  if (Array.isArray(result?.data)) {
    kategori = result.data;
  } else if (Array.isArray(result)) {
    kategori = result;
  } else {
    throw new Error(
      result?.message ||
      "Data kategori PPID tidak ditemukan."
    );
  }

} catch (error) {

  console.error(
    "API PPID KATEGORI ERROR:",
    error
  );

  apiError =
    error instanceof Error
      ? error.message
      : "Gagal mengambil kategori PPID.";
}


/* =========================================================
   API ITEM
========================================================= */

try {

  const response = await fetch(API_ITEM, {
    method: "POST",
    headers: API_HEADERS,

    body: new URLSearchParams({
      id: "",
      kategori_id: "",
    }),
  });

  const result = await response.json();

  console.log("API PPID ITEM:", result);

  if (!response.ok) {
    throw new Error(
      result?.message ||
      `HTTP ${response.status}`
    );
  }

  if (Array.isArray(result?.data)) {

    items = result.data;

  } else if (Array.isArray(result)) {

    items = result;

  } else {

    throw new Error(
      result?.message ||
      "Data item PPID tidak ditemukan."
    );

  }

} catch (error) {

  console.error(
    "API PPID ITEM ERROR:",
    error
  );

  if (!apiError) {

    apiError =
      error instanceof Error
        ? error.message
        : "Gagal mengambil data PPID.";

  }

}


/* =========================================================
   NORMALISASI KATEGORI
========================================================= */

kategori = kategori.map((kat) => {

  const nama =
    kat.nama_kategori ||
    kat.nama ||
    kat.judul ||
    "Kategori PPID";

  const slug =
    kat.slug ||
    String(nama)
      .toLowerCase()
      .trim()
      .replace(
        /[^a-z0-9]+/g,
        "-"
      )
      .replace(
        /^-+|-+$/g,
        "");

  return {

    ...kat,

    id:
      Number(kat.id),

    nama_kategori:
      nama,

    slug:
      slug,

  };

});


/* =========================================================
   NORMALISASI ITEM
========================================================= */

items = items.map((item) => {

  return {

    ...item,

    id:
      Number(item.id),

    kategori_id:
      Number(item.kategori_id),

    judul:
      item.judul || "",

    isi:
      item.isi || "",

    file_url:
      item.file_url || "",

    urutan:
      Number(item.urutan || 0),

    nama_kategori:
      item.nama_kategori || "",

    slug:
      item.slug || "",

  };

});


/* =========================================================
   SORT
========================================================= */

kategori.sort(
  (a, b) =>
    Number(a.id || 0) -
    Number(b.id || 0)
);


items.sort((a, b) => {

  const kategoriCompare =
    Number(a.kategori_id || 0) -
    Number(b.kategori_id || 0);

  if (kategoriCompare !== 0) {
    return kategoriCompare;
  }

  const urutanCompare =
    Number(a.urutan || 0) -
    Number(b.urutan || 0);

  if (urutanCompare !== 0) {
    return urutanCompare;
  }

  return (
    Number(a.id || 0) -
    Number(b.id || 0)
  );

});


/* =========================================================
   HELPERS
========================================================= */

const getItems = (kategoriId) => {

  return items.filter(
    (item) =>
      Number(item.kategori_id) ===
      Number(kategoriId)
  );

};


const getKategoriCount = (kategoriId) => {

  return getItems(kategoriId).length;

};


const iconKategori = {

  berkala:
    "fa-calendar-days",

  merta:
    "fa-bolt",

  saat:
    "fa-folder-open",

  kecuali:
    "fa-lock",

};


const descKategori = {

  berkala:
    "Informasi yang wajib disediakan dan diumumkan secara berkala oleh badan publik.",

  merta:
    "Informasi yang berkaitan dengan kepentingan publik dan wajib diumumkan secara serta-merta.",

  saat:
    "Informasi yang wajib tersedia setiap saat dan dapat diakses oleh masyarakat.",

  kecuali:
    "Informasi yang tidak dapat diberikan kepada publik sesuai dengan ketentuan yang berlaku.",

};


const getIcon = (slug) => {

  return (
    iconKategori[slug] ||
    "fa-folder"
  );

};


const getDescription = (slug) => {

  return (
    descKategori[slug] ||
    "Informasi publik DPMPTSP Kota Surabaya."
  );

};


const getExcerpt = (html) => {

  if (!html) {
    return "";
  }

  return String(html)

    .replace(
      /<script[\s\S]*?<\/script>/gi,
      ""
    )

    .replace(
      /<style[\s\S]*?<\/style>/gi,
      ""
    )

    .replace(
      /<br\s*\/?>/gi,
      " "
    )

    .replace(
      /<\/li>/gi,
      " "
    )

    .replace(
      /<[^>]*>/g,
      " "
    )

    .replace(
      /&nbsp;/gi,
      " "
    )

    .replace(
      /&amp;/gi,
      "&"
    )

    .replace(
      /&lt;/gi,
      "<"
    )

    .replace(
      /&gt;/gi,
      ">"
    )

    .replace(
      /&quot;/gi,
      '"'
    )

    .replace(
      /&#39;/gi,
      "'"
    )

    .replace(
      /\s+/g,
      " "
    )

    .trim()

    .slice(
      0,
      180
    );

};
---

<MainLayout
  title={title}
  description="Platform layanan keterbukaan informasi publik DPMPTSP Kota Surabaya."
>

  <main class="ppid-page">


    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ppid-hero">

      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>

      <div class="container">

        <div class="hero-grid">

          <div class="hero-content">

            <div class="hero-badge">

              <span>
                <i class="fa-solid fa-building-columns"></i>
              </span>

              PPID DPMPTSP

            </div>


            <h1>
              Keterbukaan
