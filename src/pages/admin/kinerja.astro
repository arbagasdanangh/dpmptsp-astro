                                                : "Belum ada data kinerja"
                                        }

                                    </div>

                                </td>

                            </tr>

                        )
                    }

                </tbody>

            </table>

        </div>


        <!-- =================================================
             BOTTOM
        ================================================== -->

        <div class="bottom">

            <div
                class="table-info"
                id="tableInfo"
            >

                {
                    totalData > 0
                        ? `Showing ${offset + 1} to ${Math.min(
                            offset + dataKinerja.length,
                            totalData
                        )} of ${totalData} entries`
                        : "Showing 0 to 0 of 0 entries"
                }

            </div>


            <div
                class="pagination"
                id="pagination"
            >

                <button
                    type="button"
                    class="page-btn"
                    data-page={Math.max(
                        currentPage - 1,
                        1
                    )}
                    disabled={currentPage <= 1}
                >
                    Previous
                </button>


                {
                    paginationItems.map((item) =>

                        item.type === "dots" ? (

                            <span class="dots">
                                ...
                            </span>

                        ) : (

                            <button
                                type="button"
                                class:list={[
                                    "page-btn",
                                    {
                                        active:
                                            item.page ===
                                            currentPage
                                    }
                                ]}
                                data-page={item.page}
                            >
                                {item.page}
                            </button>

                        )
                    )
                }


                <button
                    type="button"
                    class="page-btn"
                    data-page={Math.min(
                        currentPage + 1,
                        totalPages
                    )}
                    disabled={
                        currentPage >= totalPages
                    }
                >
                    Next
                </button>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     EDIT MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="editModal"
    aria-hidden="true"
>

    <div
        class="modal"
        role="dialog"
        aria-modal="true"
    >

        <div class="modal-header">

            <h2 class="modal-title">
                Edit Kinerja
            </h2>

            <button
                type="button"
                class="modal-close"
                data-close="editModal"
            >
                ×
            </button>

        </div>


        <form
            method="POST"
            enctype="multipart/form-data"
        >

            <input
                type="hidden"
                name="action"
                value="edit"
            />


            <input
                type="hidden"
                name="id"
                id="editId"
            />


            <div class="modal-body">

                <div class="form-group">

                    <label
                        class="form-label"
                        for="editJudul"
                    >
                        Judul Kinerja
                    </label>

                    <input
                        class="form-input"
                        type="text"
                        id="editJudul"
                        name="judul"
                        required
                    />

                </div>


                <div class="form-group">

                    <label class="form-label">
                        Dokumen Saat Ini
                    </label>

                    <div class="current-file">

                        <span>
                            📄
                        </span>

                        <span
                            class="current-file-name"
                            id="editCurrentFile"
                        >
                            -
                        </span>

                    </div>

                </div>


                <div class="form-group">

                    <label
                        class="form-label"
                        for="editFile"
                    >
                        Upload Dokumen Baru
                    </label>

                    <input
                        class="form-input"
                        type="file"
                        id="editFile"
                        name="file"
                        accept=".pdf,application/pdf"
                    />

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="modal-btn btn-cancel"
                    data-close="editModal"
                >
                    Batal
                </button>


                <button
                    type="submit"
                    class="modal-btn btn-save"
                >
                    Simpan Perubahan
                </button>

            </div>

        </form>

    </div>

</div>


<!-- =========================================================
     DELETE MODAL
========================================================= -->

<div
    class="modal-overlay"
    id="deleteModal"
    aria-hidden="true"
>

    <div
        class="modal delete-modal"
        role="dialog"
        aria-modal="true"
    >

        <div class="modal-body">

            <div class="delete-content">

                <div class="delete-icon">

                    <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >

                        <polyline points="3 6 5 6 21 6" />

                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />

                        <path d="M10 11v6" />

                        <path d="M14 11v6" />

                        <path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2" />

                    </svg>

                </div>


                <h3>
                    Hapus Kinerja?
                </h3>


                <p>

                    Data

                    <strong id="deleteTitle">
                        -
                    </strong>

                    akan dihapus secara permanen.

                </p>

            </div>

        </div>


        <form method="POST">

            <input
                type="hidden"
                name="action"
                value="delete"
            />


            <input
                type="hidden"
                name="id"
                id="deleteId"
            />


            <div class="modal-footer">

                <button
                    type="button"
                    class="modal-btn btn-cancel"
                    data-close="deleteModal"
                >
                    Batal
                </button>


                <button
                    type="submit"
                    class="modal-btn btn-delete-confirm"
                >
                    Ya, Hapus
                </button>

            </div>

        </form>

    </div>

</div>


<script>

    /* =========================================================
       ELEMENTS
    ========================================================= */

    const searchInput =
        document.getElementById(
            "searchInput"
        );

    const clearSearch =
        document.getElementById(
            "clearSearch"
        );

    const tableBody =
        document.getElementById(
            "tableBody"
        );

    const tableInfo =
        document.getElementById(
            "tableInfo"
        );

    const pagination =
        document.getElementById(
            "pagination"
        );

    const limitSelect =
        document.getElementById(
            "limitSelect"
        );


    const editModal =
        document.getElementById(
            "editModal"
        );

    const deleteModal =
        document.getElementById(
            "deleteModal"
        );


    const editId =
        document.getElementById(
            "editId"
        );

    const editJudul =
        document.getElementById(
            "editJudul"
        );

    const editCurrentFile =
        document.getElementById(
            "editCurrentFile"
        );


    const deleteId =
        document.getElementById(
            "deleteId"
        );

    const deleteTitle =
        document.getElementById(
            "deleteTitle"
        );


    let searchTimer;

    let controller = null;


    /* =========================================================
       MODAL
    ========================================================= */

    function openModal(modal) {

        if (!modal) {
            return;
        }

        modal.classList.add("show");

        modal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

    }


    function closeModal(modal) {

        if (!modal) {
            return;
        }

        modal.classList.remove("show");

        modal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

    }


    /* =========================================================
       CLOSE MODAL
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const target =
                event.target;


            const closeButton =
                target.closest(
                    "[data-close]"
                );


            if (closeButton) {

                const modalId =
                    closeButton.dataset.close;

                closeModal(
                    document.getElementById(
                        modalId
                    )
                );

                return;

            }


            /* =================================================
               CLICK BACKDROP
            ================================================= */

            if (
                target === editModal
            ) {

                closeModal(
                    editModal
                );

            }


            if (
                target === deleteModal
            ) {

                closeModal(
                    deleteModal
                );

            }

        }
    );


    /* =========================================================
       ESC
    ========================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (
                event.key !== "Escape"
            ) {
                return;
            }


            closeModal(
                editModal
            );

            closeModal(
                deleteModal
            );

        }
    );


    /* =========================================================
       EDIT / DELETE TABLE ACTION
       EVENT DELEGATION
       SUPAYA TETAP BERFUNGSI
       SETELAH FETCH
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "[data-action]"
                );


            if (!button) {
                return;
            }


            const action =
                button.dataset.action;


            const id =
                button.dataset.id;


            /* =================================================
               EDIT
            ================================================= */

            if (
                action === "edit"
            ) {

                const title =
                    button.dataset.title ||
                    "";

                const file =
                    button.dataset.file ||
                    "";


                editId.value =
                    id;


                editJudul.value =
                    title;


                editCurrentFile.textContent =
                    file
                        ? file.split("/").pop()
                        : "Belum ada dokumen";


                openModal(
                    editModal
                );

                setTimeout(
                    function () {

                        editJudul.focus();

                    },
                    100
                );

            }


            /* =================================================
               DELETE
            ================================================= */

            if (
                action === "delete"
            ) {

                const title =
                    button.dataset.title ||
                    "data ini";


                deleteId.value =
                    id;


                deleteTitle.textContent =
                    title;


                openModal(
                    deleteModal
                );

            }

        }
    );


    /* =========================================================
       CLEAR SEARCH BUTTON
    ========================================================= */

    function updateClearButton() {

        if (
            !clearSearch ||
            !searchInput
        ) {
            return;
        }


        clearSearch.style.display =
            searchInput.value.trim()
                ? "flex"
                : "none";

    }


    /* =========================================================
       LOAD TABLE
    ========================================================= */

    async function loadTable(
        targetUrl,
        updateHistory = true
    ) {

        if (controller) {
            controller.abort();
        }


        controller =
            new AbortController();


        try {

            tableBody.style.opacity =
                "0.45";


            const response =
                await fetch(
                    targetUrl.toString(),
                    {
                        method: "GET",
                        headers: {
                            "X-Requested-With":
                                "fetch"
                        },
                        signal:
                            controller.signal
                    }
                );


            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }


            const html =
                await response.text();


            const parser =
                new DOMParser();


            const doc =
                parser.parseFromString(
                    html,
                    "text/html"
                );


            const newTableBody =
                doc.querySelector(
                    "#tableBody"
                );


            const newTableInfo =
                doc.querySelector(
                    "#tableInfo"
                );


            const newPagination =
                doc.querySelector(
                    "#pagination"
                );


            if (
                newTableBody &&
                tableBody
            ) {

                tableBody.innerHTML =
                    newTableBody.innerHTML;

            }


            if (
                newTableInfo &&
                tableInfo
            ) {

                tableInfo.innerHTML =
                    newTableInfo.innerHTML;

            }


            if (
                newPagination &&
                pagination
            ) {

                pagination.innerHTML =
                    newPagination.innerHTML;

            }


            if (updateHistory) {

                window.history.pushState(
                    {},
                    "",
                    targetUrl.toString()
                );

            }


            updateClearButton();

        } catch (error) {

            if (
                error.name !==
                "AbortError"
            ) {

                console.error(
                    "Gagal mengambil data:",
                    error
                );

            }

        } finally {

            tableBody.style.opacity =
                "1";

        }

    }


    /* =========================================================
       SEARCH
    ========================================================= */

    if (searchInput) {

        searchInput.addEventListener(
            "input",
            function () {

                clearTimeout(
                    searchTimer
                );


                searchTimer =
                    setTimeout(
                        function () {

                            const keyword =
                                searchInput
                                    .value
                                    .trim();


                            const url =
                                new URL(
                                    window.location.href
                                );


                            url.searchParams.set(
                                "page",
                                "1"
                            );


                            if (keyword) {

                                url.searchParams.set(
                                    "q",
                                    keyword
                                );

                            } else {

                                url.searchParams.delete(
                                    "q"
                                );

                            }


                            loadTable(
                                url
                            );

                        },
                        300
                    );

            }
        );

    }


    /* =========================================================
       CLEAR SEARCH
    ========================================================= */

    if (clearSearch) {

        clearSearch.addEventListener(
            "click",
            function () {

                searchInput.value =
                    "";


                const url =
                    new URL(
                        window.location.href
                    );


                url.searchParams.set(
                    "page",
                    "1"
                );


                url.searchParams.delete(
                    "q"
                );


                loadTable(
                    url
                );


                searchInput.focus();

            }
        );

    }


    /* =========================================================
       PAGINATION
       EVENT DELEGATION
       AGAR TIDAK MATI SETELAH FETCH
    ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            const button =
                event.target.closest(
                    "#pagination [data-page]"
                );


            if (!button) {
                return;
            }


            if (
                button.disabled ||
                button.classList.contains(
                    "active"
                )
            ) {
                return;
            }


            const page =
                button.dataset.page;


            const url =
                new URL(
                    window.location.href
                );


            url.searchParams.set(
                "page",
                page
            );


            loadTable(
                url
            );

        }
    );


    /* =========================================================
       LIMIT
    ========================================================= */

    if (limitSelect) {

        limitSelect.addEventListener(
            "change",
            function () {

                const url =
                    new URL(
                        window.location.href
                    );


                url.searchParams.set(
                    "limit",
                    limitSelect.value
                );


                url.searchParams.set(
                    "page",
                    "1"
                );


                loadTable(
                    url
                );

            }
        );

    }


    /* =========================================================
       BACK / FORWARD
    ========================================================= */

    window.addEventListener(
        "popstate",
        function () {

            const url =
                new URL(
                    window.location.href
                );


            const keyword =
                url.searchParams.get(
                    "q"
                ) || "";


            const currentLimit =
                url.searchParams.get(
                    "limit"
                ) || "10";


            if (searchInput) {

                searchInput.value =
                    keyword;

            }


            if (limitSelect) {

                limitSelect.value =
                    currentLimit;

            }


            loadTable(
                url,
                false
            );

        }
    );


    /* =========================================================
       INIT
    ========================================================= */

    updateClearButton();

</script>

</AdminShell>
