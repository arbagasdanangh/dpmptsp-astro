export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import { writeFile, unlink } from "fs/promises";
import path from "path";
import crypto from "crypto";

/* =========================================================
   URL
========================================================= */

const url = new URL(Astro.request.url);

const currentPage = Math.max(
    Number(url.searchParams.get("page")) || 1,
    1
);

const q = (url.searchParams.get("q") || "").trim();

const limitParam =
    Number(url.searchParams.get("limit")) || 10;

const allowedLimits = [10, 25, 50, 100];

const limit = allowedLimits.includes(limitParam)
    ? limitParam
    : 10;


/* =========================================================
   HANDLE POST
   EDIT + DELETE
========================================================= */

if (Astro.request.method === "POST") {

    try {

        const formData =
            await Astro.request.formData();

        const action =
            String(
                formData.get("action") || ""
            );

        const id =
            Number(
                formData.get("id") || 0
            );


        if (!id) {
            throw new Error("ID tidak valid");
        }


        /* =====================================================
           DELETE
        ===================================================== */

        if (action === "delete") {

            const [oldRows]: any =
                await db.query(
                    `
                    SELECT file_path
                    FROM twdata
                    WHERE id = ?
                    LIMIT 1
                    `,
                    [id]
                );


            const oldFile =
                oldRows?.[0]?.file_path;


            await db.query(
                `
                DELETE FROM twdata
                WHERE id = ?
                `,
                [id]
            );


            /* ================================================
               HAPUS FILE PDF LAMA
            ================================================ */

            if (oldFile) {

                try {

                    const oldFileName =
                        path.basename(
                            oldFile
                        );

                    const oldFilePath =
                        path.join(
                            process.cwd(),
                            "public",
                            "pdf",
                            oldFileName
                        );

                    await unlink(
                        oldFilePath
                    );

                } catch (fileError) {

                    console.warn(
                        "File PDF tidak ditemukan:",
                        fileError
                    );

                }

            }


            return Astro.redirect(
                `/admin/kinerja?page=${currentPage}&limit=${limit}`
            );
        }


        /* =====================================================
           EDIT
        ===================================================== */

        if (action === "edit") {

            const judul =
                String(
                    formData.get("judul") || ""
                ).trim();


            if (!judul) {

                return Astro.redirect(
                    `/admin/kinerja?page=${currentPage}&limit=${limit}`
                );

            }


            const file =
                formData.get("file");


            /* ================================================
               CEK FILE LAMA
            ================================================ */

            const [oldRows]: any =
                await db.query(
                    `
                    SELECT file_path
                    FROM twdata
                    WHERE id = ?
                    LIMIT 1
                    `,
                    [id]
                );


            const oldFile =
                oldRows?.[0]?.file_path || "";


            /* ================================================
               JIKA UPLOAD PDF BARU
            ================================================ */

            if (
                file instanceof File &&
                file.size > 0
            ) {

                const buffer =
                    Buffer.from(
                        await file.arrayBuffer()
                    );


                /* ============================================
                   NAMA FILE AMAN
                ============================================ */

                const originalName =
                    path.basename(
                        file.name
                    );


                const safeName =
                    originalName
                        .replace(
                            /[^a-zA-Z0-9._-]/g,
                            "-"
                        );


                const uniqueName =
                    `${Date.now()}-${crypto.randomUUID()}-${safeName}`;


                const uploadDirectory =
                    path.join(
                        process.cwd(),
                        "public",
                        "pdf"
                    );


                const lokasi =
                    path.join(
                        uploadDirectory,
                        uniqueName
                    );


                await writeFile(
                    lokasi,
                    buffer
                );


                const newFilePath =
                    `/pdf/${uniqueName}`;


                await db.query(
                    `
                    UPDATE twdata
                    SET
                        tw_option = ?,
                        file_path = ?
                    WHERE id = ?
                    `,
                    [
                        judul,
                        newFilePath,
                        id
                    ]
                );


                /* ============================================
                   HAPUS FILE LAMA
                ============================================ */

                if (oldFile) {

                    try {

                        const oldFileName =
                            path.basename(
                                oldFile
                            );


                        const oldFilePath =
                            path.join(
                                process.cwd(),
                                "public",
                                "pdf",
                                oldFileName
                            );


                        await unlink(
                            oldFilePath
                        );

                    } catch (fileError) {

                        console.warn(
                            "File lama tidak ditemukan:",
                            fileError
                        );

                    }

                }

            } else {

                /* ============================================
                   UPDATE JUDUL SAJA
                ============================================ */

                await db.query(
                    `
                    UPDATE twdata
                    SET tw_option = ?
                    WHERE id = ?
                    `,
                    [
                        judul,
                        id
                    ]
                );

            }


            return Astro.redirect(
                `/admin/kinerja?page=${currentPage}&limit=${limit}`
            );

        }

    } catch (error) {

        console.error(
            "POST Kinerja Error:",
            error
        );

    }

}


/* =========================================================
   SEARCH
========================================================= */

let whereSQL = "";

const searchParams: string[] = [];

if (q) {

    whereSQL = `
        WHERE
            tw_option LIKE ?
            OR file_path LIKE ?
    `;

    searchParams.push(
        `%${q}%`,
        `%${q}%`
    );

}


/* =========================================================
   TOTAL DATA
========================================================= */

const [countRows]: any =
    await db.query(
        `
        SELECT COUNT(*) AS total
        FROM twdata
        ${whereSQL}
        `,
        searchParams
    );


const totalData =
    Number(
        countRows?.[0]?.total || 0
    );


const totalPages =
    Math.max(
        Math.ceil(
            totalData / limit
        ),
        1
    );


/* =========================================================
   OFFSET
========================================================= */

const offset =
    (currentPage - 1) * limit;


/* =========================================================
   DATA
========================================================= */

const [rows]: any =
    await db.query(
        `
        SELECT *
        FROM twdata
        ${whereSQL}
        ORDER BY id DESC
        LIMIT ? OFFSET ?
        `,
        [
            ...searchParams,
            limit,
            offset
        ]
    );


const dataKinerja =
    rows as Array<{
        id: number;
        tw_option: string;
        file_path: string;
    }>;


/* =========================================================
   PAGINATION
========================================================= */

type PaginationItem =
    | {
        type: "page";
        page: number;
    }
    | {
        type: "dots";
    };


const paginationItems: PaginationItem[] = [];


if (totalPages <= 7) {

    for (
        let page = 1;
        page <= totalPages;
        page++
    ) {

        paginationItems.push({
            type: "page",
            page
        });

    }

} else {

    paginationItems.push({
        type: "page",
        page: 1
    });


    if (currentPage > 4) {

        paginationItems.push({
            type: "dots"
        });

    }


    const startPage =
        Math.max(
            2,
            currentPage - 2
        );


    const endPage =
        Math.min(
            totalPages - 1,
            currentPage + 2
        );


    for (
        let page = startPage;
        page <= endPage;
        page++
    ) {

        paginationItems.push({
            type: "page",
            page
        });

    }


    if (
        currentPage <
        totalPages - 3
    ) {

        paginationItems.push({
            type: "dots"
        });

    }


    paginationItems.push({
        type: "page",
        page: totalPages
    });

}
