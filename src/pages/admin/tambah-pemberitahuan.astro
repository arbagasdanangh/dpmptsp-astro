---
export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";
import fs from "fs/promises";
import path from "path";

let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();

    const judul = String(data.get("judul") || "").trim();
    const isi = String(data.get("isi") || "").trim();
    const tipe = String(data.get("tipe") || "info").trim();
    const icon = String(data.get("icon") || "fa-circle-info").trim();
    const link = String(data.get("link") || "").trim();
    const teks_link = String(data.get("teks_link") || "").trim();

    const urutanRaw = String(data.get("urutan") || "0").trim();
    const urutan = Number(urutanRaw);

    const active = String(data.get("active") || "Y").trim();

    const mulaiRaw = String(data.get("mulai") || "").trim();
    const selesaiRaw = String(data.get("selesai") || "").trim();

    if (!judul) {
      throw new Error("Judul pemberitahuan wajib diisi.");
    }

    if (!Number.isFinite(urutan)) {
      throw new Error("Urutan harus berupa angka.");
    }

    const formatMySQLDateTime = (value) => {
      if (!value) return null;

      return (
        value.replace("T", " ") +
        (value.length === 16 ? ":00" : "")
      );
    };

    const mulai = formatMySQLDateTime(mulaiRaw);
    const selesai = formatMySQLDateTime(selesaiRaw);

    let gambar = null;

    const file = data.get("gambar");

    if (
      file &&
      typeof file === "object" &&
      "size" in file &&
      file.size > 0
    ) {
      const maxSize = 5 * 1024 * 1024;

      if (file.size > maxSize) {
        throw new Error("Ukuran gambar maksimal 5MB.");
      }

      const allowedTypes = [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/webp"
      ];

      if (!allowedTypes.includes(file.type)) {
        throw new Error(
          "Format gambar tidak didukung. Gunakan JPG, PNG, GIF, atau WEBP."
        );
      }

      const originalName = String(file.name || "gambar");

      let ext = path
        .extname(originalName)
        .toLowerCase();

      const allowedExt = [
        ".jpg",
        ".jpeg",
        ".png",
        ".gif",
        ".webp"
      ];

      if (!allowedExt.includes(ext)) {
        ext = ".jpg";
      }

      const filename =
        "notifikasi_" +
        Date.now() +
        ext;

      const uploadDir = path.join(
        process.cwd(),
        "public",
        "uploads"
      );

      await fs.mkdir(uploadDir, {
        recursive: true
      });

      const uploadPath = path.join(
        uploadDir,
        filename
      );

      const arrayBuffer =
        await file.arrayBuffer();

      const buffer =
        Buffer.from(arrayBuffer);

      await fs.writeFile(
        uploadPath,
        buffer
      );

      gambar =
        "/uploads/" + filename;

      console.log(
        "Gambar berhasil diupload:",
        gambar
      );
    }

    const sql = `
      INSERT INTO notifikasi_beranda
      (
        judul,
        isi,
        gambar,
        tipe,
        icon,
        link,
        teks_link,
        urutan,
        active,
        mulai,
        selesai
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `;

    const values = [
      judul,
      isi,
      gambar,
      tipe,
      icon,
      link || null,
      teks_link || null,
      urutan,
      active,
      mulai,
      selesai
    ];

    await db.query(sql, values);

    return Astro.redirect(
      "/admin/pemberitahuan"
    );

  } catch (error) {
    console.error(
      "ERROR TAMBAH PEMBERITAHUAN:",
      error
    );

    errorMessage =
      error instanceof Error
        ? error.message
        : "Terjadi kesalahan saat menyimpan pemberitahuan.";
  }
}
---
 
<AdminShell
  title="Tambah Pemberitahuan"
  subtitle="Tambahkan pemberitahuan baru"
>

<div class="page-container">
  <div class="page-header">
    <div>
      <h1>Tambah Pemberitahuan</h1>
      <p>Buat pemberitahuan baru untuk halaman beranda.</p>
    </div>

    <a
      href="/admin/pemberitahuan"
      class="btn-back"
    >
      <i class="fa-solid fa-arrow-left"></i>
      Kembali
    </a>
  </div>

  {errorMessage && (
    <div class="alert-error">
      <i class="fa-solid fa-circle-exclamation"></i>

      <div>
        <strong>Gagal menyimpan</strong>
        <p>{errorMessage}</p>
      </div>
    </div>
  )}

  <form
    method="POST"
    enctype="multipart/form-data"
    id="notificationForm"
  >
    <div class="form-grid">

      <!-- =========================
           KOLOM UTAMA
      ========================== -->
      <div class="main-column">

        <div class="card">
          <div class="card-header">
            <div class="card-icon blue">
              <i class="fa-solid fa-bell"></i>
            </div>

            <div>
              <h2>Informasi Pemberitahuan</h2>
              <p>Isi informasi utama pemberitahuan.</p>
            </div>
          </div>

          <div class="card-body">

            <div class="form-group">
              <label for="judul">
                Judul <span>*</span>
              </label>

              <input
                type="text"
                id="judul"
                name="judul"
                placeholder="Masukkan judul pemberitahuan"
                required
                maxlength="255"
              />
            </div>

            <div class="form-group">
              <label for="isi">
                Isi Pemberitahuan
              </label>

              <textarea
                id="isi"
                name="isi"
                rows="8"
                placeholder="Masukkan isi pemberitahuan..."
              ></textarea>

              <div class="field-help">
                Tuliskan informasi yang ingin ditampilkan kepada pengguna.
              </div>
            </div>

          </div>
        </div>

        <!-- =========================
             GAMBAR
        ========================== -->
        <div class="card">
          <div class="card-header">
            <div class="card-icon purple">
              <i class="fa-solid fa-image"></i>
            </div>

            <div>
              <h2>Gambar</h2>
              <p>Upload gambar pemberitahuan.</p>
            </div>
          </div>

          <div class="card-body">

            <div
              class="upload-area"
              id="uploadArea"
            >
              <input
                type="file"
                id="gambar"
                name="gambar"
                accept="image/jpeg,image/png,image/gif,image/webp"
                hidden
              />

              <div
                class="upload-placeholder"
                id="uploadPlaceholder"
              >
                <div class="upload-icon">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>

                <h3>Pilih gambar</h3>

                <p>
                  Klik untuk memilih gambar atau seret file ke sini
                </p>

                <span>
                  JPG, PNG, GIF atau WEBP — maksimal 5MB
                </span>
              </div>

              <div
                class="preview-container"
                id="previewContainer"
                style="display:none;"
              >
                <img
                  id="imagePreview"
                  src=""
                  alt="Preview gambar"
                />

                <div class="preview-info">
                  <strong id="fileName">
                    -
                  </strong>

                  <span id="fileSize">
                    -
                  </span>
                </div>

                <button
                  type="button"
                  id="removeImage"
                  class="remove-image"
                >
                  <i class="fa-solid fa-trash"></i>
                  Hapus gambar
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- =========================
             LINK
        ========================== -->
        <div class="card">
          <div class="card-header">
            <div class="card-icon green">
              <i class="fa-solid fa-link"></i>
            </div>

            <div>
              <h2>Link</h2>
              <p>Tambahkan tautan jika diperlukan.</p>
            </div>
          </div>

          <div class="card-body">

            <div class="two-column">

              <div class="form-group">
                <label for="link">
                  Link URL
                </label>

                <input
                  type="text"
                  id="link"
                  name="link"
                  placeholder="/berita atau https://..."
                />
              </div>

              <div class="form-group">
                <label for="teks_link">
                  Teks Link
                </label>

                <input
                  type="text"
                  id="teks_link"
                  name="teks_link"
                  placeholder="Contoh: Selengkapnya"
                />
              </div>

            </div>

          </div>
        </div>

      </div>

      <!-- =========================
           SIDEBAR FORM
      ========================== -->
      <div class="side-column">

        <!-- TIPE -->
        <div class="card">
          <div class="card-header compact">
            <div class="card-icon orange">
              <i class="fa-solid fa-sliders"></i>
            </div>

            <div>
              <h2>Pengaturan</h2>
              <p>Atur tampilan pemberitahuan.</p>
            </div>
          </div>

          <div class="card-body">

            <div class="form-group">
              <label for="tipe">
                Tipe
              </label>

              <select
                id="tipe"
                name="tipe"
              >
                <option value="info">
                  Info
                </option>

                <option value="success">
                  Success
                </option>

                <option value="warning">
                  Warning
                </option>

                <option value="danger">
                  Danger
                </option>

                <option value="modal">
                  Modal
                </option>
              </select>
            </div>

            <div class="form-group">
              <label for="active">
                Status
              </label>

              <select
                id="active"
                name="active"
              >
                <option value="Y">
                  Aktif
                </option>

                <option value="N">
                  Tidak Aktif
                </option>
              </select>
            </div>

            <div class="form-group">
              <label for="urutan">
                Urutan
              </label>

              <input
                type="number"
                id="urutan"
                name="urutan"
                value="0"
                min="0"
              />

              <div class="field-help">
                Angka lebih kecil akan tampil lebih dahulu.
              </div>
            </div>

          </div>
        </div>

        <!-- ICON -->
        <div class="card">
          <div class="card-header compact">
            <div class="card-icon yellow">
              <i class="fa-solid fa-icons"></i>
            </div>

            <div>
              <h2>Icon</h2>
              <p>Icon Font Awesome.</p>
            </div>
          </div>

          <div class="card-body">

            <div class="form-group">
              <label for="icon">
                Nama Icon
              </label>

              <input
                type="text"
                id="icon"
                name="icon"
                value="fa-circle-info"
                placeholder="fa-circle-info"
              />
            </div>

            <div class="icon-preview-box">
              <div class="icon-preview">
                <i
                  id="iconPreview"
                  class="fa-solid fa-circle-info"
                ></i>
              </div>

              <div>
                <strong>Preview Icon</strong>
                <small>
                  Contoh: fa-circle-info
                </small>
              </div>
            </div>

          </div>
        </div>

        <!-- JADWAL -->
        <div class="card">
          <div class="card-header compact">
            <div class="card-icon red">
              <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div>
              <h2>Periode</h2>
              <p>Atur waktu tampil.</p>
            </div>
          </div>

          <div class="card-body">

            <div class="form-group">
              <label for="mulai">
                Mulai
              </label>

              <input
                type="datetime-local"
                id="mulai"
                name="mulai"
              />
            </div>

            <div class="form-group">
              <label for="selesai">
                Selesai
              </label>

              <input
                type="datetime-local"
                id="selesai"
                name="selesai"
              />
            </div>

            <div class="period-help">
              <i class="fa-solid fa-circle-info"></i>

              <span>
                Kosongkan tanggal jika pemberitahuan ingin
                mengikuti status aktif tanpa batas waktu.
              </span>
            </div>

          </div>
        </div>

      </div>
    </div>

    <!-- =========================
         ACTION
    ========================== -->
    <div class="form-actions">

      <a
        href="/admin/pemberitahuan"
        class="btn-cancel"
      >
        Batal
      </a>

      <button
        type="submit"
        class="btn-save"
        id="saveButton"
      >
        <i class="fa-solid fa-floppy-disk"></i>
        Simpan Pemberitahuan
      </button>

    </div>
  </form>
</div>

<style>
