export const prerender = false;

import Navbar from "../../components/admin/Navbar.astro";
import Sidebar from "../../components/admin/Sidebar.astro";
import { db } from "../../lib/db";
import fs from "node:fs/promises";
import path from "node:path";

/* =========================================================
   PARAMETER ID
========================================================= */

const url = new URL(Astro.request.url);
const id = url.searchParams.get("id");

if (!id) {
    return Astro.redirect("/admin/artikel");
}


/* =========================================================
   DATA ARTIKEL
========================================================= */

let artikel: any = null;
let errorMessage = "";


/* =========================================================
   FOLDER UPLOAD
========================================================= */

const uploadDir = path.join(
    process.cwd(),
    "public",
    "uploads"
);


/* =========================================================
   HELPER SLUG
========================================================= */

const createSlug = (
    value: string
): string => {

    return value
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9\s-]/g, "")
        .replace(/\s+/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "");
};


/* =========================================================
   HELPER PREFIX KATEGORI
========================================================= */

const getCategoryPrefix = (
    category: string | number
): string => {

    const idCategory =
        String(category).trim();

    /*
     * 1, 8 = berita
     * 2, 3 = artikel
     * selain itu = artikel
     */

    if (
        ["1", "8"].includes(
            idCategory
        )
    ) {

        return "berita";
    }

    if (
        ["2", "3"].includes(
            idCategory
        )
    ) {

        return "artikel";
    }

    return "artikel";
};


/* =========================================================
   HELPER NAMA FILE
========================================================= */

const getFilename = (
    picture: string | null | undefined
): string => {

    if (!picture) {
        return "";
    }

    let value =
        String(picture).trim();

    if (!value) {
        return "";
    }


    /* ---------------------------------------------------------
       URL LENGKAP
    --------------------------------------------------------- */

    try {

        if (
            value.startsWith("http://") ||
            value.startsWith("https://")
        ) {

            const parsed =
                new URL(value);

            value =
                parsed.pathname;
        }

    } catch {
        // Bukan URL valid
    }


    /* ---------------------------------------------------------
       Normalisasi slash
    --------------------------------------------------------- */

    value =
        value.replace(
            /\\/g,
            "/"
        );


    /* ---------------------------------------------------------
       Ambil nama file saja
    --------------------------------------------------------- */

    return path.basename(
        value
    );
};


/* =========================================================
   HELPER URL FOTO
========================================================= */

const getPictureUrl = (
    picture: string | null | undefined
): string => {

    const filename =
        getFilename(picture);

    if (!filename) {
        return "";
    }

    return `/uploads/${encodeURIComponent(filename)}`;
};


/* =========================================================
   AMBIL DATA ARTIKEL
========================================================= */

try {

    const [rows] =
        await db.query(
            `
            SELECT *
            FROM post
            WHERE id_post = ?
            LIMIT 1
            `,
            [id]
        );

    artikel =
        (rows as any[])[0] ||
        null;

} catch (error: any) {

    console.error(
        "Gagal mengambil artikel:",
        error
    );

    errorMessage =
        error?.message ||
        "Gagal mengambil data artikel.";
}


/* =========================================================
   ARTIKEL TIDAK DITEMUKAN
========================================================= */

if (!artikel) {

    return Astro.redirect(
        "/admin/artikel"
    );
}


/* =========================================================
   FOTO LAMA
========================================================= */

const pictureDatabase =
    artikel.picture
        ? String(
            artikel.picture
        ).trim()
        : "";


const pictureFilename =
    getFilename(
        pictureDatabase
    );


const pictureUrl =
    getPictureUrl(
        pictureDatabase
    );


/* =========================================================
   CEK FILE FISIK
========================================================= */

let pictureExists =
    false;

if (pictureFilename) {

    try {

        await fs.access(
            path.join(
                uploadDir,
                pictureFilename
            )
        );

        pictureExists =
            true;

    } catch {

        pictureExists =
            false;
    }
}


/* =========================================================
   DATA DEFAULT
========================================================= */

const artikelDate = artikel.date
    ? new Date(artikel.date).toISOString().slice(0, 10)
    : "";



/* =========================================================
   POST / SIMPAN
========================================================= */

if (
    Astro.request.method === "POST"
) {

    let newUploadedFile = "";
    let oldFileToDelete = "";

    try {

        const formData =
            await Astro.request.formData();


        /* =================================================
           DATA FORM
        ================================================= */

        const title =
            String(
                formData.get("title") ||
                ""
            ).trim();


        const category =
            String(
                formData.get("category") ||
                ""
            ).trim();


        /*
         * ref_content = ISI ARTIKEL HTML
         */

        const refContent =
            String(
                formData.get("ref_content") ||
                ""
            );


        /*
         * content = SLUG
         */

        const slug =
            createSlug(
                title
            );


        const content =
            slug;


        const active =
            String(
                formData.get("active") ||
                "Y"
            ).trim();


        const date =
            String(
                formData.get("date") ||
                ""
            ).trim();


        const tag =
            String(
                formData.get("tag") ||
                ""
            ).trim();


        const seoTitle =
            String(
                formData.get("seotitle") ||
                title
            ).trim();


        const headline =
            String(
                formData.get("headline") ||
                artikel.headline ||
                "N"
            ).trim();


        /* =================================================
           VALIDASI JUDUL
        ================================================= */

        if (!title) {

            throw new Error(
                "Judul artikel wajib diisi."
            );
        }


        /* =================================================
           VALIDASI SLUG
        ================================================= */

        if (!slug) {

            throw new Error(
                "Judul menghasilkan slug kosong."
            );
        }


        /* =================================================
           VALIDASI KATEGORI
        ================================================= */

        const allowedCategories = [
            "1",
            "2",
            "3",
            "8",
            "10",
            "11"
        ];


        if (
            !allowedCategories.includes(
                category
            )
        ) {

            throw new Error(
                "Kategori artikel tidak valid."
            );
        }


        /* =================================================
           VALIDASI STATUS
        ================================================= */

        const allowedActive = [
            "Y",
            "N"
        ];


        if (
            !allowedActive.includes(
                active
            )
        ) {

            throw new Error(
                "Status artikel tidak valid."
            );
        }


        /* =================================================
           VALIDASI TANGGAL
        ================================================= */

        let tanggalFile =
            date;


        if (!tanggalFile) {

            tanggalFile =
                new Date()
                    .toISOString()
                    .slice(0, 10);
        }


        /*
         * Pastikan format YYYY-MM-DD
         */

        if (
            !/^\d{4}-\d{2}-\d{2}$/.test(
                tanggalFile
            )
        ) {

            throw new Error(
                "Format tanggal tidak valid. Gunakan YYYY-MM-DD."
            );
        }


        /* =================================================
           FOTO LAMA
        ================================================= */

        const oldPicture =
            pictureFilename;


        let namaPicture =
            oldPicture;


        /* =================================================
           CHECKBOX HAPUS FOTO
        ================================================= */

        const hapusPicture =
            formData.get(
                "hapus_picture"
            ) === "Y";


        /* =================================================
           FILE BARU
        ================================================= */

        const pictureFile =
            formData.get("picture");


        const hasNewFile =
            pictureFile instanceof File &&
            pictureFile.size > 0 &&
            Boolean(
                pictureFile.name
            );


        /* =================================================
           UPLOAD FOTO BARU
        ================================================= */

        if (hasNewFile) {

            const file =
                pictureFile as File;


            /* =============================================
               VALIDASI MIME TYPE
            ============================================= */

            const allowedTypes = [
                "image/jpeg",
                "image/jpg",
                "image/png",
                "image/webp"
            ];


            if (
                !allowedTypes.includes(
                    file.type
                )
            ) {

                throw new Error(
                    "Format gambar harus JPG, JPEG, PNG, atau WEBP."
                );
            }


            /* =============================================
               VALIDASI SIZE
            ============================================= */

            const maxSize =
                5 * 1024 * 1024;


            if (
                file.size > maxSize
            ) {

                throw new Error(
                    "Ukuran gambar maksimal 5 MB."
                );
            }


            /* =============================================
               BUAT FOLDER
            ============================================= */

            await fs.mkdir(
                uploadDir,
                {
                    recursive: true
                }
            );


            /* =============================================
               EXTENSION
            ============================================= */

            let extension =
                path.extname(
                    file.name
                ).toLowerCase();


            const allowedExtensions = [
                ".jpg",
                ".jpeg",
                ".png",
                ".webp"
            ];


            if (
                !allowedExtensions.includes(
                    extension
                )
            ) {

                if (
                    file.type ===
                    "image/jpeg"
                ) {

                    extension =
                        ".jpg";

                } else if (
                    file.type ===
                    "image/png"
                ) {

                    extension =
                        ".png";

                } else if (
                    file.type ===
                    "image/webp"
                ) {

                    extension =
                        ".webp";

                } else {

                    throw new Error(
                        "Extension gambar tidak valid."
                    );
                }
            }


            /* =============================================
               PREFIX KATEGORI
            ============================================= */

            const categoryPrefix =
                getCategoryPrefix(
                    category
                );


            /* =============================================
               NAMA FILE
               
               CONTOH:
               
               berita-8-mboh-bingung-aku-2026-09-04.jpg
               
               artikel-2-investasi-daerah-2026-09-04.jpg
            ============================================= */

            const newFilename =
                `${categoryPrefix}-${category}-${slug}-${tanggalFile}${extension}`;


            const newFilePath =
                path.join(
                    uploadDir,
                    newFilename
                );


            /* =============================================
               TULIS FILE
            ============================================= */

            const buffer =
                Buffer.from(
                    await file.arrayBuffer()
                );


            await fs.writeFile(
                newFilePath,
                buffer
            );


            /* =============================================
               CATAT FILE BARU
            ============================================= */

            newUploadedFile =
                newFilename;


            namaPicture =
                newFilename;


            /* =============================================
               FILE LAMA DIHAPUS SETELAH DB SUKSES
            ============================================= */

            if (
                oldPicture &&
                oldPicture !==
                    newFilename
            ) {

                oldFileToDelete =
                    oldPicture;
            }

        }


        /* =================================================
           HAPUS FOTO LAMA TANPA FOTO BARU
        ================================================= */

        else if (
            hapusPicture &&
            oldPicture
        ) {

            namaPicture =
                "";

            oldFileToDelete =
                oldPicture;
        }


        /* =================================================
           UPDATE DATABASE
           
           ref_content = isi HTML
           content     = slug
        ================================================= */

        await db.query(
            `
            UPDATE post
            SET
                title = ?,
                id_category = ?,
                content = ?,
                ref_content = ?,
                seotitle = ?,
                tag = ?,
                date = ?,
                active = ?,
                headline = ?,
                picture = ?
            WHERE id_post = ?
            `,
            [
                title,
                category,
                content,
                refContent,
                seoTitle,
                tag,
                tanggalFile,
                active,
                headline,
                namaPicture,
                id
            ]
        );


        /* =================================================
           HAPUS FILE LAMA SETELAH DB SUKSES
        ================================================= */

        if (
            oldFileToDelete &&
            oldFileToDelete !==
                namaPicture
        ) {

            const oldFilePath =
                path.join(
                    uploadDir,
                    path.basename(
                        oldFileToDelete
                    )
                );


            try {

                await fs.unlink(
                    oldFilePath
                );

                console.log(
                    "Foto lama dihapus:",
                    oldFileToDelete
                );

            } catch (
                error: any
            ) {

                if (
                    error?.code !==
                    "ENOENT"
                ) {

                    console.warn(
                        "Gagal menghapus foto lama:",
                        error
                    );
                }
            }
        }


        /* =================================================
           REDIRECT
        ================================================= */

        return Astro.redirect(
            "/admin/artikel"
        );


    } catch (
        error: any
    ) {

        console.error(
            "Gagal menyimpan artikel:",
            error
        );


        /* =================================================
           CLEANUP FILE BARU JIKA DB GAGAL
        ================================================= */

        if (
            newUploadedFile
        ) {

            try {

                await fs.unlink(
                    path.join(
                        uploadDir,
                        path.basename(
                            newUploadedFile
                        )
                    )
                );

            } catch {
                // Abaikan cleanup
            }
        }


        errorMessage =
            `Gagal menyimpan perubahan: ${
                error?.message ||
                error ||
                "Unknown error"
            }`;
    }
}
