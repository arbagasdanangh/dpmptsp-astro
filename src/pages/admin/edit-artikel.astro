<script>

/* =========================================================
   ELEMENT
========================================================= */

const pictureInput =
    document.getElementById(
        "picture"
    ) as HTMLInputElement | null;


const fileName =
    document.getElementById(
        "fileName"
    );


const hapusPicture =
    document.getElementById(
        "hapus_picture"
    ) as HTMLInputElement | null;


const editor =
    document.getElementById(
        "htmlEditor"
    ) as HTMLElement | null;


const refContentInput =
    document.getElementById(
        "ref_content"
    ) as HTMLTextAreaElement | null;


const htmlSource =
    document.getElementById(
        "htmlSource"
    ) as HTMLTextAreaElement | null;


const form =
    document.getElementById(
        "formArtikel"
    ) as HTMLFormElement | null;


const btnHtml =
    document.getElementById(
        "btnHtml"
    ) as HTMLButtonElement | null;


const formatBlock =
    document.getElementById(
        "formatBlock"
    ) as HTMLSelectElement | null;


const btnLink =
    document.getElementById(
        "btnLink"
    ) as HTMLButtonElement | null;


const editorStatus =
    document.getElementById(
        "editorStatus"
    );


const wordCount =
    document.getElementById(
        "wordCount"
    );


const btnSimpan =
    document.getElementById(
        "btnSimpan"
    ) as HTMLButtonElement | null;


const titleInput =
    document.getElementById(
        "title"
    ) as HTMLInputElement | null;


const categoryInput =
    document.getElementById(
        "category"
    ) as HTMLSelectElement | null;


const dateInput =
    document.getElementById(
        "date"
    ) as HTMLInputElement | null;


const filenameExample =
    document.getElementById(
        "filenameExample"
    );


/* =========================================================
   STATE
========================================================= */

let sourceMode =
    false;


/* =========================================================
   HELPER SLUG CLIENT
========================================================= */

function createSlugClient(
    value: string
): string {

    return value
        .toLowerCase()
        .normalize("NFD")
        .replace(
            /[\u0300-\u036f]/g,
            ""
        )
        .replace(
            /[^a-z0-9\s-]/g,
            ""
        )
        .replace(
            /\s+/g,
            "-"
        )
        .replace(
            /-+/g,
            "-"
        )
        .replace(
            /^-|-$/g,
            "");
}


/* =========================================================
   PREFIX KATEGORI CLIENT
========================================================= */

function getCategoryPrefixClient(
    category: string
): string {

    if (
        ["1", "8"].includes(
            category
        )
    ) {

        return "berita";
    }

    if (
        ["2", "3"].includes(
            category
        )
    ) {

        return "artikel";
    }

    return "artikel";
}


/* =========================================================
   UPDATE CONTOH NAMA FILE
========================================================= */

function updateFilenameExample() {

    if (
        !filenameExample ||
        !titleInput ||
        !categoryInput ||
        !dateInput
    ) {
        return;
    }


    const title =
        titleInput.value.trim();


    const category =
        categoryInput.value;


    const date =
        dateInput.value ||
        "YYYY-MM-DD";


    const slug =
        createSlugClient(
            title
        );


    const prefix =
        getCategoryPrefixClient(
            category
        );


    filenameExample.textContent =
        `${prefix}-${category}-${slug || "judul-artikel"}-${date}.jpg`;
}


/* =========================================================
   UPDATE NAMA FILE SAAT INPUT
========================================================= */

titleInput?.addEventListener(
    "input",
    updateFilenameExample
);


categoryInput?.addEventListener(
    "change",
    updateFilenameExample
);


dateInput?.addEventListener(
    "change",
    updateFilenameExample
);


/* =========================================================
   PICTURE - VALIDASI & PREVIEW
========================================================= */

pictureInput?.addEventListener(
    "change",
    function () {

        const file =
            this.files?.[0];


        if (!file) {
            return;
        }


        const allowedTypes = [
            "image/jpeg",
            "image/jpg",
            "image/png",
            "image/webp"
        ];


        /* =============================================
           TYPE
        ============================================= */

        if (
            !allowedTypes.includes(
                file.type
            )
        ) {

            alert(
                "Format gambar harus JPG, JPEG, PNG, atau WEBP."
            );

            this.value = "";

            return;
        }


        /* =============================================
           SIZE
        ============================================= */

        const maxSize =
            5 * 1024 * 1024;


        if (
            file.size > maxSize
        ) {

            alert(
                "Ukuran gambar maksimal 5 MB."
            );

            this.value = "";

            return;
        }


        /* =============================================
           NAMA FILE
        ============================================= */

        if (fileName) {

            const size =
                (
                    file.size /
                    (1024 * 1024)
                ).toFixed(2);


            fileName.textContent =
                `File baru: ${file.name} (${size} MB)`;
        }


        /* =============================================
           MATIKAN CHECKBOX HAPUS
        ============================================= */

        if (hapusPicture) {

            hapusPicture.checked =
                false;
        }


        /* =============================================
           PREVIEW
        ============================================= */

        const reader =
            new FileReader();


        reader.onload =
            function (event) {

                const box =
                    document.querySelector(
                        ".picture-preview-box"
                    );


                if (!box) {
                    return;
                }


                box.innerHTML =
                    "";


                const img =
                    document.createElement(
                        "img"
                    );


                img.id =
                    "previewPicture";


                img.className =
                    "picture-preview";


                img.alt =
                    "Preview gambar baru";


                img.src =
                    String(
                        event.target?.result ||
                        ""
                    );


                box.appendChild(
                    img
                );

            };


        reader.readAsDataURL(
            file
        );

    }
);


/* =========================================================
   CHECKBOX HAPUS FOTO
========================================================= */

hapusPicture?.addEventListener(
    "change",
    function () {

        const preview =
            document.getElementById(
                "previewPicture"
            );


        if (this.checked) {

            if (pictureInput) {

                pictureInput.value =
                    "";
            }


            if (preview) {

                preview.style.opacity =
                    "0.3";

                preview.style.filter =
                    "grayscale(1)";
            }


            if (fileName) {

                fileName.textContent =
                    "Gambar lama akan dihapus saat disimpan";
            }

        } else {

            if (preview) {

                preview.style.opacity =
                    "1";

                preview.style.filter =
                    "none";
            }


            if (fileName) {

                fileName.textContent =
                    "Gambar lama tetap digunakan";
            }

        }

    }
);


/* =========================================================
   EXECUTE COMMAND
========================================================= */

function execEditorCommand(
    command: string,
    value: string | null = null
) {

    if (!editor) {
        return;
    }


    editor.focus();


    try {

        document.execCommand(
            command,
            false,
            value
        );

    } catch (error) {

        console.warn(
            `Command "${command}" tidak didukung.`,
            error
        );
    }


    updateContent();
    updateToolbar();
    updateWordCount();
}


/* =========================================================
   TOOLBAR COMMAND
========================================================= */

document
    .querySelectorAll<HTMLButtonElement>(
        "[data-command]"
    )
    .forEach(
        button => {

            button.addEventListener(
                "mousedown",
                function (
                    event
                ) {

                    event.preventDefault();

                }
            );


            button.addEventListener(
                "click",
                function () {

                    const command =
                        this.dataset.command;


                    if (!command) {
                        return;
                    }


                    execEditorCommand(
                        command
                    );

                }
            );

        }
    );


/* =========================================================
   FORMAT BLOCK
========================================================= */

formatBlock?.addEventListener(
    "change",
    function () {

        if (!this.value) {
            return;
        }


        execEditorCommand(
            "formatBlock",
            this.value
        );

    }
);


/* =========================================================
   LINK
========================================================= */

btnLink?.addEventListener(
    "mousedown",
    function (
        event
    ) {

        event.preventDefault();

    }
);


btnLink?.addEventListener(
    "click",
    function () {

        if (!editor) {
            return;
        }


        editor.focus();


        const url =
            prompt(
                "Masukkan URL:",
                "https://"
            );


        if (!url) {
            return;
        }


        const cleanUrl =
            url.trim();


        if (
            !/^https?:\/\//i.test(
                cleanUrl
            )
        ) {

            alert(
                "URL harus diawali http:// atau https://"
            );

            return;
        }


        try {

            new URL(
                cleanUrl
            );

        } catch {

            alert(
                "URL tidak valid."
            );

            return;
        }


        execEditorCommand(
            "createLink",
            cleanUrl
        );

    }
);


/* =========================================================
   EDITOR INPUT
========================================================= */

editor?.addEventListener(
    "input",
    function () {

        updateContent();

        updateWordCount();

    }
);


/* =========================================================
   PASTE
========================================================= */

editor?.addEventListener(
    "paste",
    function () {

        window.setTimeout(
            function () {

                updateContent();
                updateWordCount();

            },
            0
        );

    }
);


/* =========================================================
   UPDATE REF_CONTENT
========================================================= */

function updateContent() {

    if (
        !editor ||
        !refContentInput
    ) {
        return;
    }


    /*
     * SIMPAN HTML KE ref_content
     */

    refContentInput.value =
        editor.innerHTML;


    if (editorStatus) {

        editorStatus.textContent =
            "Perubahan siap disimpan";
    }

}


/* =========================================================
   WORD COUNT
========================================================= */

function updateWordCount() {

    if (
        !editor ||
        !wordCount
    ) {
        return;
    }


    const text =
        editor.innerText
            .trim()
            .replace(
                /\s+/g,
                " "
            );


    const words =
        text
            ? text.split(" ").length
            : 0;


    wordCount.textContent =
        `${words} kata`;

}


/* =========================================================
   HTML SOURCE MODE
========================================================= */

btnHtml?.addEventListener(
    "click",
    function () {

        if (
            !editor ||
            !htmlSource
        ) {
            return;
        }


        /* =============================================
           VISUAL → SOURCE
        ============================================= */

        if (!sourceMode) {

            htmlSource.value =
                editor.innerHTML;


            editor.style.display =
                "none";


            htmlSource.style.display =
                "block";


            btnHtml.classList.add(
                "active"
            );


            btnHtml.title =
                "Kembali ke Visual Editor";


            if (editorStatus) {

                editorStatus.textContent =
                    "Mode HTML Source";
            }


            sourceMode =
                true;


            return;
        }


        /* =============================================
           SOURCE → VISUAL
        ============================================= */

        editor.innerHTML =
            htmlSource.value;


        htmlSource.style.display =
            "none";


        editor.style.display =
            "block";


        btnHtml.classList.remove(
            "active"
        );


        btnHtml.title =
            "HTML Source";


        sourceMode =
            false;


        updateContent();
        updateWordCount();
        updateToolbar();

    }
);


/* =========================================================
   SOURCE HTML INPUT
========================================================= */

htmlSource?.addEventListener(
    "input",
    function () {

        if (refContentInput) {

            refContentInput.value =
                this.value;
        }


        if (editorStatus) {

            editorStatus.textContent =
                "HTML sedang diedit";
        }

    }
);


/* =========================================================
   TOOLBAR ACTIVE STATE
========================================================= */

function updateToolbar() {

    if (
        !editor ||
        sourceMode
    ) {
        return;
    }


    document
        .querySelectorAll<HTMLButtonElement>(
            "[data-command]"
        )
        .forEach(
            button => {

                const command =
                    button.dataset.command;


                if (!command) {
                    return;
                }


                const supported = [
                    "bold",
                    "italic",
                    "underline",
                    "strikeThrough",
                    "insertUnorderedList",
                    "insertOrderedList"
                ];


                if (
                    !supported.includes(
                        command
                    )
                ) {
                    return;
                }


                try {

                    const active =
                        document.queryCommandState(
                            command
                        );


                    button.classList.toggle(
                        "active",
                        active
                    );

                } catch {
                    // Browser compatibility
                }

            }
        );

}


/* =========================================================
   SELECTION CHANGE
========================================================= */

document.addEventListener(
    "selectionchange",
    function () {

        if (!editor) {
            return;
        }


        if (
            document.activeElement ===
            editor
        ) {

            updateToolbar();

        }

    }
);


/* =========================================================
   FORM SUBMIT
========================================================= */

form?.addEventListener(
    "submit",
    function () {

        /* =============================================
           MODE HTML SOURCE
        ============================================= */

        if (
            sourceMode &&
            htmlSource &&
            refContentInput
        ) {

            refContentInput.value =
                htmlSource.value;

        } else {

            updateContent();

        }


        /* =============================================
           VALIDASI REF_CONTENT
        ============================================= */

        const content =
            refContentInput?.value
                ?.trim() || "";


        if (!content) {

            alert(
                "Isi artikel wajib diisi."
            );

            editor?.focus();

            return;
        }


        /* =============================================
           DISABLE BUTTON
        ============================================= */

        if (btnSimpan) {

            btnSimpan.disabled =
                true;

            btnSimpan.textContent =
                "Menyimpan...";

        }

    }
);


/* =========================================================
   INITIAL
========================================================= */

function initializeEditor() {

    if (!editor) {
        return;
    }


    updateContent();

    updateWordCount();

    updateToolbar();

    updateFilenameExample();

}


initializeEditor();

</script>
