---
export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

// ============================================================
// PARAMETER
// ============================================================

const url = new URL(Astro.request.url);

const searchQuery = (url.searchParams.get("q") || "").trim();

const requestedLimit = parseInt(
  url.searchParams.get("limit") || "10",
  10
);

const limit = [5, 10, 25, 50].includes(requestedLimit)
  ? requestedLimit
  : 10;

let currentPage = parseInt(
  url.searchParams.get("page") || "1",
  10
);

if (isNaN(currentPage) || currentPage < 1) {
  currentPage = 1;
}

// ============================================================
// DATA
// ============================================================

let semuaPemberitahuan = [];
let totalData = 0;
let totalPages = 1;

try {
  // ==========================================================
  // ADMIN MENAMPILKAN SEMUA DATA
  // ==========================================================

  let where = `
    WHERE 1 = 1
  `;

  const params = [];

  // ==========================================================
  // SEARCH
  // ==========================================================

  if (searchQuery) {
    where += `
      AND (
        judul LIKE ?
        OR isi LIKE ?
        OR tipe LIKE ?
        OR icon LIKE ?
        OR link LIKE ?
        OR teks_link LIKE ?
      )
    `;

    const keyword = "%" + searchQuery + "%";

    params.push(
      keyword,
      keyword,
      keyword,
      keyword,
      keyword,
      keyword
    );
  }

  // ==========================================================
  // TOTAL DATA
  // ==========================================================

  const [countRows] = await db.query(
    `
      SELECT COUNT(*) AS total
      FROM notifikasi_beranda
      ${where}
    `,
    params
  );

  totalData = Number(
    countRows?.[0]?.total || 0
  );

  // ==========================================================
  // TOTAL PAGE
  // ==========================================================

  totalPages =
    totalData > 0
      ? Math.ceil(totalData / limit)
      : 1;

  if (currentPage > totalPages) {
    currentPage = totalPages;
  }

  // ==========================================================
  // OFFSET
  // ==========================================================

  const offset =
    (currentPage - 1) * limit;

  // ==========================================================
  // DATA
  // ==========================================================

  const [rows] = await db.query(
    `
      SELECT
        id,
        judul,
        isi,
        gambar,
        tipe,
        icon,
        link,
        teks_link
      FROM notifikasi_beranda
      ${where}
      ORDER BY urutan ASC, id DESC
      LIMIT ? OFFSET ?
    `,
    [
      ...params,
      limit,
      offset
    ]
  );

  semuaPemberitahuan = rows || [];

} catch (error) {

  console.error(
    "Error mengambil pemberitahuan:",
    error
  );

  semuaPemberitahuan = [];
  totalData = 0;
  totalPages = 1;
}

// ============================================================
// TABLE INFO
// ============================================================

const startEntry =
  totalData === 0
    ? 0
    : (currentPage - 1) * limit + 1;

const endEntry =
  totalData === 0
    ? 0
    : Math.min(
        currentPage * limit,
        totalData
      );

// ============================================================
// PAGINATION
// ============================================================

const paginationPages = [];

if (totalPages <= 5) {

  for (
    let i = 1;
    i <= totalPages;
    i++
  ) {
    paginationPages.push(i);
  }

} else {

  paginationPages.push(1);

  if (currentPage > 3) {
    paginationPages.push("dots");
  }

  let startPage =
    Math.max(
      2,
      currentPage - 1
    );

  let endPage =
    Math.min(
      totalPages - 1,
      currentPage + 1
    );

  if (currentPage <= 2) {
    startPage = 2;
    endPage = 3;
  }

  if (
    currentPage >=
    totalPages - 1
  ) {
    startPage =
      totalPages - 2;

    endPage =
      totalPages - 1;
  }

  for (
    let i = startPage;
    i <= endPage;
    i++
  ) {
    paginationPages.push(i);
  }

  if (
    currentPage <
    totalPages - 2
  ) {
    paginationPages.push("dots");
  }

  paginationPages.push(
    totalPages
  );
}
---

<AdminShell
  title="Pemberitahuan"
  subtitle="Kelola pemberitahuan yang ditampilkan pada website publik."
  actionLabel="Tambah Pemberitahuan"
  actionHref="/admin/tambah-pemberitahuan"
>

  <div class="table-container">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="datatable-header">

      <div class="datatable-length">

        <span>Show</span>

        <select id="pageLength">

          <option
            value="5"
            selected={limit === 5}
          >
            5
          </option>

          <option
            value="10"
            selected={limit === 10}
          >
            10
          </option>

          <option
            value="25"
            selected={limit === 25}
          >
            25
          </option>

          <option
            value="50"
            selected={limit === 50}
          >
            50
          </option>

        </select>

        <span>entries</span>

      </div>


      <!-- SEARCH -->

      <div class="datatable-search">

        <label for="searchInput">
          Search:
        </label>

        <div class="search-wrapper">

          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="8"
            ></circle>

            <line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"
            ></line>
          </svg>

          <input
            id="searchInput"
            type="search"
            value={searchQuery}
            placeholder="Cari pemberitahuan..."
            autocomplete="off"
          />

        </div>

      </div>

    </div>


    <!-- =====================================================
         TABLE
    ====================================================== -->

    <div class="table-scroll">

      <table class="data-table">

        <thead>

          <tr>

            <th class="col-id">
              ID
            </th>

            <th class="col-judul">
              Judul
            </th>

            <th class="col-isi">
              Isi
            </th>

            <th class="col-tipe">
              Tipe
            </th>

            <th class="col-icon">
              Icon
            </th>

            <th class="col-gambar">
              Gambar
            </th>

            <th class="col-link">
              Link
            </th>

            <th class="col-aksi">
              Aksi
            </th>

          </tr>

        </thead>


        <tbody id="tableBody">

          {semuaPemberitahuan.length > 0 ? (

            semuaPemberitahuan.map((item) => (

              <tr>

                <!-- ID -->

                <td class="id-cell">
                  {item.id}
                </td>


                <!-- JUDUL -->

                <td>

                  <div class="judul-wrapper">

                    <strong>
                      {item.judul || "-"}
                    </strong>

                    {item.teks_link ? (

                      <small>
                        Tombol:
                        {item.teks_link}
                      </small>

                    ) : null}

                  </div>

                </td>


                <!-- ISI -->

                <td>

                  <div class="isi-wrapper">
                    {item.isi || "-"}
                  </div>

                </td>


                <!-- TIPE -->

                <td>

                  <span
                    class={
                      "badge " +
                      (
                        item.tipe === "modal"
                          ? "badge-warning"
                          : "badge-info"
                      )
                    }
                  >

                    {
                      item.tipe === "modal"
                        ? "Popup Modal"
                        : item.tipe || "Info"
                    }

                  </span>

                </td>


                <!-- ICON -->

                <td>

                  {item.icon ? (

                    <div class="icon-wrapper">

                      <i
                        class={"fa " + item.icon}
                        aria-hidden="true"
                      ></i>

                      <span>
                        {item.icon}
                      </span>

                    </div>

                  ) : (

                    <span class="muted">
                      -
                    </span>

                  )}

                </td>


                <!-- GAMBAR -->

                <td>

                  {item.gambar ? (

                    <img
                      src={item.gambar}
                      alt={
                        item.judul ||
                        "Gambar pemberitahuan"
                      }
                      class="thumb-img"
                      loading="lazy"
                    />

                  ) : (

                    <div class="no-image">
                      −
                    </div>

                  )}

                </td>


                <!-- LINK -->

                <td>

                  {item.link ? (

                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-preview"
                    >
                      {item.link}
                    </a>

                  ) : (

                    <span class="muted">
                      -
                    </span>

                  )}

                </td>


                <!-- AKSI -->

                <td>

                  <div class="action-buttons">

                    <!-- EDIT -->

                    <button
                      type="button"
                      class="btn-icon btn-edit"
                      title="Edit"
                      data-id={item.id}
                    >

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >

                        <path
                          d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                        ></path>

                        <path
                          d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1-1-4 9.5-9.5z"
                        ></path>

                      </svg>

                    </button>


                    <!-- DELETE -->

                    <button
                      type="button"
                      class="btn-icon btn-delete"
                      title="Hapus"
                      data-id={item.id}
                    >

                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >

                        <polyline
                          points="3 6 5 6 21 6"
                        ></polyline>

                        <path
                          d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"
                        ></path>

                        <path
                          d="M10 11v6"
                        ></path>

                        <path
                          d="M14 11v6"
                        ></path>

                        <path
                          d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"
                        ></path>

                      </svg>

                    </button>

                  </div>

                </td>

              </tr>

            ))

          ) : (

            <tr>

              <td
                colspan="8"
                class="empty-state"
              >

                <div class="empty-icon">
                  !
                </div>

                <strong>
                  {
                    searchQuery
                      ? "Data tidak ditemukan"
                      : "Belum ada pemberitahuan"
                  }
                </strong>

                <span>
                  {
                    searchQuery
                      ? 'Tidak ada hasil untuk "' +
                        searchQuery +
                        '".'
                      : "Belum ada data pemberitahuan."
                  }
                </span>

              </td>

            </tr>

          )}

        </tbody>

      </table>

    </div>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <div class="datatable-footer">

      <div
        class="table-info"
        id="tableInfo"
      >

        Showing

        <strong>
          {startEntry}
        </strong>

        to

        <strong>
          {endEntry}
        </strong>

        of

        <strong>
          {totalData}
        </strong>

        entries

      </div>


      <!-- PAGINATION -->

      <div
        class="pagination"
        id="pagination"
        data-current-page={currentPage}
        data-total-pages={totalPages}
      >

        <button
          type="button"
          class="page-btn"
          data-page={currentPage - 1}
          disabled={currentPage <= 1}
        >
          Previous
        </button>


        <div class="page-numbers">

          {paginationPages.map((page) => (

            page === "dots" ? (

              <span class="page-dots">
                ...
              </span>

            ) : (

              <button
                type="button"
                class={
                  "page-btn " +
                  (
                    page === currentPage
                      ? "active"
                      : ""
                  )
                }
                data-page={page}
              >
                {page}
              </button>

            )

          ))}

        </div>


        <button
          type="button"
          class="page-btn"
          data-page={currentPage + 1}
          disabled={
            currentPage >= totalPages
          }
        >
          Next
        </button>

      </div>

    </div>

  </div>


  <!-- =====================================================
       DELETE MODAL
  ====================================================== -->

  <div
    class="modal-overlay"
    id="delete-modal"
    style="display:none;"
  >

    <div class="modal-card">

      <div class="modal-icon-wrapper delete-icon-bg">

        <span class="modal-exclamation">
          !
        </span>

      </div>

      <h2>
        Hapus Pemberitahuan?
      </h2>

      <p>
        Apakah Anda yakin ingin menghapus
        pemberitahuan ini?
      </p>

      <div class="modal-actions">

        <button
          class="modal-btn btn-batal"
          id="delete-batal"
          type="button"
        >
          Batal
        </button>

        <button
          class="modal-btn btn-hapus"
          id="delete-ya"
          type="button"
        >
          Hapus
        </button>

      </div>

    </div>

  </div>


  <!-- =====================================================
       EDIT MODAL
  ====================================================== -->

  <div
    class="modal-overlay"
    id="edit-modal"
    style="display:none;"
  >

    <div class="modal-card">

      <div class="modal-icon-wrapper edit-icon-bg">

        <span class="modal-exclamation">
          !
        </span>

      </div>

      <h2>
        Edit Pemberitahuan?
      </h2>

      <p>
        Apakah Anda yakin ingin mengedit
        pemberitahuan ini?
      </p>

      <div class="modal-actions">

        <button
          class="modal-btn btn-batal"
          id="edit-batal"
          type="button"
        >
          Batal
        </button>

        <button
          class="modal-btn btn-ya-edit"
          id="edit-ya"
          type="button"
        >
          Ya, Edit
        </button>

      </div>

    </div>

  </div>

</AdminShell>


<style>

/* ==========================================================
   CONTAINER
========================================================== */

.table-container {
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  padding: 18px;
}


/* ==========================================================
   HEADER
========================================================== */

.datatable-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 16px;
}

.datatable-length {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  font-size: 0.86rem;
}

.datatable-length select {
  height: 36px;
  min-width: 68px;
  padding: 0 10px;
  border: 1px solid #dbe2ea;
  border-radius: 8px;
  background: #ffffff;
  color: #334155;
  outline: none;
  cursor: pointer;
}

.datatable-length select:focus {
  border-color: #2563eb;
}


/* ==========================================================
   SEARCH
========================================================== */

.datatable-search {
  display: flex;
  align-items: center;
  gap: 10px;
}

.datatable-search label {
  color: #64748b;
  font-size: 0.86rem;
}

.search-wrapper {
  position: relative;
}

.search-wrapper svg {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: #94a3b8;
  pointer-events: none;
}

.search-wrapper input {
  width: 260px;
  height: 38px;
  padding: 0 12px 0 38px;
  border: 1px solid #dbe2ea;
  border-radius: 9px;
  outline: none;
  background: #ffffff;
  color: #0f172a;
  font-size: 0.86rem;
}

.search-wrapper input:focus {
  border-color: #2563eb;
  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.08);
}

.search-wrapper input::placeholder {
  color: #94a3b8;
}


/* ==========================================================
   TABLE SCROLL
========================================================== */

.table-scroll {
  width: 100%;
  max-height: calc(100vh - 350px);
  min-height: 240px;
  overflow: auto;
  border: 1px solid #e5eaf2;
  border-radius: 12px;
}


/* ==========================================================
   TABLE
========================================================== */

:global(.data-table) {
  width: 100%;
  min-width: 1180px;
  border-collapse: separate;
  border-spacing: 0;
  font-size: 0.86rem;
}

:global(.data-table th),
:global(.data-table td) {
  padding: 12px 13px;
  border-bottom: 1px solid #edf1f5;
  vertical-align: middle;
  text-align: left;
}

:global(.data-table th) {
  position: sticky;
  top: 0;
  z-index: 5;
  background: #f8fafc;
  color: #334155;
  font-weight: 700;
  white-space: nowrap;
}

:global(.data-table tbody tr:hover) {
  background: #f8fafc;
}


/* ==========================================================
   COLUMN
========================================================== */

.col-id {
  width: 60px;
}

.col-judul {
  min-width: 210px;
}

.col-isi {
  min-width: 280px;
}

.col-tipe {
  width: 130px;
}

.col-icon {
  min-width: 150px;
}

.col-gambar {
  width: 100px;
}

.col-link {
  min-width: 170px;
}

.col-aksi {
  width: 110px;
  text-align: center !important;
}


/* ==========================================================
   ID
========================================================== */

.id-cell {
  color: #64748b;
  font-weight: 700;
}


/* ==========================================================
   JUDUL
========================================================== */

.judul-wrapper {
  display: flex;
  flex-direction: column;
  gap: 5px;
  max-width: 260px;
}

.judul-wrapper strong {
  color: #0f172a;
  font-weight: 700;
  line-height: 1.4;
}

.judul-wrapper small {
  color: #64748b;
  font-size: 0.74rem;
}


/* ==========================================================
   ISI
========================================================== */

.isi-wrapper {
  max-width: 320px;
  color: #64748b;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}


/* ==========================================================
   BADGE
========================================================== */

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 11px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  white-space: nowrap;
}

.badge-info {
  background: #dbeafe;
  color: #0369a1;
}

.badge-warning {
  background: #fef3c7;
  color: #b45309;
}


/* ==========================================================
   ICON
========================================================== */

.icon-wrapper {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #475569;
}

.icon-wrapper i {
  width: 25px;
  text-align: center;
  color: #2563eb;
}

.icon-wrapper span {
  font-size: 0.76rem;
}


/* ==========================================================
   GAMBAR
========================================================== */

.thumb-img {
  width: 76px;
  height: 55px;
  object-fit: cover;
  display: block;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
}

.no-image {
  width: 76px;
  height: 55px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #cbd5e1;
  border-radius: 8px;
  background: #f8fafc;
  color: #94a3b8;
  font-size: 20px;
}


/* ==========================================================
   LINK
========================================================== */

.link-preview {
  display: inline-block;
  max-width: 180px;
  color: #2563eb;
  text-decoration: none;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.link-preview:hover {
  text-decoration: underline;
}

.muted {
  color: #94a3b8;
}


/* ==========================================================
   ACTION
========================================================== */

.action-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
}

:global(.btn-icon) {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 36px !important;
  height: 36px !important;
  padding: 0 !important;
  border: none !important;
  border-radius: 9px !important;
  cursor: pointer !important;
  transition:
    transform 0.15s ease,
    background 0.15s ease !important;
}

:global(.btn-icon:hover) {
  transform: translateY(-1px);
}

:global(.btn-icon svg) {
  width: 18px !important;
  height: 18px !important;
}

:global(.btn-edit) {
  color: #2563eb !important;
  background: #dbeafe !important;
}

:global(.btn-edit:hover) {
  background: #bfdbfe !important;
}

:global(.btn-delete) {
  color: #ef4444 !important;
  background: #fee2e2 !important;
}

:global(.btn-delete:hover) {
  background: #fecaca !important;
}


/* ==========================================================
   FOOTER
========================================================== */

.datatable-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-top: 15px;
  margin-top: 10px;
  border-top: 1px solid #f1f5f9;
}

.table-info {
  color: #64748b;
  font-size: 0.83rem;
  white-space: nowrap;
}

.table-info strong {
  color: #334155;
}


/* ==========================================================
   PAGINATION
========================================================== */

.pagination {
  display: flex;
  align-items: center;
  gap: 4px;
}

.page-numbers {
  display: flex;
  align-items: center;
  gap: 4px;
}

.page-btn {
  min-width: 34px;
  height: 34px;
  padding: 0 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dbe2ea;
  border-radius: 7px;
  background: #ffffff;
  color: #475569;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    color 0.15s ease;
}

.page-btn:hover:not(:disabled):not(.active) {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.page-btn.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}

.page-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.page-dots {
  min-width: 25px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}


/* ==========================================================
   EMPTY
========================================================== */

.empty-state {
  padding: 65px 20px !important;
  text-align: center !important;
}

.empty-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 23px;
  font-weight: 800;
}

.empty-state strong {
  display: block;
  margin-top: 13px;
  color: #334155;
}

.empty-state span {
  display: block;
  margin-top: 5px;
  color: #64748b;
  font-size: 0.82rem;
}


/* ==========================================================
   MODAL
========================================================== */

.modal-overlay {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 20px;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-width: 450px;
  padding: 34px 30px;
  background: #ffffff;
  border-radius: 22px;
  text-align: center;
  box-shadow:
    0 25px 50px rgba(15, 23, 42, 0.2);
  animation: modalScaleIn 0.2s ease-out;
}

@keyframes modalScaleIn {

  from {
    transform: scale(0.95);
    opacity: 0;
  }

  to {
    transform: scale(1);
    opacity: 1;
  }

}

.modal-icon-wrapper {
  width: 72px;
  height: 72px;
  margin: 0 auto 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon-bg,
.delete-icon-bg {
  background: #fee2e2;
}

.modal-exclamation {
  color: #ef4444;
  font-size: 36px;
  font-weight: 800;
}

.modal-card h2 {
  margin: 0 0 10px;
  color: #0f172a;
  font-size: 1.35rem;
  font-weight: 800;
}

.modal-card p {
  margin: 0 0 25px;
  color: #64748b;
  font-size: 0.9rem;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 10px;
}

.modal-btn {
  min-width: 105px;
  padding: 11px 22px;
  border: none;
  border-radius: 10px;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
}

.btn-batal {
  background: #e2e8f0;
  color: #1e293b;
}

.btn-batal:hover {
  background: #cbd5e1;
}

.btn-ya-edit {
  background: #2563eb;
  color: #ffffff;
}

.btn-ya-edit:hover {
  background: #1d4ed8;
}

.btn-hapus {
  background: #ef4444;
  color: #ffffff;
}

.btn-hapus:hover {
  background: #dc2626;
}


/* ==========================================================
   MOBILE
========================================================== */

@media (max-width: 768px) {

  .table-container {
    padding: 12px;
    border-radius: 12px;
  }

  .datatable-header {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .datatable-search {
    justify-content: space-between;
  }

  .search-wrapper {
    flex: 1;
  }

  .search-wrapper input {
    width: 100%;
  }

  .table-scroll {
    max-height: calc(100vh - 390px);
  }

  .datatable-footer {
    flex-direction: column;
    align-items: flex-start;
  }

  .pagination {
    width: 100%;
    justify-content: flex-end;
    overflow-x: auto;
  }

  .page-btn {
    flex-shrink: 0;
  }

  .modal-card {
    padding: 28px 20px;
  }

}

</style>


<script>

  // ==========================================================
  // STATE
  // ==========================================================

  let selectedId = null;

  let searchTimer = null;

  let activeController = null;


  // ==========================================================
  // ELEMENT
  // ==========================================================

  const searchInput =
    document.getElementById(
      "searchInput"
    );

  const pageLength =
    document.getElementById(
      "pageLength"
    );

  const deleteModal =
    document.getElementById(
      "delete-modal"
    );

  const editModal =
    document.getElementById(
      "edit-modal"
    );

  const deleteYes =
    document.getElementById(
      "delete-ya"
    );

  const deleteCancel =
    document.getElementById(
      "delete-batal"
    );

  const editYes =
    document.getElementById(
      "edit-ya"
    );

  const editCancel =
    document.getElementById(
      "edit-batal"
    );


  // ==========================================================
  // BUILD URL
  // ==========================================================

  function buildUrl({
    q =
      searchInput?.value?.trim() ||
      "",

    page = 1,

    limit =
      pageLength?.value ||
      "10",

  } = {}) {

    const params =
      new URLSearchParams();

    if (q) {
      params.set("q", q);
    }

    params.set(
      "page",
      String(page)
    );

    params.set(
      "limit",
      String(limit)
    );

    return (
      window.location.pathname +
      "?" +
      params.toString()
    );
  }


  // ==========================================================
  // LOAD TABLE
  // ==========================================================

  async function loadTable({
    q =
      searchInput?.value?.trim() ||
      "",

    page = 1,

    limit =
      pageLength?.value ||
      "10",

  } = {}) {

    if (activeController) {
      activeController.abort();
    }

    activeController =
      new AbortController();

    const targetUrl =
      buildUrl({
        q,
        page,
        limit,
      });

    try {

      const response =
        await fetch(
          targetUrl,
          {
            method: "GET",

            headers: {
              "X-Requested-With":
                "XMLHttpRequest",
            },

            signal:
              activeController.signal,
          }
        );

      if (!response.ok) {
        throw new Error(
          "Gagal memuat data."
        );
      }

      const html =
        await response.text();

      const parser =
        new DOMParser();

      const doc =
        parser.parseFromString(
          html,
          "text/html"
        );


      // ======================================================
      // TABLE BODY
      // ======================================================

      const newBody =
        doc.getElementById(
          "tableBody"
        );

      const oldBody =
        document.getElementById(
          "tableBody"
        );

      if (
        newBody &&
        oldBody
      ) {

        oldBody.innerHTML =
          newBody.innerHTML;

      }


      // ======================================================
      // TABLE INFO
      // ======================================================

      const newInfo =
        doc.getElementById(
          "tableInfo"
        );

      const oldInfo =
        document.getElementById(
          "tableInfo"
        );

      if (
        newInfo &&
        oldInfo
      ) {

        oldInfo.innerHTML =
          newInfo.innerHTML;

      }


      // ======================================================
      // PAGINATION
      // ======================================================

      const newPagination =
        doc.getElementById(
          "pagination"
        );

      const oldPagination =
        document.getElementById(
          "pagination"
        );

      if (
        newPagination &&
        oldPagination
      ) {

        oldPagination.innerHTML =
          newPagination.innerHTML;

        oldPagination.dataset.currentPage =
          newPagination.dataset.currentPage ||
          "1";

        oldPagination.dataset.totalPages =
          newPagination.dataset.totalPages ||
          "1";

      }


      // ======================================================
      // URL
      // ======================================================

      window.history.pushState(
        {},
        "",
        targetUrl
      );


      // ======================================================
      // REBIND
      // ======================================================

      bindTableActions();

    } catch (error) {

      if (
        error?.name ===
        "AbortError"
      ) {
        return;
      }

      console.error(
        "DataTable error:",
        error
      );

    }

  }


  // ==========================================================
  // LIVE SEARCH
  // ==========================================================

  searchInput?.addEventListener(
    "input",
    () => {

      clearTimeout(
        searchTimer
      );

      searchTimer =
        setTimeout(
          () => {

            loadTable({
              q:
                searchInput.value.trim(),

              page: 1,

              limit:
                pageLength?.value ||
                "10",
            });

          },
          350
        );

    }
  );


  // ==========================================================
  // CHANGE LENGTH
  // ==========================================================

  pageLength?.addEventListener(
    "change",
    () => {

      loadTable({

        q:
          searchInput?.value?.trim() ||
          "",

        page: 1,

        limit:
          pageLength?.value ||
          "10",

      });

    }
  );


  // ==========================================================
  // BIND ACTIONS
  // ==========================================================

  function bindTableActions() {


    // ========================================================
    // PAGINATION
    // ========================================================

    document
      .querySelectorAll(
        "#pagination .page-btn"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              if (
                button.disabled
              ) {
                return;
              }

              const page =
                parseInt(
                  button.dataset.page ||
                  "1",
                  10
                );

              if (
                isNaN(page) ||
                page < 1
              ) {
                return;
              }

              loadTable({

                q:
                  searchInput?.value?.trim() ||
                  "",

                page,

                limit:
                  pageLength?.value ||
                  "10",

              });

            }
          );

        }
      );


    // ========================================================
    // EDIT
    // ========================================================

    document
      .querySelectorAll(
        ".btn-edit"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const id =
                Number(
                  button.dataset.id
                );

              console.log(
                "EDIT ID:",
                id
              );

              if (
                !Number.isInteger(id) ||
                id <= 0
              ) {

                alert(
                  "ID pemberitahuan tidak valid."
                );

                return;
              }

              selectedId =
                id;

              if (editModal) {
                editModal.style.display =
                  "flex";
              }

            }
          );

        }
      );


    // ========================================================
    // DELETE
    // ========================================================

    document
      .querySelectorAll(
        ".btn-delete"
      )
      .forEach(
        (button) => {

          button.addEventListener(
            "click",
            () => {

              const id =
                Number(
                  button.dataset.id
                );

              console.log(
                "DELETE BUTTON ID:",
                id
              );

              if (
                !Number.isInteger(id) ||
                id <= 0
              ) {

                alert(
                  "ID pemberitahuan tidak valid."
                );

                return;
              }

              selectedId =
                id;

              if (deleteModal) {

                deleteModal.style.display =
                  "flex";

              }

            }
          );

        }
      );

  }


  // ==========================================================
  // EDIT CANCEL
  // ==========================================================

  editCancel?.addEventListener(
    "click",
    () => {

      if (editModal) {
        editModal.style.display =
          "none";
      }

      selectedId =
        null;

    }
  );


  // ==========================================================
  // EDIT YES
  // ==========================================================

  editYes?.addEventListener(
    "click",
    () => {

      if (
        !selectedId ||
        selectedId <= 0
      ) {
        return;
      }

      window.location.href =
        "/admin/edit-pemberitahuan?id=" +
        encodeURIComponent(
          selectedId
        );

    }
  );


  // ==========================================================
  // DELETE CANCEL
  // ==========================================================

  deleteCancel?.addEventListener(
    "click",
    () => {

      if (deleteModal) {

        deleteModal.style.display =
          "none";

      }

      selectedId =
        null;

    }
  );


  // ==========================================================
  // DELETE YES
  // ==========================================================

  deleteYes?.addEventListener(
    "click",
    async () => {

      if (
        !selectedId ||
        selectedId <= 0
      ) {

        alert(
          "ID pemberitahuan tidak valid."
        );

        return;
      }

      const id =
        Number(selectedId);


      console.log(
        "================================"
      );

      console.log(
        "DELETE PEMBERITAHUAN"
      );

      console.log(
        "ID:",
        id
      );

      console.log(
        "URL:",
        "/api/pemberitahuan?id=" +
        id
      );

      console.log(
        "================================"
      );


      // ====================================================
      // BUTTON LOADING
      // ====================================================

      deleteYes.disabled =
        true;

      deleteYes.textContent =
        "Menghapus...";


      try {

        // ==================================================
        // DELETE
        // ID DIKIRIM VIA QUERY STRING
        // ==================================================

        const response =
          await fetch(
            "/api/pemberitahuan?id=" +
            encodeURIComponent(id),
            {
              method: "DELETE",

              headers: {
                "Accept":
                  "application/json",
              },
            }
          );


        // ==================================================
        // AMBIL RESPONSE SEBAGAI TEXT
        // ==================================================

        const text =
          await response.text();

        console.log(
          "STATUS:",
          response.status
        );

        console.log(
          "RESPONSE:",
          text
        );


        // ==================================================
        // PARSE JSON
        // ==================================================

        let result = {};

        try {

          result =
            text
              ? JSON.parse(text)
              : {};

        } catch {

          throw new Error(
            "Response API tidak valid: " +
            text
          );

        }


        // ==================================================
        // ERROR
        // ==================================================

        if (
          !response.ok ||
          !result.success
        ) {

          throw new Error(
            result.error ||
            "Gagal menghapus pemberitahuan."
          );

        }


        // ==================================================
        // BERHASIL
        // ==================================================

        console.log(
          "DELETE BERHASIL:",
          result
        );


        if (deleteModal) {

          deleteModal.style.display =
            "none";

        }

        selectedId =
          null;


        // ==================================================
        // LOAD ULANG TABLE
        // ==================================================

        await loadTable({

          q:
            searchInput?.value?.trim() ||
            "",

          page: 1,

          limit:
            pageLength?.value ||
            "10",

        });


      } catch (error) {

        console.error(
          "DELETE ERROR:",
          error
        );

        alert(
          error instanceof Error
            ? error.message
            : "Terjadi kesalahan saat menghapus pemberitahuan."
        );

      } finally {

        deleteYes.disabled =
          false;

        deleteYes.textContent =
          "Hapus";

      }

    }
  );


  // ==========================================================
  // CLOSE MODAL CLICK OUTSIDE
  // ==========================================================

  document
    .querySelectorAll(
      ".modal-overlay"
    )
    .forEach(
      (overlay) => {

        overlay.addEventListener(
          "click",
          (event) => {

            if (
              event.target ===
              overlay
            ) {

              overlay.style.display =
                "none";

              selectedId =
                null;

            }

          }
        );

      }
    );


  // ==========================================================
  // ESC
  // ==========================================================

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key ===
        "Escape"
      ) {

        document
          .querySelectorAll(
            ".modal-overlay"
          )
          .forEach(
            (modal) => {

              modal.style.display =
                "none";

            }
          );

        selectedId =
          null;

      }

    }
  );


  // ==========================================================
  // BACK / FORWARD
  // ==========================================================

  window.addEventListener(
    "popstate",
    () => {
      window.location.reload();
    }
  );


  // ==========================================================
  // INITIAL
  // ==========================================================

  bindTableActions();

</script>