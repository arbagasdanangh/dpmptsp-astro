---
export const prerender = false;

import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db.js";

/* =========================================================
   CACHE
========================================================= */

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, must-revalidate, proxy-revalidate"
);

Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");


/* =========================================================
   PROSES POST
========================================================= */

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const deleteId = String(
      formData.get("deleteId") || ""
    ).trim();

    const editId = String(
      formData.get("editId") || ""
    ).trim();


    /* =====================================================
       HAPUS
    ===================================================== */

    if (deleteId) {
      const id = Number(deleteId);

      if (!id || Number.isNaN(id)) {
        return Astro.redirect(
          "/admin/konten?error=invalid"
        );
      }


      /* Ambil nama foto sebelum data dihapus */

      const [fotoRows] = await db.execute(
        `
        SELECT Foto_Konten
        FROM tentangkamiswebv5
        WHERE Id_Konten = ?
        LIMIT 1
        `,
        [id]
      ) as any;

      const foto = fotoRows?.[0]?.Foto_Konten;


      /* Hapus data database */

      await db.execute(
        `
        DELETE FROM tentangkamiswebv5
        WHERE Id_Konten = ?
        `,
        [id]
      );


      /* Hapus file foto */

      if (
        foto &&
        typeof foto === "string"
      ) {
        try {
          const fs =
            await import("node:fs/promises");

          const path =
            await import("node:path");

          const fileName =
            path.basename(foto);

          const filePath =
            path.join(
              process.cwd(),
              "public",
              "uploads",
              "konten",
              fileName
            );

          try {
            await fs.unlink(filePath);

            console.log(
              "Foto konten dihapus:",
              filePath
            );
          } catch {
            /*
             * File tidak ditemukan.
             * Database tetap berhasil dihapus.
             */
          }

        } catch (fileError) {
          console.error(
            "Gagal menghapus file foto:",
            fileError
          );
        }
      }


      return Astro.redirect(
        "/admin/konten"
      );
    }


    /* =====================================================
       EDIT
    ===================================================== */

    if (editId) {
      const id = Number(editId);

      if (!id || Number.isNaN(id)) {
        return Astro.redirect(
          "/admin/konten?error=invalid"
        );
      }

      return Astro.redirect(
        `/admin/edit-konten?id=${id}`
      );
    }

  } catch (error) {
    console.error(
      "GAGAL MEMPROSES KONTEN:",
      error
    );

    return Astro.redirect(
      "/admin/konten?error=server"
    );
  }
}


/* =========================================================
   AMBIL DATA
========================================================= */

let konten: any[] = [];

try {
  const [rows] = await db.execute(
    `
    SELECT *
    FROM tentangkamiswebv5
    ORDER BY Id_Konten DESC
    `
  ) as any;

  konten = rows || [];

} catch (error) {
  console.error(
    "Gagal memuat data konten:",
    error
  );
}


/* =========================================================
   SUMMARY
========================================================= */

const items = [
  {
    title: "Artikel unggulan",
    value: konten.length.toString(),
    icon: "article"
  },
  {
    title: "Dokumen publik",
    value: "14",
    icon: "document"
  },
  {
    title: "Berita hari ini",
    value: "2",
    icon: "news"
  }
];
---

<AdminShell
  title="Konten"
  subtitle="Kelola dokumen dan informasi yang tampil di publik."
  actionLabel="Tambah Konten"
  actionHref="/admin/tambah-konten"
>

  <!-- =====================================================
       SUMMARY
  ====================================================== -->

  <div class="card-grid">

    {
      items.map((item) => (
        <article class="info-card">

          <div class="card-icon">

            {item.icon === "article" && (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16v16H4z"></path>
                <path d="M8 8h8"></path>
                <path d="M8 12h8"></path>
                <path d="M8 16h5"></path>
              </svg>
            )}

            {item.icon === "document" && (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M6 2h9l5 5v15H6z"></path>
                <path d="M14 2v6h6"></path>
                <path d="M9 13h6"></path>
                <path d="M9 17h6"></path>
              </svg>
            )}

            {item.icon === "news" && (
              <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M4 4h16v16H4z"></path>
                <path d="M8 8h8"></path>
                <path d="M8 12h3"></path>
                <path d="M8 16h8"></path>
                <path d="M14 11h2"></path>
              </svg>
            )}

          </div>

          <div>
            <h3>{item.title}</h3>
            <p>{item.value}</p>
          </div>

        </article>
      ))
    }

  </div>


  <!-- =====================================================
       CONTENT CARD
  ====================================================== -->

  <section class="content-card">


    <!-- ===================================================
         TABLE TOP
    ==================================================== -->

    <div class="table-top">

      <!-- SHOW ENTRIES -->

      <div class="entries-control">

        <label for="entriesSelect">
          Tampilkan
        </label>

        <select
          id="entriesSelect"
          aria-label="Jumlah entri"
        >
          <option value="10" selected>
            10
          </option>

          <option value="25">
            25
          </option>

          <option value="50">
            50
          </option>

          <option value="100">
            100
          </option>

          <option value="all">
            Semua
          </option>
        </select>

        <span>
          entri
        </span>

      </div>


      <!-- SEARCH -->

      <div class="search-box">

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle
            cx="11"
            cy="11"
            r="7"
          ></circle>

          <path d="m20 20-4-4"></path>
        </svg>

        <input
          type="search"
          id="searchInput"
          placeholder="Cari konten..."
          autocomplete="off"
          spellcheck="false"
        />

      </div>

    </div>


    <!-- ===================================================
         HEADER
    ==================================================== -->

    <div class="table-header">

      <div>
        <h2>
          Daftar Konten
        </h2>

        <p>
          Informasi dan konten yang tersedia pada website publik.
        </p>
      </div>

    </div>


    <!-- ===================================================
         TABLE
    ==================================================== -->

    <div class="table-wrapper">

      <table class="styled-table">

        <thead>

          <tr>

            <th class="th-id">
              ID
            </th>

            <th class="th-nama">
              Nama Konten
            </th>

            <th class="th-isi">
              Isi
            </th>

            <th class="th-foto">
              Foto
            </th>

            <th class="th-judul">
              Judul
            </th>

            <th class="th-ket">
              Keterangan
            </th>

            <th class="th-tags">
              Tags
            </th>

            <th class="th-aksi">
              Aksi
            </th>

          </tr>

        </thead>


        <tbody id="tableBody">

          {
            konten.length === 0 ? (

              <tr id="emptyDatabaseRow">

                <td
                  colspan="8"
                  class="no-data"
                >
                  Belum ada data konten.
                </td>

              </tr>

            ) : (

              konten.map((item: any) => (

                <tr
                  class="content-row"
                  data-search={`
                    ${item.Id_Konten ?? ""}
                    ${item.Nama_Konten ?? ""}
                    ${item.Isi_Konten ?? ""}
                    ${item.Judul_Konten ?? ""}
                    ${item.Keterangan ?? ""}
                    ${item.tags ?? ""}
                    ${item.Foto_Konten ?? ""}
                  `.replace(/\s+/g, " ").trim().toLowerCase()}
                >

                  <!-- ID -->

                  <td>
                    <span class="id-badge">
                      {item.Id_Konten}
                    </span>
                  </td>


                  <!-- NAMA -->

                  <td>

                    <div class="nama-konten">

                      <div class="content-avatar">
                        {
                          item.Nama_Konten
                            ? String(
                                item.Nama_Konten
                              )
                                .charAt(0)
                                .toUpperCase()
                            : "-"
                        }
                      </div>

                      <span
                        class="nama-text"
                        title={
                          item.Nama_Konten || ""
                        }
                      >
                        {
                          item.Nama_Konten ||
                          "-"
                        }
                      </span>

                    </div>

                  </td>


                  <!-- ISI -->

                  <td>

                    <span
                      class="cell-text"
                      title={
                        item.Isi_Konten || ""
                      }
                    >
                      {
                        item.Isi_Konten ||
                        "-"
                      }
                    </span>

                  </td>


                  <!-- FOTO -->

                  <td>

                    {
                      item.Foto_Konten ? (

                        <div class="file-box">

                          <img
                            src={
                              String(
                                item.Foto_Konten
                              ).startsWith("/")
                                ? String(
                                    item.Foto_Konten
                                  )
                                : `/uploads/konten/${String(
                                    item.Foto_Konten
                                  )}`
                            }
                            alt={
                              item.Nama_Konten ||
                              "Foto konten"
                            }
                            class="thumb-img"
                            loading="lazy"
                            onerror="this.style.display='none'"
                          />

                          <span
                            class="file-name"
                            title={
                              String(
                                item.Foto_Konten
                              )
                            }
                          >
                            {
                              String(
                                item.Foto_Konten
                              )
                                .split("/")
                                .pop()
                            }
                          </span>

                        </div>

                      ) : (

                        <span class="empty-text">
                          -
                        </span>

                      )
                    }

                  </td>


                  <!-- JUDUL -->

                  <td>

                    <span
                      class="cell-text"
                      title={
                        item.Judul_Konten || ""
                      }
                    >
                      {
                        item.Judul_Konten ||
                        "-"
                      }
                    </span>

                  </td>


                  <!-- KETERANGAN -->

                  <td>

                    <span
                      class="cell-text"
                      title={
                        item.Keterangan || ""
                      }
                    >
                      {
                        item.Keterangan ||
                        "-"
                      }
                    </span>

                  </td>


                  <!-- TAG -->

                  <td>

                    {
                      item.tags ? (

                        <span
                          class="tag"
                          title={item.tags}
                        >
                          {item.tags}
                        </span>

                      ) : (

                        <span class="empty-text">
                          -
                        </span>

                      )
                    }

                  </td>


                  <!-- AKSI -->

                  <td>

                    <div class="action-buttons">

                      <button
                        type="button"
                        class="action-btn edit-btn"
                        title="Edit konten"
                        data-id={
                          item.Id_Konten
                        }
                      >

                        <svg
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 20h9"></path>
                          <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                        </svg>

                      </button>


                      <button
                        type="button"
                        class="action-btn delete-btn"
                        title="Hapus konten"
                        data-id={
                          item.Id_Konten
                        }
                      >

                        <svg
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M3 6h18"></path>
                          <path d="M8 6V4h8v2"></path>
                          <path d="M19 6l-1 15H6L5 6"></path>
                          <path d="M10 11v6"></path>
                          <path d="M14 11v6"></path>
                        </svg>

                      </button>

                    </div>

                  </td>

                </tr>

              ))

            )
          }

        </tbody>

      </table>

    </div>


    <!-- ===================================================
         FOOTER
    ==================================================== -->

    <div class="table-footer">

      <div
        id="tableInfo"
        class="table-info"
      >
        Menampilkan 0 dari 0 entri
      </div>


      <div
        id="pagination"
        class="pagination"
      ></div>

    </div>

  </section>

</AdminShell>


<!-- =====================================================
     MODAL DELETE
====================================================== -->

<div
  id="deleteModal"
  class="modal-overlay"
  aria-hidden="true"
>

  <div
    class="modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="deleteTitle"
  >

    <div class="modal-icon-wrapper">

      <span class="modal-exclamation">
        !
      </span>

    </div>

    <h3 id="deleteTitle">
      Hapus Data?
    </h3>

    <p>
      Apakah Anda yakin ingin menghapus data konten ini?
    </p>

    <form
      method="POST"
      class="modal-actions"
      id="deleteForm"
    >

      <input
        type="hidden"
        name="deleteId"
        id="modalDeleteInput"
      />

      <button
        type="button"
        id="cancelDelete"
        class="modal-btn modal-btn-cancel"
      >
        Batal
      </button>

      <button
        type="submit"
        class="modal-btn modal-btn-delete"
        id="confirmDelete"
      >
        Hapus
      </button>

    </form>

  </div>

</div>


<!-- =====================================================
     MODAL EDIT
====================================================== -->

<div
  id="editModal"
  class="modal-overlay"
  aria-hidden="true"
>

  <div
    class="modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="editTitle"
  >

    <div class="modal-icon-wrapper edit-modal-icon">

      <span class="modal-exclamation edit-exclamation">
        !
      </span>

    </div>

    <h3 id="editTitle">
      Edit Data?
    </h3>

    <p>
      Apakah Anda yakin ingin mengedit data konten ini?
    </p>

    <form
      method="POST"
      class="modal-actions"
      id="editForm"
    >

      <input
        type="hidden"
        name="editId"
        id="modalEditInput"
      />

      <button
        type="button"
        id="cancelEdit"
        class="modal-btn modal-btn-cancel"
      >
        Batal
      </button>

      <button
        type="submit"
        class="modal-btn modal-btn-edit"
      >
        Ya, Edit
      </button>

    </form>

  </div>

</div>


<script>
  /* =========================================================
     DOM
  ========================================================= */

  const searchInput =
    document.getElementById(
      "searchInput"
    ) as HTMLInputElement | null;

  const entriesSelect =
    document.getElementById(
      "entriesSelect"
    ) as HTMLSelectElement | null;

  const tableBody =
    document.getElementById(
      "tableBody"
    ) as HTMLTableSectionElement | null;

  const tableInfo =
    document.getElementById(
      "tableInfo"
    ) as HTMLDivElement | null;

  const pagination =
    document.getElementById(
      "pagination"
    ) as HTMLDivElement | null;

  const deleteModal =
    document.getElementById(
      "deleteModal"
    ) as HTMLDivElement | null;

  const editModal =
    document.getElementById(
      "editModal"
    ) as HTMLDivElement | null;

  const modalDeleteInput =
    document.getElementById(
      "modalDeleteInput"
    ) as HTMLInputElement | null;

  const modalEditInput =
    document.getElementById(
      "modalEditInput"
    ) as HTMLInputElement | null;

  const cancelDelete =
    document.getElementById(
      "cancelDelete"
    ) as HTMLButtonElement | null;

  const cancelEdit =
    document.getElementById(
      "cancelEdit"
    ) as HTMLButtonElement | null;

  const deleteForm =
    document.getElementById(
      "deleteForm"
    ) as HTMLFormElement | null;

  const confirmDelete =
    document.getElementById(
      "confirmDelete"
    ) as HTMLButtonElement | null;


  /* =========================================================
     STATE
  ========================================================= */

  let currentPage = 1;

  let pageLength = 10;

  let filteredRows: HTMLElement[] = [];


  /* =========================================================
     GET ROW
  ========================================================= */

  function getRows(): HTMLElement[] {

    if (!tableBody) {
      return [];
    }

    return Array.from(
      tableBody.querySelectorAll<HTMLElement>(
        "tr.content-row"
      )
    );

  }


  /* =========================================================
     NORMALIZE TEXT
  ========================================================= */

  function normalizeText(
    value: string
  ): string {

    return value
      .toLocaleLowerCase("id-ID")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .trim();

  }


  /* =========================================================
     SEARCH
  ========================================================= */

  function applySearch() {

    const keyword =
      normalizeText(
        searchInput?.value || ""
      );

    const rows =
      getRows();

    filteredRows =
      rows.filter(
        (row) => {

          const text =
            normalizeText(
              row.dataset.search ||
              ""
            );

          return text.includes(
            keyword
          );

        }
      );

    currentPage = 1;

    renderTable();

  }


  /* =========================================================
     PAGE LENGTH
  ========================================================= */

  function getPageLength(): number {

    const value =
      entriesSelect?.value || "10";

    if (value === "all") {
      return filteredRows.length || 1;
    }

    const parsed =
      Number(value);

    return (
      Number.isFinite(parsed) &&
      parsed > 0
    )
      ? parsed
      : 10;

  }


  /* =========================================================
     RENDER TABLE
  ========================================================= */

  function renderTable() {

    const rows =
      getRows();

    const total =
      filteredRows.length;

    pageLength =
      getPageLength();


    const totalPages =
      total === 0
        ? 1
        : Math.ceil(
            total /
            pageLength
          );


    if (
      currentPage >
      totalPages
    ) {
      currentPage =
        totalPages;
    }


    const start =
      total === 0
        ? 0
        : (
            currentPage - 1
          ) *
          pageLength;


    const end =
      total === 0
        ? 0
        : Math.min(
            start +
              pageLength,
            total
          );


    /* -----------------------------------------------
       Sembunyikan seluruh row
    ------------------------------------------------ */

    rows.forEach(
      (row) => {
        row.style.display =
          "none";
      }
    );


    /* -----------------------------------------------
       Tampilkan row sesuai halaman
    ------------------------------------------------ */

    filteredRows
      .slice(
        start,
        end
      )
      .forEach(
        (row) => {

          row.style.display =
            "";

        }
      );


    /* -----------------------------------------------
       Info
    ------------------------------------------------ */

    if (tableInfo) {

      if (total === 0) {

        tableInfo.innerHTML =
          "Menampilkan <strong>0</strong> dari <strong>0</strong> entri";

      } else {

        tableInfo.innerHTML =
          `Menampilkan <strong>${start + 1}-${end}</strong> dari <strong>${total}</strong> entri`;

      }

    }


    /* -----------------------------------------------
       No search result
    ------------------------------------------------ */

    showNoResult(
      total === 0
    );


    /* -----------------------------------------------
       Pagination
    ------------------------------------------------ */

    renderPagination(
      totalPages
    );

  }


  /* =========================================================
     NO RESULT
  ========================================================= */

  function showNoResult(
    show: boolean
  ) {

    if (!tableBody) {
      return;
    }


    let row =
      document.getElementById(
        "searchNoResult"
      );


    if (show) {

      if (!row) {

        row =
          document.createElement(
            "tr"
          );

        row.id =
          "searchNoResult";

        row.innerHTML = `
          <td colspan="8" class="no-data">
            Data tidak ditemukan.
          </td>
        `;

        tableBody.appendChild(
          row
        );

      }

      row.style.display =
        "";

    } else {

      if (row) {

        row.style.display =
          "none";

      }

    }

  }


  /* =========================================================
     PAGINATION BUTTON
  ========================================================= */

  function createPageButton(
    label: string,
    page: number,
    disabled = false,
    active = false
  ) {

    const button =
      document.createElement(
        "button"
      );

    button.type =
      "button";

    button.className =
      "page-number";

    if (active) {

      button.classList.add(
        "active"
      );

    }

    button.disabled =
      disabled;

    button.textContent =
      label;


    if (!disabled) {

      button.addEventListener(
        "click",
        () => {

          currentPage =
            page;

          renderTable();

        }
      );

    }


    return button;

  }


  /* =========================================================
     PAGINATION
  ========================================================= */

  function renderPagination(
    totalPages: number
  ) {

    if (!pagination) {
      return;
    }

    pagination.innerHTML =
      "";


    /*
     * Tidak perlu pagination
     */

    if (
      filteredRows.length === 0 ||
      totalPages <= 1
    ) {

      return;

    }


    /* -----------------------------------------------
       PREVIOUS
    ------------------------------------------------ */

    const prev =
      document.createElement(
        "button"
      );

    prev.type =
      "button";

    prev.className =
      "page-arrow";

    prev.innerHTML =
      "‹";

    prev.title =
      "Halaman sebelumnya";

    prev.disabled =
      currentPage === 1;

    prev.addEventListener(
      "click",
      () => {

        if (
          currentPage > 1
        ) {

          currentPage--;

          renderTable();

        }

      }
    );

    pagination.appendChild(
      prev
    );


    /* -----------------------------------------------
       Nomor halaman
    ------------------------------------------------ */

    const pages =
      getPageNumbers(
        totalPages,
        currentPage
      );


    pages.forEach(
      (page) => {

        if (
          page === "..."
        ) {

          const dots =
            document.createElement(
              "span"
            );

          dots.className =
            "pagination-dots";

          dots.textContent =
            "…";

          pagination.appendChild(
            dots
          );

          return;

        }


        const button =
          createPageButton(
            String(page),
            Number(page),
            false,
            Number(page) ===
              currentPage
          );

        pagination.appendChild(
          button
        );

      }
    );


    /* -----------------------------------------------
       NEXT
    ------------------------------------------------ */

    const next =
      document.createElement(
        "button"
      );

    next.type =
      "button";

    next.className =
      "page-arrow";

    next.innerHTML =
      "›";

    next.title =
      "Halaman berikutnya";

    next.disabled =
      currentPage ===
      totalPages;

    next.addEventListener(
      "click",
      () => {

        if (
          currentPage <
          totalPages
        ) {

          currentPage++;

          renderTable();

        }

      }
    );

    pagination.appendChild(
      next
    );

  }


  /* =========================================================
     PAGE NUMBERS
  ========================================================= */

  function getPageNumbers(
    totalPages: number,
    current: number
  ): Array<number | string> {

    if (totalPages <= 7) {

      return Array.from(
        {
          length:
            totalPages
        },
        (_, index) =>
          index + 1
      );

    }


    const pages:
      Array<number | string> = [];


    pages.push(1);


    if (current > 4) {

      pages.push("...");

    }


    const start =
      Math.max(
        2,
        current - 1
      );

    const end =
      Math.min(
        totalPages - 1,
        current + 1
      );


    for (
      let i = start;
      i <= end;
      i++
    ) {

      pages.push(i);

    }


    if (
      current <
      totalPages - 3
    ) {

      pages.push("...");

    }


    pages.push(
      totalPages
    );


    return pages;

  }


  /* =========================================================
     OPEN DELETE
  ========================================================= */

  function openDelete(
    id: string
  ) {

    if (
      !deleteModal ||
      !modalDeleteInput
    ) {
      return;
    }

    modalDeleteInput.value =
      id;

    deleteModal.classList.add(
      "is-open"
    );

    deleteModal.setAttribute(
      "aria-hidden",
      "false"
    );

  }


  /* =========================================================
     OPEN EDIT
  ========================================================= */

  function openEdit(
    id: string
  ) {

    if (
      !editModal ||
      !modalEditInput
    ) {
      return;
    }

    modalEditInput.value =
      id;

    editModal.classList.add(
      "is-open"
    );

    editModal.setAttribute(
      "aria-hidden",
      "false"
    );

  }


  /* =========================================================
     CLOSE MODAL
  ========================================================= */

  function closeModal(
    modal: HTMLElement | null
  ) {

    if (!modal) {
      return;
    }

    modal.classList.remove(
      "is-open"
    );

    modal.setAttribute(
      "aria-hidden",
      "true"
    );

  }


  /* =========================================================
     EDIT BUTTON
  ========================================================= */

  document
    .querySelectorAll<HTMLButtonElement>(
      ".edit-btn"
    )
    .forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const id =
              button.dataset.id;

            if (id) {
              openEdit(id);
            }

          }
        );

      }
    );


  /* =========================================================
     DELETE BUTTON
  ========================================================= */

  document
    .querySelectorAll<HTMLButtonElement>(
      ".delete-btn"
    )
    .forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            const id =
              button.dataset.id;

            if (id) {
              openDelete(id);
            }

          }
        );

      }
    );


  /* =========================================================
     CANCEL
  ========================================================= */

  cancelDelete?.addEventListener(
    "click",
    () => {

      closeModal(
        deleteModal
      );

    }
  );


  cancelEdit?.addEventListener(
    "click",
    () => {

      closeModal(
        editModal
      );

    }
  );


  /* =========================================================
     CLICK OUTSIDE MODAL
  ========================================================= */

  window.addEventListener(
    "click",
    (event) => {

      if (
        event.target ===
        deleteModal
      ) {

        closeModal(
          deleteModal
        );

      }


      if (
        event.target ===
        editModal
      ) {

        closeModal(
          editModal
        );

      }

    }
  );


  /* =========================================================
     ESC
  ========================================================= */

  window.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key ===
        "Escape"
      ) {

        closeModal(
          deleteModal
        );

        closeModal(
          editModal
        );

      }

    }
  );


  /* =========================================================
     DELETE SUBMIT
  ========================================================= */

  deleteForm?.addEventListener(
    "submit",
    () => {

      if (confirmDelete) {

        confirmDelete.disabled =
          true;

        confirmDelete.textContent =
          "Menghapus...";

      }

    }
  );


  /* =========================================================
     SEARCH EVENT
  ========================================================= */

  searchInput?.addEventListener(
    "input",
    () => {

      applySearch();

    }
  );


  /* =========================================================
     ENTER / SEARCH
  ========================================================= */

  searchInput?.addEventListener(
    "search",
    () => {

      applySearch();

    }
  );


  /* =========================================================
     ENTRIES EVENT
  ========================================================= */

  entriesSelect?.addEventListener(
    "change",
    () => {

      currentPage =
        1;

      renderTable();

    }
  );


  /* =========================================================
     INITIAL
  ========================================================= */

  filteredRows =
    getRows();

  renderTable();

</script>


