  color:
    #334155;

  font-size:
    12px;

}


.current-image-info span {

  color:
    #94a3b8;

  font-size:
    11px;

  overflow:
    hidden;

  text-overflow:
    ellipsis;

  word-break:
    break-all;

}


.no-image {

  padding:
    18px;

  text-align:
    center;

  color:
    #94a3b8;

  background:
    #f8fafc;

  border:
    1px dashed
    #cbd5e1;

  border-radius:
    10px;

  font-size:
    12px;

}


/* =========================================================
   ACTION
========================================================= */

.form-actions {

  display:
    flex;

  justify-content:
    flex-end;

  gap:
    8px;

  padding-top:
    8px;

}


.btn-cancel,
.btn-primary {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  min-height:
    38px;

  padding:
    0 16px;

  border-radius:
    9px;

  font-size:
    12.5px;

  font-weight:
    700;

  text-decoration:
    none;

  box-sizing:
    border-box;

  cursor:
    pointer;

}


.btn-cancel {

  background:
    #f1f5f9;

  color:
    #334155;

  border:
    1px solid
    #e2e8f0;

}


.btn-cancel:hover {

  background:
    #e2e8f0;

}


.btn-primary {

  border:
    0;

  background:
    #1d4ed8;

  color:
    #ffffff;

}


.btn-primary:hover {

  background:
    #1e40af;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (
  max-width: 600px
) {

  .panel {

    padding:
      16px;

    border-radius:
      14px;

  }


  .current-image {

    align-items:
      flex-start;

    flex-direction:
      column;

  }


  .current-image img {

    width:
      100%;

    height:
      180px;

  }


  .form-actions {

    flex-direction:
      column-reverse;

  }


  .btn-cancel,
  .btn-primary {

    width:
      100%;

  }

}

</style>
