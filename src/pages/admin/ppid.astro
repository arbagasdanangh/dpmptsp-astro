---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";

export const prerender = false;

/* =========================================================
   DELETE PPID
========================================================= */

if (Astro.request.method === "DELETE") {
  const url = new URL(Astro.request.url);
  const id = url.searchParams.get("id");

  if (id) {
    try {
      await db.query(
        "DELETE FROM ppid_item WHERE id = ?",
        [id]
      );

      return new Response(
        JSON.stringify({
          success: true
        }),
        {
          status: 200,
          headers: {
            "Content-Type": "application/json"
          }
        }
      );
    } catch (error) {
      console.error("Gagal hapus PPID:", error);

      return new Response(
        JSON.stringify({
          success: false,
          message: "Gagal menghapus data PPID"
        }),
        {
          status: 500,
          headers: {
            "Content-Type": "application/json"
          }
        }
      );
    }
  }

  return new Response(
    JSON.stringify({
      success: false,
      message: "ID tidak ditemukan"
    }),
    {
      status: 400,
      headers: {
        "Content-Type": "application/json"
      }
    }
  );
}

/* =========================================================
   AMBIL DATA PPID
========================================================= */

let daftarPPID: any[] = [];

try {
  const [rows]: any = await db.query(`
    SELECT
      i.id,
      i.kategori_id,
      i.judul,
      i.isi,
      i.file_url,
      i.urutan,
      k.nama_kategori,
      k.slug
    FROM ppid_item i
    LEFT JOIN ppid_kategori k
      ON k.id = i.kategori_id
    ORDER BY
      i.kategori_id ASC,
      i.urutan ASC,
      i.id ASC
  `);

  daftarPPID = rows || [];
} catch (error) {
  console.error("Gagal ambil data PPID:", error);
  daftarPPID = [];
}
---

<AdminShell
  title="Daftar PPID"
  subtitle="Kelola informasi dan dokumen PPID yang ditampilkan pada website."
  actionLabel="Tambah PPID"
  actionHref="/admin/tambah-ppid"
>

  <div class="card-table-container">

    <!-- =====================================================
         TABLE CONTROLS
    ====================================================== -->

    <div class="table-controls">

      <!-- SHOW ENTRIES -->

      <div class="entries-wrapper">

        <label for="entriesPerPage">
          Tampilkan
        </label>

        <select
          id="entriesPerPage"
          class="entries-select"
        >
          <option value="10" selected>10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>

        <span>
          entri
        </span>

      </div>


      <!-- SEARCH -->

      <div class="search-wrapper">

        <label for="search">
          Cari:
        </label>

        <input
          type="text"
          id="search"
          placeholder="Cari kategori, judul..."
          class="search-input"
        />

      </div>

    </div>


    <!-- =====================================================
         TABLE
    ====================================================== -->

    <div class="table-responsive">

      <table
        class="data-table"
        id="ppidTable"
      >

        <thead>

          <tr>

            <th style="width: 55px;">
              ID
            </th>

            <th style="width: 170px;">
              Kategori
            </th>

            <th style="width: 250px;">
              Judul
            </th>

            <th>
              Isi
            </th>

            <th style="width: 150px;">
              File
            </th>

            <th style="width: 70px;">
              Urutan
            </th>

            <th
              style="width: 90px;"
              class="text-center"
            >
              Aksi
            </th>

          </tr>

        </thead>


        <tbody id="tableBody">

          {
            daftarPPID.length > 0 ? (

              daftarPPID.map((item) => (

                <tr class="table-row-item">

                  <!-- ID -->

                  <td class="text-center fw-medium">
                    {item.id}
                  </td>


                  <!-- KATEGORI -->

                  <td>

                    <div
                      class="category-wrapper"
                      title={item.nama_kategori || "-"}
                    >

                      <span class="badge-category">
                        {item.nama_kategori || "Tanpa Kategori"}
                      </span>

                      {item.slug && (
                        <small class="category-slug">
                          /{item.slug}
                        </small>
                      )}

                    </div>

                  </td>


                  <!-- JUDUL -->

                  <td>

                    <div
                      class="truncate-text fw-bold"
                      title={item.judul || "-"}
                    >
                      {item.judul || "-"}
                    </div>

                  </td>


                  <!-- ISI -->

                  <td>

                    <div
                      class="truncate-multiline"
                      title={item.isi || "-"}
                    >
                      {item.isi || "-"}
                    </div>

                  </td>


                  <!-- FILE -->

                  <td>

                    {item.file_url ? (

                      <a
                        href={item.file_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="file-link"
                        title={item.file_url}
                      >

                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                          <polyline points="14 2 14 8 20 8"></polyline>
                          <line x1="16" y1="13" x2="8" y2="13"></line>
                          <line x1="16" y1="17" x2="8" y2="17"></line>
                          <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>

                        <span>
                          Lihat File
                        </span>

                      </a>

                    ) : (

                      <span class="no-file">
                        -
                      </span>

                    )}

                  </td>


                  <!-- URUTAN -->

                  <td class="text-center">

                    <span class="order-badge">
                      {item.urutan ?? 0}
                    </span>

                  </td>


                  <!-- AKSI -->

                  <td>

                    <div class="action-buttons justify-center">

                      <!-- EDIT -->

                      <button
                        class="btn-action edit"
                        title="Edit"
                        data-id={item.id}
                        onclick="openEditModal(this)"
                      >

                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                          <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>

                      </button>


                      <!-- DELETE -->

                      <button
                        class="btn-action delete"
                        title="Hapus"
                        data-id={item.id}
                        onclick="openDeleteModal(this)"
                      >

                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="15"
                          height="15"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>

                      </button>

                    </div>

                  </td>

                </tr>

              ))

            ) : (

              <tr>

                <td
                  colspan="7"
                  class="text-center empty-msg"
                >
                  Tidak ada data PPID ditemukan.
                </td>

              </tr>

            )
          }

        </tbody>

      </table>

    </div>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <div class="table-footer">

      <div
        class="table-info"
        id="tableInfo"
      >
        Menampilkan 0 entri
      </div>


      <div class="pagination">

        <button
          class="page-btn"
          id="prevBtn"
          disabled
        >
          Sebelumnya
        </button>


        <div
          id="pageNumbers"
          class="page-numbers"
        ></div>


        <button
          class="page-btn"
          id="nextBtn"
          disabled
        >
          Selanjutnya
        </button>

      </div>

    </div>

  </div>


  <!-- =======================================================
       MODAL EDIT
  ======================================================== -->

  <div
    id="editModal"
    class="modal-overlay"
  >

    <div class="modal-card">

      <div class="modal-icon-wrapper">

        <div class="modal-icon edit-icon">
          !
        </div>

      </div>

      <h3>
        Edit Data?
      </h3>

      <p>
        Apakah Anda yakin ingin mengedit data PPID ini?
      </p>

      <div class="modal-actions">

        <button
          type="button"
          class="btn-modal-cancel"
          onclick="closeEditModal()"
        >
          Batal
        </button>

        <button
          type="button"
          class="btn-modal-edit"
          id="confirmEditBtn"
        >
          Ya, Edit
        </button>

      </div>

    </div>

  </div>


  <!-- =======================================================
       MODAL DELETE
  ======================================================== -->

  <div
    id="deleteModal"
    class="modal-overlay"
  >

    <div class="modal-card">

      <div class="modal-icon-wrapper">

        <div class="modal-icon">
          !
        </div>

      </div>

      <h3>
        Hapus Data?
      </h3>

      <p>
        Apakah Anda yakin ingin menghapus data PPID ini?
      </p>

      <div class="modal-actions">

        <button
          type="button"
          class="btn-modal-cancel"
          onclick="closeDeleteModal()"
        >
          Batal
        </button>

        <button
          type="button"
          class="btn-modal-delete"
          id="confirmDeleteBtn"
        >
          Hapus
        </button>

      </div>

    </div>

  </div>

</AdminShell>


