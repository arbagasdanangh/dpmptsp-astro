</style>


<script>

  /* =========================================================
     DATATABLE
  ========================================================= */

  let currentPage = 1;

  let itemsPerPage = 10;


  const rows =
    Array.from(
      document.querySelectorAll(".table-row-item")
    ) as HTMLElement[];


  const searchInput =
    document.getElementById(
      "search"
    ) as HTMLInputElement;


  const entriesPerPage =
    document.getElementById(
      "entriesPerPage"
    ) as HTMLSelectElement;


  const prevBtn =
    document.getElementById(
      "prevBtn"
    ) as HTMLButtonElement;


  const nextBtn =
    document.getElementById(
      "nextBtn"
    ) as HTMLButtonElement;


  const pageNumbers =
    document.getElementById(
      "pageNumbers"
    ) as HTMLElement;


  const tableInfo =
    document.getElementById(
      "tableInfo"
    ) as HTMLElement;


  let filteredRows =
    [...rows];


  /* =========================================================
     RENDER TABLE
  ========================================================= */

  function renderTable() {

    const totalItems =
      filteredRows.length;


    const totalPages =
      Math.ceil(
        totalItems /
        itemsPerPage
      ) || 1;


    if (
      currentPage >
      totalPages
    ) {

      currentPage =
        totalPages;

    }


    const start =
      (currentPage - 1) *
      itemsPerPage;


    const end =
      start +
      itemsPerPage;


    /* -------------------------------------------------------
       HIDE SEMUA ROW
    ------------------------------------------------------- */

    rows.forEach((row) => {

      row.style.display =
        "none";

    });


    /* -------------------------------------------------------
       TAMPILKAN ROW AKTIF
    ------------------------------------------------------- */

    filteredRows
      .slice(start, end)
      .forEach((row) => {

        row.style.display =
          "";

      });


    /* -------------------------------------------------------
       TABLE INFO
    ------------------------------------------------------- */

    const showingStart =
      totalItems === 0
        ? 0
        : start + 1;


    const showingEnd =
      Math.min(
        end,
        totalItems
      );


    if (tableInfo) {

      tableInfo.innerText =
        `Menampilkan ${showingStart} sampai ${showingEnd} dari ${totalItems} entri`;

    }


    /* -------------------------------------------------------
       PAGE NUMBERS
    ------------------------------------------------------- */

    if (pageNumbers) {

      pageNumbers.innerHTML =
        "";


      if (totalPages <= 7) {

        for (
          let i = 1;
          i <= totalPages;
          i++
        ) {

          createPageButton(i);

        }

      } else {

        /*
         * Halaman pertama
         */

        createPageButton(1);


        /*
         * Ellipsis kiri
         */

        if (currentPage > 4) {

          createEllipsis();

        }


        /*
         * Halaman sekitar posisi aktif
         */

        const startPage =
          Math.max(
            2,
            currentPage - 1
          );


        const endPage =
          Math.min(
            totalPages - 1,
            currentPage + 1
          );


        for (
          let i = startPage;
          i <= endPage;
          i++
        ) {

          createPageButton(i);

        }


        /*
         * Ellipsis kanan
         */

        if (
          currentPage <
          totalPages - 3
        ) {

          createEllipsis();

        }


        /*
         * Halaman terakhir
         */

        createPageButton(
          totalPages
        );

      }

    }


    /* -------------------------------------------------------
       PREVIOUS
    ------------------------------------------------------- */

    if (prevBtn) {

      prevBtn.disabled =
        currentPage === 1;

    }


    /* -------------------------------------------------------
       NEXT
    ------------------------------------------------------- */

    if (nextBtn) {

      nextBtn.disabled =
        currentPage === totalPages;

    }

  }


  /* =========================================================
     CREATE PAGE BUTTON
  ========================================================= */

  function createPageButton(
    page: number
  ) {

    if (!pageNumbers) {
      return;
    }


    const btn =
      document.createElement(
        "button"
      );


    btn.type =
      "button";


    btn.className =
      `page-btn ${
        page === currentPage
          ? "active"
          : ""
      }`;


    btn.innerText =
      page.toString();


    btn.addEventListener(
      "click",
      () => {

        currentPage =
          page;

        renderTable();

      }
    );


    pageNumbers.appendChild(
      btn
    );

  }


  /* =========================================================
     ELLIPSIS
  ========================================================= */

  function createEllipsis() {

    if (!pageNumbers) {
      return;
    }


    const span =
      document.createElement(
        "span"
      );


    span.className =
      "page-ellipsis";


    span.innerText =
      "...";


    pageNumbers.appendChild(
      span
    );

  }


  /* =========================================================
     PREVIOUS
  ========================================================= */

  prevBtn?.addEventListener(
    "click",
    () => {

      if (
        currentPage >
        1
      ) {

        currentPage--;

        renderTable();

      }

    }
  );


  /* =========================================================
     NEXT
  ========================================================= */

  nextBtn?.addEventListener(
    "click",
    () => {

      const totalPages =
        Math.ceil(
          filteredRows.length /
          itemsPerPage
        );


      if (
        currentPage <
        totalPages
      ) {

        currentPage++;

        renderTable();

      }

    }
  );


  /* =========================================================
     ITEMS PER PAGE
  ========================================================= */

  entriesPerPage?.addEventListener(
    "change",
    () => {

      itemsPerPage =
        parseInt(
          entriesPerPage.value
        );


      currentPage =
        1;


      renderTable();

    }
  );


  /* =========================================================
     SEARCH
  ========================================================= */

  searchInput?.addEventListener(
    "input",
    (event) => {

      const query =
        (
          event.target as HTMLInputElement
        ).value
          .toLowerCase()
          .trim();


      filteredRows =
        rows.filter(
          (row) =>
            row.innerText
              .toLowerCase()
              .includes(query)
        );


      currentPage =
        1;


      renderTable();

    }
  );


  /* =========================================================
     INITIAL RENDER
  ========================================================= */

  renderTable();


  /* =========================================================
     EDIT MODAL
  ========================================================= */

  let selectedEditId:
    string | null = null;


  // @ts-ignore
  window.openEditModal =
    function (
      button: HTMLElement
    ) {

      selectedEditId =
        button.getAttribute(
          "data-id"
        );


      const modal =
        document.getElementById(
          "editModal"
        );


      if (modal) {

        modal.style.display =
          "flex";

      }

    };


  // @ts-ignore
  window.closeEditModal =
    function () {

      selectedEditId =
        null;


      const modal =
        document.getElementById(
          "editModal"
        );


      if (modal) {

        modal.style.display =
          "none";

      }

    };


  /* =========================================================
     CONFIRM EDIT
  ========================================================= */

  document
    .getElementById(
      "confirmEditBtn"
    )
    ?.addEventListener(
      "click",
      function () {

        if (
          selectedEditId
        ) {

          window.location.href =
            `/admin/edit-ppid?id=${selectedEditId}`;

        }

      }
    );


  /* =========================================================
     DELETE MODAL
  ========================================================= */

  let selectedDeleteId:
    string | null = null;


  // @ts-ignore
  window.openDeleteModal =
    function (
      button: HTMLElement
    ) {

      selectedDeleteId =
        button.getAttribute(
          "data-id"
        );


      const modal =
        document.getElementById(
          "deleteModal"
        );


      if (modal) {

        modal.style.display =
          "flex";

      }

    };


  // @ts-ignore
  window.closeDeleteModal =
    function () {

      selectedDeleteId =
        null;


      const modal =
        document.getElementById(
          "deleteModal"
        );


      if (modal) {

        modal.style.display =
          "none";

      }

    };


  /* =========================================================
     CONFIRM DELETE
  ========================================================= */

  document
    .getElementById(
      "confirmDeleteBtn"
    )
    ?.addEventListener(
      "click",
      async function () {

        if (
          !selectedDeleteId
        ) {

          return;

        }


        const button =
          this as HTMLButtonElement;


        button.disabled =
          true;


        button.innerText =
          "Menghapus...";


        try {

          const response =
            await fetch(
              `/admin/ppid?id=${selectedDeleteId}`,
              {
                method: "DELETE"
              }
            );


          const result =
            await response.json();


          if (
            response.ok &&
            result.success
          ) {

            window.location.reload();

          } else {

            alert(
              result.message ||
              "Gagal menghapus data PPID."
            );


            button.disabled =
              false;


            button.innerText =
              "Hapus";

          }

        } catch (error) {

          console.error(
            "Gagal hapus PPID:",
            error
          );


          alert(
            "Terjadi kesalahan koneksi."
          );


          button.disabled =
            false;


          button.innerText =
            "Hapus";

        }

      }
    );


  /* =========================================================
     CLOSE MODAL OUTSIDE
  ========================================================= */

  document
    .getElementById(
      "editModal"
    )
    ?.addEventListener(
      "click",
      (event) => {

        if (
          event.target ===
          event.currentTarget
        ) {

          // @ts-ignore
          window.closeEditModal();

        }

      }
    );


  document
    .getElementById(
      "deleteModal"
    )
    ?.addEventListener(
      "click",
      (event) => {

        if (
          event.target ===
          event.currentTarget
        ) {

          // @ts-ignore
          window.closeDeleteModal();

        }

      }
    );

</script>