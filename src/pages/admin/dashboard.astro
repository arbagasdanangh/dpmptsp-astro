        font-size: 26px;
        line-height: 1;
      }

      .current-filter-total span {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 10px;
      }

      /* =====================================================
         MAIN CARDS
      ====================================================== */

      .cards {
        display: grid;
        grid-template-columns:
          repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
      }

      .stat-card {
        position: relative;
        overflow: hidden;
        min-height: 154px;
        padding: 20px;
        border: 1px solid #e5e9f0;
        border-radius: 18px;
        background: #fff;
        box-shadow:
          0 6px 22px rgba(20, 34, 65, 0.04);
        transition: 0.25s ease;
      }

      .stat-card::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -35px;
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: rgba(21, 94, 239, 0.035);
      }

      .stat-card:hover {
        transform: translateY(-3px);
        box-shadow:
          0 12px 28px rgba(20, 34, 65, 0.07);
      }

      .stat-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        font-size: 17px;
      }

      .stat-label {
        color: #8791a3;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.55px;
        text-transform: uppercase;
      }

      .stat-number {
        display: block;
        margin-top: 15px;
        color: #202b40;
        font-size: 32px;
        line-height: 1;
        font-weight: 850;
      }

      .stat-bottom {
        margin-top: 12px;
        color: #8d96a7;
        font-size: 11px;
      }

      .stat-card.blue .stat-icon {
        color: #155eef;
        background: #edf4ff;
      }

      .stat-card.green .stat-icon {
        color: #079455;
        background: #eafaf2;
      }

      .stat-card.orange .stat-icon {
        color: #d97706;
        background: #fff5e7;
      }

      .stat-card.purple .stat-icon {
        color: #7c3aed;
        background: #f3edff;
      }

      /* =====================================================
         CONTENT
      ====================================================== */

      .content-section {
        margin-bottom: 20px;
        padding: 21px;
        border: 1px solid #e4e8ef;
        border-radius: 19px;
        background: #fff;
        box-shadow:
          0 6px 22px rgba(20, 34, 65, 0.035);
      }

      .section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
      }

      .section-heading-left {
        display: flex;
        align-items: center;
        gap: 13px;
      }

      .section-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 13px;
      }

      .section-icon.news {
        color: #155eef;
        background: #edf4ff;
      }

      .section-icon.article {
        color: #7c3aed;
        background: #f1ebff;
      }

      .section-heading h2,
      .section-heading p {
        margin: 0;
      }

      .section-heading h2 {
        color: #202b40;
        font-size: 17px;
        font-weight: 850;
      }

      .section-heading p {
        margin-top: 4px;
        color: #8a94a6;
        font-size: 11px;
      }

      .section-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 13px;
        border-radius: 10px;
        color: #155eef;
        background: #f2f6ff;
        font-size: 11px;
        font-weight: 800;
        transition: 0.2s ease;
      }

      .section-link:hover {
        background: #e7efff;
        transform: translateX(2px);
      }

      /* =====================================================
         NEWS CARDS
      ====================================================== */

      .news-grid {
        display: grid;
        grid-template-columns:
          repeat(4, minmax(0, 1fr));
        gap: 13px;
      }

      .news-grid-3 {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

      .news-stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        padding: 17px;
        border: 1px solid #e8ebf1;
        border-radius: 15px;
        transition: 0.2s ease;
      }

      .news-stat-card:hover {
        transform: translateY(-2px);
        box-shadow:
          0 8px 20px rgba(30, 45, 80, 0.06);
      }

      .news-stat-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
      }

      .news-stat-content {
        min-width: 0;
      }

      .news-stat-content span,
      .news-stat-content strong,
      .news-stat-content small {
        display: block;
      }

      .news-stat-content span {
        color: #707b8f;
        font-size: 11px;
        font-weight: 750;
      }

      .news-stat-content strong {
        margin-top: 4px;
        color: #1d283d;
        font-size: 27px;
        line-height: 1;
        font-weight: 850;
      }

      .news-stat-content small {
        margin-top: 5px;
        color: #969eac;
        font-size: 10px;
      }

      .news-blue {
        background: #f8fbff;
      }

      .news-blue .news-stat-icon {
        color: #155eef;
        background: #e9f1ff;
      }

      .news-green {
        background: #f6fcf9;
      }

      .news-green .news-stat-icon {
        color: #079455;
        background: #e5f8ef;
      }

      .news-orange {
        background: #fffaf3;
      }

      .news-orange .news-stat-icon {
        color: #d97706;
        background: #fff0d9;
      }

      /* =====================================================
         ARTICLE
      ====================================================== */

      .article-category-grid {
        display: grid;
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
        gap: 13px;
      }

      .article-category-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        padding: 17px;
        border: 1px solid #e7eaf0;
        border-radius: 15px;
        background: #fafbfc;
        transition: 0.2s ease;
      }

      .article-category-card:hover {
        transform: translateY(-2px);
        box-shadow:
          0 8px 20px rgba(30, 45, 80, 0.05);
      }

      .article-category-icon {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 13px;
        color: #155eef;
        background: #eaf1ff;
      }

      .article-category-icon.investment {
        color: #079455;
        background: #e6f8ef;
      }

      .article-category-content {
        min-width: 0;
      }

      .article-category-content span,
      .article-category-content strong,
      .article-category-content small {
        display: block;
      }

      .article-category-content span {
        color: #566176;
        font-size: 11px;
        font-weight: 750;
      }

      .article-category-content strong {
        margin-top: 3px;
        color: #1d283d;
        font-size: 28px;
        line-height: 1;
        font-weight: 850;
      }

      .article-category-content small {
        margin-top: 5px;
        color: #969eac;
        font-size: 10px;
      }

      /* =====================================================
         ALL PUBLICATION
      ====================================================== */

      .summary-publication {
        display: grid;
        grid-template-columns:
          repeat(6, minmax(0, 1fr));
        gap: 12px;
      }

      .publication-mini {
        padding: 17px;
        border: 1px solid #e6eaf0;
        border-radius: 14px;
        background: #fafbfc;
      }

      .publication-mini span {
        display: block;
        color: #727d91;
        font-size: 10px;
        font-weight: 750;
      }

      .publication-mini strong {
        display: block;
        margin-top: 8px;
        color: #1d283d;
        font-size: 26px;
        line-height: 1;
        font-weight: 850;
      }

      .publication-mini.blue {
        border-color: #dbe8ff;
        background: #f7faff;
      }

      .publication-mini.green {
        border-color: #d9f2e5;
        background: #f6fcf9;
      }

      .publication-mini.orange {
        border-color: #f8e5c9;
        background: #fffaf3;
      }

      .publication-mini.purple {
        border-color: #e5dcff;
        background: #faf8ff;
      }

      .publication-mini.cyan {
        border-color: #d6eff4;
        background: #f5fcfd;
      }

      .publication-mini.darkgreen {
        border-color: #d9eee4;
        background: #f5fbf8;
      }

      /* =====================================================
         CHART
      ====================================================== */

      .chart-grid {
        display: grid;
        grid-template-columns:
          minmax(0, 1.25fr)
          minmax(0, 0.75fr);
        gap: 18px;
        margin-bottom: 18px;
      }

      .panel {
        min-width: 0;
        padding: 20px;
        border: 1px solid #e4e8ef;
        border-radius: 19px;
        background: #fff;
        box-shadow:
          0 6px 22px rgba(20, 34, 65, 0.035);
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 22px;
      }

      .panel-header h2 {
        margin: 0;
        color: #202b40;
        font-size: 16px;
        font-weight: 850;
      }

      .panel-header p {
        margin: 4px 0 0;
        color: #9099a9;
        font-size: 11px;
      }

      .panel-header-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        color: #155eef;
        background: #edf4ff;
      }

      .bar-chart {
        height: 250px;
        display: grid;
        grid-template-columns:
          repeat(12, 1fr);
        align-items: end;
        gap: 8px;
        padding-top: 25px;
      }

      .bar-item {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
      }

      .bar-value {
        min-height: 16px;
        color: #677286;
        font-size: 10px;
        font-weight: 800;
      }

      .bar-track {
        width: 100%;
        max-width: 27px;
        height: 180px;
        display: flex;
        align-items: flex-end;
        margin-top: 4px;
        border-radius: 8px;
        background: #f1f4f8;
        overflow: hidden;
      }

      .bar-fill {
        width: 100%;
        min-height: 3px;
        border-radius: 8px 8px 3px 3px;
        background:
          linear-gradient(
            180deg,
            #155eef,
            #6b98f5
          );
      }

      .bar-item > span {
        margin-top: 8px;
        color: #8a94a5;
        font-size: 9px;
      }

      /* =====================================================
         DISTRIBUTION
      ====================================================== */

      .distribution-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
      }

      .distribution-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 7px;
      }

      .distribution-name {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
      }

      .distribution-dot {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 7px;
        color: #155eef;
        background: #edf4ff;
        font-size: 9px;
        font-weight: 850;
      }

      .distribution-name strong {
        color: #4d586d;
        font-size: 11px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .distribution-count {
        color: #202b40;
        font-size: 12px;
        font-weight: 850;
      }

      .progress {
        width: 100%;
        height: 6px;
        overflow: hidden;
        border-radius: 99px;
        background: #eef1f5;
      }

      .progress-fill {
        height: 100%;
        border-radius: inherit;
        background: #155eef;
      }

      .distribution-item small {
        display: block;
        margin-top: 4px;
        color: #9aa2ae;
        font-size: 9px;
      }

      .empty-state {
        padding: 30px;
        text-align: center;
        color: #929baa;
        font-size: 12px;
      }

      /* =====================================================
         SIX MONTH
      ====================================================== */

      .six-month-panel {
        margin-bottom: 18px;
      }

      .six-month-chart {
        height: 220px;
        display: grid;
        grid-template-columns:
          repeat(6, 1fr);
        align-items: end;
        gap: 18px;
        padding: 0 10px;
      }

      .six-month-item {
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
      }

      .six-month-number {
        margin-bottom: 5px;
        color: #687388;
        font-size: 11px;
        font-weight: 850;
      }

      .six-month-track {
        width: min(60px, 70%);
        height: 155px;
        display: flex;
        align-items: flex-end;
        border-radius: 9px;
        background: #f0f3f7;
        overflow: hidden;
      }

      .six-month-fill {
        width: 100%;
        min-height: 3px;
        border-radius: 9px 9px 4px 4px;
        background:
          linear-gradient(
            180deg,
            #7c3aed,
            #a78bfa
          );
      }

      .six-month-item > span {
        margin-top: 8px;
        color: #8c95a5;
        font-size: 10px;
      }

      /* =====================================================
         TABLE
      ====================================================== */

      .recent-panel {
        margin-bottom: 18px;
      }

      .view-all {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #155eef;
        font-size: 11px;
        font-weight: 800;
      }

      .table-wrapper {
        width: 100%;
        overflow-x: auto;
      }

      table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
      }

      th {
        padding: 12px 10px;
        border-bottom: 1px solid #e8ebf0;
        color: #929aaa;
        background: #fafbfc;
        font-size: 10px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
      }

      td {
        padding: 13px 10px;
        border-bottom: 1px solid #f0f2f5;
        color: #657084;
        font-size: 11px;
      }

      tbody tr {
        transition: 0.15s ease;
      }

      tbody tr:hover {
        background: #fafcff;
      }

      .data-title {
        max-width: 310px;
        color: #273249;
        font-weight: 750;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 7px;
        color: #667085;
        background: #f4f6f9;
        font-size: 10px;
        font-weight: 750;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 750;
      }

      .status i {
        font-size: 6px;
      }

      .status.active {
        color: #079455;
      }

      .status.inactive {
        color: #d97706;
      }

      .delete-btn {
        width: 31px;
        height: 31px;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 8px;
        color: #dc2626;
        background: #fff1f2;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .delete-btn:hover {
        color: #fff;
        background: #dc2626;
        transform: scale(1.05);
      }

      .delete-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .dash {
        color: #b0b6c0;
      }

      .empty-table {
        padding: 55px 20px;
        text-align: center;
      }

      .empty-table-icon {
        width: 54px;
        height: 54px;
        display: grid;
        place-items: center;
        margin: 0 auto 12px;
        border-radius: 15px;
        color: #94a0b2;
        background: #f1f4f7;
        font-size: 20px;
      }

      .empty-table strong {
        display: block;
        color: #49546a;
        font-size: 13px;
      }

      .empty-table p {
        margin: 5px 0 0;
        color: #9aa2ae;
        font-size: 11px;
      }

      /* =====================================================
         ANALYSIS
      ====================================================== */

      .analysis-box {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 19px;
        border: 1px solid #dce8ff;
        border-radius: 17px;
        background:
          linear-gradient(
            135deg,
            #f8fbff,
            #fff
          );
      }

      .analysis-icon {
        width: 43px;
        height: 43px;
        display: grid;
        place-items: center;
        flex-shrink: 0;
        border-radius: 12px;
        color: #155eef;
        background: #eaf1ff;
      }

      .analysis-box strong {
        display: block;
        color: #273249;
        font-size: 13px;
      }

      .analysis-box p {
        margin: 5px 0 0;
        color: #7b8597;
        font-size: 11px;
        line-height: 1.7;
      }

      .analysis-box b {
        color: #155eef;
      }


      /* =====================================================
         ACCESSIBILITY / PERSONA MODE
      ====================================================== */

      .persona-trigger {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 900;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 64px;
        padding: 7px 24px 7px 8px;
        border: 6px solid #f3d33f;
        border-radius: 999px;
        color: #fff;
        background: #214d9c;
        box-shadow:
          0 12px 28px rgba(20, 42, 90, 0.22);
        font-size: 17px;
        font-weight: 800;
        cursor: pointer;
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .persona-trigger:hover {
        transform: translateY(-2px);
        box-shadow:
          0 16px 32px rgba(20, 42, 90, 0.28);
      }

      .persona-trigger:focus-visible,
      .persona-option:focus-visible,
      .persona-close:focus-visible {
        outline: 4px solid rgba(21, 94, 239, 0.28);
        outline-offset: 3px;
      }

      .persona-trigger-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        color: #214d9c;
        background: #f1f4f8;
        font-size: 22px;
      }

      .persona-modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding: 24px;
        visibility: hidden;
        opacity: 0;
        pointer-events: none;
        transition:
          opacity 0.22s ease,
          visibility 0.22s ease;
      }

      .persona-modal.show {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
      }

      .persona-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(15, 23, 42, 0.18);
      }

      .persona-dialog {
        position: relative;
        width: min(600px, calc(100vw - 48px));
        max-height: calc(100vh - 120px);
        overflow-y: auto;
        margin: 0 0 78px 0;
        padding: 26px 28px;
        border: 1px solid #dce6f5;
        border-radius: 24px;
        background: #fff;
        box-shadow:
          0 30px 80px rgba(28, 44, 75, 0.24);
        transform: translateY(16px) scale(0.98);
        transition: transform 0.22s ease;
      }

      .persona-modal.show .persona-dialog {
        transform: translateY(0) scale(1);
      }

      .persona-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
      }

      .persona-brand {
        color: #2b55a1;
        font-size: 30px;
        line-height: 1;
        font-weight: 900;
        letter-spacing: -1.8px;
      }

      .persona-city {
        margin-top: 6px;
        color: #2b55a1;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 5px;
      }

      .persona-close {
        min-width: 88px;
        min-height: 48px;
        padding: 0 16px;
        border: 0;
        border-radius: 15px;
        color: #344054;
        background: #f1f4f8;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
      }

      .persona-intro {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
      }

      .persona-info-icon {
        width: 62px;
        height: 62px;
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        border: 4px solid #3e67dc;
        border-radius: 50%;
        color: #3e67dc;
        font-size: 27px;
        font-weight: 900;
      }

      .persona-intro h2 {
        margin: 0;
        color: #344054;
        font-size: 17px;
        line-height: 1.45;
        font-weight: 800;
      }

      .persona-options {
        display: grid;
        gap: 11px;
      }

      .persona-option {
        width: 100%;
        min-height: 76px;
        display: grid;
        grid-template-columns: 44px 42px minmax(0, 1fr);
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        border: 2px solid #dfe5ee;
        border-radius: 18px;
        color: #25314a;
        background: #fff;
        text-align: left;
        cursor: pointer;
        transition:
          border-color 0.2s ease,
          background 0.2s ease,
          transform 0.2s ease;
      }

      .persona-option:hover {
        border-color: #aac0ea;
        background: #f8fbff;
        transform: translateY(-1px);
      }

      .persona-option.selected {
        border-color: #5abe6b;
        background: #e8f8eb;
      }

      .persona-radio {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        justify-self: center;
