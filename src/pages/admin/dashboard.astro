    ====================================================== -->


    <script is:inline>
      (() => {
        const modal = document.getElementById("personaModal");
        const trigger = document.getElementById("personaTrigger");
        const closeButton = document.getElementById("personaClose");
        const options = document.querySelectorAll(".persona-option");
        const layout = document.querySelector(".admin-layout");

        if (!modal || !trigger || !layout) return;

        const STORAGE_KEY = "dpmptsp-persona-mode";

        function getMode() {
          return localStorage.getItem(STORAGE_KEY) || "normal";
        }

        function applyMode(mode) {
          layout.classList.remove(
            "persona-normal",
            "persona-colorblind",
            "persona-senior"
          );

          layout.classList.add(`persona-${mode}`);

          options.forEach((option) => {
            const active = option.dataset.persona === mode;

            option.classList.toggle("selected", active);
            option.setAttribute("aria-pressed", active ? "true" : "false");

            const radio = option.querySelector(".persona-radio");

            if (radio) {
              radio.innerHTML = active
                ? '<i class="fa-solid fa-check"></i>'
                : "";
            }
          });

          localStorage.setItem(STORAGE_KEY, mode);
        }

        function openModal() {
          modal.classList.add("show");
          modal.setAttribute("aria-hidden", "false");
          document.body.classList.add("persona-modal-open");

          requestAnimationFrame(() => {
            closeButton?.focus();
          });
        }

        function closeModal() {
          modal.classList.remove("show");
          modal.setAttribute("aria-hidden", "true");
          document.body.classList.remove("persona-modal-open");
          trigger?.focus();
        }

        applyMode(getMode());

        trigger.addEventListener("click", openModal);
        closeButton?.addEventListener("click", closeModal);

        modal.querySelectorAll("[data-persona-close]").forEach((element) => {
          element.addEventListener("click", closeModal);
        });

        options.forEach((option) => {
          option.addEventListener("click", () => {
            const mode = option.dataset.persona;

            if (!mode) return;

            applyMode(mode);
            closeModal();
          });
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && modal.classList.contains("show")) {
            closeModal();
          }
        });
      })();
    </script>

    <script is:inline>
      document.addEventListener(
        "DOMContentLoaded",
        () => {
          const deleteButtons =
            document.querySelectorAll(
              ".delete-btn"
            );

          deleteButtons.forEach((button) => {

            button.addEventListener(
              "click",
              async () => {

                const id =
                  button.dataset.id;

                if (!id) {
                  alert(
                    "ID data tidak ditemukan."
                  );

                  return;
                }

                const confirmed =
                  confirm(
                    "Yakin ingin menghapus data ini?"
                  );

                if (!confirmed) {
                  return;
                }

                button.disabled = true;

                try {

                  const response =
                    await fetch(
                      `/admin/dashboard?id=${encodeURIComponent(id)}`,
                      {
                        method: "DELETE",
                      }
                    );

                  const result =
                    await response.json();

                  if (
                    !response.ok ||
                    !result.success
                  ) {
                    throw new Error(
                      result.message ||
                        "Gagal menghapus data."
                    );
                  }

                  window.location.reload();

                } catch (error) {

                  console.error(error);

                  alert(
                    error.message ||
                      "Terjadi kesalahan."
                  );

                  button.disabled = false;
                }

              }
            );

          });

        }
      );
    </script>

