---
import Sidebar from "../../components/admin/Sidebar.astro";
import Navbar from "../../components/admin/Navbar.astro";
import { db } from "../../lib/db.js";

export const prerender = false;

/* =========================================================
   AUTH
========================================================= */

const auth = Astro.cookies.get("admin-auth");

if (!auth?.value) {
  return Astro.redirect("/admin/login");
}

/* =========================================================
   NO CACHE
========================================================= */

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, must-revalidate, proxy-revalidate"
);

Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

/* =========================================================
   FILTER
========================================================= */

const allowedTypes = [
  "all",
  "berita",
  "artikel",
  "inovasi",
  "konten",
  "layanan",
  "carousel",
  "kinerja",
];

const typeParam = Astro.url.searchParams.get("type") || "all";

const type = allowedTypes.includes(typeParam)
  ? typeParam
  : "all";

/* =========================================================
   DELETE
========================================================= */

if (Astro.request.method === "DELETE") {
  try {
    const id = Astro.url.searchParams.get("id");

    if (!id) {
      return new Response(
        JSON.stringify({
          success: false,
          message: "ID data tidak ditemukan",
        }),
        {
          status: 400,
          headers: {
            "Content-Type": "application/json",
          },
        }
      );
    }

    await db.query(
      "DELETE FROM post WHERE id_post = ?",
      [Number(id)]
    );

    return new Response(
      JSON.stringify({
        success: true,
        message: "Data berhasil dihapus",
      }),
      {
        status: 200,
        headers: {
          "Content-Type": "application/json",
        },
      }
    );
  } catch (error) {
    console.error("DELETE ERROR:", error);

    return new Response(
      JSON.stringify({
        success: false,
        message: "Gagal menghapus data",
      }),
      {
        status: 500,
        headers: {
          "Content-Type": "application/json",
        },
      }
    );
  }
}

/* =========================================================
   HELPERS
========================================================= */

function getTitle(item) {
  return (
    item?.title ||
    item?.judul ||
    item?.Judul ||
    item?.judul_konten ||
    item?.Judul_Konten ||
    item?.nama ||
    item?.Nama ||
    item?.name ||
    "Tanpa Judul"
  );
}

function getDate(item) {
  const keys = [
    "date",
    "tanggal",
    "Tanggal",
    "tgl",
    "Tgl",
    "created_at",
    "createdAt",
    "tanggal_input",
    "Tanggal_Input",
    "tanggal_kegiatan",
    "Tanggal_Kegiatan",
    "updated_at",
    "published_at",
    "publish_date",
    "tanggal_publish",
    "post_date",
    "tanggal_post",
  ];

  for (const key of keys) {
    const value = item?.[key];

    if (
      value !== undefined &&
      value !== null &&
      value !== ""
    ) {
      const date = new Date(value);

      if (!Number.isNaN(date.getTime())) {
        return date;
      }
    }
  }

  return null;
}

function getActive(item) {
  if (
    item?._sourceType === "berita" ||
    item?._sourceType === "artikel"
  ) {
    const value =
      item?.status_post ??
      item?.Status_Post ??
      item?.publish_status ??
      item?.Publish_Status ??
      item?.status ??
      item?.Status ??
      item?.publish ??
      item?.published;

    if (
      value === undefined ||
      value === null ||
      value === ""
    ) {
      return true;
    }

    const text = String(value)
      .trim()
      .toLowerCase();

    if (
      [
        "inactive",
        "nonaktif",
        "tidak aktif",
        "draft",
        "unpublish",
        "unpublished",
        "false",
        "no",
      ].includes(text)
    ) {
      return false;
    }

    return true;
  }

  const value =
    item?.status ??
    item?.Status ??
    item?.aktif ??
    item?.Aktif ??
    item?.active ??
    item?.is_active ??
    item?.publish ??
    item?.published;

  if (
    value === undefined ||
    value === null ||
    value === ""
  ) {
    return true;
  }

  const text = String(value)
    .trim()
    .toLowerCase();

  if (
    [
      "aktif",
      "active",
      "publish",
      "published",
      "true",
      "yes",
      "1",
    ].includes(text)
  ) {
    return true;
  }

  if (value === true || value === 1) {
    return true;
  }

  return false;
}

function getId(item) {
  return (
    item?.id_post ??
    item?.id ??
    item?.Id_Konten ??
    item?.id_konten ??
    item?.id_layanan ??
    item?.id_inovasi ??
    item?.id_slider ??
    item?.id_tw ??
    null
  );
}

function normalize(value) {
  return String(value || "")
    .trim()
    .toLowerCase();
}

function formatTanggal(date) {
  if (!date) return "-";

  return date.toLocaleDateString("id-ID", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function getSourceLabel(item) {
  return item?._sourceLabel || "Data";
}

function getIcon(typeName) {
  const icons = {
    berita: "📰",
    artikel: "📄",
    inovasi: "💡",
    konten: "🗂️",
    layanan: "🏢",
    carousel: "🖼️",
    kinerja: "📊",
  };

  return icons[typeName] || "📌";
}

/* =========================================================
   DATABASE LOADER
   SEMUA QUERY ADA DI DALAM ASYNC FUNCTION
   ========================================================= */

async function loadDashboardData() {
  const result = {
    postRows: [],
    inovasiRows: [],
    kontenRows: [],
    layananRows: [],
    carouselRows: [],
    kinerjaRows: [],
  };

  /* -------------------------------------------------------
     POST
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT
        post.*,
        category_berita.title AS kategori
      FROM post
      LEFT JOIN category_berita
        ON post.id_category = category_berita.id_category
      ORDER BY post.id_post DESC
    `);

    result.postRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("POST QUERY ERROR:", error);
  }

  /* -------------------------------------------------------
     INOVASI
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT *
      FROM inovasi_layanan
      ORDER BY id DESC
    `);

    result.inovasiRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("INOVASI QUERY ERROR:", error);
  }

  /* -------------------------------------------------------
     KONTEN
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT *
      FROM tentangkamiswebv5
      ORDER BY Id_Konten DESC
    `);

    result.kontenRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("KONTEN QUERY ERROR:", error);
  }

  /* -------------------------------------------------------
     LAYANAN
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT *
      FROM tempat_layanan
      ORDER BY id DESC
    `);

    result.layananRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("LAYANAN QUERY ERROR:", error);
  }

  /* -------------------------------------------------------
     CAROUSEL
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT *
      FROM beranda_slider
      ORDER BY urutan ASC, id ASC
    `);

    result.carouselRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("CAROUSEL QUERY ERROR:", error);
  }

  /* -------------------------------------------------------
     KINERJA
  ------------------------------------------------------- */

  try {
    const [rows] = await db.query(`
      SELECT *
      FROM twdata
      ORDER BY id DESC
    `);

    result.kinerjaRows = Array.isArray(rows) ? rows : [];
  } catch (error) {
    console.error("KINERJA QUERY ERROR:", error);
  }

  return result;
}

/* =========================================================
   LOAD DATA
========================================================= */

const dashboardData = await loadDashboardData();

const postRows = dashboardData.postRows;
const inovasiRows = dashboardData.inovasiRows;
const kontenRows = dashboardData.kontenRows;
const layananRows = dashboardData.layananRows;
const carouselRows = dashboardData.carouselRows;
const kinerjaRows = dashboardData.kinerjaRows;

/* =========================================================
   BERITA
========================================================= */

const beritaRows = postRows.filter((item) =>
  [1, 8].includes(Number(item.id_category))
);

/* =========================================================
   ARTIKEL
========================================================= */

const artikelRows = postRows.filter((item) =>
  [2, 3].includes(Number(item.id_category))
);

/* =========================================================
   TANGGAL
========================================================= */

const sekarang = new Date();

const batasBeritaBaru = new Date(sekarang);

batasBeritaBaru.setHours(0, 0, 0, 0);

batasBeritaBaru.setDate(
  batasBeritaBaru.getDate() - 30
);

/* =========================================================
   BERITA BARU
========================================================= */

const beritaBaruRows = beritaRows.filter((item) => {
  const tanggal = getDate(item);

  if (!tanggal) return false;

  return tanggal >= batasBeritaBaru;
});

/* =========================================================
   BERITA LAMA
========================================================= */

const beritaLamaRows = beritaRows.filter((item) => {
  const tanggal = getDate(item);

  if (!tanggal) return false;

  return tanggal < batasBeritaBaru;
});

/* =========================================================
   ARTIKEL PERIZINAN
========================================================= */

const artikelPerizinanRows =
  artikelRows.filter((item) => {
    const kategori = normalize(item.kategori);

    return (
      kategori.includes("perizinan") ||
      kategori.includes("izin")
    );
  });

/* =========================================================
   ARTIKEL PENANAMAN MODAL
========================================================= */

const artikelPenanamanModalRows =
  artikelRows.filter((item) => {
    const kategori = normalize(item.kategori);

    return (
      kategori.includes("penanaman modal") ||
      kategori.includes("investasi")
    );
  });

/* =========================================================
   NORMALIZED
========================================================= */

const normalizedBerita = beritaRows.map((item) => ({
  ...item,
  _sourceLabel: "Berita",
  _sourceType: "berita",
}));

const normalizedArtikel = artikelRows.map((item) => ({
  ...item,
  _sourceLabel: "Artikel",
  _sourceType: "artikel",
}));

const normalizedInovasi = inovasiRows.map((item) => ({
  ...item,
  _sourceLabel: "Inovasi",
  _sourceType: "inovasi",
}));

const normalizedKonten = kontenRows.map((item) => ({
  ...item,
  _sourceLabel: "Konten",
  _sourceType: "konten",
}));

const normalizedLayanan = layananRows.map((item) => ({
  ...item,
  _sourceLabel: "Layanan",
  _sourceType: "layanan",
}));

const normalizedCarousel = carouselRows.map((item) => ({
  ...item,
  _sourceLabel: "Carousel",
  _sourceType: "carousel",
}));

const normalizedKinerja = kinerjaRows.map((item) => ({
  ...item,
  _sourceLabel: "Kinerja",
  _sourceType: "kinerja",
}));

/* =========================================================
   SELECTED DATA
========================================================= */

let selectedRows = [];

if (type === "berita") {
  selectedRows = normalizedBerita;
} else if (type === "artikel") {
  selectedRows = normalizedArtikel;
} else if (type === "inovasi") {
  selectedRows = normalizedInovasi;
} else if (type === "konten") {
  selectedRows = normalizedKonten;
} else if (type === "layanan") {
  selectedRows = normalizedLayanan;
} else if (type === "carousel") {
  selectedRows = normalizedCarousel;
} else if (type === "kinerja") {
  selectedRows = normalizedKinerja;
} else {
  selectedRows = [
    ...normalizedBerita,
    ...normalizedArtikel,
    ...normalizedInovasi,
    ...normalizedKonten,
    ...normalizedLayanan,
    ...normalizedCarousel,
    ...normalizedKinerja,
  ];
}

/* =========================================================
   MAIN STATISTICS
========================================================= */

const totalData = selectedRows.length;

const activeData = selectedRows.filter((item) =>
  getActive(item)
).length;

const inactiveData =
  totalData - activeData;

const activePercent =
  totalData > 0
    ? Math.round(
        (activeData / totalData) * 100
      )
    : 0;

const inactivePercent =
  totalData > 0
    ? Math.round(
        (inactiveData / totalData) * 100
      )
    : 0;

/* =========================================================
   SOURCE DISTRIBUTION
========================================================= */

const sourceMap = {};

for (const item of selectedRows) {
  const source = getSourceLabel(item);

  sourceMap[source] =
    (sourceMap[source] || 0) + 1;
}

const sourceDistribution =
  Object.entries(sourceMap)
    .map(([name, count]) => ({
      name,
      count,
      percent:
        totalData > 0
          ? Math.round(
              (count / totalData) * 100
            )
          : 0,
    }))
    .sort(
      (a, b) => b.count - a.count
    );

/* =========================================================
   CATEGORY
========================================================= */

const categoryMap = {};

for (const item of postRows) {
  const kategori =
    item.kategori || "Tanpa Kategori";

  categoryMap[kategori] =
    (categoryMap[kategori] || 0) + 1;
}

const categoryDistribution =
  Object.entries(categoryMap)
    .map(([name, count]) => ({
      name,
      count,
    }))
    .sort(
      (a, b) => b.count - a.count
    )
    .slice(0, 8);

/* =========================================================
   MONTHLY
========================================================= */

const tahunSekarang =
  sekarang.getFullYear();

const monthlyStats = Array.from(
  { length: 12 },
  (_, index) => ({
    month: index,
    name: new Date(
      tahunSekarang,
      index,
      1
    ).toLocaleDateString("id-ID", {
      month: "short",
    }),
    count: 0,
  })
);

for (const item of selectedRows) {
  const tanggal = getDate(item);

  if (!tanggal) continue;

  if (
    tanggal.getFullYear() !==
    tahunSekarang
  ) {
    continue;
  }

  monthlyStats[tanggal.getMonth()].count++;
}

const maxMonthly = Math.max(
  ...monthlyStats.map(
    (item) => item.count
  ),
  1
);

/* =========================================================
   SIX MONTH
========================================================= */

const sixMonthStats = [];

for (let i = 5; i >= 0; i--) {
  const date = new Date(
    tahunSekarang,
    sekarang.getMonth() - i,
    1
  );

  const year = date.getFullYear();
  const month = date.getMonth();

  let count = 0;

  for (const item of selectedRows) {
    const tanggal = getDate(item);

    if (!tanggal) continue;

    if (
      tanggal.getFullYear() === year &&
      tanggal.getMonth() === month
    ) {
      count++;
    }
  }

  sixMonthStats.push({
    name: date.toLocaleDateString(
      "id-ID",
      {
        month: "short",
      }
    ),
    count,
  });
}

const maxSixMonth = Math.max(
  ...sixMonthStats.map(
    (item) => item.count
  ),
  1
);

/* =========================================================
   RECENT
========================================================= */

const recentRows = [...selectedRows]
  .sort((a, b) => {
    const dateA =
      getDate(a)?.getTime() || 0;

    const dateB =
      getDate(b)?.getTime() || 0;

    return dateB - dateA;
  })
  .slice(0, 8);

/* =========================================================
   FILTER INFO
========================================================= */

const filterInfo = {
  all: {
    title: "Semua Data",
    subtitle:
      "Seluruh data yang tersedia di sistem",
    icon: "▦",
  },

  berita: {
    title: "Berita",
    subtitle:
      "Berita yang dipublikasikan",
    icon: "📰",
  },

  artikel: {
    title: "Artikel",
    subtitle:
      "Artikel informasi",
    icon: "📄",
  },

  inovasi: {
    title: "Inovasi",
    subtitle:
      "Inovasi layanan",
    icon: "💡",
  },

  konten: {
    title: "Konten",
    subtitle:
      "Konten website",
    icon: "🗂️",
  },

  layanan: {
    title: "Tempat Layanan",
    subtitle:
      "Lokasi pelayanan",
    icon: "🏢",
  },

  carousel: {
    title: "Carousel",
    subtitle:
      "Banner halaman utama",
    icon: "🖼️",
  },

  kinerja: {
    title: "Kinerja Investasi",
    subtitle:
      "Data kinerja investasi",
    icon: "📊",
  },
};

const currentFilter =
  filterInfo[type] ||
  filterInfo.all;
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>
      Dashboard Admin - DPMPTSP Surabaya
    </title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body>

    <div class="admin-layout">

      <Sidebar />

      <main class="main-content">

        <Navbar />

        <div class="dashboard-container">

          <!-- =================================================
               HEADER
          ================================================== -->

          <section class="dashboard-header">

            <div>

              <div class="breadcrumb">

                <span>Admin</span>

                <i class="fa-solid fa-chevron-right"></i>

                <strong>Dashboard</strong>

              </div>

              <h1>
                Dashboard
                <span>DPMPTSP</span>
              </h1>

              <p>
                Pantau dan kelola seluruh data
                website DPMPTSP Kota Surabaya.
              </p>

            </div>

            <div class="header-date">

              <div class="date-icon">
                <i class="fa-regular fa-calendar"></i>
              </div>

              <div>

                <small>Hari ini</small>

                <strong>
                  {
                    sekarang.toLocaleDateString(
                      "id-ID",
                      {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                      }
                    )
                  }
                </strong>

              </div>

            </div>

          </section>

          <!-- =================================================
               FILTER
          ================================================== -->

          <section class="filter-section">

            <div class="filter-title">

              <span class="filter-icon">
                <i class="fa-solid fa-filter"></i>
              </span>

              <div>

                <strong>Filter Data</strong>

                <small>
                  Pilih jenis data dashboard
                </small>

              </div>

            </div>

            <div class="filter-list">

              {
                Object.entries(filterInfo).map(
                  ([key, item]) => (
                    <a
                      href={`/admin/dashboard?type=${key}`}
                      class:list={[
                        "filter-btn",
                        {
                          active:
                            type === key,
                        },
                      ]}
                    >

                      <span>
                        {item.icon}
                      </span>

                      {item.title}

                    </a>
                  )
                )
              }

            </div>

          </section>

          <!-- =================================================
               CURRENT FILTER
          ================================================== -->

          <section class="current-filter">

            <div class="current-filter-icon">
              {currentFilter.icon}
            </div>

            <div class="current-filter-info">

              <span>MENAMPILKAN</span>

              <strong>
                {currentFilter.title}
              </strong>

              <small>
                {currentFilter.subtitle}
              </small>

            </div>

            <div class="current-filter-total">

              <strong>
                {totalData}
              </strong>

              <span>Data</span>

            </div>

          </section>

          <!-- =================================================
               MAIN CARDS
          ================================================== -->

          <section class="cards">

            <div class="stat-card blue">

              <div class="stat-card-top">

                <div class="stat-icon">
                  <i class="fa-solid fa-database"></i>
                </div>

                <span class="stat-label">
                  Total Data
                </span>

              </div>

              <strong class="stat-number">
                {totalData}
              </strong>

              <div class="stat-bottom">
                Seluruh data pada tab ini
              </div>

            </div>

            <div class="stat-card green">

              <div class="stat-card-top">

                <div class="stat-icon">
                  <i class="fa-solid fa-circle-check"></i>
                </div>

                <span class="stat-label">
                  Data Aktif
                </span>

              </div>

              <strong class="stat-number">
                {activeData}
              </strong>

              <div class="stat-bottom">
                {activePercent}% dari total
              </div>

            </div>

            <div class="stat-card orange">

              <div class="stat-card-top">

                <div class="stat-icon">
                  <i class="fa-solid fa-clock"></i>
                </div>

                <span class="stat-label">
                  Tidak Aktif
                </span>

              </div>

              <strong class="stat-number">
                {inactiveData}
              </strong>

              <div class="stat-bottom">
                {inactivePercent}% dari total
              </div>

            </div>

            <div class="stat-card purple">

              <div class="stat-card-top">

                <div class="stat-icon">
                  <i class="fa-solid fa-chart-pie"></i>
                </div>

                <span class="stat-label">
                  Sumber Data
                </span>

              </div>

              <strong class="stat-number">
                {sourceDistribution.length}
              </strong>

              <div class="stat-bottom">
                Jenis data
              </div>

            </div>

          </section>

          <!-- =================================================
               BERITA
               HANYA MUNCUL SAAT TAB BERITA
          ================================================== -->

          {
            type === "berita" && (
              <section class="content-section">

                <div class="section-heading">

                  <div class="section-heading-left">

                    <div class="section-icon news">
                      <i class="fa-solid fa-newspaper"></i>
                    </div>

                    <div>

                      <h2>
                        Statistik Berita
                      </h2>

                      <p>
                        Ringkasan publikasi berita website.
                      </p>

                    </div>

                  </div>

                  <a
                    href="/admin/artikel"
                    class="section-link"
                  >
                    Kelola Berita

                    <i class="fa-solid fa-arrow-right"></i>
                  </a>

                </div>

                <div class="news-grid news-grid-3">

                  <div class="news-stat-card news-blue">

                    <div class="news-stat-icon">
                      <i class="fa-solid fa-newspaper"></i>
                    </div>

                    <div class="news-stat-content">

                      <span>Total Berita</span>

                      <strong>
                        {beritaRows.length}
                      </strong>

                      <small>
                        Semua berita
                      </small>

                    </div>

                  </div>

                  <div class="news-stat-card news-green">

                    <div class="news-stat-icon">
                      <i class="fa-solid fa-bolt"></i>
                    </div>

                    <div class="news-stat-content">

                      <span>Berita Baru</span>

                      <strong>
                        {beritaBaruRows.length}
                      </strong>

                      <small>
                        30 hari terakhir
                      </small>

                    </div>

                  </div>

                  <div class="news-stat-card news-orange">

                    <div class="news-stat-icon">
                      <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>

                    <div class="news-stat-content">

                      <span>Berita Lama</span>

                      <strong>
                        {beritaLamaRows.length}
                      </strong>

                      <small>
                        Lebih dari 30 hari
                      </small>

                    </div>

                  </div>

                </div>

              </section>
            )
          }

          <!-- =================================================
               ARTIKEL
               HANYA MUNCUL SAAT TAB ARTIKEL
          ================================================== -->

          {
            type === "artikel" && (
              <section class="content-section">

                <div class="section-heading">

