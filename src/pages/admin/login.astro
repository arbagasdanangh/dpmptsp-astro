                  xmlns="http://www.w3.org/2000/svg"
                >

                  <path
                    d="M3 3L21 21"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />

                  <path
                    d="M10.6 5.7C11.05 5.57 11.51 5.5 12 5.5C18 5.5 21.5 12 21.5 12C21.5 12 20.25 14.3 18.2 16.2"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />

                  <path
                    d="M6.2 7.8C3.85 9.6 2.5 12 2.5 12C2.5 12 6 18.5 12 18.5C13.15 18.5 14.2 18.3 15.15 17.9"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
