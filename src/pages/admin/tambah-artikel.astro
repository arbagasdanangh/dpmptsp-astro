/* =========================================================
   LINK
========================================================= */

linkButton?.addEventListener(
    "mousedown",
    (event) => {

        event.preventDefault();

    }
);


linkButton?.addEventListener(
    "click",
    () => {

        if (!editor || htmlMode) {
            return;
        }

        editor.focus();

        const selection =
            window.getSelection();

        const hasSelection =
            selection &&
            selection.toString().trim().length > 0;

        if (!hasSelection) {

            alert(
                "Blok teks yang ingin dijadikan link terlebih dahulu."
            );

            return;

        }

        const url =
            window.prompt(
                "Masukkan URL:",
                "https://"
            );

        if (!url) {
            return;
        }

        const cleanUrl =
            url.trim();

        if (!cleanUrl) {
            return;
        }

        executeCommand(
            "createLink",
            cleanUrl
        );

    }
);


/* =========================================================
   EDITOR INPUT
========================================================= */

editor?.addEventListener(
    "input",
    () => {

        if (htmlMode) {
            return;
        }

        updateContent();
        updateWordCount();

        setEditorStatus(
            "Perubahan siap disimpan"
        );

    }
);


/* =========================================================
   KEYBOARD SHORTCUT
========================================================= */

editor?.addEventListener(
    "keydown",
    (event) => {

        if (!event.ctrlKey && !event.metaKey) {
            return;
        }

        const key =
            event.key.toLowerCase();

        /*
         * Ctrl + S
         */

        if (key === "s") {

            event.preventDefault();

            updateContent();

            setEditorStatus(
                "Isi artikel diperbarui"
            );

            return;
        }

        /*
         * Ctrl + B
         * Ctrl + I
         * Ctrl + U
         */

        if (key === "b") {

            event.preventDefault();

            executeCommand("bold");

        }

        if (key === "i") {

            event.preventDefault();

            executeCommand("italic");

        }

        if (key === "u") {

            event.preventDefault();

            executeCommand("underline");

        }

    }
);


/* =========================================================
   HTML SOURCE MODE
========================================================= */

htmlButton?.addEventListener(
    "mousedown",
    (event) => {

        event.preventDefault();

    }
);


htmlButton?.addEventListener(
    "click",
    () => {

        if (!editor || !source) {
            return;
        }


        /* =============================================
           VISUAL -> HTML
        ============================================= */

        if (!htmlMode) {

            source.value =
                editor.innerHTML;


            editor.classList.add(
                "hide"
            );

            source.classList.add(
                "show"
            );

            htmlButton.classList.add(
                "active"
            );

            htmlButton.title =
                "Kembali ke editor visual";

            setEditorStatus(
                "Mode HTML Source"
            );

            htmlMode = true;

            source.focus();

            return;
        }


        /* =============================================
           HTML -> VISUAL
        ============================================= */

        editor.innerHTML =
            source.value;


        source.classList.remove(
            "show"
        );

        editor.classList.remove(
            "hide"
        );

        htmlButton.classList.remove(
            "active"
        );

        htmlButton.title =
            "Mode HTML";

        htmlMode = false;

        updateContent();
        updateWordCount();
        updateToolbar();

        setEditorStatus(
            "Kembali ke editor visual"
        );

        editor.focus();

    }
);


/* =========================================================
   SOURCE INPUT
========================================================= */

source?.addEventListener(
    "input",
    () => {

        if (!htmlMode) {
            return;
        }

        hiddenContent.value =
            source.value;

        setEditorStatus(
