);


/* =========================================================
   SELECTION CHANGE
========================================================= */

document.addEventListener(
    "selectionchange",
    () => {

        if (
            !editor ||
            htmlMode
        ) {
            return;
        }

        if (
            document.activeElement === editor ||
            editor.contains(
                document.activeElement
            )
        ) {

            updateToolbar();

        }

    }
);


/* =========================================================
   TANGGAL HARI INI
========================================================= */

function setToday() {

    if (!dateInput) {
        return;
    }

    const now =
        new Date();

    const year =
        now.getFullYear();

    const month =
        String(
            now.getMonth() + 1
        ).padStart(2, "0");

    const day =
        String(
            now.getDate()
        ).padStart(2, "0");

    dateInput.value =
        `${year}-${month}-${day}`;

}

setToday();


/* =========================================================
   PICTURE PREVIEW
========================================================= */

pictureInput?.addEventListener(
    "change",
    () => {

        const file =
            pictureInput.files?.[0];


        if (!file) {

            resetPicturePreview();

            return;

        }


        const allowedTypes = [
            "image/jpeg",
            "image/jpg",
            "image/png",
            "image/webp"
        ];


        /* =============================================
           VALIDASI TYPE
        ============================================= */

        if (
            !allowedTypes.includes(
                file.type
            )
        ) {

            showPictureError(
                "Format gambar harus JPG, JPEG, PNG, atau WEBP."
            );

            pictureInput.value =
                "";

            return;

        }


        /* =============================================
           VALIDASI SIZE
        ============================================= */

        const maxSize =
            5 * 1024 * 1024;


        if (file.size > maxSize) {

            showPictureError(
                "Ukuran gambar maksimal 5 MB."
            );

            pictureInput.value =
                "";

            return;

        }


        clearPictureError();


        const size =
            (
                file.size /
                (1024 * 1024)
            ).toFixed(2);


        if (pictureInfo) {

            pictureInfo.textContent =
                `File: ${file.name} (${size} MB)`;

        }


        /* =============================================
           PREVIEW
        ============================================= */

        const reader =
            new FileReader();


        reader.onload =
            () => {

                if (!picturePreviewBox) {
                    return;
                }


                picturePreviewBox.innerHTML =
                    "";


                const img =
                    document.createElement(
                        "img"
                    );


                img.className =
                    "picture-preview";

                img.alt =
                    "Preview gambar utama";

                img.src =
                    String(
                        reader.result || ""
                    );


                picturePreviewBox.appendChild(
                    img
                );

            };


        reader.onerror =
            () => {

                showPictureError(
                    "Gambar tidak dapat dibaca."
                );

            };


        reader.readAsDataURL(
            file
        );

    }
);


/* =========================================================
   PICTURE ERROR
========================================================= */

function showPictureError(message) {

    if (!pictureError) {
        return;
    }

    pictureError.textContent =
        message;

    pictureError.classList.add(
        "show"
    );

}


function clearPictureError() {

    if (!pictureError) {
        return;
    }

    pictureError.textContent =
        "";

    pictureError.classList.remove(
        "show"
    );

}


/* =========================================================
   RESET PICTURE
========================================================= */

function resetPicturePreview() {

    clearPictureError();


    if (pictureInfo) {

        pictureInfo.textContent =
            "JPG, JPEG, PNG atau WEBP. Maksimal 5 MB.";

    }


    if (picturePreviewBox) {

        picturePreviewBox.innerHTML = `
            <div class="no-picture">
                Belum ada gambar
            </div>
        `;

    }

}


/* =========================================================
   FORM SUBMIT
========================================================= */

form?.addEventListener(
    "submit",
    (event) => {

        /*
         * Pastikan isi editor masuk
         * ke textarea content.
         */

        if (htmlMode && source) {

            hiddenContent.value =
                source.value;

        } else if (editor) {

            hiddenContent.value =
                editor.innerHTML;

        }


        /*
         * Jangan simpan editor kosong
         * sebagai HTML kosong yang tidak jelas.
         */

        const plainText =
            editor?.innerText
                ?.replace(/\s+/g, " ")
                ?.trim() || "";


        const html =
            hiddenContent?.value
                ?.trim() || "";


        if (
            !plainText &&
            !html
        ) {

            event.preventDefault();

            alert(
                "Isi artikel belum diisi."
            );

            editor?.focus();

            return;

        }


        /*
         * Cegah double submit.
         */

        if (submitButton) {

            submitButton.disabled =
                true;

            submitButton.textContent =
                "Menyimpan...";

        }

    }
);


/* =========================================================
   INITIAL
========================================================= */

updateContent();
updateWordCount();
updateToolbar();
