---
import AdminShell from "../../components/admin/AdminShell.astro";
import { db } from "../../lib/db";
import {
    writeFile,
    mkdir,
    access
} from "node:fs/promises";
import path from "node:path";

export const prerender = false;

let errorMessage = "";

if (Astro.request.method === "POST") {

    try {

        // =====================================================
        // CEK CONTENT TYPE
        // =====================================================

        const contentType =
            Astro.request.headers.get("content-type") || "";

        if (!contentType.includes("multipart/form-data")) {

            throw new Error(
                "Form upload harus menggunakan multipart/form-data."
            );

        }


        // =====================================================
        // AMBIL FORM DATA
        // =====================================================

        const formData =
            await Astro.request.formData();

        const judul =
            formData
                .get("judul")
                ?.toString()
                .trim() || "";

        const file =
            formData.get("file");


        // =====================================================
        // VALIDASI JUDUL
        // =====================================================

        if (!judul) {

            throw new Error(
                "Judul kinerja wajib diisi."
            );

        }


        // =====================================================
        // VALIDASI FILE
        // =====================================================

        if (!(file instanceof File)) {

            throw new Error(
                "Dokumen PDF wajib dipilih."
            );

        }


        if (file.size <= 0) {

            throw new Error(
                "File PDF yang dipilih kosong."
            );

        }


        // Maksimal 50 MB

        if (
            file.size >
            50 * 1024 * 1024
        ) {

            throw new Error(
                "Ukuran file maksimal 50 MB."
            );

        }


        // =====================================================
        // VALIDASI PDF
        // =====================================================

        const extension =
            path
                .extname(file.name)
                .toLowerCase();


        if (
            extension !== ".pdf" &&
            file.type !== "application/pdf"
        ) {

            throw new Error(
                "File harus berformat PDF."
            );

        }


        // =====================================================
        // BUAT NAMA JUDUL YANG AMAN
        // =====================================================

        const safeName =
            judul
                .trim()
                .replace(/[^a-zA-Z0-9]+/g, "-")
                .replace(/^-+|-+$/g, "");


        // =====================================================
        // TANGGAL POSTING
        // TIMEZONE ASIA/JAKARTA
        // =====================================================

        const sekarang =
            new Date();


        const tahun =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    year: "numeric"
                }
            );


        const bulan =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    month: "2-digit"
                }
            );


        const hari =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    day: "2-digit"
                }
            );


        const tanggalPos =
            `${tahun}${bulan}${hari}`;


        // =====================================================
        // NAMA FILE DASAR
        //
        // Contoh:
        // Kinerja-Investasi-TWI-2023-20260906.pdf
        // =====================================================

        let namaFile =
            `${safeName}-${tanggalPos}.pdf`;


        // =====================================================
        // FOLDER PDF
        // =====================================================

        const uploadDir =
            path.join(
                process.cwd(),
                "public",
                "pdf"
            );


        await mkdir(
            uploadDir,
            {
                recursive: true
            }
        );


        // =====================================================
        // CEK NAMA FILE AGAR TIDAK TABRAKAN
        // =====================================================

        let nomor = 1;

        let filePath =
            path.join(
                uploadDir,
                namaFile
            );


        while (true) {

            try {

                await access(filePath);

                nomor++;

                namaFile =
                    `${safeName}-${tanggalPos}-${nomor}.pdf`;

                filePath =
                    path.join(
                        uploadDir,
                        namaFile
                    );

            } catch {

                break;

            }

        }


        // =====================================================
        // SIMPAN FILE
        // =====================================================

        const buffer =
            Buffer.from(
                await file.arrayBuffer()
            );


        await writeFile(
            filePath,
            buffer
        );


        // =====================================================
        // PATH YANG DISIMPAN KE DATABASE
        // =====================================================

        const filePathDatabase =
            `/pdf/${namaFile}`;


        // =====================================================
        // SIMPAN DATABASE
        // =====================================================

        await db.query(
            `
            INSERT INTO twdata
            (
                tw_option,
                file_path
            )
            VALUES (?, ?)
            `,
            [
                judul,
                filePathDatabase
            ]
        );


        // =====================================================
        // REDIRECT
        // =====================================================

        return Astro.redirect(
            "/admin/kinerja?status=success"
        );


    } catch (error) {

        console.error(
            "ERROR TAMBAH KINERJA:",
            error
        );


        if (
            error instanceof Error
        ) {

            errorMessage =
                error.message;

        } else {

            errorMessage =
                "Terjadi kesalahan saat menyimpan kinerja.";

        }

    }

}
---


<AdminShell
    title="Tambah Kinerja Investasi"
    subtitle="Tambahkan dokumen kinerja investasi baru."
>


    <div class="form-box">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="form-header">

            <div>

                <h2>
                    Form Tambah Kinerja
                </h2>

                <p>
                    Tambahkan judul dan dokumen PDF kinerja investasi.
                </p>

            </div>


            <div class="header-icon">
                +
            </div>

        </div>


        <!-- =====================================================
             ERROR
        ====================================================== -->

        {
            errorMessage && (

                <div class="alert">
                    {errorMessage}
                </div>

            )
        }


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form
            method="POST"
            enctype="multipart/form-data"
        >


            <!-- =================================================
                 JUDUL
            ================================================== -->

            <div class="form-group">

                <label for="judul">

                    Judul Kinerja

                    <span>
                        *
                    </span>

                </label>


                <input
                    id="judul"
                    type="text"
                    name="judul"
                    placeholder="Contoh: Kinerja Investasi TWI 2023"
                    required
                    autocomplete="off"
                />

            </div>


            <!-- =================================================
                 FILE
            ================================================== -->

            <div class="form-group">

                <label for="file">

                    Upload Dokumen PDF

                    <span>
                        *
                    </span>

                </label>


                <div class="upload-box">


                    <div class="upload-icon">

                        PDF

                    </div>


                    <div class="upload-content">

                        <strong id="file-name">

                            Pilih dokumen PDF

                        </strong>


                        <small>

                            Format PDF, maksimal 50 MB

                        </small>

                    </div>


                    <input
                        id="file"
                        type="file"
                        name="file"
                        accept="application/pdf,.pdf"
                        required
                    />

                </div>


                <!-- =================================================
                     PREVIEW NAMA FILE
                ================================================== -->

                <div
                    id="filename-preview"
                    class="filename-preview"
                >

                    <span class="preview-label">
                        Nama file:
                    </span>

                    <strong id="generated-name">
                        -
                    </strong>

                </div>


            </div>


            <!-- =================================================
                 BUTTON
            ================================================== -->

            <div class="form-footer">


                <a
                    href="/admin/kinerja"
                    class="btn-cancel"
                >

                    Batal

                </a>


                <button
                    type="submit"
                    class="btn-save"
                >

                    <span>
                        Simpan Kinerja
                    </span>

                </button>


            </div>


        </form>


    </div>


</AdminShell>


<script>

    const judulInput =
        document.getElementById(
            "judul"
        ) as HTMLInputElement | null;


    const fileInput =
        document.getElementById(
            "file"
        ) as HTMLInputElement | null;


    const fileName =
        document.getElementById(
            "file-name"
        );


    const generatedName =
        document.getElementById(
            "generated-name"
        );


    // =========================================================
    // FORMAT JUDUL
    // =========================================================

    function formatJudul(
        value: string
    ) {

        return value
            .trim()
            .replace(
                /[^a-zA-Z0-9]+/g,
                "-"
            )
            .replace(
                /^-+|-+$/g,
                "");

    }


    // =========================================================
    // TANGGAL SEKARANG
    // ASIA/JAKARTA
    // =========================================================

    function getTanggalPos() {

        const sekarang =
            new Date();


        const tahun =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    year: "numeric"
                }
            );


        const bulan =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    month: "2-digit"
                }
            );


        const hari =
            sekarang.toLocaleString(
                "en-US",
                {
                    timeZone: "Asia/Jakarta",
                    day: "2-digit"
                }
            );


        return `${tahun}${bulan}${hari}`;

    }


    // =========================================================
    // UPDATE PREVIEW
    // =========================================================

    function updateFilenamePreview() {

        if (
            !judulInput ||
            !generatedName
        ) {

            return;

        }


        const judul =
            formatJudul(
                judulInput.value
            );


        if (!judul) {

            generatedName.textContent =
                "-";

            return;

        }


        const tanggalPos =
            getTanggalPos();


        generatedName.textContent =
            `${judul}-${tanggalPos}.pdf`;

    }


    // =========================================================
    // FILE DIPILIH
    // =========================================================

    if (
        fileInput &&
        fileName
    ) {

        fileInput.addEventListener(
            "change",
            () => {

                if (
                    fileInput.files &&
                    fileInput.files.length > 0
                ) {

                    fileName.textContent =
                        fileInput.files[0].name;

                } else {

                    fileName.textContent =
                        "Pilih dokumen PDF";

                }

            }
        );

    }


    // =========================================================
    // JUDUL BERUBAH
    // =========================================================

    if (judulInput) {

        judulInput.addEventListener(
            "input",
            updateFilenamePreview
        );

    }


    updateFilenamePreview();

</script>


