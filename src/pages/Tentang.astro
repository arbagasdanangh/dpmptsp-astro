/* =========================================================
   ICON
========================================================= */

function getIcon(
  tags: string | null | undefined,
  index: number = 0
): string {
  if (tags) {
    const key = String(tags)
      .trim()
      .toLowerCase()
      .replace(/\s+/g, "_")
      .replace(/-/g, "_");

    if (ICON_MAP[key]) {
      return ICON_MAP[key];
    }
  }

  return FALLBACK_ICONS[
    index % FALLBACK_ICONS.length
  ];
}

/* =========================================================
   FOTO URL
========================================================= */

function getFotoUrl(
  foto: string | null | undefined
): string {
  if (!foto) return "";

  const value = String(foto).trim();

  if (!value) return "";

  if (
    value.startsWith("http://") ||
    value.startsWith("https://") ||
    value.startsWith("//")
  ) {
    return value;
  }

  return `https://dpm-ptsp.surabaya.go.id/tentangfile/${encodeURI(
    value.replace(/^\/+/, "")
  )}`;
}

/* =========================================================
   MULTI FOTO
========================================================= */

function getMultiFotoUrls(
  fotos: string | null | undefined
): string[] {
  if (!fotos) return [];

  const value = String(fotos).trim();

  if (!value) return [];

  return [
    ...new Set(
      value
        .split(/[;,\r\n]+/)
        .map((foto) => foto.trim())
        .map((foto) =>
          foto
            .replace(/^["']+|["']+$/g, "")
            .trim()
        )
        .filter(Boolean)

        /* Hanya file gambar */
        .filter((foto) =>
          /\.(jpg|jpeg|png|webp|gif|svg)(\?.*)?$/i.test(
            foto
          )
        )

        .map((foto) => getFotoUrl(foto))
        .filter(Boolean)
    ),
  ];
}

/* =========================================================
   BULAN
========================================================= */

const namaBulan: Record<string, string> = {
  "01": "Januari",
  "02": "Februari",
  "03": "Maret",
  "04": "April",
  "05": "Mei",
  "06": "Juni",
  "07": "Juli",
  "08": "Agustus",
  "09": "September",
  "10": "Oktober",
  "11": "November",
  "12": "Desember",
};

/* =========================================================
   PARSE TANGGAL IKM
========================================================= */

function parseIKMDate(
  foto: string | null | undefined
) {
  const value = String(foto || "");

  const isFinal = /final/i.test(value);

  const yearMatch = value.match(/(\d{4})/);

  if (!yearMatch) {
    return {
      tahun: "Lainnya",
      bulan: "00",
      bulanNama: "Tidak diketahui",
      isFinal: false,
    };
  }

  const tahun = yearMatch[1];

  if (isFinal) {
    return {
      tahun,
      bulan: "13",
      bulanNama: "Laporan Final",
      isFinal: true,
    };
  }

  const monthMatch = value.match(
    /\d{4}-(\d{2})(?:-\d{2})?/
  );

  if (!monthMatch) {
    return {
      tahun,
      bulan: "00",
      bulanNama: "Tidak diketahui",
      isFinal: false,
    };
  }

  const bulan = monthMatch[1];

  return {
    tahun,
    bulan,
    bulanNama: namaBulan[bulan] || bulan,
    isFinal: false,
  };
}

/* =========================================================
   DATA IKM
========================================================= */

const ALLOWED_IKM_YEARS = [
  "2024",
  "2025",
  "2026",
];

const ikmData = ikmRows
  .map((row: any) => {
    const parsed = parseIKMDate(
      row.Foto_Konten
    );

    return {
      ...row,

      ikmTahun: parsed.tahun,
      ikmBulan: parsed.bulan,
      ikmBulanNama: parsed.bulanNama,
      ikmIsFinal: parsed.isFinal,

      ikmFoto: getFotoUrl(
        row.Foto_Konten
      ),
    };
  })
  .filter(
    (item: any) =>
      ALLOWED_IKM_YEARS.includes(
        item.ikmTahun
      ) &&
      item.ikmBulan !== "00"
  )
  .sort((a: any, b: any) => {
    if (
      a.ikmTahun !== b.ikmTahun
    ) {
      return (
        Number(b.ikmTahun) -
        Number(a.ikmTahun)
      );
    }

    return (
      Number(b.ikmBulan) -
      Number(a.ikmBulan)
    );
  });

const ikmYears = [
  ...new Set(
    ikmData.map(
      (item: any) =>
        item.ikmTahun
    )
  ),
].sort(
  (a: string, b: string) =>
    Number(b) - Number(a)
);

const ikmFirst = ikmData[0];

