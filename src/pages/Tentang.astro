<script>
  document.addEventListener("DOMContentLoaded", () => {

    /* ===================================================
       TAB INFORMASI
    =================================================== */

    const tabButtons =
      document.querySelectorAll(".tab-btn");

    const tabContents =
      document.querySelectorAll(".tab-content");


    function activateTab(button) {

      const targetId =
        button.getAttribute("data-tab");

      if (!targetId) return;


      tabButtons.forEach((btn) => {

        btn.classList.remove(
          "bg-blue-600",
          "text-white",
          "shadow-lg"
        );

        btn.classList.add(
          "bg-gray-100",
          "text-gray-700"
        );

        btn.setAttribute(
          "aria-selected",
          "false"
        );


        const icon =
          btn.querySelector(".tab-icon");

        if (icon) {

          icon.classList.remove(
            "bg-white",
            "text-blue-600",
            "shadow"
          );

          icon.classList.add(
            "bg-blue-100",
            "text-blue-600"
          );

        }

      });


      tabContents.forEach((content) => {

        content.classList.add("hidden");
        content.classList.remove("block");

      });


      button.classList.remove(
        "bg-gray-100",
        "text-gray-700"
      );

      button.classList.add(
        "bg-blue-600",
        "text-white",
        "shadow-lg"
      );

      button.setAttribute(
        "aria-selected",
        "true"
      );


      const activeIcon =
        button.querySelector(".tab-icon");

      if (activeIcon) {

        activeIcon.classList.remove(
          "bg-blue-100",
          "text-blue-600"
        );

        activeIcon.classList.add(
          "bg-white",
          "text-blue-600",
          "shadow"
        );

      }


      const target =
        document.getElementById(targetId);

      if (target) {

        target.classList.remove("hidden");
        target.classList.add("block");

        requestAnimationFrame(() => {

          target.classList.remove(
            "tab-content-enter"
          );

          void target.offsetWidth;

          target.classList.add(
            "tab-content-enter"
          );

        });

      }

    }


    tabButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {
          activateTab(button);
        }
      );

    });


    /* ===================================================
       IKM TAHUN
    =================================================== */

    const ikmYearSelect =
      document.getElementById("ikm-year");

    const ikmYearGroups =
      document.querySelectorAll(".ikm-year-group");


    ikmYearSelect?.addEventListener(
      "change",
      () => {

        const selectedYear =
          ikmYearSelect.value;


        ikmYearGroups.forEach((group) => {

          const year =
            group.getAttribute(
              "data-year-group"
            );


          if (year === selectedYear) {

            group.classList.remove("hidden");
            group.classList.add("block");

          } else {

            group.classList.add("hidden");
            group.classList.remove("block");

          }

        });

      }
    );


    /* ===================================================
       IKM BULAN
    =================================================== */

    const ikmMonthButtons =
      document.querySelectorAll(
        ".ikm-month-btn"
      );


    ikmMonthButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const year =
            button.getAttribute("data-year");

          const month =
            button.getAttribute("data-month");


          document
            .querySelectorAll(
              `.ikm-month-btn[data-year="${year}"]`
            )
            .forEach((btn) => {

              btn.classList.remove(
                "bg-blue-600",
                "text-white",
                "border-blue-600",
                "shadow-lg"
              );

              btn.classList.add(
                "bg-white",
                "text-blue-700",
                "border-blue-100"
              );

              btn.setAttribute(
                "aria-selected",
                "false"
              );

            });


          button.classList.remove(
            "bg-white",
            "text-blue-700",
            "border-blue-100"
          );

          button.classList.add(
            "bg-blue-600",
            "text-white",
            "border-blue-600",
            "shadow-lg"
          );

          button.setAttribute(
            "aria-selected",
            "true"
          );


          document
            .querySelectorAll(
              `.ikm-image-panel[data-year-panel="${year}"]`
            )
            .forEach((panel) => {

              const panelMonth =
                panel.getAttribute(
                  "data-month-panel"
                );


              if (panelMonth === month) {

                panel.classList.remove("hidden");
                panel.classList.add("block");

              } else {

                panel.classList.add("hidden");
                panel.classList.remove("block");

              }

            });

        }
      );

    });


    /* ===================================================
       FAQ ACCORDION
    =================================================== */

    const accordionButtons =
      document.querySelectorAll(
        ".accordion-button"
      );


    accordionButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const targetId =
            button.getAttribute(
              "data-target"
            );

          if (!targetId) return;


          const target =
            document.getElementById(
              targetId
            );

          if (!target) return;


          const icon =
            button.querySelector(
              "i.fa-chevron-down"
            );


          const isOpen =
            !target.classList.contains(
              "hidden"
            );


          document
            .querySelectorAll(
              ".accordion-content"
            )
            .forEach((content) => {

              content.classList.add(
                "hidden"
              );

            });


          document
            .querySelectorAll(
              ".accordion-button"
            )
            .forEach((item) => {

              item.setAttribute(
                "aria-expanded",
                "false"
              );

            });


          document
            .querySelectorAll(
              ".accordion-button i.fa-chevron-down"
            )
            .forEach((item) => {

              item.classList.remove(
                "rotate-180"
              );

            });


          if (!isOpen) {

            target.classList.remove(
              "hidden"
            );

            button.setAttribute(
              "aria-expanded",
              "true"
            );

            if (icon) {

              icon.classList.add(
                "rotate-180"
              );

            }

          }

        }
      );

    });


    /* ===================================================
       IMAGE ZOOM
    =================================================== */

    const zoomModal =
      document.getElementById(
        "imageZoomModal"
      );

    const zoomTarget =
      document.getElementById(
        "imageZoomTarget"
      );

    const zoomClose =
      document.getElementById(
        "imageZoomClose"
      );

    const zoomBackdrop =
      document.getElementById(
        "imageZoomBackdrop"
      );

    const zoomButtons =
      document.querySelectorAll(
        ".image-zoom-btn"
      );


    const closeZoom = () => {

      if (!zoomModal || !zoomTarget) {
        return;
      }


      zoomModal.classList.add(
        "hidden"
      );

      zoomModal.classList.remove(
        "flex"
      );

      zoomModal.setAttribute(
        "aria-hidden",
        "true"
      );


      zoomTarget.src = "";
      zoomTarget.alt = "";


      document.body.classList.remove(
        "overflow-hidden"
      );

    };


    zoomButtons.forEach((button) => {

      button.addEventListener(
        "click",
        () => {

          const imageUrl =
            button.getAttribute(
              "data-image"
            );

          const title =
            button.getAttribute(
              "data-title"
            ) || "";


          if (
            !imageUrl ||
            !zoomModal ||
            !zoomTarget
          ) {
            return;
          }


          zoomTarget.src =
            imageUrl;

          zoomTarget.alt =
            title;


          zoomModal.classList.remove(
            "hidden"
          );

          zoomModal.classList.add(
            "flex"
          );

          zoomModal.setAttribute(
            "aria-hidden",
            "false"
          );


          document.body.classList.add(
            "overflow-hidden"
          );

        }
      );

    });


    zoomClose?.addEventListener(
      "click",
      closeZoom
    );


    zoomBackdrop?.addEventListener(
      "click",
      closeZoom
    );


    document.addEventListener(
      "keydown",
      (event) => {

        if (
          event.key === "Escape" &&
          zoomModal &&
          !zoomModal.classList.contains(
            "hidden"
          )
        ) {

          closeZoom();

        }

      }
    );


    /* ===================================================
       MAIN SLIDESHOW
    =================================================== */

    const slides =
      document.querySelectorAll(
        ".main-slide"
      );

    const floatingThumbs =
      document.querySelectorAll(
        ".floating-thumb"
      );


    let currentSlide = 0;

    let slideTimer = null;


    const showSlide = (index) => {

      if (!slides.length) {
        return;
      }


      if (index >= slides.length) {
        index = 0;
      }


      if (index < 0) {
        index = slides.length - 1;
      }


      slides.forEach((slide, i) => {

        slide.classList.toggle(
          "opacity-100",
          i === index
        );

        slide.classList.toggle(
          "opacity-0",
          i !== index
        );

      });


      currentSlide = index;

    };


    const nextSlide = () => {

      showSlide(
        currentSlide + 1
      );

    };


    const restartSlider = () => {

      if (slideTimer) {

        window.clearInterval(
          slideTimer
        );

      }


      slideTimer =
        window.setInterval(
          nextSlide,
          5000
        );

    };


    if (slides.length > 0) {

      showSlide(0);


      if (slides.length > 1) {
        restartSlider();
      }

    }


    floatingThumbs.forEach((thumb) => {

      thumb.addEventListener(
        "click",
        () => {

          const index =
            Number(
              thumb.getAttribute(
                "data-slide-index"
              )
            );


          if (
            Number.isNaN(index) ||
            index < 0 ||
            index >= slides.length
          ) {
            return;
          }


          showSlide(index);

          restartSlider();

        }
      );

    });


    window.addEventListener(
      "beforeunload",
      () => {

        if (slideTimer) {

          window.clearInterval(
            slideTimer
          );

        }

      }
    );

  });
</script>


<!-- =========================================================
     SCRIPT KHUSUS GAMBAR-SEC
     5 FOTO = 1 UTAMA + 4 THUMBNAIL
     TIDAK ADA FOTO DOBEL
========================================================= -->

<script is:inline>
  (() => {

    const section = document.getElementById("gambar-sec");

    if (!section) return;

    const slides = Array.from(
      section.querySelectorAll(".gambar-main-slide")
    );

    const thumbs = Array.from(
      section.querySelectorAll(".gambar-floating-thumb")
    );

    const total = slides.length;

    if (!total) return;

    let currentIndex = 0;


    /* =======================================================
       DATA FOTO DARI HTML
    ======================================================= */

    const images = slides.map((slide) => {

      const img = slide.querySelector("img");

      return {
        src: img?.getAttribute("src") || "",
        alt: img?.getAttribute("alt") || "Tentang DPMPTSP",
      };

    });


    /* =======================================================
       TAMPILKAN SLIDE UTAMA
    ======================================================= */

    function showMain(index) {

      if (total === 0) return;

      currentIndex =
        ((index % total) + total) % total;

      slides.forEach((slide, i) => {

        slide.classList.toggle(
          "opacity-100",
          i === currentIndex
        );

        slide.classList.toggle(
          "opacity-0",
          i !== currentIndex
        );

      });

      updateThumbs();

    }


    /* =======================================================
       UPDATE 4 THUMBNAIL
       
       PENTING:
       FOTO YANG SEDANG JADI FOTO UTAMA
       TIDAK AKAN MUNCUL DI THUMBNAIL.
       
       Jadi:
       5 foto DB
       =
       1 foto utama
       +
       4 foto berbeda
    ======================================================= */

    function updateThumbs() {

      if (total <= 1) return;

      const otherIndexes = [];

      for (let i = 1; i < total; i++) {

        otherIndexes.push(
          (currentIndex + i) % total
        );

      }


      thumbs.forEach((button, slot) => {

        const img =
          button.querySelector(".gambar-thumb-image");

        const imageIndex =
          otherIndexes[slot];

        if (
          imageIndex === undefined ||
          !images[imageIndex]
        ) {

          button.style.display = "none";

          return;

        }

        button.style.display = "";

        button.dataset.slideIndex =
          String(imageIndex);

        if (img) {

          img.src =
            images[imageIndex].src;

          img.alt =
            images[imageIndex].alt;

        }

        button.setAttribute(
          "aria-label",
          `Tampilkan gambar ${imageIndex + 1}`
        );

      });

    }


    /* =======================================================
       KLIK THUMBNAIL
    ======================================================= */

    thumbs.forEach((button) => {

      button.addEventListener("click", () => {

        const index =
          Number(button.dataset.slideIndex);

        if (
          Number.isInteger(index) &&
          index >= 0 &&
          index < total
        ) {

          showMain(index);

        }

      });

    });


    /* =======================================================
       AUTO SLIDE
    ======================================================= */

    let timer = null;

    function startSlider() {

      if (total <= 1) return;

      clearInterval(timer);

      timer = setInterval(() => {

        showMain(currentIndex + 1);

      }, 5000);

    }


    /* =======================================================
       STOP AUTO SLIDE SAAT MOUSE DI ATAS GALLERY
    ======================================================= */

    const gallery =
      section.querySelector(
        "#gambar-gallery-area"
      );

    if (gallery) {

      gallery.addEventListener(
        "mouseenter",
        () => {
          clearInterval(timer);
        }
      );

      gallery.addEventListener(
        "mouseleave",
        () => {
          startSlider();
        }
      );

    }


    /* =======================================================
       INIT
    ======================================================= */

    showMain(0);

    startSlider();

  })();
</script>


