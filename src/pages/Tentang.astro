---
import MainLayout from "../layouts/MainLayout.astro";
//import { db } from "../lib/db.js";
import "../styles/global.css";

const {
  title = "DPMPTSP Kota Surabaya",
  description =
    "Dinas Penanaman Modal dan Pelayanan Terpadu Satu Pintu Kota Surabaya",
} = Astro.props;

/* =========================================================
   DATA TENTANG
========================================================= */

let tentangdp: any[] = [];
let allTabs: any[] = [];
let tabs: any[] = [];
let ikmRows: any[] = [];
let dbError = false;

/* =========================================================
   TENTANG DPMPTSP
========================================================= */

/* =========================================================
   DATA ABOUT TENTANG DARI JSON API
   API:
   https://dpm-ptsp.surabaya.go.id/sso/apiabouttentang.php
========================================================= */

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiabouttentang.php",
    {
      method: "POST",
      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json",
      },
    }
  );

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API About Tentang HTTP ${response.status}: ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API About Tentang bukan JSON: ${responseText.substring(0, 500)}`
    );
  }

  const apiData = Array.isArray(payload)
    ? payload
    : Array.isArray(payload?.data)
      ? payload.data
      : Array.isArray(payload?.results)
        ? payload.results
        : [];

  tentangdp = apiData
    .map((item) => ({
      id: Number(item.id) || 0,
      tipe: item.tipe ?? "",
      konten: item.konten ?? "",
      urutan: Number(item.urutan) || 999999,
    }))
    .sort(
      (a, b) =>
        Number(a.urutan || 0) -
        Number(b.urutan || 0)
    );

  console.log(
    "[API ABOUT TENTANG]",
    tentangdp
  );

} catch (error) {
  console.error(
    "API ERROR About Tentang:",
    error
  );

  tentangdp = [];
}

/* =========================================================
   DATA TENTANG KONTEN DARI JSON API
========================================================= */

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apitentangkami.php",
    {
      method: "POST",
      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json"
      }
    }
  );

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API Tentang Kami HTTP ${response.status}: ${responseText}`
    );
  }

  const payload = JSON.parse(responseText);

  const apiData =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];

  allTabs = apiData
    .map((item) => ({
      Id_Konten: Number(item.Id_Konten) || 0,
      Nama_Konten: item.Nama_Konten ?? "",
      Isi_Konten: item.Isi_Konten ?? "",
      Foto_Konten: item.Foto_Konten ?? "",
      Judul_Konten: item.Judul_Konten ?? "",
      Keterangan: item.Keterangan ?? "",
      tags: item.tags ?? ""
    }))
    .sort(
      (a, b) =>
        Number(a.Id_Konten || 0) -
        Number(b.Id_Konten || 0)
    );

  console.log("[API TENTANG KAMI]", allTabs);

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apitentangkami.php",
    {
      method: "POST",
      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json",
      },
    }
  );

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `HTTP ${response.status}: ${responseText}`
    );
  }

  const payload = JSON.parse(responseText);

  const apiData = Array.isArray(payload)
    ? payload
    : Array.isArray(payload?.data)
      ? payload.data
      : Array.isArray(payload?.results)
        ? payload.results
        : [];

  allTabs = apiData
    .map((item) => ({
      Id_Konten: Number(item.Id_Konten) || 0,
      Nama_Konten: item.Nama_Konten ?? "",
      Isi_Konten: item.Isi_Konten ?? "",
      Foto_Konten: item.Foto_Konten ?? "",
      Judul_Konten: item.Judul_Konten ?? "",
      Keterangan: item.Keterangan ?? "",
      tags: item.tags ?? "",
    }))
    .sort(
      (a, b) =>
        Number(a.Id_Konten || 0) -
        Number(b.Id_Konten || 0)
    );

} catch (error) {
  console.error("API ERROR TentangKamisWebV5:", error);
  dbError = true;
}
  /* =======================================================
     IKM
  ======================================================= */

  ikmRows = allTabs.filter((row: any) => {
    const nama = String(row.Nama_Konten || "")
      .trim()
      .toLowerCase();

    const tags = String(row.tags || "")
      .trim()
      .toLowerCase();

    const judul = String(row.Judul_Konten || "")
      .trim()
      .toLowerCase();

    return (
      tags === "ikm" ||
      nama === "ikm" ||
      nama.includes("indeks kepuasan masyarakat") ||
      judul.includes("indeks kepuasan masyarakat")
    );
  });

  /* =======================================================
     FILTER MENU INFORMASI
  ======================================================= */

  const seen = new Set<string>();

  tabs = allTabs.filter((row: any) => {
    const nama = String(row.Nama_Konten || "")
      .trim()
      .toLowerCase();

    const tags = String(row.tags || "")
      .trim()
      .toLowerCase();

    const judul = String(row.Judul_Konten || "")
      .trim()
      .toLowerCase();

    const isi = String(row.Isi_Konten || "")
      .trim()
      .toLowerCase();

    /* =====================================================
       IKM
    ===================================================== */

    const isIKM =
      tags === "ikm" ||
      nama === "ikm" ||
      nama.includes("indeks kepuasan masyarakat") ||
      judul.includes("indeks kepuasan masyarakat");

    if (isIKM) {
      if (seen.has("ikm")) {
        return false;
      }

      seen.add("ikm");

      return true;
    }

    /* =====================================================
       PIAGAM PENGHARGAAN
    ===================================================== */

    const isPiagam =
      nama === "piagam penghargaan";

    if (isPiagam) {
      if (seen.has("piagam penghargaan")) {
        return false;
      }

      seen.add("piagam penghargaan");

      return true;
    }

    /* =====================================================
       STANDAR PELAYANAN
       
       KHUSUS:
       HANYA STANDAR PELAYANAN 2026

       Tahun dibaca dari:
       - Isi_Konten
       - Judul_Konten

       BUKAN Foto_Konten.
    ===================================================== */

    const isStandarPelayanan =
      nama.includes("standar pelayanan") ||
      judul.includes("standar pelayanan") ||
      tags === "standar pelayanan" ||
      tags === "standar_pelayanan" ||
      tags === "standar-pelayanan";

    if (isStandarPelayanan) {
      const isStandar2026 =
        /\b2026\b/.test(isi) ||
        /\b2026\b/.test(judul);

      /*
       * Kalau bukan 2026, jangan tampilkan.
       *
       * Dengan demikian row Standar Pelayanan 2025
       * tidak akan masuk ke tabs.
       */

      if (!isStandar2026) {
        return false;
      }

      /*
       * Hanya satu row Standar Pelayanan 2026.
       */

      if (seen.has("standar_pelayanan")) {
        return false;
      }

      seen.add("standar_pelayanan");

      return true;
    }

    /* =====================================================
       KONTEN LAIN
    ===================================================== */

    if (seen.has(nama)) {
      return false;
    }

    seen.add(nama);

    return true;
  });

  /* =======================================================
     FALLBACK STANDAR PELAYANAN 2026
     
     Kalau karena filter sebelumnya row 2026 belum masuk,
     cari langsung dari seluruh data.
  ======================================================= */

  const standarPelayanan2026 = allTabs.find((row: any) => {
    const nama = String(row.Nama_Konten || "")
      .trim()
      .toLowerCase();

    const judul = String(row.Judul_Konten || "")
      .trim()
      .toLowerCase();

    const isi = String(row.Isi_Konten || "")
      .trim()
      .toLowerCase();

    const isStandarPelayanan =
      nama.includes("standar pelayanan") ||
      judul.includes("standar pelayanan");

    return (
      isStandarPelayanan &&
      /\b2026\b/.test(isi)
    );
  });

  /* =======================================================
     MASUKKAN STANDAR PELAYANAN 2026 JIKA BELUM ADA
  ======================================================= */

  if (standarPelayanan2026) {
    const sudahAdaStandar = tabs.some((row: any) => {
      const nama = String(row.Nama_Konten || "")
        .trim()
        .toLowerCase();

      const judul = String(row.Judul_Konten || "")
        .trim()
        .toLowerCase();

      return (
        nama.includes("standar pelayanan") ||
        judul.includes("standar pelayanan")
      );
    });

    if (!sudahAdaStandar) {
      tabs.push(standarPelayanan2026);
    }
  }

} catch (error) {
  console.error("DB ERROR TentangKamisWebV5:", error);
  dbError = true;
}

/* =========================================================
   GALERI PIAGAM PENGHARGAAN
