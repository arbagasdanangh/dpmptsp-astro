---
import MainLayout from "../../layouts/MainLayout.astro";

export const prerender = false;

/* =========================================================
   SLUGIFY
========================================================= */

function slugify(text = "") {
  return String(text)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");
}

/* =========================================================
   URL SLUG
========================================================= */

const { id: slug } = Astro.params;

let berita = [];
let post = null;

/* =========================================================
   API BERITA
========================================================= */

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiberita.php",
    {
      method: "POST",

      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json",
        "Content-Type": "application/x-www-form-urlencoded",
      },

      body: new URLSearchParams({
        awal: "2024-01-01",
        akhir: new Date().toISOString().split("T")[0],
        id_category: "",
        active: "",
        headline: "",
      }).toString(),
    }
  );

  if (!response.ok) {
    throw new Error(`API Error ${response.status}`);
  }

  const text = await response.text();

  console.log("API RESPONSE:", text.substring(0, 500));

  const json = JSON.parse(text);

  /* =======================================================
     AMBIL DATA
  ======================================================= */

  const data = Array.isArray(json)
    ? json
    : Array.isArray(json?.data)
      ? json.data
      : Array.isArray(json?.results)
        ? json.results
        : [];

  /* =======================================================
     NORMALISASI
  ======================================================= */

  berita = data
    .map((item) => ({
      id_post: item.id_post ?? item.id ?? null,

      title:
        item.title ??
        item.judul ??
        "",

      content:
        item.content ??
        item.isi ??
        item.konten ??
        "",

      picture:
        item.picture ??
        item.gambar ??
        item.image ??
        "",

      date:
        item.date ??
        item.tanggal ??
        item.created_at ??
        null,

      time:
        item.time ??
        item.jam ??
        "",

      hits:
        item.hits ??
        item.view ??
        item.views ??
        0,

      category:
        item.category_title ??
        item.category ??
        item.nama_category ??
        "BERITA",

      seotitle:
        item.seotitle ??
        item.slug ??
        "",
    }))
    .filter((item) => item.title);

  /* =======================================================
     CARI BERDASARKAN SLUG
     
     contoh:
     /media/pelayanan-perizinan-berusaha
  ======================================================= */

  post = berita.find((item) => {
    const titleSlug = slugify(item.title);

    const seoSlug = item.seotitle
      ? slugify(item.seotitle)
      : "";

    return (
      titleSlug === slug ||
      seoSlug === slug
    );
  });

  console.log("================================");
  console.log("SLUG URL     :", slug);
  console.log("TOTAL BERITA :", berita.length);
  console.log("POST         :", post);
  console.log("================================");

} catch (error) {
  console.error("ERROR API BERITA:", error);
}


/* =========================================================
   404
========================================================= */

if (!post) {
  return new Response(
    `
      <!DOCTYPE html>
      <html lang="id">
      <head>
        <meta charset="UTF-8">
        <title>Berita Tidak Ditemukan</title>
      </head>
      <body style="
        font-family: Arial, sans-serif;
        text-align: center;
        padding: 80px 20px;
      ">
        <h1>Berita Tidak Ditemukan</h1>
        <p>Berita yang kamu cari tidak tersedia.</p>
        <a href="/berita">← Kembali ke Berita</a>
      </body>
      </html>
    `,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8",
      },
    }
  );
}


/* =========================================================
   HELPER
========================================================= */

function formatDate(value) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleDateString("id-ID", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  });
}


function getImageUrl(value) {
  if (!value) return "";

  const image = String(value).trim();

  if (
    image.startsWith("http://") ||
    image.startsWith("https://")
  ) {
    return image;
  }

  if (image.startsWith("//")) {
    return `https:${image}`;
  }

  return image;
}


/* =========================================================
   DATA
========================================================= */

const tanggal = formatDate(post.date);

const gambar = getImageUrl(post.picture);

const isi =
  post.content ||
  "<p>Isi berita belum tersedia.</p>";

const beritaTerkait = berita
  .filter(
    (item) =>
      String(item.id_post) !==
      String(post.id_post)
  )
  .slice(0, 6);


/* =========================================================
   SHARE URL
========================================================= */

const currentUrl =
  new URL(Astro.request.url).href;

const encodedUrl =
  encodeURIComponent(currentUrl);

const encodedTitle =
  encodeURIComponent(post.title);

