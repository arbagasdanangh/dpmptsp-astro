---
import MainLayout from "../layouts/MainLayout.astro";
import { slugify } from "../utils/slugify";

export const prerender = false;

/* =========================================================
   CONFIG
========================================================= */

const API_URL =
  "https://dpm-ptsp.surabaya.go.id/sso/apiberita.php";

const API_USERNAME =
  import.meta.env.API_BERITA_USERNAME;

const API_PASSWORD =
  import.meta.env.API_BERITA_PASSWORD;

const limit = 12;

const url =
  new URL(Astro.request.url);

const q =
  url.searchParams.get("q") || "";

const type =
  url.searchParams.get("type") || "perizinan";

const lang =
  url.searchParams.get("lang") || "id";

let page =
  parseInt(
    url.searchParams.get("page") || "1",
    10
  );


/* =========================================================
   TANGGAL API
========================================================= */

const awal =
  url.searchParams.get("awal") ||
  "2024-01-01";

const akhir =
  url.searchParams.get("akhir") ||
  "2026-12-31";


/* =========================================================
   DATA
========================================================= */

let allArticles = [];
let apiError = "";


/* =========================================================
   AMBIL DATA API
========================================================= */

try {

  if (!API_USERNAME || !API_PASSWORD) {

    throw new Error(
      "Credential API belum tersedia. Pastikan API_BERITA_USERNAME dan API_BERITA_PASSWORD ada di .env"
    );

  }


  const formData =
    new URLSearchParams();

  formData.append(
    "awal",
    awal
  );

  formData.append(
    "akhir",
    akhir
  );


  const response =
    await fetch(
      API_URL,
      {
        method: "POST",

        headers: {
          username:
            API_USERNAME,

          password:
            API_PASSWORD,

          Accept:
            "application/json",

          "Content-Type":
            "application/x-www-form-urlencoded"
        },

        body:
          formData.toString()
      }
    );


  const responseText =
    await response.text();


  if (!response.ok) {

    throw new Error(
      `HTTP ${response.status}: ${responseText}`
    );

  }


  let payload;

  try {

    payload =
      JSON.parse(
        responseText
      );

  } catch {

    throw new Error(
      "Response API bukan JSON."
    );

  }


  const apiData =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];


  /* =======================================================
     NORMALISASI
  ======================================================= */

  allArticles =
    apiData.map(
      (item) => ({

        id_post:
          Number(
            item.id_post
          ) || 0,

        id_category:
          Number(
            item.id_category
          ) || 0,

        title:
          item.title ??
          item.judul ??
          "",

        content:
          item.content ??
          item.isi ??
          "",

        ref_content:
          item.ref_content ??
          "",

        seotitle:
          item.seotitle ??
          "",

        tag:
          item.tag ??
          "",

        date:
          item.date ??
          item.tanggal ??
          "",

        time:
          item.time ??
          "",

        editor:
          item.editor ??
          "",

        active:
          item.active ??
          "Y",

        headline:
          item.headline ??
          "N",

        picture:
          item.picture ??
          item.foto ??
          "",

        hits:
          Number(
            item.hits
          ) || 0,

        title_en:
          item.title_en ??
          "",

        content_en:
          item.content_en ??
          ""

      })
    );


  /* =======================================================
     HANYA ARTIKEL
     
     CATEGORY:
     2 = Artikel Perizinan
     3 = Penanaman Modal
  ======================================================= */

  allArticles =
    allArticles.filter(
      (item) =>
        [2, 3].includes(
          Number(
            item.id_category
          )
        )
    );


  /* =======================================================
     HANYA AKTIF
  ======================================================= */

  allArticles =
    allArticles.filter(
      (item) =>
        String(
          item.active
        )
          .toUpperCase() === "Y"
    );


  /* =======================================================
     FILTER KATEGORI
  ======================================================= */

  if (
    type === "perizinan"
  ) {

    allArticles =
      allArticles.filter(
        (item) =>
          Number(
            item.id_category
          ) === 2
      );

  }


  if (
    type === "penanaman-modal"
  ) {

    allArticles =
      allArticles.filter(
        (item) =>
          Number(
            item.id_category
          ) === 3
      );

  }


  /* =======================================================
     PENCARIAN
  ======================================================= */

  if (q) {

    const keyword =
      q
        .toLowerCase()
        .trim();


    allArticles =
      allArticles.filter(
        (item) => {

          const fields = [

            item.title,

            item.content,

            item.ref_content,

            item.tag,

            item.title_en,

            item.content_en

          ];


          return fields
            .filter(Boolean)
            .some(
              (value) =>
                String(value)
                  .toLowerCase()
                  .includes(keyword)
            );

        }
      );

  }


  /* =======================================================
     SORT TERBARU
  ======================================================= */

  allArticles.sort(
    (a, b) => {

      const dateA =
        `${a.date || ""} ${a.time || ""}`;

      const dateB =
        `${b.date || ""} ${b.time || ""}`;

      return dateB.localeCompare(
        dateA
      );

    }
  );


} catch (error) {

  console.error(
    "API ARTIKEL ERROR:",
    error
  );

  apiError =
    error instanceof Error
      ? error.message
      : "Gagal mengambil data artikel.";

  allArticles = [];

}


/* =========================================================
   PAGINATION
========================================================= */

const totalItems =
  allArticles.length;

const totalPages =
  Math.ceil(
    totalItems / limit
  ) || 1;


if (page < 1) {

  page = 1;

}

if (page > totalPages) {

  page = totalPages;

}


const offset =
  (page - 1) * limit;


const rows =
  allArticles.slice(
    offset,
    offset + limit
  );


/* =========================================================
   NAMA KATEGORI
========================================================= */

const getCategoryName =
  (categoryId) => {

    if (
      Number(categoryId) === 2
    ) {

      return "Artikel Perizinan";

    }

    if (
      Number(categoryId) === 3
    ) {

      return "Penanaman Modal";

    }

    return "Artikel";

  };


/* =========================================================
   ICON KATEGORI
========================================================= */

const getCategoryIcon =
  (categoryId) => {

    if (
      Number(categoryId) === 2
    ) {

      return "fa-file-circle-check";

    }

    if (
      Number(categoryId) === 3
    ) {

      return "fa-chart-line";

    }

    return "fa-newspaper";

  };


/* =========================================================
   LINK
========================================================= */

const getLink =
  (
    p,
    t = type
  ) => {

    const params =
      new URLSearchParams();

    params.set(
      "page",
      String(p)
    );

    params.set(
      "type",
      t
    );

    params.set(
      "awal",
      awal
    );

    params.set(
      "akhir",
      akhir
    );


    if (q) {

      params.set(
        "q",
        q
      );

    }


    if (lang) {

      params.set(
        "lang",
        lang
      );

    }


    return `?${params.toString()}`;

  };


/* =========================================================
   EXCERPT
========================================================= */

const getExcerpt =
  (content) => {

    if (!content) {

      return "Informasi artikel DPMPTSP Kota Surabaya.";

    }


    return String(content)
      .replace(
        /<[^>]*>/g,
        " "
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim()
      .substring(
        0,
        150
      );

  };


/* =========================================================
   FORMAT TANGGAL
========================================================= */

const formatDate =
  (date) => {

    if (!date) {

      return "";

    }


    const parsed =
      new Date(date);


    if (
      Number.isNaN(
        parsed.getTime()
      )
    ) {

      return date;

    }


    return parsed.toLocaleDateString(
      "id-ID",
      {
        day: "numeric",
        month: "long",
        year: "numeric"
      }
    );

  };
---

<MainLayout
  title="Artikel | DPMPTSP Kota Surabaya"
  description="Artikel perizinan dan penanaman modal DPMPTSP Kota Surabaya."
>

  <!-- =====================================================
       HERO
  ====================================================== -->

  <section class="article-hero">

  <!-- WATERMARK -->
  <div class="article-hero-watermark" aria-hidden="true">
    IKHLAS, CERDAS
    <br />
    &amp; TERDEPAN
  </div>

  <div class="hero-orb orb-one"></div>
  <div class="hero-orb orb-two"></div>

  <div class="container">
    <div class="hero-content">

      <div class="hero-badge">
        <span>
          <i class="fa-solid fa-book-open"></i>
        </span>
        MEDIA INFORMASI
      </div>

      <h1>
        Artikel
        <strong>DPMPTSP Surabaya</strong>
      </h1>

      <p>
        Informasi seputar perizinan, penanaman modal, dan kemudahan
        berusaha di Kota Surabaya.
      </p>

    </div>
  </div>

</section>


  <!-- =====================================================
       FILTER
  ====================================================== -->

  <section class="filter-section">

    <div class="container">

      <div class="filter-box">

        <div class="search-wrapper">

          <i class="fa-solid fa-magnifying-glass"></i>

          <input
            id="searchBox"
            type="text"
            value={q}
            placeholder="Cari artikel..."
          />

        </div>


        <div class="category-tabs">

          <a
            href={getLink(1, "perizinan")}
            class:list={[
              "category-tab",
              {
                active:
                  type === "perizinan"
              }
            ]}
          >

            <i
              class="fa-solid fa-file-circle-check"
            ></i>

            <span>
              Artikel Perizinan
            </span>

          </a>


          <a
            href={getLink(
              1,
              "penanaman-modal"
            )}
            class:list={[
              "category-tab",
              {
                active:
                  type ===
                  "penanaman-modal"
              }
            ]}
          >

            <i
              class="fa-solid fa-chart-line"
            ></i>

            <span>
              Penanaman Modal
            </span>

          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- =====================================================
       CONTENT
  ====================================================== -->

  <main class="article-main">

    <div class="container">


      <!-- HEADER -->

      <div class="content-header">

        <div>

          <span class="section-label">

            {
              type ===
              "penanaman-modal"
                ? "PENANAMAN MODAL"
                : "ARTIKEL PERIZINAN"
            }

          </span>


          <h2>

            {
              type ===
              "penanaman-modal"
                ? "Informasi Penanaman Modal"
                : "Artikel Perizinan"
            }

          </h2>

        </div>


        <div class="total-data">

          <strong>
            {totalItems}
          </strong>

          <span>
            Artikel
          </span>

        </div>

      </div>


      <!-- ERROR -->

      {
        apiError && (

          <div class="error-box">

            <i
              class="fa-solid fa-circle-exclamation"
            ></i>

            <div>

              <strong>
                Data belum dapat dimuat
              </strong>

              <p>
                {apiError}
              </p>

            </div>

          </div>

        )
      }


      <!-- EMPTY -->

      {
        !apiError &&
        rows.length === 0 && (

          <div class="empty-box">

            <div class="empty-icon">

              <i
                class="fa-regular fa-folder-open"
              ></i>

            </div>


            <h3>
              Artikel tidak ditemukan
            </h3>


            <p>
              Belum ada artikel pada kategori
              ini atau kata kunci pencarian
              tidak ditemukan.
            </p>


            <a
              href="/artikel"
              class="reset-button"
            >

              <i
                class="fa-solid fa-rotate-left"
              ></i>

              Reset Pencarian

            </a>

          </div>

        )
      }


      <!-- =================================================
           ARTICLE GRID
      ================================================== -->

      {
        rows.length > 0 && (

          <div class="article-grid">

            {
              rows.map(
                (item) => (

                  <article
                    class="article-card"
                  >

                    <!-- IMAGE -->

                    <a
                      href={`/media/${slugify(item.title)}`}
                      class="article-image"
                    >

                      <img
                        src={
                          item.picture
                            ? `https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}`
                            : "/no-image.jpg"
                        }
                        alt={item.title}
                        loading="lazy"
                      />


                      <div
                        class="image-overlay"
                      ></div>


                      <span
                        class="category-badge"
                      >

                        <i
                          class={`fa-solid ${getCategoryIcon(item.id_category)}`}
                        ></i>

                        {
                          getCategoryName(
                            item.id_category
                          )
                        }

                      </span>

                    </a>


                    <!-- CONTENT -->

                    <div class="article-body">


                      <div class="article-meta">

                        <span>

                          <i
                            class="fa-regular fa-calendar"
                          ></i>

                          {
                            formatDate(
                              item.date
                            )
                          }

                        </span>


                        {
                          item.hits > 0 && (

                            <span>

                              <i
                                class="fa-regular fa-eye"
                              ></i>

                              {item.hits}

                            </span>

                          )
                        }

                      </div>


                      <a
                        href={`/media/${slugify(item.title)}`}
                      >

                        <h3>

                          {
                            lang === "en"
                              ? (
                                item.title_en ||
                                item.title
                              )
                              : item.title
                          }

                        </h3>

                      </a>


                      <p>

                        {
                          getExcerpt(
                            lang === "en"
                              ? (
                                item.content_en ||
                                item.content
                              )
                              : item.content
                          )
                        }

                        ...

                      </p>


                      <div
                        class="article-footer"
                      >

                        <span>

                          Baca Artikel

                        </span>


                        <a
                          href={`/media/${slugify(item.title)}`}
                          aria-label={`Baca ${item.title}`}
                        >

                          <i
                            class="fa-solid fa-arrow-right"
                          ></i>

                        </a>

                      </div>

                    </div>

                  </article>

                )
              )
            }

          </div>

        )
      }


      <!-- =================================================
           PAGINATION
      ================================================== -->

      {
        totalPages > 1 && (

          <nav
            class="pagination"
            aria-label="Pagination"
          >

            <a
              href={
                page > 1
                  ? getLink(page - 1)
                  : "#"
              }
              class:list={[
                "page-button",
                {
                  disabled:
                    page <= 1
                }
              ]}
            >

              <i
                class="fa-solid fa-chevron-left"
              ></i>

            </a>


            <div class="page-numbers">

              {
                Array.from(
                  {
                    length:
                      totalPages
                  },
                  (_, i) =>
                    i + 1
                )
                .filter(
                  (p) =>
                    p === 1 ||
                    p === totalPages ||
                    Math.abs(
                      p - page
                    ) <= 1
                )
                .map(
                  (
                    p,
                    index,
                    array
                  ) => (

                    <Fragment>

                      {
                        index > 0 &&
                        array[
                          index - 1
                        ] !== p - 1 && (

                          <span class="dots">
                            ...
                          </span>

                        )
                      }


                      <a
                        href={getLink(p)}
                        class:list={[
                          "page-number",
                          {
                            active:
                              page === p
                          }
                        ]}
                      >

                        {p}

                      </a>

                    </Fragment>

                  )
                )
              }

            </div>


            <a
              href={
                page <
                totalPages
                  ? getLink(
                      page + 1
                    )
                  : "#"
              }
              class:list={[
                "page-button",
                {
                  disabled:
                    page >=
                    totalPages
                }
              ]}
            >

              <i
                class="fa-solid fa-chevron-right"
              ></i>

            </a>

          </nav>

        )
      }

    </div>

  </main>

</MainLayout>


<!-- =======================================================
     STYLE
======================================================= -->

<style>

