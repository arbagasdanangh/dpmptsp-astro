  margin: 0;
  background: #f8fafc;
  color: #334155;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}


:global(a) {
  text-decoration: none;
}


.container {
  width: min(
    1180px,
    calc(100% - 40px)
  );

  margin-inline: auto;
}


/* =====================================================
   HERO
===================================================== */

.article-hero {
  position: relative;

  overflow: hidden;

  padding:
    78px 0 125px;

  background:
    linear-gradient(
      135deg,
