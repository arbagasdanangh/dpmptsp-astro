  position: relative;
  z-index: 6;

  max-width: 720px;

  margin-top: 28px;

  color: rgba(255, 255, 255, 0.78);

  font-size: 18px;

  line-height: 1.75;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

  .article-hero {
    min-height: 520px;
  }

  .article-hero-watermark {
    top: 58% !important;
    left: 50% !important;

    transform:
      translate(-50%, -50%)
      rotate(-8deg) !important;

    font-size: 62px !important;

    line-height: 0.85;

    color: rgba(255, 255, 255, 0.07) !important;
  }

  .hero-content {
    padding: 70px 20px 100px;
  }

  .article-hero h1 {
    font-size: 52px;

    line-height: 0.95;
  }

  .article-hero p {
    max-width: 100%;

    margin-top: 22px;

    font-size: 15px;

    line-height: 1.65;
  }

  .hero-badge {
    font-size: 10px;

    letter-spacing: 0.12em;
  }

  .hero-badge span {
    width: 34px;
    height: 34px;
  }

  .orb-one {
    width: 280px;
    height: 280px;

