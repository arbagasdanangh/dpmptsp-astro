<!-- =======================================================
     SEARCH SCRIPT
======================================================= -->

<script is:inline>

  const searchBox =
    document.getElementById(
      "searchBox"
    );


  searchBox?.addEventListener(
    "keypress",
    (event) => {

      if (
        event.key !==
        "Enter"
      ) {

        return;

      }


      const value =
        searchBox.value.trim();


      const params =
        new URLSearchParams(
          window.location.search
        );


      if (value) {

        params.set(
          "q",
          value
        );

      } else {

        params.delete(
          "q"
        );

      }


      params.set(
        "page",
        "1"
      );


      window.location.href =
        `/artikel?${params.toString()}`;

    }
  );

</script>