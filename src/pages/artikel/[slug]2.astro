  <!-- =====================================================
       TAB + SEARCH
  ====================================================== -->

  <script>
    const tabs =
      document.querySelectorAll(".tab-btn");

    const items =
      document.querySelectorAll(".related-item");

    const searchInput =
      document.getElementById(
        "search-related"
      );

    let activeType =
      "perizinan";


    function renderList() {

      const keyword =
        searchInput?.value
          .toLowerCase()
          .trim() || "";


      items.forEach((item) => {

        const title =
          item.querySelector("h3")
            ?.innerText
            .toLowerCase() || "";


        const matchType =
          item.dataset.type ===
          activeType;


        const matchText =
          title.includes(keyword);


        item.classList.toggle(
          "hidden",
          !(matchType && matchText)
        );

      });

    }


    function setActive(type) {

      activeType =
        type;


      tabs.forEach((tab) => {

        const active =
          tab.dataset.category ===
          type;


        tab.className =
          "tab-btn flex-1 px-3 py-2 text-xs font-semibold rounded-lg transition " +
          (
            active
              ? "bg-blue-600 text-white shadow"
              : "text-slate-600 hover:text-slate-900"
          );

      });


      renderList();

    }


    setActive("perizinan");


    tabs.forEach((tab) => {

      tab.addEventListener(
        "click",
        () => {

          setActive(
            tab.dataset.category
          );

        }
      );

    });


    searchInput?.addEventListener(
      "input",
      renderList
    );


    /* =====================================================
       COPY LINK
    ====================================================== */

    const copyButton =
      document.getElementById(
        "copy-link"
      );

    const articleLink =
      document.getElementById(
        "article-link"
      );

    const copyMessage =
      document.getElementById(
        "copy-message"
      );


    copyButton?.addEventListener(
      "click",
      async () => {

        try {

          await navigator.clipboard.writeText(
            `${window.location.origin}${articleLink.value}`
          );


          copyMessage?.classList.remove(
            "hidden"
          );


          setTimeout(() => {

            copyMessage?.classList.add(
              "hidden"
            );

          }, 2000);


        } catch (error) {

          console.error(
            "Gagal copy link",
            error
          );

        }

      }
    );

  </script>

</MainLayout>
