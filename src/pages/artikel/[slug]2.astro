export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { slugify } from "../../utils/slugify";

const rawSlug = Astro.params.slug || "";

const slug = decodeURIComponent(rawSlug)
  .toString()
  .toLowerCase()
  .trim();

/* =========================================================
   TANGGAL API
========================================================= */

const awal = "2024-01-01";

const sekarang = new Date();

const akhir =
  `${sekarang.getFullYear()}-` +
  `${String(sekarang.getMonth() + 1).padStart(2, "0")}-` +
  `${String(sekarang.getDate()).padStart(2, "0")}`;


/* =========================================================
   API BERITA / ARTIKEL
========================================================= */

let rows = [];

try {

  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apiberita.php";

  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }

  const form = new URLSearchParams();

  form.append("awal", awal);
  form.append("akhir", akhir);

  const response = await fetch(
    apiUrl,
    {
      method: "POST",

      headers: {
        username,
        password,
        Accept: "application/json",
        "Content-Type":
          "application/x-www-form-urlencoded"
      },

      body: form.toString()
    }
  );

  const responseText =
    await response.text();

  if (!response.ok) {
    throw new Error(
      `API Berita HTTP ${response.status}: ${responseText}`
    );
  }

  let payload;

  try {

    payload =
      JSON.parse(responseText);

  } catch {

    throw new Error(
      `Response API bukan JSON: ${
        responseText.substring(0, 500)
      }`
    );

  }


  /* =====================================================
     AMBIL ARRAY
  ===================================================== */

  let apiData = [];

  if (Array.isArray(payload)) {

    apiData = payload;

  } else if (Array.isArray(payload?.data)) {

    apiData = payload.data;

  } else if (Array.isArray(payload?.results)) {

    apiData = payload.results;

  } else if (Array.isArray(payload?.result)) {

    apiData = payload.result;

  } else if (Array.isArray(payload?.items)) {

    apiData = payload.items;

  } else if (Array.isArray(payload?.rows)) {

    apiData = payload.rows;

  }


  /* =====================================================
     NORMALISASI
  ===================================================== */

  rows =
    apiData

      .map((item) => ({

        id_post:
          Number(
            item?.id_post ??
            item?.id ??
            0
          ),

        id_category:
          Number(
            item?.id_category ??
            0
          ),

        title:
          item?.title ??
          item?.judul ??
          "",

        content:
          item?.content ??
          item?.isi ??
          item?.isi_konten ??
          "",

        ref_content:
          item?.ref_content ??
          "",

        seotitle:
          item?.seotitle ??
          item?.seo_title ??
          "",

        tag:
          item?.tag ??
          "",

        date:
          item?.date ??
          item?.tanggal ??
          "",

        time:
          item?.time ??
          item?.jam ??
          "",

        editor:
          item?.editor ??
          "",

        active:
          item?.active ??
          item?.aktif ??
          "Y",

        headline:
          item?.headline ??
          "N",

        picture:
          item?.picture ??
          item?.gambar ??
          item?.foto ??
          "",

        hits:
          Number(
            item?.hits ??
            0
          ),

        category_title:
          item?.category_title ??
          item?.category ??
          item?.nama_category ??
          "",

        raw:
          item

      }))

      /* =================================================
         HANYA ARTIKEL
         2 = PERIZINAN
         3 = PENANAMAN MODAL
      ================================================= */

      .filter(
        (item) =>
          [2, 3].includes(
            Number(item.id_category)
          )
      )

      /* =================================================
         HANYA AKTIF
      ================================================= */

      .filter(
        (item) =>
          String(item.active)
            .toUpperCase() === "Y"
      );


} catch (error) {

  console.error(
    "[API ARTIKEL ERROR]",
    error
  );

  rows = [];

}


/* =========================================================
   CARI ARTIKEL BERDASARKAN SLUG
========================================================= */

const post =
  rows.find((row) => {

    const rowSlug =
      slugify(
        row.title || ""
      )
        .toLowerCase()
        .trim();

    return rowSlug === slug;

  });


/* =========================================================
   KATEGORI ARTIKEL
========================================================= */

const categoryMap = {
  2: "Artikel Perizinan",
  3: "Artikel Penanaman Modal"
};


/* =========================================================
   NAMA KATEGORI
========================================================= */

const namaKategori =
  post
    ? (
        categoryMap[
          Number(post.id_category)
        ] ||
        "Artikel"
      )
    : "Artikel";


/* =========================================================
   ARTIKEL PERIZINAN
   CATEGORY 2
========================================================= */

const perizinanList =
  [...rows]

    .filter(
      (item) =>
        Number(item.id_category) === 2
    )

    .sort(
      (a, b) => {

        const dateA =
          `${a.date || ""} ${a.time || ""}`;

        const dateB =
          `${b.date || ""} ${b.time || ""}`;

        return dateB.localeCompare(
          dateA
        );

      }
    )

    .slice(0, 5);


/* =========================================================
   ARTIKEL PENANAMAN MODAL
   CATEGORY 3
========================================================= */

const penanamanModalList =
  [...rows]

    .filter(
      (item) =>
        Number(item.id_category) === 3
    )

    .sort(
      (a, b) => {

        const dateA =
          `${a.date || ""} ${a.time || ""}`;

        const dateB =
          `${b.date || ""} ${b.time || ""}`;

        return dateB.localeCompare(
          dateA
        );

      }
    )

    .slice(0, 5);


/* =========================================================
   POST TIDAK DITEMUKAN
========================================================= */

if (!post) {

  console.error(
    "[ARTIKEL TIDAK DITEMUKAN]",
    slug
  );

  throw new Error(
    "Artikel tidak ditemukan"
  );

}


/* =========================================================
   DEBUG
========================================================= */

console.log(
  "[ARTIKEL]",
  {
    id: post.id_post,
    title: post.title,
    category: namaKategori,
    slug
  }
);

