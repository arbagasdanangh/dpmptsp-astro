---
export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { db } from "../../lib/db";
import { slugify } from "../../utils/slugify";


// =========================================================
// PARAMETER SLUG
// =========================================================

const { slug } = Astro.params;

if (!slug) {
    return new Response("Slug artikel tidak ditemukan", {
        status: 404
    });
}


// =========================================================
// NORMALISASI SLUG
// =========================================================

const normalizeSlug = (value = "") => {
    return String(value)
        .trim()
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/&/g, " dan ")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");
};

const requestedSlug = normalizeSlug(slug);


// =========================================================
// AMBIL DATA ARTIKEL
// =========================================================

let rows = [];
let post = null;

try {

    const [result] = await db.query(`
        SELECT
            *
        FROM post
        WHERE id_category IN (2, 3)
        ORDER BY id_post DESC
    `);

    rows = result || [];

} catch (error) {

    console.error("DATABASE ARTIKEL ERROR:", error);

    return new Response("Gagal mengambil data artikel", {
        status: 500
    });
}


// =========================================================
// CARI ARTIKEL BERDASARKAN SLUG
// =========================================================

for (const item of rows) {

    const slugDariSlugify = normalizeSlug(
        slugify(item.title || "")
    );

    const slugDariTitle = normalizeSlug(
        item.title || ""
    );

    if (
        slugDariSlugify === requestedSlug ||
        slugDariTitle === requestedSlug
    ) {
        post = item;
        break;
    }
}


// =========================================================
// ARTIKEL TIDAK DITEMUKAN
// =========================================================

if (!post) {

    console.error("========================================");
    console.error("ARTIKEL TIDAK DITEMUKAN");
    console.error("SLUG URL:", slug);
    console.error("SLUG NORMAL:", requestedSlug);
    console.error("TOTAL DATA:", rows.length);
    console.error("========================================");

    return new Response(
        `Artikel tidak ditemukan

Slug yang dibuka:
${slug}

Slug yang dicari:
${requestedSlug}`,
        {
            status: 404,
            headers: {
                "Content-Type": "text/plain; charset=utf-8"
            }
        }
    );
}


// =========================================================
// DATA ARTIKEL
// =========================================================

const title = post.title || "Artikel";

const content = post.content || "";

const editor =
    post.editor ||
    "DPMPTSP Kota Surabaya";

const hits =
    Number(post.hits || 0);

const categoryId =
    Number(post.id_category);

const categoryName =
    categoryId === 2
        ? "Artikel Perizinan"
        : categoryId === 3
            ? "Penanaman Modal"
            : "Artikel";


// =========================================================
// TANGGAL
// =========================================================

let tanggal = "";

if (post.date) {

    const dateObj = new Date(post.date);

    if (!Number.isNaN(dateObj.getTime())) {

        tanggal = dateObj.toLocaleDateString(
            "id-ID",
            {
                day: "numeric",
                month: "long",
                year: "numeric"
            }
        );

    } else {

        tanggal = String(post.date);

    }
}


// =========================================================
// GAMBAR
// =========================================================

const getPictureUrl = (picture) => {

    if (!picture) return "";

    const value = String(picture).trim();

    if (!value) return "";

    if (
        value.startsWith("http://") ||
        value.startsWith("https://") ||
        value.startsWith("//")
    ) {
        return value;
    }

    return `https://dpm-ptsp.surabaya.go.id/fileberita/${value}`;
};

const pictureUrl = getPictureUrl(post.picture);


// =========================================================
// ARTIKEL TERKAIT
// =========================================================

const relatedArticles = rows
    .filter(
        (item) =>
            Number(item.id_post) !== Number(post.id_post)
    )
    .filter(
        (item) =>
            Number(item.id_category) === categoryId
    )
    .slice(0, 6);


// =========================================================
// URL ARTIKEL
// =========================================================

const canonicalUrl =
    `/artikel/${normalizeSlug(slug)}`;

const fullUrl =
    new URL(canonicalUrl, Astro.site || Astro.url.origin).href;

---


<MainLayout title={title}>

    <div class="min-h-screen bg-[#f7f8fc]">

        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="relative overflow-hidden bg-[#0900C3]">

            <div class="absolute inset-0 opacity-10">
                <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-[#FFD41D]"></div>
                <div class="absolute -bottom-32 -left-24 w-96 h-96 rounded-full bg-white"></div>
            </div>

            <div class="relative max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 py-12 md:py-16">

                <!-- Breadcrumb -->

                <div class="flex flex-wrap items-center gap-2 text-sm text-white/70 mb-7">

                    <a
                        href="/"
                        class="hover:text-[#FFD41D] transition"
                    >
                        Beranda
                    </a>

                    <i class="fas fa-chevron-right text-[10px]"></i>

                    <a
                        href="/artikel"
                        class="hover:text-[#FFD41D] transition"
                    >
                        Artikel
                    </a>

                    <i class="fas fa-chevron-right text-[10px]"></i>

                    <span class="text-white/90">
                        {categoryName}
                    </span>

                </div>


                <!-- Category -->

                <div class="mb-5">

                    <span
                        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#FFD41D] text-[#0900C3] font-bold text-sm shadow-sm"
                    >

                        {categoryId === 2 ? (
                            <i class="fas fa-file-circle-check"></i>
                        ) : (
                            <i class="fas fa-chart-line"></i>
                        )}

                        {categoryName}

                    </span>

                </div>


                <!-- Title -->

                <h1
                    class="max-w-5xl text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight text-white"
                >
                    {title}
                </h1>


                <!-- Meta -->

                <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-7 text-sm text-white/80">

                    {tanggal && (
                        <div class="flex items-center gap-2">

                            <i class="far fa-calendar"></i>

                            <span>
                                {tanggal}
                            </span>

                        </div>
                    )}


                    <div class="flex items-center gap-2">

                        <i class="far fa-user"></i>

                        <span>
                            {editor}
                        </span>

                    </div>


                    <div class="flex items-center gap-2">

                        <i class="far fa-eye"></i>

                        <span>
                            {hits.toLocaleString("id-ID")} views
                        </span>

                    </div>

                </div>

            </div>

        </section>



        <!-- =====================================================
             CONTENT AREA
        ====================================================== -->

        <section class="py-10 md:py-14">

            <div class="max-w-7xl mx-auto px-5 sm:px-6 lg:px-8">

                <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_320px] gap-8 lg:gap-10">


                    <!-- =================================================
                         ARTIKEL UTAMA
                    ================================================== -->

                    <article class="min-w-0">

                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">


                            <!-- GAMBAR UTAMA -->

                            {pictureUrl && (
                                <div class="w-full bg-gray-100">

                                    <img
                                        src={pictureUrl}
                                        alt={title}
                                        class="block w-full max-h-[600px] object-cover"
                                        loading="eager"
                                    />

                                </div>
                            )}


                            <!-- ISI -->

                            <div class="p-6 sm:p-8 md:p-10">

                                <div
                                    class="article-content"
                                    set:html={content}
                                ></div>


                                <!-- =================================================
                                     SHARE
                                ================================================== -->

                                <div class="mt-10 pt-7 border-t border-gray-200">

                                    <div class="flex flex-wrap items-center gap-3">

                                        <span class="font-bold text-gray-700 mr-2">
                                            Bagikan:
                                        </span>


                                        <!-- Facebook -->

                                        <a
                                            id="shareFacebook"
                                            href="#"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Bagikan ke Facebook"
                                            class="share-button bg-[#1877F2] text-white"
                                        >
                                            <i class="fab fa-facebook-f"></i>
                                        </a>


                                        <!-- WhatsApp -->

                                        <a
                                            id="shareWhatsApp"
                                            href="#"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Bagikan ke WhatsApp"
                                            class="share-button bg-[#25D366] text-white"
                                        >
                                            <i class="fab fa-whatsapp"></i>
                                        </a>


                                        <!-- Copy -->

                                        <button
                                            id="copyLink"
                                            type="button"
                                            aria-label="Salin link"
                                            class="share-button bg-gray-100 text-gray-700 hover:bg-gray-200"
                                        >
                                            <i class="fas fa-link"></i>
                                        </button>


                                        <span
                                            id="copyMessage"
                                            class="hidden text-sm font-semibold text-green-600"
                                        >
                                            Link berhasil disalin
                                        </span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             BACK BUTTON
                        ================================================== -->

                        <div class="mt-7">

                            <a
                                href="/artikel"
                                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#0900C3] text-white font-semibold hover:bg-blue-800 transition shadow-sm"
                            >

                                <i class="fas fa-arrow-left"></i>

                                Kembali ke Artikel

                            </a>

                        </div>

                    </article>



                    <!-- =================================================
                         SIDEBAR
                    ================================================== -->

                    <aside class="lg:sticky lg:top-24 h-fit space-y-5">


                        <!-- MENU ARTIKEL -->

                        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

                            <div class="px-5 py-4 border-b border-gray-100">

                                <h2 class="font-bold text-lg text-gray-900">
                                    Artikel
                                </h2>

                            </div>


                            <div class="p-3">

                                <a
                                    href="/artikel"
                                    class="sidebar-link"
                                >

                                    <span class="sidebar-icon">
                                        <i class="fas fa-layer-group"></i>
                                    </span>

                                    <span>
                                        Semua Artikel
                                    </span>

                                </a>


                                <a
                                    href="/artikel?type=perizinan"
                                    class:list={[
                                        "sidebar-link",
                                        categoryId === 2 && "sidebar-active"
                                    ]}
                                >

                                    <span class="sidebar-icon">
                                        <i class="fas fa-file-circle-check"></i>
                                    </span>

                                    <span>
                                        Artikel Perizinan
                                    </span>

                                </a>


                                <a
                                    href="/artikel?type=penanaman-modal"
                                    class:list={[
                                        "sidebar-link",
                                        categoryId === 3 && "sidebar-active"
                                    ]}
                                >

                                    <span class="sidebar-icon">
                                        <i class="fas fa-chart-line"></i>
                                    </span>

                                    <span>
                                        Penanaman Modal
                                    </span>

                                </a>

                            </div>

                        </div>



                        <!-- =================================================
                             RELATED
                        ================================================== -->

                        {relatedArticles.length > 0 && (

                            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">

                                <div class="px-5 py-4 border-b border-gray-100">

                                    <h2 class="font-bold text-lg text-gray-900">
                                        Artikel Terkait
                                    </h2>

                                </div>


                                <div class="divide-y divide-gray-100">

                                    {relatedArticles.map((item) => (

                                        <a
                                            href={`/artikel/${normalizeSlug(slugify(item.title || ""))}`}
                                            class="block p-4 hover:bg-gray-50 transition"
                                        >

                                            <div class="flex gap-3">


                                                <!-- Thumbnail -->

                                                {item.picture ? (

                                                    <img
                                                        src={getPictureUrl(item.picture)}
                                                        alt={item.title}
                                                        class="w-16 h-16 rounded-lg object-cover shrink-0 bg-gray-100"
                                                        loading="lazy"
                                                    />

                                                ) : (

                                                    <div class="w-16 h-16 rounded-lg bg-blue-50 flex items-center justify-center shrink-0">

                                                        <i class="fas fa-newspaper text-[#0900C3]"></i>

                                                    </div>

                                                )}


                                                <!-- Text -->

                                                <div class="min-w-0">

                                                    <h3 class="text-sm font-semibold text-gray-800 line-clamp-3 leading-snug">

                                                        {item.title}

                                                    </h3>

                                                    {item.date && (

                                                        <p class="text-xs text-gray-400 mt-2">

                                                            {new Date(item.date).toLocaleDateString(
                                                                "id-ID",
                                                                {
                                                                    day: "numeric",
                                                                    month: "short",
                                                                    year: "numeric"
                                                                }
                                                            )}

                                                        </p>

                                                    )}

                                                </div>

                                            </div>

                                        </a>

                                    ))}

                                </div>

                            </div>

                        )}

                    </aside>

                </div>

            </div>

        </section>

    </div>

</MainLayout>



<style>

    /* =========================================================
       SHARE BUTTON
    ========================================================= */

    .share-button {
        width: 42px;
        height: 42px;
        border-radius: 9999px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .share-button:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }


    /* =========================================================
       SIDEBAR
    ========================================================= */

    .sidebar-link {
        display: flex;
        align-items: center;
        gap: 12px;

        width: 100%;

        padding: 12px;

        border-radius: 10px;

        color: #374151;

        font-size: 14px;
        font-weight: 600;

        transition:
            background 0.2s ease,
            color 0.2s ease;
    }

    .sidebar-link:hover {
        background: #f3f4ff;
        color: #0900C3;
    }

    .sidebar-active {
        background: #eef0ff;
        color: #0900C3;
    }

    .sidebar-icon {
        width: 34px;
        height: 34px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 8px;

        background: #eef2ff;

        color: #0900C3;
    }


    /* =========================================================
       ARTICLE CONTENT
    ========================================================= */

    .article-content {
        color: #374151;

        font-size: 17px;

        line-height: 1.9;

        overflow-wrap: anywhere;
    }


    .article-content :global(p) {
        margin: 0 0 1.25rem;
    }


    .article-content :global(h1) {
        font-size: 2rem;

        line-height: 1.3;

        font-weight: 800;

        color: #111827;

        margin-top: 2rem;
        margin-bottom: 1rem;
    }


    .article-content :global(h2) {
        font-size: 1.7rem;

        line-height: 1.35;

        font-weight: 800;

        color: #111827;

        margin-top: 2rem;
        margin-bottom: 1rem;
    }


    .article-content :global(h3) {
        font-size: 1.4rem;

        line-height: 1.4;

        font-weight: 700;

        color: #111827;

        margin-top: 1.75rem;
        margin-bottom: 0.9rem;
    }


    .article-content :global(h4) {
        font-size: 1.2rem;

        font-weight: 700;

        color: #111827;

        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
    }


    .article-content :global(strong) {
        font-weight: 700;

        color: #111827;
    }


    .article-content :global(a) {
        color: #0900C3;

        text-decoration: underline;

        text-underline-offset: 2px;
    }


    .article-content :global(a:hover) {
        color: #050078;
    }


    .article-content :global(ul) {
        list-style: disc;

        padding-left: 1.75rem;

        margin: 1rem 0 1.5rem;
    }


    .article-content :global(ol) {
        list-style: decimal;

        padding-left: 1.75rem;

        margin: 1rem 0 1.5rem;
    }


    .article-content :global(li) {
        margin-bottom: 0.45rem;
    }


    .article-content :global(blockquote) {
        margin: 1.5rem 0;

        padding: 1rem 1.25rem;

        border-left: 4px solid #0900C3;

        background: #f5f6ff;

        color: #4b5563;

        border-radius: 0 10px 10px 0;
    }


    .article-content :global(img) {
        max-width: 100%;

        height: auto;

        display: block;

        margin: 1.5rem auto;

        border-radius: 12px;
    }


    .article-content :global(figure) {
        margin: 1.5rem 0;
    }


    .article-content :global(figcaption) {
        text-align: center;

        font-size: 14px;

        color: #6b7280;

        margin-top: 0.5rem;
    }


    .article-content :global(table) {
        width: 100%;

        border-collapse: collapse;

        margin: 1.5rem 0;

        display: block;

        overflow-x: auto;
    }


    .article-content :global(th),
    .article-content :global(td) {
        border: 1px solid #d1d5db;

        padding: 10px 12px;

        text-align: left;

        vertical-align: top;
    }


    .article-content :global(th) {
        background: #f3f4f6;

        color: #111827;

        font-weight: 700;
    }


    .article-content :global(hr) {
        border: 0;

        border-top: 1px solid #e5e7eb;

        margin: 2rem 0;
    }


    .article-content :global(pre) {
        overflow-x: auto;

        padding: 1rem;

        border-radius: 10px;

        background: #111827;

        color: white;

        margin: 1.5rem 0;
    }


    .article-content :global(code) {
        font-family: monospace;
    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 640px) {

        .article-content {
            font-size: 16px;

            line-height: 1.8;
        }

        .article-content :global(h1) {
            font-size: 1.6rem;
        }

        .article-content :global(h2) {
            font-size: 1.4rem;
        }

        .article-content :global(h3) {
            font-size: 1.2rem;
        }

    }

</style>



<script>

    // =========================================================
    // SHARE
    // =========================================================

    const currentUrl = window.location.href;

    const facebook =
        document.getElementById("shareFacebook");

    const whatsapp =
        document.getElementById("shareWhatsApp");

    const copyButton =
        document.getElementById("copyLink");

    const copyMessage =
        document.getElementById("copyMessage");


    // Facebook

    if (facebook) {

        facebook.setAttribute(
            "href",
            `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`
        );

    }


    // WhatsApp

    if (whatsapp) {

        whatsapp.setAttribute(
            "href",
            `https://wa.me/?text=${encodeURIComponent(currentUrl)}`
        );

    }


    // Copy link

    if (copyButton) {

        copyButton.addEventListener(
            "click",
            async () => {

                try {

                    await navigator.clipboard.writeText(
                        currentUrl
                    );

                    copyButton.innerHTML =
                        '<i class="fas fa-check"></i>';

                    if (copyMessage) {
                        copyMessage.classList.remove("hidden");
                    }

                    setTimeout(() => {

                        copyButton.innerHTML =
                            '<i class="fas fa-link"></i>';

                        if (copyMessage) {
                            copyMessage.classList.add("hidden");
                        }

                    }, 1800);

                } catch (error) {

                    console.error(
                        "Gagal menyalin URL:",
                        error
                    );

                }

            }
        );

    }

</script>
