---
export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { slugify } from "../../utils/slugify";
import { db } from "../../lib/db";

const rawSlug = Astro.params.slug || "";

const slug = decodeURIComponent(rawSlug)
  .trim()
  .toLowerCase();

console.log("=================================");
console.log("[MEDIA DETAIL]");
console.log("rawSlug :", rawSlug);
console.log("slug    :", slug);
console.log("=================================");


/* =========================================================
   AMBIL ARTIKEL PERIZINAN + PENANAMAN MODAL
   2 = ARTIKEL PERIZINAN
   3 = PENANAMAN MODAL
========================================================= */

let rows = [];

try {
  const [result] = await db.query(`
    SELECT
      id_post,
      id_category,
      title,
      content,
      ref_content,
      seotitle,
      tag,
      date,
      time,
      editor,
      active,
      headline,
      picture,
      hits
    FROM post
    WHERE active = 'Y'
      AND id_category IN (2, 3)
    ORDER BY date DESC, time DESC, id_post DESC
  `);

  rows = result || [];

} catch (error) {

  console.error(
    "[DATABASE MEDIA ERROR]",
    error
  );

  rows = [];
}


/* =========================================================
   CARI BERDASARKAN SLUG TITLE
========================================================= */

let post = rows.find((item) => {

  const titleSlug = slugify(
    String(item.title || "")
  )
    .trim()
    .toLowerCase();

  console.log(
    "[CHECK SLUG]",
    item.title,
    "=>",
    titleSlug
  );

  return titleSlug === slug;

});


/* =========================================================
   JIKA TIDAK KETEMU
========================================================= */

if (!post) {

  console.error("=================================");
  console.error("[ARTIKEL TIDAK DITEMUKAN]");
  console.error("URL SLUG :", slug);
  console.error("TOTAL DATA :", rows.length);

  rows.forEach((item) => {

    console.error(
      item.id_post,
      "|",
      item.id_category,
      "|",
      item.title,
      "|",
      slugify(String(item.title || ""))
    );

  });

  console.error("=================================");

  return new Response(
    `
      <!DOCTYPE html>
      <html lang="id">
      <head>
        <meta charset="UTF-8">
        <title>Artikel Tidak Ditemukan</title>
        <style>
          body {
            font-family: Arial, sans-serif;
            padding: 40px;
            background: #f5f5f5;
          }

          .box {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,.08);
          }

          h1 {
            color: #dc2626;
          }

          code {
            background: #f1f5f9;
            padding: 4px 8px;
            border-radius: 5px;
          }

          a {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 18px;
            background: #1d4ed8;
            color: white;
            text-decoration: none;
            border-radius: 8px;
          }
        </style>
      </head>

      <body>

        <div class="box">

          <h1>Artikel tidak ditemukan</h1>

          <p>
            Slug yang dibuka:
          </p>

          <p>
            <code>${slug}</code>
          </p>

          <p>
            Pastikan link artikel menggunakan:
          </p>

          <p>
            <code>/media/${slug}</code>
          </p>

          <a href="/artikel">
            Kembali ke Artikel
          </a>

        </div>

      </body>
      </html>
    `,
    {
      status: 404,
      headers: {
        "Content-Type": "text/html; charset=utf-8"
      }
    }
  );

}


/* =========================================================
   KATEGORI
========================================================= */

const categoryId =
  Number(post.id_category);

const namaKategori =
  categoryId === 2
    ? "Artikel Perizinan"
    : categoryId === 3
      ? "Penanaman Modal"
      : "Artikel";


/* =========================================================
   ICON
========================================================= */

const categoryIcon =
  categoryId === 2
    ? "fa-file-circle-check"
    : "fa-chart-line";


/* =========================================================
   WARNA KATEGORI
========================================================= */

const categoryClass =
  categoryId === 2
    ? "bg-blue-700"
    : "bg-emerald-600";


/* =========================================================
   ARTIKEL TERKAIT
========================================================= */

const artikelPerizinan =
  rows
    .filter(
      (item) =>
        Number(item.id_category) === 2 &&
        Number(item.id_post) !== Number(post.id_post)
    )
    .slice(0, 10);


const artikelPenanamanModal =
  rows
    .filter(
      (item) =>
        Number(item.id_category) === 3 &&
        Number(item.id_post) !== Number(post.id_post)
    )
    .slice(0, 10);


/* =========================================================
   FORMAT TANGGAL
========================================================= */

const formatDate = (date) => {

  if (!date) return "";

  const parsed =
    new Date(date);

  if (
    Number.isNaN(
      parsed.getTime()
    )
  ) {
    return String(date);
  }

  return parsed.toLocaleDateString(
    "id-ID",
    {
      day: "numeric",
      month: "long",
      year: "numeric"
    }
  );

};


/* =========================================================
   LINK ARTIKEL
========================================================= */

const getArtikelLink = (item) => {

  return `/media/${slugify(
    String(item.title || "")
  )}`;

};


/* =========================================================
   ISI ARTIKEL
   PENTING:
   ISI ADA DI content
========================================================= */

const articleContent =
  post.content || "";


/* =========================================================
   ESTIMASI WAKTU BACA
========================================================= */

const plainContent =
  String(articleContent)
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const wordCount =
  plainContent
    ? plainContent.split(/\s+/).length
    : 0;

const readingTime =
  Math.max(
    1,
    Math.ceil(wordCount / 200)
  );


/* =========================================================
   URL
========================================================= */

const currentUrl =
  Astro.url.href;

---

<style>

  @import url(
    'https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap'
  );

  body {
    font-family: 'Poppins', sans-serif;
  }

  @keyframes fadeInUp {

    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }

  .animate-fadeInUp {
    animation:
      fadeInUp .5s ease-out;
  }

  .card-hover {
    transition:
      all .3s ease;
  }

  .card-hover:hover {
    transform:
      translateY(-5px);

    box-shadow:
      0 20px 25px -5px
      rgba(0,0,0,.1),
      0 10px 10px -5px
      rgba(0,0,0,.04);
  }

  .shadow-custom {
    box-shadow:
      0 10px 30px
      rgba(0,0,0,.08);
  }

  .first-letter::first-letter {
    font-size: 3.5rem;
    font-weight: 800;
    float: left;
    line-height: 1;
    margin-right: .5rem;
    color: #1d4ed8;
    padding-top: .5rem;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .article-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
  }

  .article-content :global(td),
  .article-content :global(th) {
    border: 1px solid #ddd;
    padding: 8px;
  }

  .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    font-weight: 700;
    color: #111827;
    margin-top: 1.5rem;
    margin-bottom: .75rem;
  }

  .article-content :global(p) {
    margin-bottom: 1rem;
  }

  .article-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .article-content :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .article-content :global(a) {
    color: #1d4ed8;
    text-decoration: underline;
  }

</style>


<MainLayout title={post.title}>

  <!-- HERO -->

  <section
    class="relative overflow-hidden bg-gradient-to-r from-blue-800 to-blue-900 py-14"
  >

    <div
      class="container mx-auto px-4 text-center text-white"
    >

      <h1
        class="text-3xl md:text-4xl font-bold mb-4"
      >
        Detail Artikel
      </h1>

      <p
        class="text-lg opacity-90 max-w-3xl mx-auto"
      >
        Informasi seputar perizinan dan
        penanaman modal DPMPTSP Surabaya
      </p>

      <div class="mt-6">

        <a
          href="/artikel"
          class="inline-flex items-center bg-yellow-400 text-blue-800 font-bold px-6 py-3 rounded-lg hover:bg-yellow-300 transition"
        >

          <i class="fas fa-arrow-left mr-2"></i>

          Kembali ke Artikel

        </a>

      </div>

    </div>

  </section>


  <!-- CONTENT -->

  <section
    class="container mx-auto px-4 py-10"
  >

    <div
      class="grid grid-cols-1 lg:grid-cols-3 gap-8"
    >


      <!-- ARTIKEL -->

      <article
        class="lg:col-span-2 bg-white rounded-2xl shadow-custom overflow-hidden animate-fadeInUp"
      >

        <!-- HEADER -->

        <div
          class="p-6 md:p-8 border-b"
        >

          <div
            class="flex flex-wrap justify-between items-center gap-3 mb-4"
          >

            <span
              class={`${categoryClass} text-white px-4 py-2 rounded-full text-sm font-semibold`}
            >

              <i
                class={`fas ${categoryIcon} mr-1`}
              ></i>

              {namaKategori}

            </span>


            <span
              class="text-sm text-gray-500"
            >

              <i
                class="far fa-calendar-alt mr-1"
              ></i>

              {formatDate(post.date)}

            </span>

          </div>


          <h1
            class="text-2xl md:text-3xl font-bold text-gray-900 leading-tight mb-5"
          >
            {post.title}
          </h1>


          <div
            class="flex flex-wrap items-center gap-4 text-gray-600"
          >

            <div class="flex items-center gap-2">

              <i
                class="fas fa-user text-blue-700"
              ></i>

              <span>
                {post.editor || "Admin DPMPTSP"}
              </span>

            </div>


            <div class="flex items-center gap-2">

              <i
                class="fas fa-eye text-blue-700"
              ></i>

              <span>
                {post.hits || 0} views
              </span>

            </div>


            <div class="flex items-center gap-2">

              <i
                class="fas fa-clock text-blue-700"
              ></i>

              <span>
                {readingTime} min read
              </span>

            </div>

          </div>

        </div>


        <!-- GAMBAR -->

        {post.picture && (

          <div class="px-6 md:px-8 pt-6">

            <img
              src={`https://dpm-ptsp.surabaya.go.id/fileberita/${post.picture}`}
              alt={post.title}
              class="w-full max-h-[600px] object-cover rounded-xl"
            />

          </div>

        )}


        <!-- ISI ARTIKEL -->

        <div
          class="p-6 md:p-8 prose prose-lg max-w-none text-justify text-gray-700 article-content first-letter"
        >

          <div
            set:html={post.content || ""}
          />


          <!-- TAG -->

          <div
            class="mt-8 pt-6 border-t border-gray-100 not-prose"
          >

            <div
              class="flex items-center gap-2 flex-wrap"
            >

              <span
                class="font-semibold text-gray-700"
              >
                Kategori:
              </span>


              <span
                class="bg-blue-50 text-blue-700 px-3 py-1 rounded-full text-sm"
              >
                #{namaKategori}
              </span>


              {post.tag && (

                <span
                  class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm"
                >
                  #{post.tag}
                </span>

              )}

            </div>

          </div>

        </div>

      </article>


      <!-- SIDEBAR -->

      <aside class="space-y-6">


        <!-- ARTIKEL TERKAIT -->

        <div
          class="bg-white rounded-2xl shadow-custom p-6"
        >

          <h2
            class="text-xl font-bold mb-4 border-b pb-2"
          >
            Artikel Terkait
          </h2>


          <input
            type="text"
            id="search-related"
            placeholder="Cari judul..."
            class="w-full mb-4 px-4 py-2 text-sm border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600"
          />


          <!-- TAB -->

          <div
            class="flex gap-1 mb-5 bg-slate-100 p-1 rounded-xl"
          >

            <button
              type="button"
              class="tab-btn flex-1 px-3 py-2 text-xs font-medium rounded-lg bg-blue-600 text-white shadow"
              data-category="perizinan"
            >
              Perizinan
            </button>


            <button
              type="button"
              class="tab-btn flex-1 px-3 py-2 text-xs font-medium rounded-lg text-slate-600"
              data-category="penanaman"
            >
              Penanaman Modal
            </button>

          </div>


          <div id="related-list">


            <!-- PERIZINAN -->

            {artikelPerizinan.map((item) => (

              <a
                href={getArtikelLink(item)}
                class="related-item flex gap-4 mb-4 group"
                data-type="perizinan"
              >

                {item.picture ? (

                  <img
                    src={`https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}`}
                    alt={item.title}
                    class="w-20 h-20 rounded-xl object-cover flex-shrink-0"
                  />

                ) : (

                  <div
                    class="w-20 h-20 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0"
                  >

                    <i
                      class="fas fa-file-circle-check text-blue-700 text-xl"
                    ></i>

                  </div>

                )}


                <div class="min-w-0">

                  <span
                    class="text-[10px] bg-blue-50 text-blue-700 px-2 py-1 rounded"
                  >
                    Artikel Perizinan
                  </span>

                  <h3
                    class="font-semibold text-sm line-clamp-2 mt-1 group-hover:text-blue-700"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="text-xs text-slate-500 mt-1"
                  >
                    {formatDate(item.date)}
                  </p>

                </div>

              </a>

            ))}


            <!-- PENANAMAN -->

            {artikelPenanamanModal.map((item) => (

              <a
                href={getArtikelLink(item)}
                class="related-item hidden flex gap-4 mb-4 group"
                data-type="penanaman"
              >

                {item.picture ? (

                  <img
                    src={`https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}`}
                    alt={item.title}
                    class="w-20 h-20 rounded-xl object-cover flex-shrink-0"
                  />

                ) : (

                  <div
                    class="w-20 h-20 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0"
                  >

                    <i
                      class="fas fa-chart-line text-emerald-700 text-xl"
                    ></i>

                  </div>

                )}


                <div class="min-w-0">

                  <span
                    class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-1 rounded"
                  >
                    Penanaman Modal
                  </span>

                  <h3
                    class="font-semibold text-sm line-clamp-2 mt-1 group-hover:text-emerald-700"
                  >
                    {item.title}
                  </h3>

                  <p
                    class="text-xs text-slate-500 mt-1"
                  >
                    {formatDate(item.date)}
                  </p>

                </div>

              </a>

            ))}

          </div>


          <a
            href="/artikel"
            class="block text-center bg-blue-700 text-white py-3 rounded-lg hover:bg-blue-800 transition mt-4"
          >
            Lihat Semua Artikel
          </a>

        </div>


        <!-- QUICK LINKS -->

        <div
          class="bg-gradient-to-r from-blue-700 to-blue-900 rounded-2xl shadow-custom p-6 text-white card-hover"
        >

          <h2
            class="text-xl font-bold mb-6"
          >
            Layanan Cepat
          </h2>

          <div class="space-y-4">

            <a
              href="/Aplikasi#ijinusaha-sec"
              class="flex items-center justify-between p-3 bg-white/10 rounded-lg hover:bg-white/20"
            >

              <span>
                Call Center Surabaya
              </span>

              <i
                class="fas fa-arrow-right text-yellow-300"
              ></i>

            </a>


            <a
              href="/Aplikasi#ijinusaha-sec"
              class="flex items-center justify-between p-3 bg-white/10 rounded-lg hover:bg-white/20"
            >

              <span>
                TAKON SOBAT
              </span>

              <i
                class="fas fa-arrow-right text-yellow-300"
              ></i>

            </a>


            <a
              href="/Aplikasi#ijinusaha-sec"
              class="flex items-center justify-between p-3 bg-white/10 rounded-lg hover:bg-white/20"
            >

              <span>
                LAPIS LUPIS
              </span>

              <i
                class="fas fa-arrow-right text-yellow-300"
              ></i>

            </a>


            <a
              href="/Aplikasi#ijinusaha-sec"
              class="flex items-center justify-between p-3 bg-white/10 rounded-lg hover:bg-white/20"
            >

              <span>
                Perizinan Online
              </span>

              <i
                class="fas fa-arrow-right text-yellow-300"
              ></i>

            </a>


            <a
              href="/Aplikasi#pengaduan-sec"
              class="flex items-center justify-between p-3 bg-white/10 rounded-lg hover:bg-white/20"
            >

              <span>
                Pengaduan Layanan
              </span>

              <i
                class="fas fa-arrow-right text-yellow-300"
              ></i>

            </a>

          </div>

        </div>


        <!-- SHARE -->

        <div
          class="bg-white rounded-2xl shadow-custom p-6"
        >

          <h2
            class="text-xl font-bold mb-4 border-b pb-2"
          >
            Bagikan Artikel
          </h2>


          <div
            class="grid grid-cols-2 gap-3"
          >

            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-600 text-white p-3 rounded-lg flex flex-col items-center justify-center"
            >

              <i
                class="fab fa-facebook-f text-lg mb-2"
              ></i>

              <span class="text-xs">
                Facebook
              </span>

            </a>


            <a
              href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(post.title)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-400 text-white p-3 rounded-lg flex flex-col items-center justify-center"
            >

              <i
                class="fab fa-twitter text-lg mb-2"
              ></i>

              <span class="text-xs">
                Twitter
              </span>

            </a>


            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent(post.title + " " + currentUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-green-500 text-white p-3 rounded-lg flex flex-col items-center justify-center"
            >

              <i
                class="fab fa-whatsapp text-lg mb-2"
              ></i>

              <span class="text-xs">
                WhatsApp
              </span>

            </a>


            <a
              href={`mailto:?subject=${encodeURIComponent(post.title)}&body=${encodeURIComponent(currentUrl)}`}
              class="bg-red-500 text-white p-3 rounded-lg flex flex-col items-center justify-center"
            >

              <i
                class="fas fa-envelope text-lg mb-2"
              ></i>

              <span class="text-xs">
                Email
              </span>

            </a>

          </div>


          <!-- COPY -->

          <div
            class="mt-6 pt-4 border-t"
          >

            <div class="flex">

              <input
                type="text"
                id="article-link"
                value={currentUrl}
                readonly
                class="flex-grow min-w-0 px-3 py-2 text-sm border rounded-l-lg"
              />

              <button
                type="button"
                id="copy-link"
                class="bg-blue-700 text-white px-4 py-2 rounded-r-lg"
              >

                <i class="fas fa-copy"></i>

              </button>

            </div>


            <p
              id="copy-message"
              class="text-xs text-green-600 mt-2 hidden"
            >
              Link berhasil disalin!
            </p>

          </div>

        </div>

      </aside>

    </div>

  </section>


  <!-- JAVASCRIPT -->

  <script>

    const tabs =
      document.querySelectorAll(
        ".tab-btn"
      );

    const items =
      document.querySelectorAll(
        ".related-item"
      );

    const searchInput =
      document.getElementById(
        "search-related"
      );

    let activeType =
      "perizinan";


    function renderList() {

      const keyword =
        searchInput?.value
          .toLowerCase()
          .trim() || "";


      items.forEach((item) => {

        const title =
          item
            .querySelector("h3")
            ?.innerText
            .toLowerCase() || "";


        const matchType =
          item.dataset.type ===
          activeType;


        const matchSearch =
          title.includes(
            keyword
          );


        item.classList.toggle(
          "hidden",
          !(
            matchType &&
            matchSearch
          )
        );

      });

    }


    function setActive(type) {

      activeType = type;


      tabs.forEach((tab) => {

        const active =
          tab.dataset.category ===
          type;


        tab.className =
          "tab-btn flex-1 px-3 py-2 text-xs font-medium rounded-lg transition " +
          (
            active
              ? "bg-blue-600 text-white shadow"
              : "text-slate-600 hover:text-slate-900"
          );

      });


      renderList();

    }


    setActive("perizinan");


    tabs.forEach((tab) => {

      tab.addEventListener(
        "click",
        () => {

          setActive(
            tab.dataset.category
          );

        }
      );

    });


    searchInput?.addEventListener(
      "input",
      renderList
    );


    /* COPY LINK */

    const copyButton =
      document.getElementById(
        "copy-link"
      );

    const articleLink =
      document.getElementById(
        "article-link"
      );

    const copyMessage =
      document.getElementById(
        "copy-message"
      );


    copyButton?.addEventListener(
      "click",
      async () => {

        try {

          await navigator.clipboard.writeText(
            articleLink?.value ||
            window.location.href
          );


          copyMessage?.classList.remove(
            "hidden"
          );


          setTimeout(() => {

            copyMessage?.classList.add(
              "hidden"
            );

          }, 2000);


        } catch (error) {

          console.error(
            "COPY ERROR:",
            error
          );

        }

      }
    );

  </script>

</MainLayout>
