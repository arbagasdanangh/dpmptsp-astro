  <script>

    const tabs =
      document.querySelectorAll(
        ".tab-btn"
      );

    const items =
      document.querySelectorAll(
        ".related-item"
      );

    const searchInput =
      document.getElementById(
        "search-related"
      );

    const emptyState =
      document.getElementById(
        "related-empty"
      );


    let activeType =
      "artikel";


    /* =====================================================
       RENDER LIST
    ===================================================== */

    function renderList() {

      const keyword =
        searchInput?.value
          .toLowerCase()
          .trim() || "";


      let visibleCount =
        0;


      items.forEach(
        (item) => {

          const title =
            item
              .querySelector("h3")
              ?.innerText
              .toLowerCase() || "";


          const matchType =
            item.dataset.type ===
            activeType;


          const matchText =
            title.includes(
              keyword
            );


          const show =
            matchType &&
            matchText;


          item.classList.toggle(
            "hidden",
            !show
          );


          if (show) {
            visibleCount++;
          }

        }
      );


      if (emptyState) {

        emptyState.classList.toggle(
          "hidden",
          visibleCount !== 0
        );

      }

    }


    /* =====================================================
       ACTIVE TAB
    ===================================================== */

    function setActive(
      type
    ) {

      activeType =
        type;


      tabs.forEach(
        (tab) => {

          const active =
            tab.dataset.category ===
            type;


          tab.className =
            "tab-btn " +
            "px-4 py-2 " +
            "text-sm " +
            "font-medium " +
            "rounded-lg " +
            "transition " +
            "whitespace-nowrap " +
            (
              active
                ? "bg-blue-600 text-white shadow"
                : "text-slate-600 hover:text-slate-900"
            );

        }
      );


      renderList();

    }


    /* =====================================================
       INIT
    ===================================================== */

    setActive(
      "artikel"
    );


    /* =====================================================
       TAB CLICK
    ===================================================== */

    tabs.forEach(
      (tab) => {

        tab.addEventListener(
          "click",
          () => {

            setActive(
              tab.dataset.category
            );

          }
        );

      }
    );


    /* =====================================================
       SEARCH
    ===================================================== */

    searchInput?.addEventListener(
      "input",
      renderList
    );


    /* =====================================================
       COPY LINK
    ===================================================== */

    const copyButton =
      document.getElementById(
        "copy-link"
      );

    const articleLink =
      document.getElementById(
        "article-link"
      );

    const copyMessage =
      document.getElementById(
        "copy-message"
      );


    copyButton?.addEventListener(
      "click",
      async () => {

        try {

          await navigator.clipboard.writeText(
            articleLink.value
          );


          copyMessage.classList.remove(
            "hidden"
          );


          setTimeout(
            () => {

              copyMessage.classList.add(
                "hidden"
              );

            },
            2000
          );


        } catch (error) {

          console.error(
            "Gagal menyalin link:",
            error
          );

        }

      }
    );

  </script>


