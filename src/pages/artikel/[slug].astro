export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { slugify } from "../../utils/slugify";

/* =========================================================
   SLUG URL
========================================================= */

const rawSlug = Astro.params.slug || "";

const slug = decodeURIComponent(rawSlug)
  .toString()
  .toLowerCase()
  .trim();


/* =========================================================
   TANGGAL FILTER API
========================================================= */

const awal = "2024-01-01";

const sekarang = new Date();

const akhir =
  `${sekarang.getFullYear()}-` +
  `${String(sekarang.getMonth() + 1).padStart(2, "0")}-` +
  `${String(sekarang.getDate()).padStart(2, "0")}`;


/* =========================================================
   AMBIL DATA DARI API BERITA
========================================================= */

let rows = [];

try {

  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apiberita.php";

  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;


  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }


  /* =====================================================
     FORM PARAMETER
  ===================================================== */

  const form = new URLSearchParams();

  form.append("awal", awal);
  form.append("akhir", akhir);


  console.log("========================================");
  console.log("[API BERITA] REQUEST");
  console.log("URL:", apiUrl);
  console.log("FILTER:", { awal, akhir });
  console.log("SLUG:", slug);
  console.log("========================================");


  /* =====================================================
     REQUEST
  ===================================================== */

  const response = await fetch(
    apiUrl,
    {
      method: "POST",

      headers: {
        username,
        password,

        Accept: "application/json",

        "Content-Type":
          "application/x-www-form-urlencoded"
      },

      body: form.toString()
    }
  );


  /* =====================================================
     RESPONSE TEXT
  ===================================================== */

  const responseText =
    await response.text();


  console.log(
    "[API BERITA] STATUS:",
    response.status
  );

  console.log(
    "[API BERITA] RAW:",
    responseText
  );


  if (!response.ok) {
    throw new Error(
      `API Berita HTTP ${response.status}: ${responseText}`
    );
  }


  /* =====================================================
     PARSE JSON
  ===================================================== */

  let payload;

  try {

    payload =
      JSON.parse(responseText);

  } catch {

    throw new Error(
      `Response API Berita bukan JSON: ${
        responseText.substring(0, 1000)
      }`
    );

  }


  console.log(
    "[API BERITA] PAYLOAD:",
    payload
  );


  /* =====================================================
     AMBIL ARRAY DATA
  ===================================================== */

  let apiData = [];


  if (Array.isArray(payload)) {

    apiData = payload;

  }

  else if (Array.isArray(payload?.data)) {

    apiData = payload.data;

  }

  else if (Array.isArray(payload?.results)) {

    apiData = payload.results;

  }

  else if (Array.isArray(payload?.result)) {

    apiData = payload.result;

  }

  else if (Array.isArray(payload?.items)) {

    apiData = payload.items;

  }

  else if (Array.isArray(payload?.rows)) {

    apiData = payload.rows;

  }


  console.log(
    "[API BERITA] TOTAL RAW:",
    apiData.length
  );


  /* =====================================================
     NORMALISASI DATA
  ===================================================== */

  rows =
    apiData

      .map(
        (item) => ({

          id_post:
            Number(
              item?.id_post ??
              item?.id ??
              0
            ),

          id_category:
            Number(
              item?.id_category ??
              0
            ),

          title:
            item?.title ??
            item?.judul ??
            "",

          content:
            item?.content ??
            item?.isi ??
            item?.isi_konten ??
            "",

          ref_content:
            item?.ref_content ??
            "",

          seotitle:
            item?.seotitle ??
            item?.seo_title ??
            "",

          tag:
            item?.tag ??
            "",

          date:
            item?.date ??
            item?.tanggal ??
            "",

          time:
            item?.time ??
            item?.jam ??
            "",

          editor:
            item?.editor ??
            "",

          active:
            item?.active ??
            item?.aktif ??
            "Y",

          headline:
            item?.headline ??
            "N",

          picture:
            item?.picture ??
            item?.gambar ??
            item?.foto ??
            "",

          hits:
            Number(
              item?.hits ??
              0
            ),

          category_title:
            item?.category_title ??
            item?.category ??
            item?.nama_category ??
            "",

          raw:
            item

        })
      )

      /* =================================================
         HANYA AKTIF
      ================================================= */

      .filter(
        (item) =>
          String(item.active)
            .toUpperCase() === "Y"
      );


  console.log(
    "[API BERITA] TOTAL SETELAH FILTER:",
    rows.length
  );

  console.log(
    "[API BERITA] DATA:",
    rows
  );


} catch (error) {

  console.error(
    "========================================"
  );

  console.error(
    "[API BERITA ERROR]:",
    error
  );

  console.error(
    "========================================"
  );

  rows = [];

}


/* =========================================================
   CARI POST BERDASARKAN SLUG
========================================================= */

const post =
  rows.find(
    (row) => {

      const rowSlug =
        slugify(row.title || "")
          .toLowerCase()
          .trim();

      return rowSlug === slug;

    }
  );


/* =========================================================
   DEBUG SLUG
========================================================= */

console.log(
  "========================================"
);

console.log(
  "[SLUG URL]",
  slug
);

console.log(
  "[POST DITEMUKAN]",
  post
);

console.log(
  "========================================"
);


/* =========================================================
   MAP KATEGORI
=========================================================

   2 = Artikel
   3 = Penanaman Modal

   ID 1 dan 8 tidak digunakan untuk
   kategori sidebar halaman ini.
========================================================= */

const categoryMap = {

  2:
    "Artikel",

  3:
    "Penanaman Modal"

};


/* =========================================================
   NAMA KATEGORI POST
========================================================= */

let namaKategori =
  "Tanpa Kategori";


if (post?.id_category) {

  const idKategori =
    Number(
      post.id_category
    );


  namaKategori =
    categoryMap[idKategori] ||
    post.category_title ||
    "Tanpa Kategori";

}


/* =========================================================
   TANGGAL SORT
========================================================= */

const sortByDate =
  (a, b) => {

    const dateA =
      `${a.date || ""} ${a.time || ""}`;

    const dateB =
      `${b.date || ""} ${b.time || ""}`;

    return dateB.localeCompare(
      dateA
    );

  };


/* =========================================================
   ARTIKEL TERBARU
   CATEGORY 2
========================================================= */

const artikelRows =
  [...rows]

    .filter(
      (row) =>
        Number(
          row.id_category
        ) === 2
    )

    .sort(sortByDate)

    .slice(
      0,
      5
    );


/* =========================================================
   PENANAMAN MODAL TERBARU
   CATEGORY 3
========================================================= */

const penanamanModalRows =
  [...rows]

    .filter(
      (row) =>
        Number(
          row.id_category
        ) === 3
    )

    .sort(sortByDate)

    .slice(
      0,
      5
    );


/* =========================================================
   LIST ARTIKEL
========================================================= */

const artikelList =
  artikelRows;


/* =========================================================
   LIST PENANAMAN MODAL
========================================================= */

const penanamanModalList =
  penanamanModalRows;


/* =========================================================
   JIKA POST TIDAK DITEMUKAN
========================================================= */

if (!post) {

  console.error(
    "========================================"
  );

  console.error(
    "DATA TIDAK DITEMUKAN"
  );

  console.error(
    "Slug URL:",
    slug
  );

  console.error(
    "Tanggal:",
    awal,
    "s/d",
    akhir
  );


  /* =====================================================
     DEBUG SEMUA SLUG
  ===================================================== */

  rows.forEach(
    (r) => {

      console.error(
        "ID:",
        r.id_post
      );

      console.error(
        "CATEGORY:",
        r.id_category
      );

      console.error(
        "TITLE:",
        r.title
      );

      console.error(
        "SLUG:",
        slugify(
          r.title || ""
        )
      );

    }
  );


  console.error(
    "========================================"
  );


  throw new Error(
    "Data tidak ditemukan"
  );

}


/* =========================================================
   DATA POST FINAL
========================================================= */

console.log(
  "[POST FINAL]",
  {

    id:
      post.id_post,

    title:
      post.title,

    category:
      namaKategori,

    tanggal:
      post.date,

    slug:
      slug

  }
);
