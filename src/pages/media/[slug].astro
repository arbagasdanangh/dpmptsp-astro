---
export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { slugify } from "../../utils/slugify";

/* ---------- SLUG ---------- */
const slug = decodeURIComponent(Astro.params.slug || "").toLowerCase().trim();

/* ---------- API ---------- */
const pad = (n) => String(n).padStart(2, "0");
const now = new Date();
const awal = "2024-01-01";
const akhir = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;

let rows = [];

try {
  const username = import.meta.env.API_BERITA_USERNAME;
  const password = import.meta.env.API_BERITA_PASSWORD;
  if (!username || !password) {
    throw new Error("API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset");
  }

  const form = new URLSearchParams({ awal, akhir });
  const response = await fetch("https://dpm-ptsp.surabaya.go.id/sso/apiberita.php", {
    method: "POST",
    headers: {
      username,
      password,
      Accept: "application/json",
      "Content-Type": "application/x-www-form-urlencoded"
    },
    body: form.toString()
  });

  const text = await response.text();
  if (!response.ok) throw new Error(`API Berita HTTP ${response.status}: ${text}`);

  let payload;
  try { payload = JSON.parse(text); }
  catch { throw new Error(`Response API bukan JSON: ${text.substring(0, 1000)}`); }

  const apiData =
    [payload, payload?.data, payload?.results, payload?.result, payload?.items, payload?.rows]
      .find(Array.isArray) || [];

  rows = apiData
    .map((item) => ({
      id_post: Number(item?.id_post ?? item?.id ?? 0),
      id_category: Number(item?.id_category ?? 0),
      title: item?.title ?? item?.judul ?? "",
      content: item?.content ?? item?.isi ?? item?.isi_konten ?? "",
      ref_content: item?.ref_content ?? item?.content ?? item?.isi ?? "",
      seotitle: item?.seotitle ?? item?.seo_title ?? "",
      tag: item?.tag ?? "",
      date: item?.date ?? item?.tanggal ?? "",
      time: item?.time ?? item?.jam ?? "",
      editor: item?.editor ?? "",
      active: item?.active ?? item?.aktif ?? "Y",
      picture: item?.picture ?? item?.gambar ?? item?.foto ?? "",
      hits: Number(item?.hits ?? 0),
      category_title: item?.category_title ?? item?.category ?? item?.nama_category ?? ""
    }))
    .filter((item) => String(item.active).toUpperCase() === "Y");
} catch (error) {
  console.error("[API BERITA ERROR]", error);
  rows = [];
}

/* ---------- KATEGORI: Berita (1/8), Artikel (2/3) ---------- */
function getCategoryType(item) {
  const id = Number(item?.id_category);
  const name = String(item?.category_title || "").toLowerCase().trim();
  if (id === 1 || id === 8 || name.includes("berita")) return "berita";
  if (id === 2 || id === 3 || name.includes("artikel")) return "artikel";
  return "lainnya";
}

const sortTerbaru = (a, b) =>
  `${b.date || ""} ${b.time || ""}`.localeCompare(`${a.date || ""} ${a.time || ""}`);

const mediaList = rows
  .filter((i) => ["berita", "artikel"].includes(getCategoryType(i)))
  .sort(sortTerbaru);

const totalBerita = mediaList.filter((i) => getCategoryType(i) === "berita").length;
const totalArtikel = mediaList.filter((i) => getCategoryType(i) === "artikel").length;

const mediaListDisplay = [
  ...mediaList.filter((i) => getCategoryType(i) === "berita").slice(0, 10),
  ...mediaList.filter((i) => getCategoryType(i) === "artikel").slice(0, 10)
].sort(sortTerbaru);

/* ---------- POST ---------- */
const post = rows.find((r) => slugify(r.title || "").toLowerCase().trim() === slug);
if (!post) throw new Error(`Media tidak ditemukan: ${slug}`);

const type = getCategoryType(post);
const namaKategori =
  type === "berita" ? "Berita" : type === "artikel" ? "Artikel" : post.category_title || "Tanpa Kategori";
const kategoriIcon = type === "artikel" ? "fa-book-open" : "fa-newspaper";

/* ---------- HELPER ---------- */
function formatDate(date) {
  if (!date) return "—";
  const d = new Date(date);
  if (Number.isNaN(d.getTime())) return date;
  return d.toLocaleDateString("id-ID", { day: "numeric", month: "long", year: "numeric" });
}

function imageUrl(picture) {
  if (!picture) return "";
  return String(picture).startsWith("http")
    ? picture
    : "https://dpm-ptsp.surabaya.go.id/fileberita/" + picture;
}

const plain = String(post.ref_content || "").replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim();
const readMinutes = Math.max(1, Math.round(plain.split(" ").filter(Boolean).length / 200));
const idx = mediaList.findIndex((i) => slugify(i.title) === slugify(post.title));
const newer = idx > 0 ? mediaList[idx - 1] : null;
const older = idx >= 0 && idx < mediaList.length - 1 ? mediaList[idx + 1] : null;
const related = mediaListDisplay.filter((i) => slugify(i.title) !== slugify(post.title)).slice(0, 3);
const tags = String(post.tag || "").split(",").map((t) => t.trim()).filter(Boolean).slice(0, 6);
---

<style>
@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Inter:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap');

/* ---------- TOKENS ---------- */
.page {
  --navy: #06265c;
  --blue: #0754bd;
  --sky: #e8f1fd;
  --gold: #ffc61a;
  --ink: #14233c;
  --muted: #5b6b85;
  --line: #dde6f3;
  --paper: #f4f9ff;
  --display: 'Plus Jakarta Sans', sans-serif;
  --headline: 'Bricolage Grotesque', 'Plus Jakarta Sans', sans-serif;
  --sans: 'Inter', system-ui, sans-serif;
  font-family: var(--sans);
  background: var(--paper);
  color: var(--ink);
}

:global(html) { scroll-behavior: smooth; }
:global(body) { margin: 0; }
.page a:focus-visible, .page button:focus-visible, .page input:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 2px;
}

/* ---------- PROGRESS ---------- */
.progress {
  position: fixed; inset: 0 auto auto 0; z-index: 9999;
  height: 3px; width: 0; background: linear-gradient(90deg, var(--gold), #38bdf8, var(--blue));
}

/* ---------- HERO ---------- */
.hero {
  position: relative; overflow: hidden; color: #fff;
  background: linear-gradient(110deg, #062d70 0%, #064b9d 48%, #0756ad 100%);
  padding: 28px 0 104px;
}
.hero::before {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size: 38px 38px;
}
.hero::after {
  content: ""; position: absolute; width: 380px; height: 380px; left: -190px; top: -170px;
  border-radius: 50%; border: 72px solid rgba(30,112,208,.45); pointer-events: none;
}
.hero-ribbon {
  position: absolute; z-index: 1; left: -70px; top: 118px; width: 210px; height: 66px;
  background: var(--gold); border-radius: 50px; transform: rotate(-32deg);
}
.hero-stripe, .hero-photo {
  position: absolute; top: 0; bottom: 0; right: 0; width: 46%;
  clip-path: polygon(24% 0, 100% 0, 100% 100%, 0 100%);
}
.hero-stripe { background: var(--gold); transform: translateX(-20px); }
.hero-photo {
  background:
    linear-gradient(90deg, rgba(5,75,157,.55), rgba(5,75,157,.1) 55%),
    url("/images/siola.jpg") center / cover no-repeat;
}
.wrap { width: min(1200px, calc(100% - 40px)); margin: 0 auto; position: relative; }
.hero .wrap { z-index: 2; animation: rise .8s cubic-bezier(.22,1,.36,1) both; }
@keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
.hero-text { max-width: 52%; }

.crumbs { display: flex; gap: 8px; font-size: 13px; color: rgba(255,255,255,.7); margin-bottom: 20px; }
.crumbs a { color: #fff; text-decoration: none; }
.crumbs a:hover { color: var(--gold); }

.kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-bottom: 14px; font-size: 14px; }
.badge {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--gold); color: var(--navy);
  font-weight: 800; font-size: 13px; padding: 7px 14px; border-radius: 6px;
}
.kicker .date { display: inline-flex; align-items: center; gap: 8px; color: rgba(255,255,255,.88); }

.hero h1 {
  margin: 0; font-family: var(--headline);
  font-size: clamp(28px, 3.5vw, 46px);
  line-height: 1.08; font-weight: 800; letter-spacing: -.025em;
  text-wrap: balance;
}
.byline {
  display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 22px; padding-top: 18px;
  border-top: 1px solid rgba(255,255,255,.18);
  font-size: 13px; color: rgba(255,255,255,.88);
}
.byline span { display: inline-flex; align-items: center; gap: 8px; }
.byline i { color: var(--gold); }

/* ---------- LAYOUT ---------- */
.layout {
  display: grid; gap: 32px; margin-top: -68px; padding: 0 0 48px;
  grid-template-columns: minmax(0, 1fr);
  position: relative; z-index: 5;
}
@media (min-width: 1024px) {
  .layout { grid-template-columns: minmax(0, 1fr) 360px; gap: 40px; }
}

/* ---------- ARTICLE ---------- */
.cover {
  margin: 0; overflow: hidden; border-radius: 22px; border: 1px solid #fff; background: var(--sky);
  box-shadow: 0 18px 50px rgba(15,23,42,.07), 0 3px 12px rgba(15,23,42,.035);
}
.cover { position: relative; }
.cover-tag { position: absolute; left: 16px; bottom: 16px; background: var(--gold); color: var(--navy); font-weight: 800; font-size: 12px; padding: 7px 14px; border-radius: 999px; box-shadow: 0 6px 16px rgba(0,0,0,.2); }
.cover img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
.cover-empty {
  aspect-ratio: 16 / 9; display: grid; place-items: center; text-align: center;
  color: var(--blue); font-weight: 700;
}
.cover-empty i { display: block; font-size: 44px; margin-bottom: 10px; }

.meta-bar {
  margin-top: 16px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;
  background: #fff; border: 1px solid #dbeafe; border-radius: 16px; padding: 14px 20px;
  box-shadow: 0 18px 50px rgba(15,23,42,.07), 0 3px 12px rgba(15,23,42,.035);
  font-size: 12px; color: #64748b;
}
.meta-left { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; }
.meta-left span:not(.ic):not(.vsep) { display: inline-flex; align-items: center; gap: 8px; }
.meta-left i { color: #2563eb; }
.meta-left strong { color: #334155; }
.meta-left .ic { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 8px; background: #eff6ff; }
.meta-left .vsep { width: 1px; height: 20px; background: #e2e8f0; }
.pub { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #ecfdf5; color: #047857; font-size: 10px; font-weight: 700; }
.pub i { width: 6px; height: 6px; border-radius: 50%; background: #10b981; }
.sheet {
  margin-top: 20px; background: #fff; border: 1px solid var(--line);
  border-radius: 22px; padding: clamp(24px, 4vw, 40px);
  box-shadow: 0 18px 50px rgba(15,23,42,.07), 0 3px 12px rgba(15,23,42,.035);
}

.article-content {
  font-size: 16px; line-height: 1.9; color: #355276; text-align: justify; text-wrap: pretty; hyphens: auto;
}
.article-content :global(p) { margin: 0 0 1.45rem; }
.article-content :global(p:first-of-type)::first-letter {
  float: left; margin: 4px 10px 0 0; color: #0a55bd; font-family: var(--display);
  font-size: 66px; font-weight: 900; line-height: 1;
}
.article-content :global(h2),
.article-content :global(h3) {
  font-family: var(--sans); color: var(--navy); line-height: 1.3; font-weight: 800;
  letter-spacing: -.01em;
}
.article-content :global(h2) { font-size: 1.55rem; margin: 2.4em 0 .8em; }
.article-content :global(h3) { font-size: 1.2rem; margin: 2em 0 .7em; }
.article-content :global(img) {
  display: block; max-width: 100%; height: auto; margin: 2em auto; border-radius: 12px;
}
.article-content :global(a) {
  color: var(--blue); text-decoration: underline; text-underline-offset: 3px;
  text-decoration-thickness: 1px;
}
.article-content :global(ul), .article-content :global(ol) { margin: 1.3em 0; padding-left: 1.4em; }
.article-content :global(li) { margin-bottom: .5em; }
.article-content :global(blockquote) {
  margin: 2em 0; padding: 1em 1.4em; background: var(--sky);
  border-left: 4px solid var(--gold); border-radius: 0 12px 12px 0;
}
.article-content :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
.article-content :global(td), .article-content :global(th) { border: 1px solid var(--line); padding: 8px 12px; }

.sheet-foot {
  margin: 40px 0 0; padding-top: 24px; border-top: 1px solid var(--line);
  display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;
}
.tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tag {
  font-size: 13px; font-weight: 600; color: var(--blue);
  background: var(--sky); padding: 6px 12px; border-radius: 8px;
}
.share { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
.share a, .share button {
  width: 40px; height: 40px; display: grid; place-items: center; border: 0; cursor: pointer;
  border-radius: 10px; color: #fff; text-decoration: none; font-size: 15px;
  transition: transform .15s ease;
}
.share a:hover, .share button:hover { transform: translateY(-2px); }
.share .fb { background: #1877f2; }
.share .tw { background: #111827; }
.share .wa { background: #1fa855; }
.share .cp { background: var(--sky); color: var(--blue); }
#copy-message { font-weight: 700; color: #15803d; }

/* ---------- PREV / NEXT ---------- */
.pager { display: grid; gap: 16px; margin-top: 20px; grid-template-columns: 1fr; }
@media (min-width: 640px) { .pager { grid-template-columns: 1fr 1fr; } }
.pager a {
  display: flex; align-items: center; gap: 14px; padding: 16px 18px; text-decoration: none;
  background: #fff; border: 1px solid #dbeafe; border-radius: 16px; color: var(--navy);
  box-shadow: 0 10px 30px rgba(15,23,42,.05); transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
}
.pager a:hover { border-color: var(--blue); transform: translateY(-2px); box-shadow: 0 16px 36px rgba(7,84,189,.14); }
.pager .next { flex-direction: row-reverse; text-align: right; }
.pager .arr { flex: none; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; background: var(--sky); color: var(--blue); font-size: 13px; transition: background .2s ease, color .2s ease; }
.pager a:hover .arr { background: var(--gold); color: var(--navy); }
.pager small { display: block; font-size: 11px; font-weight: 700; color: var(--muted); margin-bottom: 3px; }
.pager strong { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; line-height: 1.45; }

/* ---------- SIDEBAR ---------- */
aside { align-self: start; min-width: 0; }
@media (min-width: 1024px) { aside { position: sticky; top: 96px; } }
.stack { display: flex; flex-direction: column; gap: 20px; }

.panel {
  background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden;
  box-shadow: 0 18px 44px rgba(6,38,92,.1);
}
.panel-head {
  position: relative; overflow: hidden; color: #fff;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 20px 20px 18px; margin-bottom: 14px;
  background: linear-gradient(135deg, #063b82, #0754b8 55%, #0b72df);
}
.panel-head::after {
  content: ""; position: absolute; right: -34px; top: -44px; width: 110px; height: 110px;
  border-radius: 50%; border: 22px solid rgba(255,198,26,.28); pointer-events: none;
}
.panel-head > * { position: relative; z-index: 1; }
.panel-head h2 { margin: 0; font-size: 17px; font-weight: 800; color: #fff; }
.panel-head p { margin: 2px 0 0; font-size: 12px; color: rgba(255,255,255,.75); }
.panel-head a {
  font-size: 12px; font-weight: 700; color: #fff; text-decoration: none;
  padding: 7px 12px; border-radius: 999px; background: rgba(255,255,255,.14);
  border: 1px solid rgba(255,255,255,.25); transition: background .15s ease, color .15s ease;
}
.panel-head a:hover { background: var(--gold); color: var(--navy); }

.filter { padding: 0 16px 12px; border-bottom: 1px solid var(--line); background: #fff; }
.search { position: relative; }
.search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #8a98b0; font-size: 12px; }
.search input {
  width: 100%; box-sizing: border-box; padding: 11px 14px 11px 36px;
  font: 500 13px var(--sans); color: var(--ink);
  background: var(--paper); border: 1px solid var(--line); border-radius: 10px;
}
.search input:focus { border-color: var(--blue); background: #fff; outline: none; box-shadow: 0 0 0 4px rgba(7,84,189,.12); }

.tabs { display: flex; gap: 4px; margin-top: 10px; padding: 4px; background: var(--paper); border-radius: 10px; }
.media-tab {
  flex: 1; border: 0; background: transparent; cursor: pointer;
  font: 700 12px var(--sans); color: var(--muted); padding: 8px 6px; border-radius: 8px;
  transition: background .15s ease, color .15s ease;
}
.media-tab:hover { color: var(--blue); }
.media-tab.active { background: #fff; color: var(--blue); box-shadow: 0 1px 4px rgba(6,38,92,.14); }
.media-tab small { font-weight: 600; opacity: .6; margin-left: 3px; }

#media-list {
  max-height: calc(100vh - 430px); min-height: 260px; overflow-y: auto;
  overscroll-behavior: contain; padding: 8px 10px;
  scrollbar-width: thin; scrollbar-color: #b6cdf0 transparent;
}
.media-item {
  display: flex; gap: 12px; padding: 10px; border-radius: 12px;
  text-decoration: none; color: inherit; align-items: center;
  transition: background .15s ease;
}
.media-item[hidden] { display: none; }
.media-item:hover { background: var(--sky); }
.media-item:hover h3 { color: var(--blue); }
.media-item { margin-bottom: 2px; }
.thumb img { transition: transform .4s ease; }
.media-item:hover .thumb img { transform: scale(1.06); }
.media-item[aria-current="page"] { background: var(--sky); box-shadow: inset 3px 0 0 var(--blue); }
.thumb {
  position: relative; flex: none; width: 76px; height: 62px; border-radius: 10px;
  overflow: hidden; background: var(--sky); display: grid; place-items: center; color: var(--blue);
}
.thumb img { width: 100%; height: 100%; object-fit: cover; }
.media-body { min-width: 0; }
.media-meta { display: flex; align-items: center; gap: 8px; font-size: 11px; color: var(--muted); margin-bottom: 4px; }
.dot { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); }
.dot.artikel { background: var(--gold); }
.media-body h3 {
  margin: 0; font-size: 13px; line-height: 1.45; font-weight: 700; color: var(--navy);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.empty { padding: 28px 20px; text-align: center; font-size: 13px; font-weight: 600; color: var(--muted); }
.empty[hidden] { display: none; }
.panel-foot { padding: 12px; border-top: 1px solid var(--line); background: var(--paper); }
.btn {
  display: flex; justify-content: center; align-items: center; gap: 8px;
  padding: 12px; border-radius: 10px; background: var(--blue); color: #fff;
  font-size: 13px; font-weight: 700; text-decoration: none; transition: background .15s ease;
}
.btn:hover { background: var(--navy); }

/* ---------- LAYANAN ---------- */
.service { position: relative; overflow: hidden; background: linear-gradient(135deg, #0751b3, #0a68d2); color: #fff; border-radius: 16px; padding: 22px; }
.service::after { content: ""; position: absolute; right: -60px; top: -60px; width: 160px; height: 160px; border-radius: 50%; border: 32px solid rgba(255,255,255,.08); pointer-events: none; }
.service > * { position: relative; z-index: 1; }
.service h2 { margin: 0 0 4px; font-size: 17px; font-weight: 800; }
.service p { margin: 0 0 14px; font-size: 12px; color: rgba(255,255,255,.7); line-height: 1.5; }
.service a {
  display: flex; align-items: center; gap: 12px; padding: 11px 12px; margin-top: 6px;
  border-radius: 10px; color: #fff; text-decoration: none; font-size: 13px; font-weight: 600;
  background: rgba(255,255,255,.08); transition: background .15s ease;
}
.service a:hover { background: rgba(255,255,255,.18); }
.service a i:first-child { width: 18px; text-align: center; color: var(--gold); }
.service a i:last-child { margin-left: auto; font-size: 10px; opacity: .6; }

/* ---------- BACA JUGA ---------- */
.related { padding-bottom: 72px; }
.related-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 20px; padding-top: 28px; border-top: 3px solid var(--gold); }
.related-head h2 { margin: 0; font-family: var(--display); font-size: 26px; font-weight: 800; color: var(--navy); }
.related-head a { font-size: 14px; font-weight: 700; color: var(--blue); text-decoration: none; }
.related-grid { display: grid; gap: 20px; grid-template-columns: 1fr; }
@media (min-width: 768px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
.rcard { display: block; text-decoration: none; color: inherit; background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; transition: transform .2s ease, box-shadow .2s ease; }
.rcard:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(6,38,92,.14); }
.rcard img, .rcard .ph { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: var(--sky); }
.rcard .ph { display: grid; place-items: center; color: var(--blue); font-size: 28px; }
.rcard div.txt { padding: 16px 18px 20px; }
.rcard small { font-size: 12px; color: var(--muted); }
.rcard h3 { margin: 6px 0 0; font-size: 16px; line-height: 1.4; font-weight: 700; color: var(--navy); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

/* ---------- BACK TO TOP ---------- */
.to-top {
  position: fixed; right: 20px; bottom: 20px; z-index: 50; width: 44px; height: 44px;
  display: none; place-items: center; border: 0; border-radius: 12px; cursor: pointer;
  background: var(--blue); color: #fff; box-shadow: 0 10px 24px rgba(6,38,92,.3);
}
.to-top.show { display: grid; }

/* ---------- RESPONSIVE ---------- */
@media (max-width: 768px) {
  .hero-stripe, .hero-ribbon { display: none; }
  .hero-photo { width: 100%; clip-path: none; opacity: .28; }
  .hero-text { max-width: 100%; }
  .article-content { font-size: 15px; text-align: left; }
  .hero { padding: 24px 0 96px; }
  #media-list { max-height: 520px; }
}
@media (prefers-reduced-motion: reduce) {
  :global(html) { scroll-behavior: auto; }
  * { transition: none !important; animation: none !important; }
}
</style>

<MainLayout title={post.title}>
<div class="page">

  <div id="reading-progress" class="progress"></div>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-ribbon"></div>
    <div class="hero-stripe"></div>
    <div class="hero-photo"></div>
    <div class="wrap">
      <div class="hero-text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/beritalist">Media</a><span>›</span><span>{namaKategori}</span>
        </nav>

        <div class="kicker">
          <span class="badge"><i class={`fas ${kategoriIcon}`}></i>{namaKategori}</span>
          <span class="date"><i class="far fa-calendar"></i>{formatDate(post.date)}</span>
        </div>
        <h1>{post.title}</h1>
      </div>
    </div>
  </section>

  <main class="wrap layout">

    <!-- ARTIKEL -->
    <article>
      <figure class="cover">
        {post.picture ? (
          <img src={imageUrl(post.picture)} alt={post.title} loading="eager" />
        ) : (
          <div class="cover-empty">
            <div>
              <i class={`fas ${kategoriIcon}`}></i>
              DPMPTSP Kota Surabaya
            </div>
          </div>
        )}
        <span class="cover-tag">{namaKategori}</span>
      </figure>

      <div class="meta-bar">
        <div class="meta-left">
          <span class="ic"><i class="fas fa-user"></i></span>
          <strong>DPMPTSP Kota Surabaya</strong>
          <span class="vsep"></span>
          <span><i class="far fa-calendar"></i>{formatDate(post.date)}</span>
          <span class="vsep"></span>
        </div>
        <span class="pub"><i></i>Publikasi</span>
      </div>

      <div class="sheet">
        <div class="article-content" set:html={post.ref_content}></div>

        <div class="sheet-foot">
          <div class="tags">
            <span class="tag">#{namaKategori}</span>
            {tags.map((t) => <span class="tag">#{t}</span>)}
          </div>

          <div class="share">
            <span>Bagikan</span>
            <a id="share-facebook" class="fb" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke Facebook"><i class="fab fa-facebook-f"></i></a>
            <a id="share-twitter" class="tw" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke X"><i class="fab fa-x-twitter"></i></a>
            <a id="share-whatsapp" class="wa" href="#" target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp"><i class="fab fa-whatsapp"></i></a>
            <button id="copy-link" class="cp" type="button" aria-label="Salin tautan"><i class="fas fa-link"></i></button>
            <span id="copy-message" hidden>Tautan disalin</span>
          </div>
        </div>
      </div>
      {(newer || older) && (
        <nav class="pager" aria-label="Media lainnya">
          {older ? (
            <a href={`/media/${slugify(older.title)}`} class="prev">
              <span class="arr"><i class="fas fa-arrow-left"></i></span>
              <span><small>Lebih lama</small><strong>{older.title}</strong></span>
            </a>
          ) : <span></span>}
          {newer && (
            <a href={`/media/${slugify(newer.title)}`} class="next">
              <span class="arr"><i class="fas fa-arrow-right"></i></span>
              <span><small>Lebih baru</small><strong>{newer.title}</strong></span>
            </a>
          )}
        </nav>
      )}
    </article>

    <!-- SIDEBAR -->
    <aside>
      <div class="stack">

        <section class="panel">
          <div class="panel-head">
            <div>
              <h2>Media terbaru</h2>
              <p>{totalBerita} berita dan {totalArtikel} artikel</p>
            </div>
            <a href="/beritalist">Lihat semua</a>
          </div>

          <div class="filter">
            <div class="search">
              <i class="fas fa-search"></i>
              <input id="media-search" type="search" autocomplete="off" placeholder="Cari berita atau artikel" aria-label="Cari media" />
            </div>
            <div class="tabs">
              <button type="button" class="media-tab active" data-category="semua">Semua</button>
              <button type="button" class="media-tab" data-category="berita">Berita<small>{totalBerita}</small></button>
              <button type="button" class="media-tab" data-category="artikel">Artikel<small>{totalArtikel}</small></button>
            </div>
          </div>

          <div id="media-list">
            {mediaListDisplay.map((item) => {
              const t = getCategoryType(item);
              const current = slugify(item.title) === slugify(post.title);
              return (
                <a
                  href={`/media/${slugify(item.title)}`}
                  class="media-item"
                  data-type={t}
                  data-title={String(item.title || "").toLowerCase()}
                  aria-current={current ? "page" : undefined}
                >
                  <div class="thumb">
                    {item.picture ? (
                      <img src={imageUrl(item.picture)} alt="" loading="lazy" />
                    ) : (
                      <i class={`fas ${t === "artikel" ? "fa-book-open" : "fa-newspaper"}`}></i>
                    )}
                  </div>
                  <div class="media-body">
                    <div class="media-meta">
                      <span class={`dot ${t}`}></span>
                      {t === "artikel" ? "Artikel" : "Berita"} · {formatDate(item.date)}
                    </div>
                    <h3>{item.title}</h3>
                  </div>
                </a>
              );
            })}
          </div>

          <div id="media-empty" class="empty" hidden>Tidak ada media yang cocok dengan pencarian Anda.</div>

          <div class="panel-foot">
            <a href="/beritalist" class="btn">Lihat semua media <i class="fas fa-arrow-right"></i></a>
          </div>
        </section>

        <section class="service">
          <h2>Layanan cepat</h2>
          <p>Akses layanan DPMPTSP Kota Surabaya.</p>
          {[
            ["Call Center Surabaya", "/Aplikasi#ijinusaha-sec", "fa-phone"],
            ["TAKON SOBAT", "/Aplikasi#ijinusaha-sec", "fa-comments"],
            ["LAPIS LUPIS", "/Aplikasi#ijinusaha-sec", "fa-layer-group"],
            ["Perizinan Online", "/Aplikasi#ijinusaha-sec", "fa-file-signature"],
            ["Pengaduan Layanan", "/Aplikasi#pengaduan-sec", "fa-headset"]
          ].map(([label, href, icon]) => (
            <a href={href}>
              <i class={`fas ${icon}`}></i>{label}<i class="fas fa-chevron-right"></i>
            </a>
          ))}
        </section>

      </div>
    </aside>
  </main>

  {related.length > 0 && (
    <section class="wrap related">
      <div class="related-head">
        <h2>Baca juga</h2>
        <a href="/beritalist">Semua media</a>
      </div>
      <div class="related-grid">
        {related.map((item) => (
          <a class="rcard" href={`/media/${slugify(item.title)}`}>
            {item.picture ? (
              <img src={imageUrl(item.picture)} alt="" loading="lazy" />
            ) : (
              <div class="ph"><i class={`fas ${getCategoryType(item) === "artikel" ? "fa-book-open" : "fa-newspaper"}`}></i></div>
            )}
            <div class="txt">
              <small>{getCategoryType(item) === "artikel" ? "Artikel" : "Berita"} · {formatDate(item.date)}</small>
              <h3>{item.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <button id="back-to-top" class="to-top" type="button" aria-label="Kembali ke atas">
    <i class="fas fa-arrow-up"></i>
  </button>
</div>
</MainLayout>

<script>
  const $ = (id) => document.getElementById(id);
  const search = $("media-search") as HTMLInputElement | null;
  const tabs = document.querySelectorAll<HTMLButtonElement>(".media-tab");
  const items = document.querySelectorAll<HTMLElement>(".media-item");
  const empty = $("media-empty");
  let activeCategory = "semua";

  function filterMedia() {
    const keyword = (search?.value || "").toLowerCase().trim();
    let visible = 0;
    items.forEach((el) => {
      const show =
        (activeCategory === "semua" || el.dataset.type === activeCategory) &&
        (!keyword || (el.dataset.title || "").includes(keyword));
      el.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  }

  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      activeCategory = tab.dataset.category || "semua";
      tabs.forEach((t) => t.classList.toggle("active", t === tab));
      filterMedia();
    })
  );
  search?.addEventListener("input", filterMedia);
  filterMedia();

  // scroll item aktif ke tengah list
  const current = document.querySelector<HTMLElement>('.media-item[aria-current="page"]');
  const list = $("media-list");
  if (current && list) list.scrollTop = Math.max(0, current.offsetTop - list.clientHeight / 2 + current.clientHeight / 2);

  // share
  const url = window.location.href;
  const title = document.title;
  const set = (id: string, href: string) => { const a = $(id) as HTMLAnchorElement | null; if (a) a.href = href; };
  set("share-facebook", `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`);
  set("share-twitter", `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`);
  set("share-whatsapp", `https://wa.me/?text=${encodeURIComponent(title + " " + url)}`);

  const copyMessage = $("copy-message");
  $("copy-link")?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      const tmp = document.createElement("input");
      tmp.value = url;
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand("copy");
      tmp.remove();
    }
    if (copyMessage) {
      copyMessage.hidden = false;
      setTimeout(() => (copyMessage.hidden = true), 2500);
    }
  });

  // progress + back to top
  const progress = $("reading-progress");
  const backTop = $("back-to-top");
  function onScroll() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    if (progress) progress.style.width = `${max > 0 ? Math.min(100, (window.scrollY / max) * 100) : 0}%`;
    backTop?.classList.toggle("show", window.scrollY > 500);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  backTop?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
  onScroll();
</script>
