export const prerender = false;

import MainLayout from "../../layouts/MainLayout.astro";
import { slugify } from "../../utils/slugify";

/* =========================================================
   SLUG
========================================================= */

const rawSlug = Astro.params.slug || "";

const slug = decodeURIComponent(rawSlug)
  .toString()
  .toLowerCase()
  .trim();


/* =========================================================
   API DATE
========================================================= */

const awal = "2024-01-01";

const sekarang = new Date();

const akhir =
  `${sekarang.getFullYear()}-` +
  `${String(sekarang.getMonth() + 1).padStart(2, "0")}-` +
  `${String(sekarang.getDate()).padStart(2, "0")}`;


/* =========================================================
   DATA
========================================================= */

let rows = [];


/* =========================================================
   API BERITA + ARTIKEL
========================================================= */

try {

  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apiberita.php";

  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;


  if (!username || !password) {

    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );

  }


  const form =
    new URLSearchParams();

  form.append(
    "awal",
    awal
  );

  form.append(
    "akhir",
    akhir
  );


  const response =
    await fetch(
      apiUrl,
      {
        method: "POST",

        headers: {
          username,
          password,
          Accept: "application/json",
          "Content-Type":
            "application/x-www-form-urlencoded"
        },

        body:
          form.toString()
      }
    );


  const responseText =
    await response.text();


  if (!response.ok) {

    throw new Error(
      `API Berita HTTP ${response.status}: ${responseText}`
    );

  }


  let payload;

  try {

    payload =
      JSON.parse(
        responseText
      );

  } catch {

    throw new Error(
      `Response API bukan JSON: ${responseText.substring(0, 1000)}`
    );

  }


  /* =======================================================
     AMBIL ARRAY RESPONSE
  ======================================================= */

  let apiData = [];


  if (Array.isArray(payload)) {

    apiData = payload;

  }

  else if (Array.isArray(payload?.data)) {

    apiData = payload.data;

  }

  else if (Array.isArray(payload?.results)) {

    apiData = payload.results;

  }

  else if (Array.isArray(payload?.result)) {

    apiData = payload.result;

  }

  else if (Array.isArray(payload?.items)) {

    apiData = payload.items;

  }

  else if (Array.isArray(payload?.rows)) {

    apiData = payload.rows;

  }


  /* =======================================================
     NORMALISASI DATA
  ======================================================= */

  rows =
    apiData
      .map(
        (item) => ({

          id_post:
            Number(
              item?.id_post ??
              item?.id ??
              0
            ),

          id_category:
            Number(
              item?.id_category ??
              0
            ),

          title:
            item?.title ??
            item?.judul ??
            "",

          content:
            item?.content ??
            item?.isi ??
            item?.isi_konten ??
            "",

          ref_content:
            item?.ref_content ??
            item?.content ??
            item?.isi ??
            "",

          seotitle:
            item?.seotitle ??
            item?.seo_title ??
            "",

          tag:
            item?.tag ??
            "",

          date:
            item?.date ??
            item?.tanggal ??
            "",

          time:
            item?.time ??
            item?.jam ??
            "",

          editor:
            item?.editor ??
            "",

          active:
            item?.active ??
            item?.aktif ??
            "Y",

          headline:
            item?.headline ??
            "N",

          picture:
            item?.picture ??
            item?.gambar ??
            item?.foto ??
            "",

          hits:
            Number(
              item?.hits ??
              0
            ),

          category_title:
            item?.category_title ??
            item?.category ??
            item?.nama_category ??
            "",

          raw:
            item

        })
      )
      .filter(
        (item) =>
          String(
            item.active
          )
            .toUpperCase() === "Y"
      );


} catch (error) {

  console.error(
    "[API BERITA ERROR]",
    error
  );

  rows = [];

}


/* =========================================================
   CATEGORY
=========================================================

   BERITA
   ID 1 / 8

   ARTIKEL
   ID 2 / 3
========================================================= */

function getCategoryType(item) {

  const id =
    Number(
      item?.id_category
    );

  const name =
    String(
      item?.category_title || ""
    )
      .toLowerCase()
      .trim();


  if (
    id === 1 ||
    id === 8 ||
    name === "berita" ||
    name.includes("berita")
  ) {

    return "berita";

  }


  if (
    id === 2 ||
    id === 3 ||
    name === "artikel" ||
    name.includes("artikel")
  ) {

    return "artikel";

  }


  return "lainnya";

}


/* =========================================================
   SORT TERBARU
========================================================= */

function sortTerbaru(a, b) {

  const dateA =
    `${a.date || ""} ${a.time || ""}`;

  const dateB =
    `${b.date || ""} ${b.time || ""}`;


  return dateB.localeCompare(
    dateA
  );

}


/* =========================================================
   MEDIA LIST
========================================================= */

const mediaList =
  [...rows]
    .filter(
      (item) =>
        [
          "berita",
          "artikel"
        ].includes(
          getCategoryType(item)
        )
    )
    .sort(
      sortTerbaru
    );


/* =========================================================
   TOTAL JUMLAH MEDIA
========================================================= */

const totalBerita =
  mediaList.filter(
    (item) =>
      getCategoryType(item) === "berita"
  ).length;

const totalArtikel =
  mediaList.filter(
    (item) =>
      getCategoryType(item) === "artikel"
  ).length;

const totalMedia =
  totalBerita + totalArtikel;


/* =========================================================
   10 BERITA TERBARU
========================================================= */

const beritaMedia =
  mediaList
    .filter(
      (item) =>
        getCategoryType(item) === "berita"
    )
    .slice(0, 10);


/* =========================================================
   10 ARTIKEL TERBARU
========================================================= */

const artikelMedia =
  mediaList
    .filter(
      (item) =>
        getCategoryType(item) === "artikel"
    )
    .slice(0, 10);


/* =========================================================
   DISPLAY SIDEBAR
   Tetap hanya 20 terbaru
========================================================= */

const mediaListDisplay = [
  ...beritaMedia,
  ...artikelMedia
];

/* =========================================================
   CARI POST DETAIL
========================================================= */

const post =
  rows.find(
    (row) => {

      const rowSlug =
        slugify(
          row.title || ""
        )
          .toLowerCase()
          .trim();


      return (
        rowSlug === slug
      );

    }
  );


/* =========================================================
   KATEGORI POST
========================================================= */

let namaKategori =
  "Tanpa Kategori";


if (post) {

  const detected =
    getCategoryType(
      post
    );


  if (
    detected === "berita"
  ) {

    namaKategori =
      "Berita";

  }

  else if (
    detected === "artikel"
  ) {

    namaKategori =
      "Artikel";

  }

  else if (
    post.category_title
  ) {

    namaKategori =
      post.category_title;

  }

}


/* =========================================================
   DEBUG
========================================================= */

console.log(
  "[MEDIA DETAIL]",
  {
    slug,
    post: post?.title,
    kategori: namaKategori,
    totalRows: rows.length,
    totalMedia: mediaList.length,
    totalBerita: beritaMedia.length,
    totalArtikel: artikelMedia.length,
    totalDisplay: mediaListDisplay.length
  }
);


/* =========================================================
   404
========================================================= */

if (!post) {

  throw new Error(
    `Media tidak ditemukan: ${slug}`
  );

}


/* =========================================================
   FORMAT DATE
========================================================= */

function formatDate(date) {

  if (!date) {

    return "—";

  }


  const parsed =
    new Date(date);


  if (
    Number.isNaN(
      parsed.getTime()
    )
  ) {

    return date;

  }


  return parsed.toLocaleDateString(
    "id-ID",
    {
      day: "numeric",
      month: "long",
      year: "numeric"
    }
  );

}


/* =========================================================
   IMAGE URL
========================================================= */

function imageUrl(picture) {

  if (!picture) {

    return "";

  }


  if (
    String(picture)
      .startsWith("http")
  ) {

    return picture;

  }


  return (
    "https://dpm-ptsp.surabaya.go.id/fileberita/" +
    picture
  );

}

