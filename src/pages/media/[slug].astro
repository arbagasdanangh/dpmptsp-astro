<!-- =====================================================
     JAVASCRIPT
====================================================== -->

<script>

  /* =====================================================
     SEARCH
  ===================================================== */

  const mediaSearch =
    document.getElementById(
      "media-search"
    );


  /* =====================================================
     TABS
  ===================================================== */

  const mediaTabs =
    document.querySelectorAll(
      ".media-tab"
    );


  /* =====================================================
     MEDIA ITEMS
  ===================================================== */

  const mediaItems =
    document.querySelectorAll(
      ".media-item"
    );


  /* =====================================================
     EMPTY
  ===================================================== */

  const mediaEmpty =
    document.getElementById(
      "media-empty"
    );


  /* =====================================================
     ACTIVE CATEGORY
  ===================================================== */

  let activeCategory =
    "semua";


  /* =====================================================
     FILTER
  ===================================================== */

  function filterMedia() {

    const keyword =
      String(
        mediaSearch?.value || ""
      )
        .toLowerCase()
        .trim();


    let visible =
      0;


    mediaItems.forEach(
      (item) => {

        const type =
          item.dataset.type ||
          "";


        const title =
          item.dataset.title ||
          "";


        const categoryMatch =
          activeCategory === "semua" ||
          type === activeCategory;


        const searchMatch =
          !keyword ||
          title.includes(
            keyword
          );


        const shouldShow =
          categoryMatch &&
          searchMatch;


        if (shouldShow) {

          item.classList.remove(
            "hidden"
          );

          visible++;

        }

        else {

          item.classList.add(
            "hidden"
          );

        }

      }
    );


    if (mediaEmpty) {

      mediaEmpty.classList.toggle(
        "hidden",
        visible > 0
      );

    }

  }


  /* =====================================================
     TAB CLICK
  ===================================================== */

  mediaTabs.forEach(
    (tab) => {

      tab.addEventListener(
        "click",
        () => {

          activeCategory =
            tab.dataset.category ||
            "semua";


          mediaTabs.forEach(
            (button) => {

              button.classList.remove(
                "active"
              );

              button.classList.remove(
                "bg-white"
              );

              button.classList.remove(
                "text-blue-700"
              );

              button.classList.remove(
                "shadow-sm"
              );

              button.classList.add(
                "text-slate-500"
              );

            }
          );


          tab.classList.add(
            "active"
          );

          tab.classList.add(
            "bg-white"
          );

          tab.classList.add(
            "text-blue-700"
          );

          tab.classList.add(
            "shadow-sm"
          );

          tab.classList.remove(
            "text-slate-500"
          );


          filterMedia();

        }
      );

    }
  );


  /* =====================================================
     SEARCH INPUT
  ===================================================== */

  mediaSearch?.addEventListener(
    "input",
    filterMedia
  );


  /* =====================================================
     INITIAL FILTER
  ===================================================== */

  filterMedia();


  /* =====================================================
     SHARE URL
  ===================================================== */

  const currentUrl =
    window.location.href;


  const pageTitle =
    document.title;


  const articleLink =
    document.getElementById(
      "article-link"
    );


  if (articleLink) {

    articleLink.value =
      currentUrl;

  }


  /* =====================================================
     FACEBOOK
  ===================================================== */

  const facebook =
    document.getElementById(
      "share-facebook"
    );


  if (facebook) {

    facebook.href =
      `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;

  }


  /* =====================================================
     X
  ===================================================== */

  const twitter =
    document.getElementById(
      "share-twitter"
    );


  if (twitter) {

    twitter.href =
      `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(pageTitle)}`;

  }


  /* =====================================================
     WHATSAPP
  ===================================================== */

  const whatsapp =
    document.getElementById(
      "share-whatsapp"
    );


  if (whatsapp) {

    whatsapp.href =
      `https://wa.me/?text=${encodeURIComponent(
        pageTitle + " " + currentUrl
      )}`;

  }


  /* =====================================================
     COPY LINK
  ===================================================== */

  const copyButton =
    document.getElementById(
      "copy-link"
    );


  const copyMessage =
    document.getElementById(
      "copy-message"
    );


  async function copyLink() {

    try {

      await navigator.clipboard.writeText(
        currentUrl
      );


      if (copyMessage) {

        copyMessage.classList.remove(
          "hidden"
        );


        setTimeout(
          () => {

            copyMessage.classList.add(
              "hidden"
            );

          },
          2500
        );

      }

    }

    catch {

      if (articleLink) {

        articleLink.select();

        document.execCommand(
          "copy"
        );

      }

    }

  }


  copyButton?.addEventListener(
    "click",
    copyLink
  );


  /* =====================================================
     READING PROGRESS
  ===================================================== */

  const progress =
    document.getElementById(
      "reading-progress"
    );


  function updateProgress() {

    if (!progress) {

      return;

    }


    const scrollTop =
      window.scrollY;


    const height =
      document.documentElement
        .scrollHeight -
      window.innerHeight;


    const percent =
      height > 0
        ? (
            scrollTop /
            height
          ) * 100
        : 0;


    progress.style.width =
      `${Math.min(
        100,
        Math.max(
          0,
          percent
        )
      )}%`;

  }


  window.addEventListener(
    "scroll",
    updateProgress,
    {
      passive: true
    }
  );


  updateProgress();


  /* =====================================================
     BACK TO TOP
  ===================================================== */

  const backTop =
    document.getElementById(
      "back-to-top"
    );


  function updateBackTop() {

    if (!backTop) {

      return;

    }


    if (
      window.scrollY > 500
    ) {

      backTop.classList.remove(
        "hidden"
      );

      backTop.classList.add(
        "flex"
      );

    }

    else {

      backTop.classList.add(
        "hidden"
      );

      backTop.classList.remove(
        "flex"
      );

    }

  }


  window.addEventListener(
    "scroll",
    updateBackTop,
    {
      passive: true
    }
  );


  backTop?.addEventListener(
    "click",
    () => {

      window.scrollTo(
        {
          top: 0,
          behavior: "smooth"
        }
      );

    }
  );


  updateBackTop();

</script>

