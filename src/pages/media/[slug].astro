========================================================= */

.quick-service {

  position:
    relative;

  overflow:
    hidden;

  background:
    linear-gradient(
      135deg,
      #0751b3,
      #0a68d2
    );

}


.quick-service::after {

  content:
    "";

  position:
    absolute;

  right:
    -65px;

  top:
    -65px;

  width:
    170px;

  height:
    170px;

  border-radius:
    50%;

  border:
    35px solid
    rgba(255,255,255,.08);

}


.quick-link {

