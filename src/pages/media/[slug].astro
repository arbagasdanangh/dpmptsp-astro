========================================================= */

.footer-wave {

  position:
    relative;

  overflow:
    hidden;

}


.footer-wave::before {

  content:
    "";

  position:
    absolute;

  left:
    -5%;

  top:
    -95px;

  width:
    110%;

  height:
    150px;

  border-radius:
    50%;

