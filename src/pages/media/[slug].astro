    rgba(15,23,42,.08);

  border-color:
    #bfdbfe;
}


.media-card::before {
  content: "";

  position: absolute;

  left: 0;
  top: 10px;
  bottom: 10px;

  width: 3px;

  border-radius:
    0 999px 999px 0;

  background:
    #2563eb;

  opacity: 0;

  transform:
    scaleY(.5);

  transition:
    opacity .25s ease,
    transform .25s ease;
}


.media-card:hover::before {
  opacity: 1;

  transform:
    scaleY(1);
}


.media-thumb {
  transition:
    transform .4s ease;
}


.media-card:hover .media-thumb {
  transform:
    scale(1.06);
}


.sidebar-scroll::-webkit-scrollbar {
  width: 6px;
}

.sidebar-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-scroll::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, #93c5fd, #2563eb);
  border-radius: 999px;
}

.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: #1d4ed8;
}

.media-card {
  position: relative;
  isolation: isolate;
  border-color: transparent;
}

.media-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 3px;
  border-radius: 0 999px 999px 0;
  background: #2563eb;
  opacity: 0;
  transform: scaleY(.5);
  transition: opacity .25s ease, transform .25s ease;
}

.media-card:hover::before {
  opacity: 1;
  transform: scaleY(1);
}

.media-sidebar .media-filter-sticky {
  box-shadow: 0 8px 18px rgba(15,23,42,.035);
}

/* =========================================================
