  min-width:0;

  padding:8px;

  border:1px solid rgba(255,255,255,.15);

  border-radius:13px;

  background:rgba(255,255,255,.08);

  color:white;

  cursor:pointer;

  text-align:left;

  transition:.3s;
}


.news-thumb:hover{
