 /* =========================================================
   APLIKASI PUBLIK DARI JSON API
   API:
   https://dpm-ptsp.surabaya.go.id/sso/apiaplikasi.php

   Mulai: 2024-01-01
   Sampai: hari ini
========================================================= */

let aplikasi = [];

try {
  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apiaplikasi.php";

  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }

  /*
   * =====================================================
   * FILTER TANGGAL
   * =====================================================
   */

  const awal = "2024-01-01";

  const sekarang = new Date();

  const akhir =
    sekarang.getFullYear() +
    "-" +
    String(
      sekarang.getMonth() + 1
    ).padStart(2, "0") +
    "-" +
    String(
      sekarang.getDate()
    ).padStart(2, "0");


  /*
   * =====================================================
   * BODY REQUEST
   * =====================================================
   */

  const form = new URLSearchParams();

  form.append("awal", awal);
  form.append("akhir", akhir);


  /*
   * =====================================================
   * REQUEST API
   * =====================================================
   */

  const response = await fetch(apiUrl, {
    method: "POST",

    headers: {
      username,
      password,

      Accept:
        "application/json",

      "Content-Type":
        "application/x-www-form-urlencoded",
    },

    body:
      form.toString(),
  });


  const responseText =
    await response.text();


  /*
   * =====================================================
   * DEBUG
   * =====================================================
   */

  console.log(
    "========================================"
  );

  console.log(
    "[API APLIKASI] STATUS:",
    response.status
  );

  console.log(
    "[API APLIKASI] FILTER:",
    {
      awal,
      akhir,
    }
  );

  console.log(
    "[API APLIKASI] RAW:",
    responseText
  );

  console.log(
    "========================================"
  );


  /*
   * =====================================================
   * CEK RESPONSE
   * =====================================================
   */

  if (!response.ok) {
    throw new Error(
      `API aplikasi gagal: HTTP ${response.status} - ${responseText}`
    );
  }


  let payload;

  try {

    payload =
      JSON.parse(responseText);

  } catch {

    throw new Error(
      `Response API aplikasi bukan JSON: ${responseText.substring(
        0,
        1000
      )}`
    );

  }


  console.log(
    "[API APLIKASI] PAYLOAD:",
    payload
  );


  /*
   * =====================================================
   * AMBIL DATA
   * =====================================================
   */

  let apiData = [];


  if (
    Array.isArray(payload)
  ) {

    apiData =
      payload;

  }

  else if (
    Array.isArray(
      payload?.data
    )
  ) {

    apiData =
      payload.data;

  }

  else if (
    Array.isArray(
      payload?.results
    )
  ) {

    apiData =
      payload.results;

  }

  else if (
    Array.isArray(
      payload?.result
    )
  ) {

    apiData =
      payload.result;

  }

  else if (
    Array.isArray(
      payload?.items
    )
  ) {

    apiData =
      payload.items;

  }

  else if (
    Array.isArray(
      payload?.rows
    )
  ) {

    apiData =
      payload.rows;

  }


  console.log(
    "[API APLIKASI] TOTAL DATA:",
    apiData.length
  );


  /*
   * =====================================================
   * NORMALISASI
   * =====================================================
   */

  aplikasi =
    apiData

      .map((item) => ({

        id:
          item.id ??
          item.id_aplikasi ??
          null,

        nama:
          item.nama_aplikasi ??
          item.nama ??
          item.title ??
          item.judul ??
          item.name ??
          item.label ??
          "",

        deskripsi:
          item.deskripsi ??
          item.description ??
          item.keterangan ??
          item.desc ??
          "",

        url:
          item.url_aplikasi ??
          item.link_aplikasi ??
          item.url ??
          item.link ??
          item.href ??
          item.website ??
          "",

        icon:
          item.icon_aplikasi ??
          item.icon ??
          item.logo ??
          item.gambar ??
          item.image ??
          "▣",

        target:
          item.target ??
          "_blank",

        active:
          item.active ??
          item.aktif ??
          item.status ??
          item.is_active ??
          "",

        urutan:
          Number(
            item.urutan ??
            item.order ??
            item.sort_order ??
            item.position ??
            999999
          ) || 999999,

        tanggal:
          item.tanggal ??
          item.date ??
          item.created_at ??
          null,

        raw:
          item,

      }))


      /*
       * Jangan filter active dulu.
       *
       * Tujuannya memastikan seluruh
       * data dari API bisa terlihat.
       */

      .filter(
        (item) =>
          item.nama
      )


      .sort(
        (a, b) =>
          a.urutan -
          b.urutan
      );


  /*
   * =====================================================
   * HASIL AKHIR
   * =====================================================
   */

  console.log(
    "========================================"
  );

  console.log(
    "[API APLIKASI] BERHASIL:",
    aplikasi.length
  );

  console.log(
    "[API APLIKASI] HASIL:",
    aplikasi
  );

  console.log(
    "========================================"
  );


} catch (error) {

  console.error(
    "========================================"
  );

  console.error(
    "[API APLIKASI ERROR]:",
    error
  );

  console.error(
    "========================================"
  );

  aplikasi = [];

}

/* =========================================================
   HELPER DESAIN BARU
========================================================= */

const principles = [
  { n: "01", t: "Cepat", d: "Sesuai SLA pelayanan", tag: "Speed", i: "fa-bolt" },
  { n: "02", t: "Mudah", d: "Online 24 jam, satu pintu", tag: "Simple", i: "fa-wand-magic-sparkles" },
  { n: "03", t: "Akuntabel", d: "Seluruh proses tercatat", tag: "Accountable", i: "fa-clipboard-check" },
  { n: "04", t: "Transparan", d: "Status real-time & tracking online", tag: "Open", i: "fa-eye" },
  { n: "05", t: "Bebas Pungli", d: "Komitmen WBK & WBBM", tag: "Integrity", i: "fa-shield-halved" },
];

const isImg = (v) =>
  /^(\/|https?:)/.test(String(v || "")) ||
  /\.(png|jpe?g|webp|svg|gif)(\?.*)?$/i.test(String(v || ""));

const isFa = (v) => /(^|\s)fa[a-z]?(\s|$)|fa-/.test(String(v || ""));

const partnerLabel = (nama = "") => {
  const n = nama.toLowerCase();
  if (n.includes("panrb")) return "Kementerian";
  if (n.includes("wbs")) return "Surabaya";
  if (n.includes("dpmptsp jawa timur")) return "Pemerintah Daerah";
  if (n.includes("oss")) return "Perizinan Berusaha";
  if (n.includes("djki")) return "Kekayaan Intelektual";
  if (n.includes("bkpm")) return "Investasi Indonesia";
  return "Instansi Terkait";
};
