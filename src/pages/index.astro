<!-- ============ INVESTASI ============ -->
<section class="sec" id="potensi-investasi">
  <div class="wrap">
    <div class="inv">
      <div class="inv-map">
        <span class="inv-badge"><i></i> Peta potensi aktif</span>
        <div class="inv-blob">
          <img
            src={peta[0]?.gambar || "https://dpm-ptsp.surabaya.go.id/images/PetaPotensi.png"}
            alt={peta[0]?.judul || "Peta Potensi Investasi Surabaya"}
