---
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import { slugify } from "../utils/slugify";

const bgInvestasi = `/bgkeunggulan.jpeg`;
const logoUrl = "https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true";
const B = "https://dpm-ptsp.surabaya.go.id";

/* =========================================================
   HELPER API
   Semua endpoint memakai kredensial yang sama.
========================================================= */

const username = import.meta.env.API_BERITA_USERNAME;
const password = import.meta.env.API_BERITA_PASSWORD;

const pad = (n) => String(n).padStart(2, "0");
const sekarang = new Date();
const hariIni = `${sekarang.getFullYear()}-${pad(sekarang.getMonth() + 1)}-${pad(sekarang.getDate())}`;

async function fetchApi(nama, endpoint, params = null, allowSingle = false) {
  try {
    if (!username || !password) {
      throw new Error("API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset");
    }

    const headers = { username, password, Accept: "application/json" };
    const init = { method: "POST", headers };

    if (params) {
      headers["Content-Type"] = "application/x-www-form-urlencoded";
      init.body = new URLSearchParams(params).toString();
    }

    const response = await fetch(`${B}/sso/${endpoint}`, init);
    const text = await response.text();

    if (!response.ok) throw new Error(`HTTP ${response.status} - ${text}`);

    let payload;
    try {
      payload = JSON.parse(text);
    } catch {
      throw new Error(`Response bukan JSON: ${text.substring(0, 500)}`);
    }

    let rows =
      [payload, payload?.data, payload?.results, payload?.result, payload?.items, payload?.rows]
        .find(Array.isArray) || [];

    if (!rows.length && allowSingle && payload && typeof payload === "object" && (payload.judul || payload.deskripsi || payload.title)) {
      rows = [payload];
    }

    return { rows, error: "" };
  } catch (error) {
    console.error(`[API ${nama} ERROR]`, error);
    return { rows: [], error: error instanceof Error ? error.message : "Gagal mengambil data API" };
  }
}

/* =========================================================
   INSTANSI TERKAIT
========================================================= */

const partnerRes = await fetchApi("INSTANSI", "apinstansiterkait.php");

const partners = partnerRes.rows
  .map((item) => ({
    id: item.id ?? null,
    nama: item.nama ?? "",
    link: item.link ?? "#",
    logo: item.logo ?? "",
    alt_logo: item.alt_logo ?? item.nama ?? "",
    aktif: item.aktif ?? 1,
    urutan: Number(item.urutan) || 999999,
  }))
  .filter((item) => item.nama && Number(item.aktif) === 1)
  .sort((a, b) => a.urutan - b.urutan || (Number(a.id) || 0) - (Number(b.id) || 0));

/* =========================================================
   NOTIFIKASI
========================================================= */

const notifRes = await fetchApi("NOTIFIKASI", "apinotifikasi.php");

const notifikasi = notifRes.rows
  .map((item) => ({
    id: item.id ?? null,
    judul: item.judul ?? "",
    isi: item.isi ?? "",
    gambar: item.gambar ?? "",
    tipe: item.tipe ?? "info",
    icon: item.icon ?? "fa-circle-info",
    link: item.link ?? "#",
    teks_link: item.teks_link ?? "Selengkapnya",
    active: item.active ?? "Y",
    urutan: Number(item.urutan) || 999999,
  }))
  .filter((item) => item.judul && String(item.active).toUpperCase() === "Y")
  .sort((a, b) => a.urutan - b.urutan || (Number(b.id) || 0) - (Number(a.id) || 0));

/* =========================================================
   BERITA (1 Jan 2024 s/d hari ini, 10 terbaru)
========================================================= */

const beritaRes = await fetchApi("BERITA", "apiberita.php", {
  awal: "2024-01-01",
  akhir: hariIni,
  id_category: "",
  active: "",
  headline: "",
});

const berita = beritaRes.rows
  .map((item) => ({
    id_post: item.id_post ?? item.id ?? null,
    id_category: item.id_category ?? null,
    title: item.title ?? item.judul ?? "",
    content: item.content ?? item.isi ?? "",
    ref_content: item.ref_content ?? item.content ?? item.isi ?? "",
    seotitle: item.seotitle ?? item.slug ?? "",
    date: item.date ?? item.tanggal ?? item.created_at ?? null,
    time: item.time ?? item.jam ?? null,
    picture: item.picture ?? item.gambar ?? item.image ?? "",
    hits: item.hits ?? item.view ?? item.views ?? 0,
    category_title: item.category_title ?? item.category ?? item.nama_category ?? "BERITA",
  }))
  .filter((item) => item.title)
  .sort((a, b) => {
    const da = new Date(`${a.date || ""} ${a.time || ""}`).getTime() || 0;
    const db = new Date(`${b.date || ""} ${b.time || ""}`).getTime() || 0;
    return db - da;
  })
  .slice(0, 10);

/* link berita dihitung di server (slugify tidak tersedia di browser) */
berita.forEach((b) => { b.href = `/media/${slugify(b.content)}`; });

/* =========================================================
   KEUNGGULAN INVESTASI
========================================================= */

const unggulRes = await fetchApi("KEUNGGULAN", "apikeunggulan.php", {
  awal: "2026-01-01",
  akhir: "2026-12-31",
});
const apiError = unggulRes.error;

const unggul = unggulRes.rows.map((item) => ({
  id: item?.id ?? null,
  judul: item?.judul ?? item?.title ?? "",
  deskripsi: item?.deskripsi ?? item?.description ?? "",
  icon: item?.icon ?? "fas fa-star",
  link: item?.link ?? "#",
  tanggal: item?.tanggal ?? "",
}));

/* =========================================================
   VIDEO
========================================================= */

const videoRes = await fetchApi("VIDEO", "apivideo.php");

const videos = videoRes.rows
  .map((item) => ({
    id: item.id ?? null,
    judul: item.judul ?? "",
    deskripsi: item.deskripsi ?? "",
    thumbnail: item.thumbnail ?? "",
    url_video: item.url_video ?? "#",
    status: item.status ?? "VIDEO",
    tanggal: item.tanggal ?? null,
    created_at: item.created_at ?? null,
  }))
  .filter((item) => item.judul)
  .sort((a, b) => {
    const da = new Date(a.tanggal || a.created_at || "").getTime() || 0;
    const db = new Date(b.tanggal || b.created_at || "").getTime() || 0;
    return db - da;
  })
  .slice(0, 6);

/* =========================================================
   PETA POTENSI INVESTASI
========================================================= */

const petaRes = await fetchApi("PETA", "apipetapotensi.php", null, true);

const peta = petaRes.rows
  .map((item) => ({
    id: item?.id ?? item?.id_peta ?? item?.id_potensi ?? null,
    judul: item?.judul ?? item?.Judul ?? item?.title ?? item?.nama ?? item?.nama_peta ?? item?.nama_potensi ?? "",
    deskripsi: item?.deskripsi ?? item?.Deskripsi ?? item?.description ?? item?.keterangan ?? item?.desc ?? "",
    gambar: item?.gambar ?? item?.foto ?? item?.image ?? item?.img ?? item?.foto_peta ?? "",
    link: item?.link ?? item?.url ?? item?.href ?? item?.url_peta ?? "#",
    wilayah_unggulan: item?.wilayah_unggulan ?? item?.wilayahUnggulan ?? item?.wilayah ?? "",
  }))
  .filter((item) => item.judul || item.deskripsi || item.gambar || item.wilayah_unggulan || item.link !== "#");

/* =========================================================
   APLIKASI PUBLIK
========================================================= */

const aplikasiRes = await fetchApi("APLIKASI", "apiaplikasi.php", { awal: "2024-01-01", akhir: hariIni });

const aplikasi = aplikasiRes.rows
  .map((item) => ({
    id: item.id ?? item.id_aplikasi ?? null,
    nama: item.nama_aplikasi ?? item.nama ?? item.title ?? item.judul ?? item.name ?? item.label ?? "",
    deskripsi: item.deskripsi ?? item.description ?? item.keterangan ?? item.desc ?? "",
    url: item.url_aplikasi ?? item.link_aplikasi ?? item.url ?? item.link ?? item.href ?? item.website ?? "",
    icon: item.icon_aplikasi ?? item.icon ?? item.logo ?? item.gambar ?? item.image ?? "▣",
    target: item.target ?? "_blank",
    urutan: Number(item.urutan ?? item.order ?? item.sort_order ?? item.position ?? 999999) || 999999,
  }))
  .filter((item) => item.nama)
  .sort((a, b) => a.urutan - b.urutan);

/* =========================================================
   HELPER TAMPILAN
========================================================= */

function stripHtml(value) {
  if (!value) return "";
  return String(value)
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function excerpt(value, length = 220) {
  const text = stripHtml(value);
  return text.length <= length ? text : text.substring(0, length).trim() + "...";
}

function formatDate(value) {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" });
}

const principles = [
  { n: "01", t: "Cepat", d: "Sesuai SLA pelayanan", tag: "Speed", i: "fa-bolt" },
  { n: "02", t: "Mudah", d: "Online 24 jam, satu pintu", tag: "Simple", i: "fa-wand-magic-sparkles" },
  { n: "03", t: "Akuntabel", d: "Seluruh proses tercatat", tag: "Accountable", i: "fa-clipboard-check" },
  { n: "04", t: "Transparan", d: "Status real-time & tracking online", tag: "Open", i: "fa-eye" },
  { n: "05", t: "Bebas Pungli", d: "Komitmen WBK & WBBM", tag: "Integrity", i: "fa-shield-halved" },
];

const isImg = (v) =>
  /^(\/|https?:)/.test(String(v || "")) ||
  /\.(png|jpe?g|webp|svg|gif)(\?.*)?$/i.test(String(v || ""));

const isFa = (v) => /(^|\s)fa[a-z]?(\s|$)|fa-/.test(String(v || ""));

const partnerLabel = (nama = "") => {
  const n = nama.toLowerCase();
  if (n.includes("panrb")) return "Kementerian";
  if (n.includes("wbs")) return "Surabaya";
  if (n.includes("dpmptsp jawa timur")) return "Pemerintah Daerah";
  if (n.includes("oss")) return "Perizinan Berusaha";
  if (n.includes("djki")) return "Kekayaan Intelektual";
  if (n.includes("bkpm")) return "Investasi Indonesia";
  return "Instansi Terkait";
};

const fallbackApps = [
  { nama: "Aplikasi Ijin Usaha", deskripsi: "Pengajuan dan pengurusan izin usaha secara online.", url: `${B}/aplikasi.php#ijinusaha-sec`, icon: "fas fa-building-circle-check" },
  { nama: "Aplikasi Pengaduan", deskripsi: "Sampaikan pengaduan dan masukan layanan.", url: `${B}/aplikasi.php#pengaduan-sec`, icon: "fas fa-headset" },
  { nama: "Dashboard Investasi", deskripsi: "Data dan statistik investasi Kota Surabaya.", url: "https://dashboardinvestasi.surabaya.go.id/", icon: "fas fa-chart-pie" },
  { nama: "SIWASTIB", deskripsi: "Sistem pengawasan dan ketertiban perizinan.", url: `${B}/siwastib/`, icon: "fas fa-user-shield" },
  { nama: "SIPINTAR", deskripsi: "Layanan informasi perizinan yang cerdas.", url: `${B}/sipintar/`, icon: "fas fa-lightbulb" },
  { nama: "SICERDAS", deskripsi: "Konsultasi dan informasi perizinan terpadu.", url: `${B}/sicerdas/`, icon: "fas fa-brain" },
  { nama: "Kalkulator Investasi", deskripsi: "Simulasi dan estimasi biaya investasi.", url: `${B}/kalkulator_investasi/`, icon: "fas fa-calculator" },
  { nama: "Mal Pelayanan Publik", deskripsi: "Layanan publik terpadu dalam satu tempat.", url: "https://mpp.surabaya.go.id/", icon: "fas fa-landmark" },
  { nama: "SKM", deskripsi: "Survei Kepuasan Masyarakat atas layanan kami.", url: "https://skm.surabaya.go.id/", icon: "fas fa-face-smile" },
];
const services = aplikasi.length > 0 ? aplikasi : fallbackApps;

---

<MainLayout title="DPMPTSP Kota Surabaya">
<div class="home">

{notifikasi.length > 0 && (
  <div id="notificationModal" class="notif" aria-hidden="false" role="dialog" aria-modal="true" aria-label="Informasi">
    <div class="book-wrap">

      <div class="book">
        <!-- sampul buku: terbuka otomatis saat modal tampil -->
        <div class="book-cover" aria-hidden="true">
          <div class="cover-face cover-front">
            <span class="cover-logo"><img src={logoUrl} alt="" /></span>
            <strong>Informasi</strong>
            <small>DPMPTSP Kota Surabaya</small>
          </div>
          <div class="cover-face cover-back"></div>
        </div>

        <button type="button" id="notificationClose" class="notif-close" aria-label="Tutup">
          <i class="fas fa-xmark"></i>
        </button>

        <div id="notificationSlider" class="notif-slider">
          {notifikasi.map((item, index) => (
            <div class={`notification-slide ${index === 0 ? "active" : ""}`} data-index={index}>
              {item.gambar ? (
                <img class="notif-img" src={item.gambar} alt={item.judul || "Informasi"} />
              ) : (
                <div class="notif-card">
                  <div class="notif-fallback"><i class={`fas ${item.icon || "fa-bell"}`}></i></div>
                  {(item.judul || item.isi) && (
                    <div class="notif-info">
                      {item.judul && <h2>{item.judul}</h2>}
                      {item.isi && <p>{item.isi}</p>}
                    </div>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

      {notifikasi.length > 1 && (
        <div class="notif-foot">
          <button type="button" id="notificationPrev" class="notif-arrow" aria-label="Sebelumnya"><i class="fas fa-chevron-left"></i></button>
          <span id="notificationCounter" class="notif-count" aria-live="polite">1 / {notifikasi.length}</span>
          <button type="button" id="notificationNext" class="notif-arrow" aria-label="Berikutnya"><i class="fas fa-chevron-right"></i></button>
        </div>
      )}
    </div>
  </div>
)}

<!-- ============ HERO ============ -->
<section class="hero" id="sectionHero" aria-labelledby="sectionHeroTitle">
  <span class="bubble b1"></span><span class="bubble b2"></span><span class="bubble b3"></span>
  <div class="wrap">
    <div class="hero-copy">
      <span class="pill"><i></i> DPMPTSP Kota Surabaya</span>
      <h1 id="sectionHeroTitle">Perizinan &amp; Investasi <em>Lebih Mudah</em></h1>
      <p>Satu pintu layanan digital untuk mengurus perizinan, memantau investasi, dan terhubung dengan Pemerintah Kota Surabaya.</p>
      <div class="hero-cta">
        <a href="#aplikasi" class="btn btn-y">Jelajahi Aplikasi <i class="fas fa-arrow-down"></i></a>
        <a href="#potensi-investasi" class="btn btn-ghost">Potensi Investasi</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <span class="ring r1"></span><span class="ring r2"></span>
      <div class="orb"><img src={logoUrl} alt="" onerror="this.onerror=null;this.src='/logo-surabaya.png';" /></div>
      <div class="float f1"><i class="fas fa-clock"></i><div><strong>24 Jam</strong><span>Layanan online</span></div></div>
      <div class="float f2"><i class="fas fa-map-location-dot"></i><div><strong>31</strong><span>Kecamatan</span></div></div>
      <div class="float f3"><i class="fas fa-shield-halved"></i><div><strong>Bebas Pungli</strong><span>WBK &amp; WBBM</span></div></div>
    </div>
  </div>
</section>

<!-- ============ LAYANAN DIGITAL ============ -->
<section class="svc-sec" id="aplikasi" aria-label="Layanan digital">
  <div class="wrap">
    <div class="svc-head">
      <span class="eyebrow">Layanan Digital</span>
      <h2>Pilih layanan yang Anda butuhkan</h2>
    </div>
    <div class="svc-grid">
      {services.map((app, index) => (
        <a
          href={app.url || "#"}
          target={app.target || "_blank"}
          rel="noopener noreferrer"
          class="svc"
          style={`--i:${index}`}
          aria-label={`Buka ${app.nama || "Aplikasi"}`}
        >
          <span class="svc-ic">
            {isImg(app.icon) ? <img src={app.icon} alt="" />
              : isFa(app.icon) ? <i class={app.icon}></i>
              : <i class="fas fa-layer-group"></i>}
          </span>
          <strong>{app.nama || "Aplikasi"}</strong>
          <small>{app.deskripsi || "Layanan digital untuk masyarakat Surabaya."}</small>
        </a>
      ))}
    </div>
    <div class="svc-more"><a href="/inovasi" class="svc-all">Lihat semua layanan <i class="fas fa-arrow-right"></i></a></div>
  </div>
</section>

<!-- ============ KEUNGGULAN ============ -->
<section id="keunggulan-investasi" class="sec wv keunggulan" style={`--bgimg:url("${bgInvestasi}")`}>
  <div class="wrap">
    <div class="head center">
      <span class="eyebrow">Potensi Investasi Surabaya</span>
      <h2>Mengapa Berinvestasi di Surabaya?</h2>
      <p>Kota Surabaya menawarkan berbagai keunggulan sebagai destinasi investasi terbaik di Indonesia.</p>
    </div>

    {apiError && <div class="alert">Gagal mengambil data dari API: {apiError}</div>}

    {unggul.length > 0 ? (
      <div id="keunggulanGrid" class="ung-grid">
        {unggul.map((item, index) => (
          <article class="ung">
            <div class="ung-icon">
              <i class={item.icon}></i>
              <span class="ung-no">{String(index + 1).padStart(2, "0")}</span>
            </div>
            <h3>{item.judul}</h3>
            <p>{item.deskripsi}</p>
