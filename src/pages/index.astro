let regulasi = [];

try {
  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apiregulasi.php";

  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }


  /* =====================================================
     TANGGAL
  ===================================================== */

  const awal = "2024-01-01";

  const sekarang = new Date();

  const akhir =
    sekarang.getFullYear() +
    "-" +
    String(
      sekarang.getMonth() + 1
    ).padStart(2, "0") +
    "-" +
    String(
      sekarang.getDate()
    ).padStart(2, "0");


  /* =====================================================
     FORM POST
  ===================================================== */

  const form = new URLSearchParams();

  form.append(
    "awal",
    awal
  );

  form.append(
    "akhir",
    akhir
  );


  /* =====================================================
     REQUEST
  ===================================================== */

  const response = await fetch(
    apiUrl,
    {
      method: "POST",

      headers: {
        username,
        password,

        Accept:
          "application/json",

        "Content-Type":
          "application/x-www-form-urlencoded",
      },

      body:
        form.toString(),
    }
  );


  const responseText =
    await response.text();


  /* =====================================================
     DEBUG
  ===================================================== */

  console.log(
    "========================================"
  );

  console.log(
    "[API REGULASI] STATUS:",
    response.status
  );

  console.log(
    "[API REGULASI] FILTER:",
    {
      awal,
      akhir,
    }
  );

  console.log(
    "[API REGULASI] RAW:",
    responseText
  );

  console.log(
    "========================================"
  );


  /* =====================================================
     CEK HTTP
  ===================================================== */

  if (!response.ok) {
    throw new Error(
      `API regulasi gagal: HTTP ${response.status} - ${responseText}`
    );
  }


  /* =====================================================
     PARSE JSON
  ===================================================== */

  let payload;

  try {

    payload =
      JSON.parse(
        responseText
      );

  } catch {

    throw new Error(
      `Response API regulasi bukan JSON: ${responseText.substring(
        0,
        1000
      )}`
    );

  }


  console.log(
    "[API REGULASI] PAYLOAD:",
    payload
  );


  /* =====================================================
     AMBIL DATA
  ===================================================== */

  let apiData = [];


  if (
    Array.isArray(payload)
  ) {

    apiData =
      payload;

  }

  else if (
    Array.isArray(
      payload?.data
    )
  ) {

    apiData =
      payload.data;

  }

  else if (
    Array.isArray(
      payload?.results
    )
  ) {

    apiData =
      payload.results;

  }

  else if (
    Array.isArray(
      payload?.result
    )
  ) {

    apiData =
      payload.result;

  }

  else if (
    Array.isArray(
      payload?.items
    )
  ) {

    apiData =
      payload.items;

  }

  else if (
    Array.isArray(
      payload?.rows
    )
  ) {

    apiData =
      payload.rows;

  }


  console.log(
    "[API REGULASI] TOTAL RAW:",
    apiData.length
  );


  /* =====================================================
     NORMALISASI
  ===================================================== */

  regulasi =
    apiData

      .map((item) => ({

        id:
          item.id ??
          item.id_regulasi ??
          item.id_peraturan ??
          null,

        jenis:
          item.jenis ??
          item.jenis_regulasi ??
          item.type ??
          "",

        nomor:
          item.nomor ??
          item.no ??
          item.nomor_regulasi ??
          "",

        tahun:
          item.tahun ??
          item.year ??
          null,

        judul:
          item.judul ??
          item.title ??
          item.nama ??
          item.nama_regulasi ??
          "",

        file:
          item.file ??
          item.file_url ??
          item.url_file ??
          item.pdf ??
          item.link ??
          "",

        url:
          item.url ??
          item.link ??
          item.file_url ??
          item.url_file ??
          "",

        active:
          item.active ??
          item.aktif ??
          item.status ??
          item.is_active ??
          "Y",

        urutan:
          Number(
            item.urutan ??
            item.order ??
            item.sort_order ??
            999999
          ) || 999999,

        tanggal:
          item.tanggal ??
          item.date ??
          item.created_at ??
          null,

        created_at:
          item.created_at ??
          null,

        raw:
          item,

      }))


      /*
       * Untuk sementara jangan terlalu ketat
       * pada active.
       *
       * Yang penting regulasi dari API
       * benar-benar tampil.
       */

      .filter(
        (item) =>
          item.judul
      )


      .sort((a, b) => {

        const tahunA =
          Number(a.tahun) || 0;

        const tahunB =
          Number(b.tahun) || 0;

        if (
          tahunA !== tahunB
        ) {

          return (
            tahunB -
            tahunA
          );

        }

        return (
          (Number(b.id) || 0) -
          (Number(a.id) || 0)
        );

      });


  console.log(
    "========================================"
  );

  console.log(
    "[API REGULASI] BERHASIL:",
    regulasi.length
  );

  console.log(
    "[API REGULASI] HASIL:",
    regulasi
  );

  console.log(
    "========================================"
  );


} catch (error) {

  console.error(
    "========================================"
  );

  console.error(
    "[API REGULASI ERROR]:",
    error
  );

  console.error(
    "========================================"
  );

  regulasi = [];

}

