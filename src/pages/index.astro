/* =========================================================
   API INSTANSI TERKAIT
========================================================= */

let partners = [];

try {
  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apinstansiterkait.php";

  const username = import.meta.env.API_BERITA_USERNAME;
  const password = import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }

  const response = await fetch(apiUrl, {
    method: "POST",
    headers: {
      username,
      password,
      Accept: "application/json",
    },
  });

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API instansi gagal: HTTP ${response.status} - ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API instansi bukan JSON: ${responseText.substring(0, 500)}`
    );
  }

  const apiData =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];

  partners = apiData
    .map((item) => ({
      id: item.id ?? null,
      nama: item.nama ?? "",
      link: item.link ?? "#",
      logo: item.logo ?? "",
      alt_logo: item.alt_logo ?? item.nama ?? "",
      aktif: item.aktif ?? 1,
      urutan: Number(item.urutan) || 999999,
      created_at: item.created_at ?? null,
      updated_at: item.updated_at ?? null,
    }))
    .filter(
      (item) =>
        item.nama &&
        Number(item.aktif) === 1
    )
    .sort((a, b) => {
      if (a.urutan !== b.urutan) {
        return a.urutan - b.urutan;
      }

      return (
        (Number(a.id) || 0) -
        (Number(b.id) || 0)
      );
    });

  console.log(
    "[API INSTANSI TERKAIT] berhasil:",
    partners
  );

} catch (error) {

  console.error(
    "[API INSTANSI TERKAIT ERROR]",
    error
  );

  partners = [];
}

