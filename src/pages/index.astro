        <div class="inv-stats">
          <div class="stat"><strong>31</strong><span>Kecamatan</span></div>
          <div class="stat y"><strong>1</strong><span>Kota Surabaya</span></div>
        </div>
        <a
          href={peta[0]?.link && peta[0].link !== "#" ? peta[0].link : "#"}
          class="btn btn-blue"
          target={peta[0]?.link && peta[0].link !== "#" ? "_blank" : undefined}
          rel={peta[0]?.link && peta[0].link !== "#" ? "noopener noreferrer" : undefined}
        >Lihat Potensi Investasi <i class="fas fa-arrow-right"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- ============ BERITA ============ -->
<section class="sec wv berita">
  <div class="wrap">
    <div class="head-row">
      <div class="head">
        <span class="eyebrow">Informasi Terkini</span>
        <h2>Berita &amp; <span class="hl">Artikel</span></h2>
        <p>Informasi terbaru DPMPTSP Kota Surabaya seputar pelayanan, perizinan, investasi dan perkembangan kota.</p>
      </div>
      <div class="arrows">
        <button type="button" id="newsPrev" aria-label="Berita sebelumnya"><i class="fas fa-arrow-left"></i></button>
        <button type="button" id="newsNext" aria-label="Berita berikutnya"><i class="fas fa-arrow-right"></i></button>
      </div>
    </div>

    {berita.length > 0 ? (
      <>
        <div class="news-main" id="newsMain">
          <div class="news-image">
            <img id="newsImage" src={`${B}/fileberita/${berita[0].picture}`} alt={berita[0].title} />
            <div class="news-badge" id="newsCategory">{berita[0].category_title || "BERITA"}</div>
          </div>
          <div class="news-content">
            <div class="news-number" id="newsNumber">01</div>
            <div class="news-meta" id="newsMeta">{berita[0].category_title || "BERITA"} • {formatDate(berita[0].date)}</div>
            <h3 id="newsTitle">{berita[0].title}</h3>
            <p id="newsDescription">{excerpt(berita[0].content)}</p>
            <a id="newsLink" href={berita[0].href} class="news-read">Baca Selengkapnya <i class="fas fa-arrow-up-right-from-square"></i></a>
            <div class="news-progress"><span id="newsProgress"></span></div>
          </div>
        </div>

        <div class="news-thumbs" id="newsThumbs">
          {berita.map((item, index) => (
            <button type="button" class:list={["news-thumb", { active: index === 0 }]} data-index={index} aria-label={item.title} title={item.title}>
              <img src={`${B}/fileberita/${item.picture}`} alt="" loading={index === 0 ? "eager" : "lazy"} />
            </button>
          ))}
        </div>

        <div class="more"><a href="/beritalist" class="btn btn-blue">Lihat Semua Berita <i class="fas fa-arrow-right"></i></a></div>
      </>
    ) : (
      <p class="empty">Belum ada berita.</p>
    )}
  </div>
</section>

<!-- ============ VIDEO ============ -->
<section class="sec wv video">
  <div class="wrap">
    <div class="head center">
      <span class="eyebrow">Media Informasi</span>
      <h2>Video <span class="hl">Terupdate</span></h2>
      <p>Ikuti perkembangan terbaru seputar investasi dan pelayanan perizinan di Kota Surabaya.</p>
    </div>

    {videos.length > 0 ? (
      <div class="vid-grid">
        {videos.map((video) => (
          <article class="vid">
            <a href={video.url_video} target="_blank" rel="noopener noreferrer" class="vid-thumb">
              <img src={video.thumbnail} alt={video.judul} loading="lazy" />
              <span class="vid-play"><i class="fas fa-play"></i></span>
              <span class="vid-status">{video.status || "VIDEO"}</span>
            </a>
            <div class="vid-body">
              <h3>{video.judul}</h3>
              {video.deskripsi && <p>{video.deskripsi}</p>}
              <a href={video.url_video} target="_blank" rel="noopener noreferrer" class="vid-watch">Tonton video <i class="fas fa-arrow-right"></i></a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty light">Belum ada video tersedia.</p>
    )}

    <div class="more"><a href="/video" class="btn btn-y">Lihat Semua Video <i class="fas fa-arrow-right"></i></a></div>
  </div>
</section>

<!-- ============ INSTANSI TERKAIT ============ -->
<section class="sec partner" id="instansi-terkait">
  <div class="wrap">
    <div class="head center">
      <span class="eyebrow">Mitra &amp; Jejaring Strategis</span>
      <h2>Instansi <span class="hl">Terkait</span></h2>
      <p>Kolaborasi lintas kementerian, lembaga, dan pemerintah daerah untuk memperkuat pelayanan publik serta ekosistem investasi Kota Surabaya.</p>
    </div>

    {partners.length > 0 ? (
      <div class="pt-grid">
        {partners.map((partner) => {
          const nama = partner?.nama || "Instansi Terkait";
          return (
            <a href={partner?.link || "#"} target="_blank" rel="noopener noreferrer" class="pt">
              <div class="pt-logo">
                {partner?.logo
                  ? <img src={partner.logo} alt={partner.alt_logo || nama} loading="lazy" onerror="this.style.display='none';" />
                  : <i class="fas fa-building"></i>}
              </div>
              <span class="pt-label">{partnerLabel(nama)}</span>
              <strong>{nama}</strong>
            </a>
          );
        })}
      </div>
    ) : (
      <p class="empty">Data instansi terkait belum tersedia.</p>
    )}
  </div>
</section>

</div>


<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700;12..96,800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap");

  :where(.home) a { color: inherit; text-decoration: none; }

  @keyframes newsProgress { from { width: 0 } to { width: 100% } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes bob { 50% { transform: translateY(-10px); } }
  @keyframes drift { 50% { transform: translate(14px, -18px) scale(1.05); } }

  /* ---- modal: buka buku ---- */
  @keyframes veilIn { from { opacity: 0; } }
  @keyframes veilOut { to { opacity: 0; } }
  @keyframes bookIn {
    from { opacity: 0; transform: translateY(46px) rotateX(16deg) scale(.86); }
  }
  @keyframes bookOut {
    to { opacity: 0; transform: translateY(30px) scale(.9); }
  }
  @keyframes coverOpen {
    0%   { transform: rotateY(0); opacity: 1; visibility: visible; }
    80%  { opacity: 1; }
    100% { transform: rotateY(-172deg); opacity: 0; visibility: hidden; }
  }
  @keyframes coverClose {
    0%   { transform: rotateY(-172deg); opacity: 0; visibility: visible; }
    20%  { opacity: 1; }
    100% { transform: rotateY(0); opacity: 1; visibility: visible; }
  }
  @keyframes pageShade {
    0%, 28% { filter: brightness(.5); }
    100% { filter: none; }
  }
  @keyframes pageFwd {
    0%   { transform: rotateY(-100deg); opacity: 0; }
    55%  { opacity: 1; }
    100% { transform: rotateY(0); opacity: 1; }
  }
  @keyframes pageBack {
    0%   { transform: rotateY(100deg); opacity: 0; }
    55%  { opacity: 1; }
    100% { transform: rotateY(0); opacity: 1; }
  }
</style>

<style>
  .home {
    --b9: #0a1b55; --b7: #173ea5; --b5: #2f63e0; --y: #ffd21f;
    --ink: #0f172a; --mut: #5b6478; --line: #d6e2fb; --bg: #eef3ff;
    --hd: "Bricolage Grotesque", "Plus Jakarta Sans", system-ui, sans-serif;
    font-family: "Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--ink); background: #fff; overflow-x: clip;
  }
  .home *, .home *::before, .home *::after { box-sizing: border-box; }
  .home img { max-width: 100%; display: block; }
  .home h1, .home h2, .home h3, .home p { margin: 0; }
  .home h1, .home h2 { font-family: var(--hd); }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 20px; position: relative; }
  .sec { position: relative; padding: 88px 0; }
  .sec.wv { padding: 96px 0; }
  .hidden { display: none; }
  .empty { text-align: center; color: var(--mut); padding: 40px 0; }
  .empty.light { color: rgba(255,255,255,.8); }
  .alert { margin-bottom: 24px; padding: 14px 18px; border-radius: 24px; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }

  /* ---------- shared ---------- */
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--b7); }
  .eyebrow::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--y); box-shadow: 0 0 0 5px rgba(255,210,31,.28); }
  .eyebrow i { display: none; }
  .head { max-width: 660px; margin-bottom: 56px; }
  .head.center { margin-inline: auto; text-align: center; }
  .head h2 { font-size: clamp(1.9rem, 3.6vw, 2.8rem); line-height: 1.12; font-weight: 800; letter-spacing: -.025em; color: var(--b9); margin: 14px 0 12px; }
  .head h2::after { content: ""; display: block; width: 64px; height: 6px; border-radius: 6px; background: var(--y); margin-top: 16px; }
  .head.center h2::after { margin-inline: auto; }
  .head p { color: var(--mut); line-height: 1.7; }
  .hl { color: var(--b5); }
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .more { display: flex; justify-content: center; margin-top: 48px; }
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 26px; border-radius: 999px; font-weight: 700; font-size: 15px; border: 1.5px solid transparent; cursor: pointer; transition: transform .2s, box-shadow .2s, background .2s; }
  .btn:hover { transform: translateY(-2px); }
  .btn-y { background: var(--y); color: var(--b9) !important; box-shadow: 0 10px 28px rgba(255,210,31,.35); }
  .btn-blue { background: var(--b7); color: #fff !important; box-shadow: 0 12px 28px rgba(23,62,165,.3); }
  .btn-blue:hover { background: var(--b9); }
  .btn-ghost { border-color: rgba(255,255,255,.45); color: #fff; }
  .btn-ghost:hover { background: rgba(255,255,255,.14); }
  .btn-sm { padding: 9px 18px; font-size: 13px; }

  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; color: #fff; padding: 72px 0 150px; border-radius: 0 0 50% 50% / 0 0 56px 56px;
    background: radial-gradient(800px 480px at 90% 0, rgba(255,210,31,.26), transparent 60%), radial-gradient(600px 400px at 0 100%, rgba(47,99,224,.5), transparent 60%), linear-gradient(135deg, var(--b9), var(--b7) 65%, #2456c9); }
  .bubble { position: absolute; border-radius: 50%; pointer-events: none; animation: drift 14s ease-in-out infinite; }
  .b1 { width: 340px; height: 340px; left: -120px; top: -120px; border: 54px solid rgba(255,255,255,.07); }
  .b2 { width: 120px; height: 120px; right: 38%; bottom: 90px; background: rgba(255,210,31,.18); animation-delay: -4s; }
  .b3 { width: 26px; height: 26px; left: 46%; top: 90px; background: var(--y); animation-delay: -8s; }
  .hero .wrap { display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 10px; padding: 8px 18px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .pill i { width: 9px; height: 9px; border-radius: 50%; background: var(--y); box-shadow: 0 0 0 4px rgba(255,210,31,.3); }
  .hero h1 { font-size: clamp(2.5rem, 5.6vw, 4.4rem); line-height: 1.04; font-weight: 800; letter-spacing: -.035em; margin: 22px 0 18px; color: #fff; text-wrap: balance; }
  .hero h1 em { font-style: normal; color: var(--y); }
  .hero-copy > p { font-size: 1.1rem; line-height: 1.7; color: rgba(255,255,255,.84); max-width: 520px; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .hero-art { position: relative; aspect-ratio: 1; max-width: 440px; width: 100%; margin-inline: auto; display: grid; place-items: center; }
  .ring { position: absolute; border-radius: 50%; border: 1px dashed rgba(255,255,255,.3); }
  .r1 { inset: 4%; animation: spin 40s linear infinite; }
  .r2 { inset: 20%; border-style: solid; border-color: rgba(255,210,31,.4); }
  .orb { position: relative; width: 52%; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: rgba(255,255,255,.96); box-shadow: 0 0 0 14px rgba(255,255,255,.1), 0 30px 70px rgba(0,0,0,.35); }
  .orb img { width: 66%; height: 66%; object-fit: contain; }
  .float { position: absolute; display: flex; align-items: center; gap: 12px; padding: 10px 20px 10px 10px; border-radius: 999px; background: rgba(255,255,255,.96); color: var(--b9); box-shadow: 0 18px 40px rgba(0,0,0,.25); animation: bob 5s ease-in-out infinite; }
  .float i { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--b7); color: var(--y); }
  .float strong { display: block; font-size: 15px; font-weight: 800; line-height: 1.2; }
  .float span { font-size: 12px; color: var(--mut); }
  .f1 { top: 6%; left: -4%; } .f2 { top: 44%; right: -6%; animation-delay: -1.5s; } .f3 { bottom: 4%; left: 4%; animation-delay: -3s; }

  /* ---------- layanan digital: ikon lingkaran ---------- */
  .svc-sec { padding: 20px 0 40px; }
  .svc-head { text-align: center; margin-bottom: 40px; }
  .svc-head h2 { margin-top: 12px; font-size: clamp(1.6rem, 2.8vw, 2.2rem); font-weight: 800; letter-spacing: -.02em; color: var(--b9); }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 36px 20px; }
  .svc { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 4px; border-radius: 28px; transition: transform .25s; }
  .svc:hover { transform: translateY(-6px); }
  .svc-ic { position: relative; width: 84px; height: 84px; margin-bottom: 10px; border-radius: 50%; display: grid; place-items: center; font-size: 30px; color: #fff;
    background: linear-gradient(145deg, var(--b5), var(--b7)); box-shadow: 0 0 0 7px var(--bg), 0 16px 30px -12px rgba(23,62,165,.55); transition: box-shadow .25s, transform .25s; }
  .svc:nth-child(even) .svc-ic { background: linear-gradient(145deg, #ffe066, var(--y)); color: var(--b9); box-shadow: 0 0 0 7px #fff8d6, 0 16px 30px -12px rgba(224,170,0,.6); }
  .svc:hover .svc-ic { transform: scale(1.08); box-shadow: 0 0 0 7px var(--y), 0 20px 34px -12px rgba(23,62,165,.55); }
  .svc-ic img { width: 56%; height: 56%; object-fit: contain; }
  .svc strong { font-size: .95rem; font-weight: 700; line-height: 1.3; color: var(--b9); }
  .svc small { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 12.5px; line-height: 1.5; color: var(--mut); max-width: 190px; }
  .svc-more { display: flex; justify-content: center; margin-top: 36px; }
  .svc-all { font-size: 14px; font-weight: 700; color: var(--b7); }
  .svc-all i { margin-left: 6px; transition: transform .2s; }
  .svc-all:hover i { transform: translateX(4px); }

  /* ---------- keunggulan: tanpa kotak ---------- */
  .keunggulan { background: linear-gradient(rgba(238,243,255,.93), rgba(238,243,255,.97)), var(--bgimg) center / cover no-repeat; }
  .ung-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px 40px; }
  .ung { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ung:nth-child(3n+2) { margin-top: 40px; }
  .ung-icon { position: relative; width: 104px; height: 104px; margin-bottom: 24px; border-radius: 50%; display: grid; place-items: center; font-size: 38px; color: var(--y);
    background: linear-gradient(145deg, var(--b5), var(--b9)); box-shadow: 0 0 0 9px rgba(23,62,165,.1), 0 22px 40px -16px rgba(10,27,85,.6); transition: transform .3s; }
  .ung-icon::before { content: ""; position: absolute; inset: -17px; border-radius: 50%; border: 2px dashed rgba(23,62,165,.35); transition: transform 1s; }
  .ung:hover .ung-icon { transform: scale(1.06); }
  .ung:hover .ung-icon::before { transform: rotate(120deg); }
  .ung-no { position: absolute; right: -6px; top: -4px; min-width: 38px; height: 38px; padding: 0 6px; border-radius: 50%; display: grid; place-items: center; font-family: var(--hd); font-size: 14px; font-weight: 800; color: var(--b9); background: var(--y); border: 3px solid #fff; }
  .ung h3 { font-size: 1.15rem; font-weight: 800; color: var(--b9); margin-bottom: 8px; }
  .ung p { color: var(--mut); font-size: .93rem; line-height: 1.7; flex: 1; max-width: 330px; }
  .keunggulan-btn { margin-top: 18px; display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border: 0; border-radius: 999px; background: #fff; box-shadow: 0 6px 18px -8px rgba(23,62,165,.5); cursor: pointer; font: inherit; font-weight: 700; font-size: 13.5px; color: var(--b7); transition: background .2s, color .2s; }
  .keunggulan-btn:hover { background: var(--b7); color: #fff; }
  .keunggulan-btn i { transition: transform .2s; }
  .keunggulan-btn:hover i { transform: translateX(3px); }
  .ung-na { margin-top: 18px; font-size: 12px; color: #a3abbd; }

  .pdf { margin-top: 56px; border-radius: 36px; overflow: hidden; background: #fff; box-shadow: 0 30px 60px -30px rgba(15,23,42,.35); }
  .pdf-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 22px; border-bottom: 1px solid var(--line); }
  .pdf-title { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .pdf-title small { display: block; font-size: 11px; color: #94a0b8; }
  .pdf-title h3 { font-size: 1rem; font-weight: 700; color: var(--b9); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pdf-ic { flex: none; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: #fef2f2; color: #ef4444; }
  .pdf-act { display: flex; align-items: center; gap: 8px; flex: none; }
  .pdf-x { width: 40px; height: 40px; border-radius: 50%; border: 0; background: #fef2f2; color: #ef4444; cursor: pointer; }
  .pdf iframe { width: 100%; height: 700px; border: 0; background: #eef1f7; display: block; }

  /* ---------- prinsip: lingkaran ---------- */
  .prinsip, .video { color: #fff; background: radial-gradient(700px 380px at 100% 0, rgba(255,210,31,.18), transparent 60%), linear-gradient(150deg, var(--b9), var(--b7)); }
  .prinsip .head h2, .video .head h2 { color: #fff; }
  .prinsip .head p, .video .head p { color: rgba(255,255,255,.82); }
  .prinsip .eyebrow, .video .eyebrow, .prinsip .hl, .video .hl { color: var(--y); }
  .pr-grid { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }
  .pr-grid::before { content: ""; position: absolute; left: 10%; right: 10%; top: 59px; border-top: 2px dashed rgba(255,210,31,.45); }
  .pr { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pr-ic { position: relative; width: 120px; height: 120px; margin-bottom: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 40px; color: var(--b9);
    background: radial-gradient(circle at 30% 25%, #fff3a8, var(--y) 60%); box-shadow: 0 0 0 10px rgba(255,210,31,.2), 0 24px 44px -14px rgba(0,0,0,.5); transition: transform .3s; }
  .pr:hover .pr-ic { transform: translateY(-8px) rotate(-5deg); }
  .pr-n { position: absolute; right: -2px; top: -2px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; font-family: var(--hd); font-size: 15px; font-weight: 800; color: #fff; background: var(--b9); border: 3px solid var(--y); }
  .pr h3 { font-size: 1.2rem; font-weight: 800; color: #fff; }
  .pr p { margin-top: 6px; font-size: .88rem; line-height: 1.55; color: rgba(255,255,255,.8); max-width: 180px; }
  .pr-tag { display: inline-block; margin-top: 14px; padding: 4px 14px; border-radius: 999px; border: 1px solid rgba(255,210,31,.55); font-size: 10.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--y); }

  /* ---------- investasi: bentuk organik ---------- */
  .inv { display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center; }
  .inv-map { position: relative; padding: 18px; }
  .inv-map::before { content: ""; position: absolute; left: -10px; bottom: -6px; width: 62%; aspect-ratio: 1; border-radius: 50%; background: var(--y); }
  .inv-map::after { content: ""; position: absolute; right: 2px; top: 2px; width: 74px; height: 74px; border-radius: 50%; border: 12px solid var(--b7); opacity: .85; }
  .inv-blob { position: relative; z-index: 1; border-radius: 24px; overflow: hidden; background: #fff; border: 6px solid #fff; box-shadow: 0 34px 70px -28px rgba(10,27,85,.55); }
  .inv-blob img { width: 100%; }
  .inv-badge { position: absolute; z-index: 2; top: 34px; left: 20px; display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgba(10,27,85,.9); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .inv-badge i { width: 8px; height: 8px; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0 4px rgba(74,222,128,.25); }
  .inv h2 { font-size: clamp(1.8rem, 3.2vw, 2.7rem); line-height: 1.12; font-weight: 800; letter-spacing: -.025em; color: var(--b9); margin: 14px 0 20px; }
  .inv h2 em { font-style: normal; color: var(--b5); }
  .inv h3 { font-size: 1.1rem; font-weight: 700; color: var(--b9); }
  .inv-body > p { margin-top: 8px; line-height: 1.75; color: var(--mut); }
  .inv-stats { display: flex; gap: 20px; margin: 30px 0 34px; }
  .stat { width: 124px; height: 124px; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #fff; background: linear-gradient(145deg, var(--b5), var(--b9)); box-shadow: 0 0 0 7px rgba(23,62,165,.1); }
  .stat.y { background: radial-gradient(circle at 30% 25%, #fff3a8, var(--y) 60%); color: var(--b9); box-shadow: 0 0 0 7px rgba(255,210,31,.25); }
  .stat strong { font-family: var(--hd); font-size: 2.2rem; font-weight: 800; line-height: 1; }
  .stat span { margin-top: 4px; font-size: 12px; font-weight: 600; opacity: .9; }

  /* ---------- berita ---------- */
  .berita { background: var(--bg); }
  .head-row .head { margin-bottom: 44px; }
  .arrows { display: flex; gap: 10px; margin-bottom: 44px; }
  .arrows button { width: 50px; height: 50px; border-radius: 50%; border: 0; background: #fff; color: var(--b7); cursor: pointer; box-shadow: 0 8px 20px -10px rgba(23,62,165,.55); transition: .2s; }
  .arrows button:hover { background: var(--b7); color: #fff; }
  .news-main { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .news-main::before { content: ""; position: absolute; left: -36px; bottom: -34px; width: 170px; height: 170px; border-radius: 50%; background: var(--y); }
  .news-image { position: relative; z-index: 1; aspect-ratio: 4 / 3; overflow: hidden; background: #dbe3f5; border-radius: 24px; border: 8px solid #fff; box-shadow: 0 34px 60px -30px rgba(23,62,165,.55); }
