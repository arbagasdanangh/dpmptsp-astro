    box-shadow:
      0 8px 30px rgba(7,48,90,.055);

    opacity: 0;

    transform:
      translateY(20px);

    animation:
      regIn .65s
      var(--delay)
      ease forwards;

    transition:
      transform .3s ease,
      box-shadow .3s ease,
      border-color .3s ease;

  }


  @keyframes regIn {

    to {

