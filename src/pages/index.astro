<script define:vars={{ berita }}>
document.addEventListener("DOMContentLoaded", () => {
  const $ = (id) => document.getElementById(id);
  const newsImage = $("newsImage");
  const newsTitle = $("newsTitle");
  if (!berita.length || !newsImage || !newsTitle) return;

  const newsCategory = $("newsCategory");
  const newsNumber = $("newsNumber");
  const newsMeta = $("newsMeta");
  const newsDescription = $("newsDescription");
  const newsLink = $("newsLink");
  const newsProgress = $("newsProgress");
  const newsPhoto = document.querySelector(".news-image");
  const newsThumbs = Array.from(document.querySelectorAll(".news-thumb"));
  const thumbsBox = $("newsThumbs");

  let newsIndex = 0;
  let newsTimer = null;

  const cleanText = (v) => !v ? "" : String(v)
    .replace(/<[^>]*>/g, "").replace(/&nbsp;/gi, " ").replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"').replace(/&#39;/gi, "'").replace(/\s+/g, " ").trim();

  const shortText = (v) => {
    const t = cleanText(v);
    return t.length <= 220 ? t : t.substring(0, 220) + "...";
  };

  const dateText = (v) => {
    if (!v) return "";
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? v
      : d.toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" });
  };

  function renderNews(index) {
    newsIndex = (index + berita.length) % berita.length;
    const item = berita[newsIndex];
    newsPhoto?.classList.add("switching");

    setTimeout(() => {
      newsImage.src = item.picture ? `https://dpm-ptsp.surabaya.go.id/fileberita/${item.picture}` : "";
      newsImage.alt = item.title || "Berita";
      newsCategory.textContent = item.category_title || "BERITA";
      newsNumber.textContent = String(newsIndex + 1).padStart(2, "0");
      newsMeta.textContent = `${item.category_title || "BERITA"} • ${dateText(item.date)}`;
      newsTitle.textContent = item.title || "";
      newsDescription.textContent = shortText(item.content);
      newsLink.href = item.href || "#";

      newsThumbs.forEach((t, i) => {
        t.classList.toggle("active", i === newsIndex);
        if (i === newsIndex && thumbsBox) {
          // geser hanya baris thumbnail, bukan seluruh halaman
          const left = t.offsetLeft - (thumbsBox.clientWidth - t.clientWidth) / 2;
          thumbsBox.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
        }
      });

      if (newsProgress) {
        newsProgress.style.animation = "none";
        void newsProgress.offsetWidth;
        newsProgress.style.animation = "newsProgress 5s linear";
      }
      newsPhoto?.classList.remove("switching");
    }, 180);
  }

  function restartNews() {
    clearInterval(newsTimer);
    if (berita.length > 1) newsTimer = setInterval(() => renderNews(newsIndex + 1), 5000);
  }

  const go = (i) => { renderNews(i); restartNews(); };

  newsThumbs.forEach((t, i) => t.addEventListener("click", () => go(i)));
  $("newsNext")?.addEventListener("click", () => go(newsIndex + 1));
  $("newsPrev")?.addEventListener("click", () => go(newsIndex - 1));

  let startX = 0;
  newsPhoto?.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
  newsPhoto?.addEventListener("touchend", (e) => {
    const dist = startX - e.changedTouches[0].clientX;
    if (Math.abs(dist) < 50) return;
    go(newsIndex + (dist > 0 ? 1 : -1));
  }, { passive: true });

  renderNews(0);
  restartNews();
});
</script>

<script>
/* =====================================================
   MODAL NOTIFIKASI: buka & tutup seperti buku
===================================================== */
const modal = document.getElementById("notificationModal");

if (modal) {
  const slider = modal.querySelector("#notificationSlider");
  const slides = Array.from(modal.querySelectorAll(".notification-slide"));
  const counter = modal.querySelector("#notificationCounter");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  let current = 0;
  let closing = false;

  document.body.style.overflow = "hidden";

  function show(index, dir = 1) {
    if (slides.length < 2) return;
    const next = (index + slides.length) % slides.length;
    if (next === current) return;

    // maju = engsel di kiri, mundur = engsel di kanan
    slider.classList.toggle("back", dir < 0);

    slides.forEach((s, i) => {
      s.classList.remove("flip");
      s.classList.toggle("active", i === next);
    });
    void slides[next].offsetWidth;
    if (!reduce) slides[next].classList.add("flip");
    if (counter) counter.textContent = `${next + 1} / ${slides.length}`;

    current = next;
    slider.scrollTop = 0;
  }

  function closeBook() {
    if (closing) return;
    closing = true;
    modal.classList.add("closing");
    modal.setAttribute("aria-hidden", "true");
    setTimeout(() => {
      modal.style.display = "none";
      document.body.style.overflow = "";
    }, reduce ? 0 : 1300);
  }

  modal.addEventListener("click", (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;

    if (t.closest("#notificationNext")) { e.preventDefault(); show(current + 1, 1); return; }
    if (t.closest("#notificationPrev")) { e.preventDefault(); show(current - 1, -1); return; }

    if (t.closest("#notificationClose") || t.closest(".notification-later")) {
      e.preventDefault();
      closeBook();
      return;
    }

    // klik area gelap di luar buku
    if (t === modal || t.classList.contains("book-wrap")) closeBook();
  });

  document.addEventListener("keydown", (e) => {
    if (closing || modal.style.display === "none") return;
    if (e.key === "Escape") closeBook();
    if (e.key === "ArrowRight") show(current + 1, 1);
    if (e.key === "ArrowLeft") show(current - 1, -1);
  });
}
</script>

<script>
/* =====================================================
   PDF KEUNGGULAN
===================================================== */
document.addEventListener("DOMContentLoaded", () => {
  const dropdown = document.getElementById("keunggulanDropdown");
  const pdfFrame = document.getElementById("keunggulanPdf");
  const title = document.getElementById("keunggulanTitle");
  const download = document.getElementById("keunggulanDownload");
  const closeBtn = document.getElementById("keunggulanClose");

  let activeButton = null;
  let buttonViewportTop = 0;

  document.querySelectorAll(".keunggulan-btn").forEach((button) => {
    button.addEventListener("click", () => {
      activeButton = button;
      buttonViewportTop = button.getBoundingClientRect().top;

      const pdfLink = button.dataset.link;
      title.textContent = button.dataset.title;
      pdfFrame.src = pdfLink;
      download.href = pdfLink;
      dropdown.classList.remove("hidden");

      setTimeout(() => dropdown.scrollIntoView({ behavior: "smooth", block: "start" }), 100);
    });
  });

  closeBtn?.addEventListener("click", () => {
    dropdown.classList.add("hidden");
    pdfFrame.src = "";

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (!activeButton) return;
        const diff = activeButton.getBoundingClientRect().top - buttonViewportTop;
        window.scrollBy({ top: diff, behavior: "smooth" });
      });
    });
  });
});
</script>
