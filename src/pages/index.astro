      <p class="empty">Data keunggulan investasi belum tersedia.</p>
    )}

    <div id="keunggulanPdfArea">
      <div id="keunggulanDropdown" class="pdf hidden">
        <div class="pdf-bar">
          <div class="pdf-title">
            <span class="pdf-ic"><i class="fas fa-file-pdf"></i></span>
            <div><small>Informasi Keunggulan</small><h3 id="keunggulanTitle">Informasi Keunggulan</h3></div>
          </div>
          <div class="pdf-act">
            <a id="keunggulanDownload" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-y btn-sm"><i class="fas fa-download"></i> Download</a>
            <button id="keunggulanClose" type="button" class="pdf-x" aria-label="Tutup"><i class="fas fa-xmark"></i></button>
          </div>
        </div>
