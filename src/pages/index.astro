/* =========================================================
   NOTIFIKASI DARI JSON API
   API: https://dpm-ptsp.surabaya.go.id/sso/apinotifikasi.php
========================================================= */

let notifikasi = [];

try {
  const apiUrl =
    "https://dpm-ptsp.surabaya.go.id/sso/apinotifikasi.php";

  const username = import.meta.env.API_BERITA_USERNAME;
  const password = import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }

  const response = await fetch(apiUrl, {
    method: "POST",
    headers: {
      username,
      password,
      Accept: "application/json",
    },
  });

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API notifikasi gagal: HTTP ${response.status} - ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API notifikasi bukan JSON: ${responseText.substring(0, 500)}`
    );
  }

  const apiData = Array.isArray(payload)
    ? payload
    : Array.isArray(payload?.data)
      ? payload.data
      : Array.isArray(payload?.results)
        ? payload.results
        : [];

  notifikasi = apiData
    .map((item) => ({
      id: item.id ?? null,
      judul: item.judul ?? "",
      isi: item.isi ?? "",
      gambar: item.gambar ?? "",
      tipe: item.tipe ?? "info",
      icon: item.icon ?? "fa-circle-info",
      link: item.link ?? "#",
      teks_link: item.teks_link ?? "Selengkapnya",
      active: item.active ?? "Y",
      mulai: item.mulai ?? null,
      selesai: item.selesai ?? null,
      urutan: Number(item.urutan) || 999999,
      created_at: item.created_at ?? null,
    }))
    .filter(
      (item) =>
        item.judul &&
        String(item.active).toUpperCase() === "Y"
    )
    .sort((a, b) => {
      if (a.urutan !== b.urutan) {
        return a.urutan - b.urutan;
      }

      return (Number(b.id) || 0) - (Number(a.id) || 0);
    });

  console.log(
    "[API NOTIFIKASI] berhasil:",
    notifikasi
  );

} catch (error) {
  console.error(
    "[API NOTIFIKASI ERROR]",
    error
  );

  notifikasi = [];
}


/* =========================================================
   REGULASI DARI JSON API

   API:
   https://dpm-ptsp.surabaya.go.id/sso/apiregulasi.php

   Mulai:
