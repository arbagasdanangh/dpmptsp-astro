      </div>
    </div>
  </div>
</section>

<!-- ============ PRINSIP ============ -->
<section class="sec wv prinsip">
  <div class="wrap">
    <div class="head center">
      <span class="eyebrow">Nilai Pelayanan Publik</span>
      <h2>5 prinsip. <span class="hl">Satu komitmen.</span></h2>
      <p>Pelayanan DPMPTSP Surabaya dibangun untuk memberikan pengalaman yang cepat, mudah, transparan, dan berintegritas bagi masyarakat.</p>
    </div>
    <div class="pr-grid">
      {principles.map((p) => (
        <div class="pr">
          <div class="pr-ic">
            <i class={`fas ${p.i}`}></i>
            <span class="pr-n">{p.n}</span>
          </div>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
          <span class="pr-tag">{p.tag}</span>
        </div>
