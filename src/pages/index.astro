}


/* =====================================================
   GRID
===================================================== */

.video-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 24px;
}


/* =====================================================
   CARD
===================================================== */

.video-card {
  overflow: hidden;

  border: 1px solid #e3eaf2;

  border-radius: 18px;

  background: #fff;

