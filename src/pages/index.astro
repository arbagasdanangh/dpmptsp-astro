<script>
  const buttons =
    document.querySelectorAll(".keunggulan-btn");

  const dropdown =
    document.getElementById("keunggulanDropdown");

  const pdf =
    document.getElementById("keunggulanPdf");

  const title =
    document.getElementById("keunggulanTitle");

  const download =
    document.getElementById("keunggulanDownload");

  const close =
    document.getElementById("keunggulanClose");


  buttons.forEach((button) => {

    button.addEventListener("click", () => {

      const link =
        button.getAttribute("data-link");

      const nama =
        button.getAttribute("data-title") ||
        "Informasi Keunggulan";


      if (!link || link === "#") {
        return;
      }


      /* Judul */

      title.textContent = nama;


      /* PDF */

      pdf.src = link;


      /* Download */

      download.href = link;


      /* Tampilkan */

      dropdown.classList.remove("hidden");


      /* Scroll */

      setTimeout(() => {

        dropdown.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });

      }, 100);

    });

  });


  /* =====================================================
     TUTUP
  ====================================================== */

  close?.addEventListener("click", () => {

    dropdown.classList.add("hidden");

    pdf.src = "";

  });
</script>

