  align-items: center;

  gap: 9px;

  color: #0878c9;

  text-decoration: none;

  font-size: 13px;

  font-weight: 800;
}

.video-watch strong {
  font-size: 17px;

  font-weight: 400;

  transition:
    transform .25s ease;
}

.video-watch:hover {
  color: #082b57;
}

.video-watch:hover strong {
  transform:
    translateX(5px);
}


/* =====================================================
   FOOTER
===================================================== */

.video-footer {
  display: flex;

  justify-content: center;

  margin-top: 38px;
}

.video-all {
  display: inline-flex;

