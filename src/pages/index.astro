---
import MainLayout from "../layouts/MainLayout.astro";
import HeroInovasi from "../components/HeroInovasi.astro";
import { slugify } from "../utils/slugify";
import { callApi, safeApi, today } from "../lib/api.js";

export const prerender = false;

const bgInvestasi = `/bgkeunggulan.jpeg`;
const watermarkLogo =
  "https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true";

const awal = "2024-01-01";
const akhir = today();
const tahun = akhir.slice(0, 4);

/* ---------- HELPER ---------- */

function stripHtml(value) {
  if (!value) return "";
  return String(value)
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function excerpt(value, length = 220) {
  const text = stripHtml(value);
  return text.length <= length ? text : text.substring(0, length).trim() + "...";
}

function formatDate(value) {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" });
}

const byUrutan = (a, b) => a.urutan - b.urutan || (Number(a.id) || 0) - (Number(b.id) || 0);
const toTime = (d, t = "") => new Date(`${d || ""} ${t || ""}`).getTime() || 0;

/* ---------- AMBIL SEMUA DATA SEKALIGUS (paralel) ---------- */

let apiError = "";

const [
  rawPartners,
  rawNotifikasi,
  rawBerita,
  rawUnggul,
  rawVideos,
  rawPeta,
  rawAplikasi,
] = await Promise.all([
  safeApi("apinstansiterkait.php"),
  safeApi("apinotifikasi.php"),
  safeApi("apiberita.php", { awal, akhir, id_category: "", active: "", headline: "" }),
  callApi("apikeunggulan.php", { awal: `${tahun}-01-01`, akhir: `${tahun}-12-31` }).catch((e) => {
    apiError = e instanceof Error ? e.message : "Gagal mengambil data API";
    return [];
  }),
  safeApi("apivideo.php"),
  safeApi("apipetapotensi.php"),
  safeApi("apiaplikasi.php", { awal, akhir }),
]);

/* ---------- INSTANSI TERKAIT ---------- */

const partners = rawPartners
  .map((i) => ({
    id: i.id ?? null,
    nama: i.nama ?? "",
    link: i.link ?? "#",
    logo: i.logo ?? "",
    alt_logo: i.alt_logo ?? i.nama ?? "",
    aktif: i.aktif ?? 1,
    urutan: Number(i.urutan) || 999999,
  }))
  .filter((i) => i.nama && Number(i.aktif) === 1)
  .sort(byUrutan);

/* ---------- NOTIFIKASI ---------- */

const notifikasi = rawNotifikasi
  .map((i) => ({
    id: i.id ?? null,
    judul: i.judul ?? "",
    isi: i.isi ?? "",
    gambar: i.gambar ?? "",
    tipe: i.tipe ?? "info",
    icon: i.icon ?? "fa-circle-info",
    link: i.link ?? "#",
    teks_link: i.teks_link ?? "Selengkapnya",
    active: i.active ?? "Y",
    urutan: Number(i.urutan) || 999999,
  }))
  .filter((i) => i.judul && String(i.active).toUpperCase() === "Y")
  .sort((a, b) => a.urutan - b.urutan || (Number(b.id) || 0) - (Number(a.id) || 0));

/* ---------- BERITA ---------- */
/* slug dihitung DI SINI (server), supaya script di browser tidak
   perlu memanggil slugify() yang tidak ada di browser. */

const berita = rawBerita
  .map((i) => {
    const title = i.title ?? i.judul ?? "";
    return {
      id_post: i.id_post ?? i.id ?? null,
      id_category: i.id_category ?? null,
      title,
      content: i.content ?? i.isi ?? "",
      seotitle: i.seotitle ?? i.slug ?? "",
      slug: slugify(i.seotitle || i.slug || title),
      date: i.date ?? i.tanggal ?? i.created_at ?? null,
      time: i.time ?? i.jam ?? null,
      picture: i.picture ?? i.gambar ?? i.image ?? "",
      hits: i.hits ?? i.view ?? i.views ?? 0,
      category_title: i.category_title ?? i.category ?? i.nama_category ?? "BERITA",
    };
  })
  .filter((i) => i.title)
  .sort((a, b) => toTime(b.date, b.time) - toTime(a.date, a.time))
  .slice(0, 10);

/* ---------- KEUNGGULAN ---------- */

const unggul = rawUnggul.map((i) => ({
  id: i?.id ?? null,
  judul: i?.judul ?? i?.title ?? "",
  deskripsi: i?.deskripsi ?? i?.description ?? "",
  icon: i?.icon ?? "fas fa-star",
  warna_icon: i?.warna_icon ?? "blue-600",
  warna_bg: i?.warna_bg ?? "blue-100",
  link: i?.link ?? "#",
  tanggal: i?.tanggal ?? "",
}));

/* ---------- VIDEO ---------- */

const videos = rawVideos
  .map((i) => ({
    id: i.id ?? null,
    judul: i.judul ?? "",
    deskripsi: i.deskripsi ?? "",
    thumbnail: i.thumbnail ?? "",
    url_video: i.url_video ?? "#",
    status: i.status ?? "VIDEO",
    tanggal: i.tanggal ?? null,
    created_at: i.created_at ?? null,
  }))
  .filter((i) => i.judul)
  .sort((a, b) => toTime(b.tanggal || b.created_at) - toTime(a.tanggal || a.created_at))
  .slice(0, 6);

/* ---------- PETA POTENSI ---------- */

const peta = rawPeta
  .map((i) => ({
    id: i?.id ?? i?.id_peta ?? i?.id_potensi ?? null,
    judul: i?.judul ?? i?.Judul ?? i?.title ?? i?.nama ?? i?.nama_peta ?? i?.nama_potensi ?? "",
    deskripsi: i?.deskripsi ?? i?.Deskripsi ?? i?.description ?? i?.keterangan ?? i?.desc ?? "",
    gambar: i?.gambar ?? i?.foto ?? i?.image ?? i?.img ?? i?.foto_peta ?? "",
    link: i?.link ?? i?.url ?? i?.href ?? i?.url_peta ?? "#",
    wilayah_unggulan:
      i?.wilayah_unggulan ?? i?.wilayahUnggulan ?? i?.wilayah ?? i?.wilayah_unggulan_investasi ?? "",
  }))
  .filter((i) => i.judul || i.deskripsi || i.gambar || i.wilayah_unggulan || i.link !== "#");

/* ---------- APLIKASI ---------- */

const aplikasi = rawAplikasi
  .map((i) => ({
    id: i.id ?? i.id_aplikasi ?? null,
    nama: i.nama_aplikasi ?? i.nama ?? i.title ?? i.judul ?? i.name ?? i.label ?? "",
    deskripsi: i.deskripsi ?? i.description ?? i.keterangan ?? i.desc ?? "",
    url: i.url_aplikasi ?? i.link_aplikasi ?? i.url ?? i.link ?? i.href ?? i.website ?? "",
    icon: i.icon_aplikasi ?? i.icon ?? i.logo ?? i.gambar ?? i.image ?? "",
    target: i.target ?? "_blank",
    urutan: Number(i.urutan ?? i.order ?? i.sort_order ?? i.position ?? 999999) || 999999,
  }))
  .filter((i) => i.nama)
  .sort((a, b) => a.urutan - b.urutan);

/* ---------- Variabel lama yang tidak dipakai database lagi ----------
   slider & renstra dulu dari db (sudah di-comment, jadi selalu kosong).
   Dibiarkan kosong supaya template lama tidak error. */
const slider = [];
const renstra = [];
---

// src/lib/api.js
const BASE = "https://dpm-ptsp.surabaya.go.id/sso/";

/** Tanggal hari ini (WIB) format YYYY-MM-DD */
export function today() {
  return new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Jakarta" });
}

/** Ambil array dari berbagai bentuk response */
function extractList(payload) {
  if (Array.isArray(payload)) return payload;
  for (const key of ["data", "results", "result", "items", "rows"]) {
    if (Array.isArray(payload?.[key])) return payload[key];
  }
  return [];
}

/**
 * Panggil satu endpoint. Melempar error kalau gagal.
 * params = null  -> POST tanpa body
 * params = {...} -> POST form-urlencoded
 */
export async function callApi(endpoint, params = null) {
  const username = import.meta.env.API_BERITA_USERNAME;
  const password = import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error("API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset");
  }

  const headers = { username, password, Accept: "application/json" };
  const init = { method: "POST", headers };

  if (params) {
    headers["Content-Type"] = "application/x-www-form-urlencoded";
    init.body = new URLSearchParams(params).toString();
  }

  const res = await fetch(BASE + endpoint, init);
  const text = await res.text();

  if (!res.ok) throw new Error(`${endpoint}: HTTP ${res.status} - ${text.slice(0, 300)}`);

  let payload;
  try {
    payload = JSON.parse(text);
  } catch {
    throw new Error(`${endpoint}: response bukan JSON - ${text.slice(0, 300)}`);
  }

  const list = extractList(payload);
  // beberapa endpoint (peta) bisa mengembalikan satu objek
  if (!list.length && payload && typeof payload === "object" && (payload.judul || payload.title)) {
    return [payload];
  }
  return list;
}

/** Sama seperti callApi, tapi tidak pernah melempar error: hasilnya [] */
export async function safeApi(endpoint, params = null) {
  try {
    return await callApi(endpoint, params);
  } catch (error) {
    console.error(`[API ERROR] ${endpoint}`, error);
    return [];
  }
}

---
/**
 * HeroInovasi.astro
 * Pemakaian di index.astro:
 *   import HeroInovasi from "../components/HeroInovasi.astro";
 *   <HeroInovasi apps={aplikasi} />
 */
const { apps = [] } = Astro.props;
const list = apps.slice(0, 5);

const isImage = (v) =>
  /^(\/|https?:)/.test(String(v)) ||
  /\.(png|jpe?g|webp|svg|gif)(\?.*)?$/i.test(String(v));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-kicker">DPMPTSP Kota Surabaya</p>
      <h1 id="hero-title">
        Urus perizinan dan investasi dari <em>satu layar.</em>
      </h1>
      <p class="hero-lead">
        Aplikasi resmi untuk mengurus izin, memantau status, dan menyampaikan
        pengaduan, kapan saja tanpa antre.
      </p>
      <a href="/inovasi" class="hero-cta">Lihat semua aplikasi</a>
    </div>

    <ul class="hero-apps" aria-label="Aplikasi unggulan">
      {list.map((app, i) => (
        <li class:list={["app", { "app-main": i === 0 }]}>
          <a
            href={app.url || "#"}
            target={app.target || "_self"}
            rel={app.target === "_blank" ? "noopener noreferrer" : undefined}
          >
            <span class="app-icon">
              {app.icon ? (
                isImage(app.icon) ? (
                  <img src={app.icon} alt="" loading="lazy" />
                ) : (
                  <i class={app.icon}></i>
                )
              ) : (
                <i class="fas fa-layer-group"></i>
              )}
            </span>
            <span class="app-text">
              <strong>{app.nama || "Aplikasi"}</strong>
              <small>{app.deskripsi || "Layanan digital untuk masyarakat Surabaya."}</small>
            </span>
            <span class="app-go" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    --navy: #062a7d;
    --blue: #0b4dcc;
    --yellow: #ffc900;
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(60% 80% at 85% 20%, rgba(40, 110, 230, .45), transparent 70%),
      linear-gradient(135deg, #04205f 0%, var(--navy) 55%, #0a45b0 100%);
  }

  /* satu aksen kuning: busur di pojok kanan bawah */
  .hero::after {
    content: "";
    position: absolute;
    right: -140px;
    bottom: -260px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: var(--yellow);
    opacity: .95;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: center;
    gap: 64px;
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: 96px 32px;
  }

  .hero-kicker {
    margin: 0 0 18px;
    font-size: 15px;
    font-weight: 700;
    color: var(--yellow);
  }

  .hero h1 {
    margin: 0;
    max-width: 14ch;
    font-size: clamp(38px, 4.6vw, 64px);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -.02em;
  }

  .hero h1 em {
    font-style: normal;
    box-shadow: inset 0 -.28em 0 rgba(255, 201, 0, .55);
  }

  .hero-lead {
    max-width: 44ch;
    margin: 24px 0 0;
    font-size: 17px;
    line-height: 1.65;
    color: rgba(255, 255, 255, .86);
  }

  .hero-cta {
    display: inline-block;
    margin-top: 32px;
    padding: 15px 28px;
    border-radius: 12px;
    background: var(--yellow);
    color: var(--navy);
    font-weight: 800;
    text-decoration: none;
    transition: transform .2s ease, background .2s ease;
  }
  .hero-cta:hover { background: #fff; transform: translateY(-2px); }
  .hero-cta:focus-visible,
  .app a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  /* ===== daftar aplikasi ===== */
  .hero-apps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .app a {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 100%;
    padding: 22px;
    border-radius: 20px;
    background: #fff;
    color: var(--navy);
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(0, 15, 70, .25);
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .app a:hover {
    transform: translateY(-5px);
    box-shadow: 0 24px 50px rgba(0, 15, 70, .35);
  }

  .app-icon {
    flex: 0 0 50px;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #eaf1ff;
    color: var(--blue);
    font-size: 22px;
  }
  .app-icon img { width: 30px; height: 30px; object-fit: contain; }

  .app-text { display: grid; gap: 6px; min-width: 0; padding-right: 24px; }
  .app-text strong { font-size: 16px; line-height: 1.25; font-weight: 800; }
  .app-text small {
    font-size: 13px;
    line-height: 1.5;
    color: #566179;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .app-go {
    position: absolute;
    right: 18px;
    bottom: 18px;
    font-size: 13px;
    color: var(--blue);
    transition: transform .25s ease;
  }
  .app a:hover .app-go { transform: translateX(4px); }

  /* kartu utama: satu-satunya yang menonjol */
  .app-main { grid-column: 1 / -1; }
  .app-main a {
    padding: 28px;
    border: 2px solid var(--yellow);
    background: linear-gradient(135deg, #fff, #f3f7ff);
  }
  .app-main .app-icon {
    flex-basis: 68px;
    width: 68px;
    height: 68px;
    border-radius: 18px;
    font-size: 30px;
    background: var(--yellow);
    color: var(--navy);
  }
  .app-main .app-text strong { font-size: 21px; }
  .app-main .app-text small { font-size: 14px; -webkit-line-clamp: 3; }
  .app-main .app-go { font-size: 16px; right: 24px; bottom: 24px; }

  /* gerakan hanya saat halaman dibuka, satu kali */
  @media (prefers-reduced-motion: no-preference) {
    .app { animation: rise .6s cubic-bezier(.2, .8, .2, 1) backwards; }
    .app:nth-child(2) { animation-delay: .08s; }
    .app:nth-child(3) { animation-delay: .14s; }
    .app:nth-child(4) { animation-delay: .20s; }
    .app:nth-child(5) { animation-delay: .26s; }
    @keyframes rise { from { opacity: 0; transform: translateY(24px); } }
  }

  /* ===== tablet ===== */
  @media (max-width: 980px) {
    .hero-inner { grid-template-columns: 1fr; gap: 44px; padding: 72px 24px; }
    .hero h1 { max-width: 18ch; }
  }

  /* ===== mobile: kartu digeser ke samping ===== */
  @media (max-width: 600px) {
    .hero-inner { padding: 56px 0 64px; gap: 36px; }
    .hero-copy { padding: 0 20px; }
    .hero-lead { font-size: 15px; }

    .hero-apps {
      display: flex;
      gap: 12px;
      padding: 6px 20px 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .hero-apps::-webkit-scrollbar { display: none; }
    .app { flex: 0 0 82%; scroll-snap-align: center; }
    .app a { min-height: 150px; }
    .hero::after { width: 320px; height: 320px; right: -120px; bottom: -180px; }
  }
</style>
