  right: 110px;
  top: 5px;
  color: rgba(255,255,255,.075);
  font-size: 78px;
  font-weight: 800;
  letter-spacing: 15px;
  pointer-events: none;
}

/* ===== CARDS ===== */
.carousel-wrap {
  position: relative;
}

.cards {
  display: grid;
  gap: 20px;
}

.news-cards {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.article-cards {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.news-card,
.article-card {
  overflow: hidden;
  border-radius: 18px;
  background: white;
  color: var(--text);
  border: 1px solid rgba(255,255,255,.35);
  box-shadow: var(--shadow);
  transition: transform .25s ease, box-shadow .25s ease;
}

.news-card:hover,
.article-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 18px 38px rgba(3, 39, 105, .17);
}

.card-image {
  height: 205px;
  position: relative;
  overflow: hidden;
  background: #dce6f7;
}

.card-image img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform .4s ease;
}

.news-card:hover .card-image img,
.article-card:hover .card-image img {
  transform: scale(1.045);
}

.badge {
  position: absolute;
  left: 15px;
  top: 15px;
  padding: 8px 13px;
  border-radius: 30px;
  background: var(--yellow);
  color: #082e77;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .5px;
}

.blue-badge {
  background: var(--blue);
  color: white;
}

.card-body {
  padding: 18px 18px 20px;
}

.date {
  font-size: 11px;
  font-weight: 600;
  color: #63749a;
  margin-bottom: 10px;
}

.card-body h2 {
  margin: 0;
  font-size: 17px;
  line-height: 1.35;
  letter-spacing: -.25px;
  font-weight: 800;
}

.card-body p {
  color: #61718f;
  font-size: 12px;
  line-height: 1.65;
  margin: 10px 0 15px;
}

.card-body a {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--blue);
  font-size: 12px;
  font-weight: 800;
}

.card-body a span {
  display: inline-flex;
  width: 28px;
  height: 28px;
  border: 1px solid #d7e1f4;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  transition: .2s;
}

.card-body a:hover span {
  background: var(--blue);
  color: white;
  border-color: var(--blue);
}

/* ===== ARROWS ===== */
.carousel-arrow {
  position: absolute;
  top: 50%;
  z-index: 4;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border: 1px solid #dbe5f5;
  background: white;
  color: var(--blue);
  border-radius: 50%;
  box-shadow: 0 8px 20px rgba(0,0,0,.12);
  font-size: 32px;
  line-height: 35px;
  display: grid;
  place-items: center;
}

.carousel-arrow.left { left: -22px; }
.carousel-arrow.right { right: -22px; }

.carousel-arrow:hover {
  background: var(--yellow);
  color: var(--deep-blue);
  border-color: var(--yellow);
}

/* ===== DOTS ===== */
.dots {
  display: flex;
  justify-content: center;
  gap: 7px;
  margin-top: 24px;
}

.dots button {
  width: 7px;
  height: 7px;
  border: 0;
  border-radius: 50%;
  background: #c8d3e8;
  padding: 0;
}

.berita-section .dots button.active {
  background: var(--yellow);
  width: 22px;
  border-radius: 10px;
}

.article-section .dots button.active,
.artikel-section .dots button.active {
  background: var(--blue);
  width: 22px;
  border-radius: 10px;
}

/* ===== ARTIKEL BACKGROUND ===== */
.artikel-section {
  background:
    radial-gradient(circle at 10% 15%, rgba(11,77,204,.07) 0 2px, transparent 3px),
    radial-gradient(circle at 90% 80%, rgba(251,189,24,.16) 0 3px, transparent 4px),
    #fff;
}

.artikel-section::before {
  content: "";
  position: absolute;
  width: 240px;
  height: 240px;
  left: -120px;
  bottom: -100px;
  border: 28px solid rgba(11,77,204,.035);
  border-radius: 50%;
}

.artikel-section::after {
  content: "";
  position: absolute;
  width: 180px;
  height: 180px;
  right: -80px;
  top: 80px;
  background: rgba(251,189,24,.10);
  border-radius: 50%;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1100px) {
  .news-cards { grid-template-columns: repeat(2, 1fr); }
  .article-cards { grid-template-columns: repeat(2, 1fr); }
  .berita-section .section-inner::before { display: none; }
}

@media (max-width: 700px) {
  .content-section { padding: 42px 0 50px; }
  .section-inner { width: min(100% - 30px, 560px); }
  .section-heading {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 22px;
  }
  .view-all { align-self: stretch; justify-content: center; }
  .news-cards,
  .article-cards { grid-template-columns: 1fr; }
  .carousel-arrow { display: none; }
  .card-image { height: 190px; }
}

