<!-- =========================================================
     JAVASCRIPT TAB
========================================================= -->

<script>
  const tabs =
    document.querySelectorAll(
      ".pelayanan-tab"
    );

  const panels =
    document.querySelectorAll(
      ".pelayanan-panel"
    );

  function activateTab(
    key
  ) {

    tabs.forEach((tab) => {

      const active =
        tab.dataset.tab === key;

      tab.classList.toggle(
        "bg-blue-600",
        active
      );

      tab.classList.toggle(
        "text-white",
        active
      );

      tab.classList.toggle(
        "shadow-lg",
        active
      );

      tab.classList.toggle(
        "shadow-blue-200",
        active
      );

      tab.classList.toggle(
        "bg-gray-100",
        !active
      );

      tab.classList.toggle(
        "text-gray-700",
        !active
      );

    });


    panels.forEach(
      (panel) => {

        panel.classList.toggle(
          "hidden",
          panel.dataset.panel !== key
        );

      }
    );
  }


  tabs.forEach(
    (tab) => {

      tab.addEventListener(
        "click",
        () => {

          activateTab(
            tab.dataset.tab
          );

        }
      );

    }
  );


  /* =======================================================
     DROPDOWN MOBILE
  ======================================================= */

  const select =
    document.querySelector(
      "#pelayanan-select"
    );

  if (select) {

    select.addEventListener(
      "change",
      () => {

        activateTab(
          select.value
        );

      }
    );

  }


  /* =======================================================
     SSW / OSS
  ======================================================= */

  const serviceButtons =
    document.querySelectorAll(
      ".service-switch"
    );

  const sswFrame =
    document.querySelector(
      "#ssw-frame"
    );

  const ossFrame =
    document.querySelector(
      "#oss-frame"
    );

  serviceButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          const service =
            button.dataset.service;

          serviceButtons.forEach(
            (btn) => {

              btn.classList.remove(
                "bg-blue-600",
                "text-white"
              );

              btn.classList.add(
                "bg-gray-100",
                "text-gray-700"
              );

            }
          );


          button.classList.remove(
            "bg-gray-100",
            "text-gray-700"
          );

          button.classList.add(
            "bg-blue-600",
            "text-white"
          );


          if (service === "ssw") {

            sswFrame?.classList.remove(
              "hidden"
            );

            ossFrame?.classList.add(
              "hidden"
            );

          } else {

            ossFrame?.classList.remove(
              "hidden"
            );

            sswFrame?.classList.add(
              "hidden"
            );

          }

        }
      );

    }
  );
</script>




