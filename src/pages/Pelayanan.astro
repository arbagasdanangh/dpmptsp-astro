---
import MainLayout from "../layouts/MainLayout.astro";

export const prerender = false;

/* =========================================================
   CONFIG API
========================================================= */

const API_USERNAME = import.meta.env.API_BERITA_USERNAME;
const API_PASSWORD = import.meta.env.API_BERITA_PASSWORD;

const API_HEADERS = {
  username: API_USERNAME,
  password: API_PASSWORD,
  Accept: "application/json",
};

/* =========================================================
   HELPER PARSE API
========================================================= */

function getApiArray(payload) {
  if (Array.isArray(payload)) {
    return payload;
  }

  if (Array.isArray(payload?.data)) {
    return payload.data;
  }

  if (Array.isArray(payload?.results)) {
    return payload.results;
  }

  if (Array.isArray(payload?.result)) {
    return payload.result;
  }

  if (Array.isArray(payload?.items)) {
    return payload.items;
  }

  if (Array.isArray(payload?.rows)) {
    return payload.rows;
  }

  if (
    payload &&
    typeof payload === "object" &&
    payload.id
  ) {
    return [payload];
  }

  return [];
}


/* =========================================================
   API INFORMASI SECTION
   https://dpm-ptsp.surabaya.go.id/sso/apiinformasi-sec.php
========================================================= */

let informasiSec = null;
let informasiSecError = "";

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiinformasi-sec.php",
    {
      method: "POST",
      headers: API_HEADERS,
    }
  );

  const responseText = await response.text();

  console.log(
    "[API INFORMASI SEC]",
    response.status,
    responseText
  );

  if (!response.ok) {
    throw new Error(
      `HTTP ${response.status}`
    );
  }

  const payload =
    JSON.parse(responseText);

  const data =
    getApiArray(payload);

  const aktif =
    data
      .filter(
        (item) =>
          Number(item?.status ?? 1) === 1
      )
      .sort(
        (a, b) =>
          Number(a?.urutan ?? 999) -
          Number(b?.urutan ?? 999)
      );

  informasiSec =
    aktif[0] ?? null;

} catch (error) {
  console.error(
    "[API INFORMASI SEC ERROR]",
    error
  );

  informasiSecError =
    error instanceof Error
      ? error.message
      : "API error";
}


/* =========================================================
   API INFORMASI DETAIL
   https://dpm-ptsp.surabaya.go.id/sso/apiinformasi.php
========================================================= */

let informasi = null;
let informasiError = "";

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiinformasi.php",
    {
      method: "POST",
      headers: API_HEADERS,
    }
  );

  const responseText = await response.text();

  console.log(
    "[API INFORMASI]",
    response.status,
    responseText
  );

  if (!response.ok) {
    throw new Error(
      `HTTP ${response.status}`
    );
  }

  const payload =
    JSON.parse(responseText);

  const data =
    getApiArray(payload);

  const aktif =
    data.filter(
      (item) =>
        Number(item?.status ?? 1) === 1
    );

  informasi =
    aktif[0] ?? data[0] ?? null;

} catch (error) {
  console.error(
    "[API INFORMASI ERROR]",
    error
  );

  informasiError =
    error instanceof Error
      ? error.message
      : "API error";
}


/* =========================================================
   DATA SECTION
========================================================= */

const sectionId =
  informasiSec?.section_id ||
  "info-sec";

const badge =
  informasiSec?.judul ||
  informasi?.judul ||
  "Informasi Publik";

const judul =
  informasiSec?.judul ||
  "Informasi Publik";

const deskripsi =
  informasiSec?.deskripsi ||
  informasi?.deskripsi ||
  "Informasi layanan dan pelayanan publik yang dapat diakses masyarakat.";

const sectionIcon =
  informasiSec?.icon ||
  "fas fa-file-lines";


/* =========================================================
   DATA DETAIL
========================================================= */

const subjudul =
  informasi?.subjudul ||
  "Keterbukaan Informasi Publik";

const subjudulKeterangan =
  informasi?.subjudul_keterangan ||
  "Transparan • Mudah Diakses • Akuntabel";

const isi =
  informasi?.isi ||
  "";

const aksesJudul =
  informasi?.akses_judul ||
  "Akses Informasi";

const aksesDeskripsi =
  informasi?.akses_deskripsi ||
  "Masyarakat dapat memperoleh informasi publik dan menyampaikan permohonan informasi melalui kanal resmi DPMPTSP Kota Surabaya.";

const aksesButton =
  informasi?.akses_button ||
  "Hubungi Kami";

const aksesLink =
  informasi?.akses_link ||
  "#kontak-sec";

const emailLabel =
  informasi?.email_label ||
  "Email Informasi";

const email =
  informasi?.email ||
  "dpmptsp@surabaya.go.id";

const emailButton =
  informasi?.email_button ||
  "Kirim Email";

const alamatLabel =
  informasi?.alamat_label ||
  "Lokasi Pelayanan";

const namaInstansi =
  informasi?.nama_instansi ||
  "DPMPTSP Kota Surabaya";

const alamat =
  informasi?.alamat ||
  "Jl. Tunjungan No. 1–3, Surabaya";

const ctaJudul =
  informasi?.cta_judul ||
  "Membutuhkan Informasi Lebih Lanjut?";

const ctaDeskripsi =
  informasi?.cta_deskripsi ||
  "Tim DPMPTSP Kota Surabaya siap membantu kebutuhan informasi dan pelayanan Anda.";

const ctaButton =
  informasi?.cta_button ||
  "Konsultasi Sekarang";

const ctaLink =
  informasi?.cta_link ||
  "#kontak-sec";


/* =========================================================
   ISI PARAGRAF
========================================================= */

const paragraphs =
  String(isi)
    .split(/\n\s*\n/)
    .map(
      (item) => item.trim()
    )
    .filter(Boolean);

/* =========================================================
   API PELAYANAN
   https://dpm-ptsp.surabaya.go.id/sso/apipelayanan.php
========================================================= */

const API_URL =
  "https://dpm-ptsp.surabaya.go.id/sso/apipelayanan.php";

let pelayanan = [];
let apiError = "";

try {
  const username =
    import.meta.env.API_BERITA_USERNAME;

  const password =
    import.meta.env.API_BERITA_PASSWORD;

  if (!username || !password) {
    throw new Error(
      "API_BERITA_USERNAME / API_BERITA_PASSWORD belum diset"
    );
  }

  const response = await fetch(API_URL, {
    method: "POST",

    headers: {
      username,
      password,
      Accept: "application/json",
    },
  });

  const responseText =
    await response.text();

  if (!response.ok) {
    throw new Error(
      `API Pelayanan HTTP ${response.status}: ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API Pelayanan bukan JSON: ${responseText.substring(
        0,
        500
      )}`
    );
  }

  /* =======================================================
     AMBIL ARRAY DATA
  ======================================================= */

  let apiData = [];

  if (Array.isArray(payload)) {
    apiData = payload;
  } else if (Array.isArray(payload?.data)) {
    apiData = payload.data;
  } else if (Array.isArray(payload?.results)) {
    apiData = payload.results;
  } else if (Array.isArray(payload?.result)) {
    apiData = payload.result;
  } else if (Array.isArray(payload?.items)) {
    apiData = payload.items;
  }

  /* =======================================================
     NORMALISASI
  ======================================================= */

  pelayanan = apiData
    .map((item) => {
      let isi = [];

      /*
       * FIELD isi dari API berupa JSON STRING
       *
       * Contoh:
       * "[{\"icon\":\"fas fa-bolt\", ...}]"
       */

      if (Array.isArray(item?.isi)) {
        isi = item.isi;
      } else if (
        typeof item?.isi === "string" &&
        item.isi.trim()
      ) {
        try {
          const parsed =
            JSON.parse(item.isi);

          if (Array.isArray(parsed)) {
            isi = parsed;
          }
        } catch (error) {
          console.warn(
            "[API PELAYANAN] isi bukan JSON valid:",
            item.isi
          );
        }
      }

      return {
        id:
          Number(item?.id) || 0,

        tab_key:
          item?.tab_key ?? "",

        tab_icon:
          item?.tab_icon ??
          "fas fa-star",

        tab_judul:
          item?.tab_judul ??
          "",

        judul:
          item?.judul ??
          "",

        deskripsi:
          item?.deskripsi ??
          "",

        isi,

        urutan:
          Number(item?.urutan) || 0,

        status:
          Number(item?.status) || 0,
      };
    })
    .filter(
      (item) =>
        item.status === 1 &&
        item.tab_key
    )
    .sort(
      (a, b) =>
        a.urutan - b.urutan
    );

  console.log(
    "[API PELAYANAN] TOTAL:",
    pelayanan.length
  );

  console.log(
    "[API PELAYANAN] DATA:",
    pelayanan
  );

} catch (error) {
  console.error(
    "[API PELAYANAN ERROR]",
    error
  );

  apiError =
    error instanceof Error
      ? error.message
      : "Gagal mengambil data pelayanan";

  pelayanan = [];
}


/* =========================================================
   TAB AKTIF
========================================================= */

const defaultTab =
  pelayanan.find(
    (item) =>
      item.tab_key === "standar"
  ) ||
  pelayanan[0] ||
  null;


/* =========================================================
   ICON WARNA
========================================================= */

function getColor(
  warna,
  index
) {
  if (warna === "yellow") {
    return {
      bg: "bg-yellow-50",
      icon: "bg-yellow-400",
      text: "text-yellow-600",
    };
  }

  const colors = [
    {
      bg: "bg-blue-50",
      icon: "bg-blue-600",
      text: "text-blue-600",
    },
    {
      bg: "bg-yellow-50",
      icon: "bg-yellow-400",
      text: "text-yellow-600",
    },
  ];

  return (
    colors[
      index % colors.length
    ]
  );
}
