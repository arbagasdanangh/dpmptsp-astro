---
// =========================================================
// HEADER DPM-PTSP SURABAYA
// API MENU:
// https://dpm-ptsp.surabaya.go.id/sso/apiheader.php
// =========================================================

let allMenuRows = [];

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiheader.php",
    {
      method: "POST",
      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json"
      }
    }
  );

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API Header HTTP ${response.status}: ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API Header bukan JSON: ${responseText.substring(0, 500)}`
    );
  }

  allMenuRows =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];

  allMenuRows = allMenuRows
    .map((item) => ({
      id: Number(item.id) || 0,

      parent_id:
        item.parent_id === null ||
        Number(item.parent_id) === 0
          ? null
          : Number(item.parent_id),

      nama: item.nama ?? "",

      url: item.url ?? "#",

      urutan: Number(item.urutan) || 0,

      aktif:
        Number(item.aktif) === 1
          ? 1
          : 0,

      tipe: item.tipe ?? "link",

      tombol_kontak:
        Number(item.tombol_kontak) === 1
          ? 1
          : 0
    }))
    .filter((item) => item.aktif === 1);

} catch (error) {
  console.error("[API HEADER ERROR]", error);
  allMenuRows = [];
}


// =========================================================
// BENTUK TREE MENU
// =========================================================

const menuMap = new Map();

for (const item of allMenuRows) {
  menuMap.set(Number(item.id), {
    ...item,

    id: Number(item.id),

    parent_id:
      item.parent_id === null ||
      Number(item.parent_id) === 0
        ? null
        : Number(item.parent_id),

    children: []
  });
}


// =========================================================
// MASUKKAN CHILD KE PARENT
// =========================================================

const menuTree = [];

for (const item of menuMap.values()) {
  if (
    item.parent_id !== null &&
    menuMap.has(item.parent_id)
  ) {
    menuMap
      .get(item.parent_id)
      .children
      .push(item);
  } else {
    menuTree.push(item);
  }
}


// =========================================================
// SORT MENU
// =========================================================

const sortMenu = (items) => {
  items.sort((a, b) => {
    const urutanA = Number(a.urutan || 0);
    const urutanB = Number(b.urutan || 0);

    if (urutanA !== urutanB) {
      return urutanA - urutanB;
    }

    return Number(a.id || 0) - Number(b.id || 0);
  });

  for (const item of items) {
    if (
      item.children &&
      item.children.length
    ) {
      sortMenu(item.children);
    }
  }
};

sortMenu(menuTree);


// =========================================================
// PISAHKAN NAVIGASI DAN KONTAK
// =========================================================

const contactMenus =
  menuTree.filter(
    (menu) =>
      Number(menu.tombol_kontak) === 1
  );

const navigationMenus =
  menuTree.filter(
    (menu) =>
      Number(menu.tombol_kontak) !== 1
  );
---


<!-- =========================================================
     HEADER UTAMA
========================================================== -->

<header
  id="site-header"
  class="site-header"
>

  <div class="header-container">

    <div class="header-grid">


      <!-- ===================================================
           LOGO
      ==================================================== -->

      <div class="header-logo">

        <a
          href="/"
          aria-label="DPM-PTSP Surabaya"
        >

          <img
            src="https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"
            alt="DPM-PTSP Surabaya"
            class="logo-image"
          />

        </a>

      </div>


      <!-- ===================================================
           DESKTOP / TABLET NAVIGATION
      ==================================================== -->

      <nav
        id="desktop-navigation"
        class="desktop-navigation"
        aria-label="Navigasi utama"
      >

        <ul class="desktop-menu">

          {
            navigationMenus.map((menu) => {

              const hasChildren =
                menu.children &&
                menu.children.length > 0;

              if (hasChildren) {

                return (
                  <li class="desktop-menu-item has-dropdown">

                    <a
                      href={
                        menu.url &&
                        menu.url !== "#"
                          ? menu.url
                          : "#"
                      }
                      class="desktop-menu-link"
                    >

                      <span>
                        {menu.nama}
                      </span>

                      <i
                        class="fas fa-chevron-down menu-chevron"
                        aria-hidden="true"
                      ></i>

                    </a>


                    <div class="desktop-dropdown">

                      {
                        menu.children.map(
                          (child, childIndex) => {

                            const childHasChildren =
                              child.children &&
                              child.children.length > 0;

                            if (childHasChildren) {

                              return (
                                <div class="dropdown-item nested-parent">

                                  <a
                                    href={
                                      child.url &&
                                      child.url !== "#"
                                        ? child.url
                                        : "#"
                                    }
                                    class="dropdown-link nested-trigger"
                                  >

                                    <span>
                                      {child.nama}
                                    </span>

                                    <i
                                      class="fas fa-chevron-down nested-chevron"
                                      aria-hidden="true"
                                    ></i>

                                  </a>


                                  <div class="nested-dropdown">

                                    {
                                      child.children.map(
                                        (grandchild) => (
                                          <a
                                            href={
                                              grandchild.url ||
                                              "#"
                                            }
                                            class="nested-dropdown-link"
                                          >
                                            {grandchild.nama}
                                          </a>
                                        )
                                      )
                                    }

                                  </div>

                                </div>
                              );

                            }

                            return (
                              <a
                                href={
                                  child.url ||
                                  "#"
                                }
                                class="dropdown-link"
                              >

                                <span>
                                  {child.nama}
                                </span>

                              </a>
                            );

                          }
                        )
                      }

                    </div>

                  </li>
                );

              }


              return (
                <li class="desktop-menu-item">

                  <a
                    href={
                      menu.url ||
                      "#"
                    }
                    class="desktop-menu-link"
                  >

                    {menu.nama}

                  </a>

                </li>
              );

            })
          }

        </ul>

      </nav>


      <!-- ===================================================
           KONTAK DESKTOP
      ==================================================== -->

      <div class="header-contact">

        {
          contactMenus.map(
            (menu) => (
              <a
                href={
                  menu.url ||
                  "#"
                }
                class="contact-button"
              >
                {menu.nama}
              </a>
            )
          )
        }

      </div>


      <!-- ===================================================
           MOBILE MENU BUTTON
      ==================================================== -->

      <button
        id="mobile-menu-button"
        type="button"
        class="mobile-menu-button"
        aria-label="Buka menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >

        <i
          id="mobile-menu-icon"
          class="fas fa-bars"
          aria-hidden="true"
        ></i>

      </button>

    </div>

  </div>

</header>


<!-- =========================================================
     MOBILE OVERLAY
========================================================== -->

<div
  id="mobile-overlay"
  class="mobile-overlay"
  aria-hidden="true"
></div>


<!-- =========================================================
     MOBILE DRAWER
     
     TIDAK ADA LOGO DI SINI
     
     Drawer dimulai di bawah header.
========================================================== -->

<aside
  id="mobile-drawer"
  class="mobile-drawer"
  aria-label="Menu mobile"
>

  <div class="mobile-drawer-content">

    <nav aria-label="Navigasi mobile">

      <ul class="mobile-menu-list">

        {
          navigationMenus.map((menu) => {

            const hasChildren =
              menu.children &&
              menu.children.length > 0;


            if (hasChildren) {

              return (
                <li class="mobile-menu-item">

                  <button
                    type="button"
                    class="mobile-parent-button"
                    aria-expanded="false"
                  >

                    <span>
                      {menu.nama}
                    </span>

                    <i
                      class="fas fa-chevron-down"
                      aria-hidden="true"
                    ></i>

                  </button>


                  <div class="mobile-submenu">

                    {
                      menu.children.map((child) => {

                        const childHasChildren =
                          child.children &&
                          child.children.length > 0;


                        if (childHasChildren) {

                          return (
                            <div class="mobile-nested-item">

                              <button
                                type="button"
                                class="mobile-child-button"
                                aria-expanded="false"
                              >

                                <span>
                                  {child.nama}
                                </span>

                                <i
                                  class="fas fa-chevron-down"
                                  aria-hidden="true"
                                ></i>

                              </button>


                              <div class="mobile-nested-submenu">

                                {
                                  child.children.map(
                                    (grandchild) => (
                                      <a
                                        href={
                                          grandchild.url ||
                                          "#"
                                        }
                                        class="mobile-grandchild-link"
                                      >
                                        {grandchild.nama}
                                      </a>
                                    )
                                  )
                                }

                              </div>

                            </div>
                          );

                        }


                        return (
                          <a
                            href={
                              child.url ||
                              "#"
                            }
                            class="mobile-child-link"
                          >

                            {child.nama}

                          </a>
                        );

                      })
                    }

                  </div>

                </li>
              );

            }


            return (
              <li class="mobile-menu-item">

                <a
                  href={
                    menu.url ||
                    "#"
                  }
                  class="mobile-normal-link"
                >

                  {menu.nama}

                </a>

              </li>
            );

          })
        }

      </ul>


      <!-- ===================================================
           KONTAK MOBILE
      ==================================================== -->

      {
        contactMenus.length > 0 && (
          <div class="mobile-contact-area">

            {
              contactMenus.map(
                (menu) => (
                  <a
                    href={
                      menu.url ||
                      "#"
                    }
                    class="mobile-contact-button"
                  >
                    {menu.nama}
                  </a>
                )
              )
            }

          </div>
        )
      }

    </nav>

  </div>

</aside>


<!-- =========================================================
     HEADER SPACER
========================================================== -->

<div
  id="header-spacer"
  aria-hidden="true"
></div>


<style>

/* ============================================================
   RESET
============================================================ */

#site-header,
#site-header *,
#mobile-drawer,
#mobile-drawer * {
  box-sizing: border-box;
}


/* ============================================================
   HEADER
============================================================ */

.site-header {

  position: fixed;

  top: 0;
  left: 0;
  right: 0;

  width: 100%;

  z-index: 9999;

  background: #f7f7f7;

  border-bottom:
    1px solid rgba(0, 0, 0, 0.05);

  transition:
    box-shadow 0.25s ease;
}


.header-container {

  width: 100%;

  max-width: 1600px;

  margin: 0 auto;

  padding:
    0 24px;
}


/* ============================================================
   HEADER GRID

   KIRI  = LOGO
   TENGAH = NAV
   KANAN = KONTAK
============================================================ */

.header-grid {

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    auto
    minmax(0, 1fr);

  align-items: center;

  min-height: 80px;

  width: 100%;
}


/* ============================================================
   LOGO
============================================================ */

.header-logo {

  grid-column: 1;

  justify-self: start;

  display: flex;

  align-items: center;

  min-width: 0;

  position: relative;

  z-index: 2;
}


.header-logo a {

  display: flex;

  align-items: center;

  text-decoration: none;
}


.logo-image {

  display: block;

  width: auto;

  height: 48px;

  max-width: 190px;

  object-fit: contain;

  transition:
    transform 0.2s ease;
}


.logo-image:hover {

  transform:
    scale(1.02);
}


/* ============================================================
   DESKTOP NAV
============================================================ */

.desktop-navigation {

  grid-column: 2;

  justify-self: center;

  display: block;

  position: relative;

  z-index: 20;
}


.desktop-menu {

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 28px;

  margin: 0;

  padding: 0;

  list-style: none;

  white-space: nowrap;
}


.desktop-menu-item {

  position: relative;

  display: flex;

  align-items: center;

  height: 80px;
}


.desktop-menu-link {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 6px;

  height: 100%;

  padding: 0;

  color: #374151;

  font-size: 14px;

  font-weight: 600;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  transition:
    color 0.2s ease;
}


.desktop-menu-link:hover {

  color: #001bb7;
}


.menu-chevron {

  font-size: 8px;

  transition:
    transform 0.2s ease;
}


.has-dropdown:hover
> .desktop-menu-link
.menu-chevron {

  transform:
    rotate(180deg);
}


/* ============================================================
   DESKTOP DROPDOWN LEVEL 1

   LURUS DENGAN MENU INDUK
============================================================ */

.desktop-dropdown {

  position: absolute;

  top: 100%;

  left: 0;

  width: 245px;

  margin: 0;

  padding: 6px 0;

  background: #ffffff;

  border:
    1px solid rgba(0, 0, 0, 0.06);

  border-radius:
    0 0 10px 10px;

  box-shadow:
    0 12px 30px
    rgba(0, 0, 0, 0.12);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transform:
    translateY(6px);

  transform-origin:
    top left;

  transition:
    opacity 0.18s ease,
    visibility 0.18s ease,
    transform 0.18s ease;

  z-index: 10000;
}


.has-dropdown:hover
> .desktop-dropdown {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;

  transform:
    translateY(0);
}


/* ============================================================
   DROPDOWN ITEM
============================================================ */

.dropdown-item {

  position: relative;

  width: 100%;

  background: #ffffff;
}


.dropdown-link {

  position: relative;

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 44px;

  padding:
    10px 16px;

  color: #374151;

  background: #ffffff;

  font-size: 13px;

  font-weight: 500;

  line-height: 1.4;

  text-decoration: none;

  transition:
    color 0.18s ease,
    background 0.18s ease;
}


.dropdown-link:hover {

  color: #001bb7;

  background: #ffd41d;
}


/* ============================================================
   ARTIKEL NESTED

   SUBMENU TURUN KE BAWAH
============================================================ */

.nested-parent {

  position: relative;

  width: 100%;
}


.nested-trigger {

  padding-right: 16px;
}


.nested-chevron {

  font-size: 8px;

  transition:
    transform 0.2s ease;
}


/*
  Submenu Artikel TIDAK absolute.
  Jadi otomatis turun ke bawah.
*/

.nested-dropdown {

  position: static;

  width: 100%;

  max-height: 0;

  overflow: hidden;

  padding: 0;

  margin: 0;

  background: #f8fafc;

  opacity: 0;

  visibility: hidden;

  transition:
    max-height 0.28s ease,
    opacity 0.2s ease,
    visibility 0.2s ease;
}


.nested-parent:hover
> .nested-dropdown {

  max-height: 200px;

  opacity: 1;

  visibility: visible;
}


.nested-parent:hover
> .nested-trigger
.nested-chevron {

  transform:
    rotate(180deg);
}


/* ============================================================
   PERIZINAN / PENANAMAN MODAL
============================================================ */

.nested-dropdown-link {

  display: block;

  width: 100%;

  padding:
    10px 16px 10px 30px;

  color: #001bb7;

  background: #f8fafc;

  font-size: 12px;

  font-weight: 500;

  line-height: 1.4;

  text-decoration: none;

  border-top:
    1px solid rgba(0, 0, 0, 0.04);

  transition:
    background 0.18s ease,
    color 0.18s ease,
    padding-left 0.18s ease;
}


.nested-dropdown-link:hover {

  color: #001bb7;

  background: #ffd41d;

  padding-left: 34px;
}


/* ============================================================
   KONTAK DESKTOP
============================================================ */

.header-contact {

  grid-column: 3;

  justify-self: end;

  display: flex;

  align-items: center;

  gap: 8px;

  min-width: 0;

  z-index: 2;
}


.contact-button {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height: 42px;

  padding:
    0 16px;

  color: #0900c3;

  background: #ffd41d;

  border-radius: 9px;

  font-size: 14px;

  font-weight: 700;

  line-height: 1;

  text-decoration: none;

  white-space: nowrap;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}


.contact-button:hover {

  transform:
    translateY(-1px);

  box-shadow:
    0 7px 18px
    rgba(0, 0, 0, 0.12);
}


/* ============================================================
   MOBILE BUTTON
============================================================ */

.mobile-menu-button {

  display: none;

  align-items: center;

  justify-content: center;

  width: 42px;

  height: 42px;

  margin-left: auto;

  padding: 0;

  color: #001bb7;

  background: transparent;

  border: 0;

  cursor: pointer;

  font-size: 22px;

  line-height: 1;
}


.mobile-menu-button:focus-visible {

  outline:
    2px solid #001bb7;

  outline-offset:
    2px;
}


/* ============================================================
   MOBILE OVERLAY
============================================================ */

.mobile-overlay {

  position: fixed;

  top: 64px;
  left: 0;
  right: 0;
  bottom: 0;

  z-index: 9997;

  background:
    rgba(0, 0, 0, 0.42);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity 0.25s ease,
    visibility 0.25s ease;
}


.mobile-overlay.is-open {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}


/* ============================================================
   MOBILE DRAWER

   PENTING:
   top: 64px

   Drawer TIDAK menutupi logo/header.
============================================================ */

.mobile-drawer {

  position: fixed;

  top: 64px;

  right: 0;

  bottom: 0;

  z-index: 9998;

  width:
    min(340px, 88vw);

  background: #ffffff;

  box-shadow:
    -10px 10px 35px
    rgba(0, 0, 0, 0.16);

  transform:
    translateX(100%);

  visibility: hidden;

  transition:
    transform 0.28s ease,
    visibility 0.28s ease;

  overflow-y: auto;

  overscroll-behavior:
    contain;
}


.mobile-drawer.is-open {

  transform:
    translateX(0);

  visibility: visible;
}


/* ============================================================
   DRAWER CONTENT

   Tidak ada logo.
   Tidak ada header putih kedua.
============================================================ */

.mobile-drawer-content {

  padding:
    8px 18px 30px;
}


/* ============================================================
   MOBILE MENU
============================================================ */

.mobile-menu-list {

  margin: 0;

  padding: 0;

  list-style: none;
}


.mobile-menu-item {

  width: 100%;

  border-bottom:
    1px solid #eeeeee;
}


/* ============================================================
   MOBILE NORMAL LINK
============================================================ */

.mobile-normal-link {

  display: flex;

  align-items: center;

  width: 100%;

  min-height: 50px;

  padding:
    13px 4px;

  color: #374151;

  font-size: 15px;

  font-weight: 600;

  line-height: 1.35;

  text-decoration: none;

  transition:
    color 0.18s ease;
}


.mobile-normal-link:hover {

  color: #001bb7;
}


/* ============================================================
   MOBILE PARENT
============================================================ */

.mobile-parent-button {

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 50px;

  padding:
    13px 4px;

  color: #374151;

  background: transparent;

  border: 0;

  font-family: inherit;

  font-size: 15px;

  font-weight: 600;

  line-height: 1.35;

  text-align: left;

  cursor: pointer;
}


.mobile-parent-button:hover {

  color: #001bb7;
}


.mobile-parent-button i {

  font-size: 9px;

  transition:
    transform 0.2s ease;
}


.mobile-parent-button.is-open i {

  transform:
    rotate(180deg);
}


/* ============================================================
   MOBILE SUBMENU
============================================================ */

.mobile-submenu {

  display: none;

  width: 100%;

  padding:
    0 0 8px 14px;
}


.mobile-submenu.is-open {

  display: block;
}


/* ============================================================
   MOBILE CHILD LINK
============================================================ */

.mobile-child-link {

  display: flex;

  align-items: center;

  width: 100%;

  min-height: 42px;

  padding:
    9px 4px;

  color: #4b5563;

  font-size: 14px;

  font-weight: 500;

  line-height: 1.35;

  text-decoration: none;
}


.mobile-child-link:hover {

  color: #001bb7;
}


/* ============================================================
   MOBILE NESTED ITEM
============================================================ */

.mobile-nested-item {

  width: 100%;
}


/* ============================================================
   MOBILE CHILD BUTTON
   Untuk Artikel
============================================================ */

.mobile-child-button {

  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 42px;

  padding:
    9px 4px;

  color: #4b5563;

  background: transparent;

  border: 0;

  font-family: inherit;

  font-size: 14px;

  font-weight: 500;

  line-height: 1.35;

  text-align: left;

  cursor: pointer;
}


.mobile-child-button:hover {

  color: #001bb7;
}


.mobile-child-button i {

  font-size: 9px;

  transition:
    transform 0.2s ease;
}


.mobile-child-button.is-open i {

  transform:
    rotate(180deg);
}


/* ============================================================
   MOBILE NESTED SUBMENU

   PERIZINAN
   PENANAMAN MODAL

   TURUN KE BAWAH
============================================================ */

.mobile-nested-submenu {

  display: none;

  width: 100%;

  padding:
    2px 0 7px 14px;
}


.mobile-nested-submenu.is-open {

  display: block;
}


/* ============================================================
   GRANDCHILD
============================================================ */

.mobile-grandchild-link {

  position: relative;

  display: block;

  width: 100%;

  padding:
    8px 8px 8px 16px;

  color: #001bb7;

  font-size: 13px;

  font-weight: 500;

  line-height: 1.4;

  text-decoration: none;

