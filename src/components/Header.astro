---
// =========================================================
// HEADER.astro
// =========================================================
// DPM-PTSP KOTA SURABAYA
//
// RESPONSIVE:
// < 768px     = MOBILE / DRAWER KANAN
// 768-1023px  = IPAD AIR / DESKTOP COMPACT
// 1024-1279px = IPAD PRO / DESKTOP COMPACT
// >=1280px    = DESKTOP NORMAL
// =========================================================


/*
|--------------------------------------------------------------------------
| AMBIL SEMUA MENU HEADER DARI API
|--------------------------------------------------------------------------
*/

let allMenuRows = [];


try {

  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiheader.php",
    {
      method: "POST",

      headers: {
        username:
          import.meta.env.API_BERITA_USERNAME,

        password:
          import.meta.env.API_BERITA_PASSWORD,

        Accept: "application/json"
      }
    }
  );


  const responseText =
    await response.text();


  if (!response.ok) {

    throw new Error(
      `API Header HTTP ${response.status}: ${responseText}`
    );

  }


  /*
  |--------------------------------------------------------------------------
  | PARSE JSON
  |--------------------------------------------------------------------------
  */

  let payload;

  try {

    payload =
      JSON.parse(responseText);

  } catch {

    throw new Error(
      `Response API Header bukan JSON: ${responseText.substring(0, 500)}`
    );

  }


  /*
  |--------------------------------------------------------------------------
  | AMBIL ARRAY DATA
  |--------------------------------------------------------------------------
  */

  allMenuRows =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];


  /*
  |--------------------------------------------------------------------------
  | NORMALISASI DATA
  |--------------------------------------------------------------------------
  */

  allMenuRows =
    allMenuRows
      .map((item) => ({

        id:
          Number(item.id) || 0,

        parent_id:
          item.parent_id === null ||
          Number(item.parent_id) === 0
            ? null
            : Number(item.parent_id),

        nama:
          item.nama ?? "",

        url:
          item.url ?? "#",

        urutan:
          Number(item.urutan) || 0,

        aktif:
          Number(item.aktif) === 1
            ? 1
            : 0,

        tipe:
          item.tipe ?? "link",

        tombol_kontak:
          Number(item.tombol_kontak) === 1
            ? 1
            : 0

      }))

      /*
      |--------------------------------------------------------------------------
      | HANYA MENU AKTIF
      |--------------------------------------------------------------------------
      */

      .filter(
        (item) =>
          item.aktif === 1
      );


  console.log(
    "[API HEADER]",
    allMenuRows
  );


} catch (error) {

  console.error(
    "[API HEADER ERROR]",
    error
  );

  allMenuRows = [];

}


/*
|--------------------------------------------------------------------------
| BENTUK TREE MENU
|--------------------------------------------------------------------------
*/

const menuMap = new Map();


for (const item of allMenuRows) {

  menuMap.set(
    Number(item.id),
    {
      ...item,

      id:
        Number(item.id),

      parent_id:
        item.parent_id === null ||
        Number(item.parent_id) === 0
          ? null
          : Number(item.parent_id),

      children: []
    }
  );

}


/*
|--------------------------------------------------------------------------
| MASUKKAN CHILD KE PARENT
|--------------------------------------------------------------------------
*/

const menuTree = [];


for (const item of menuMap.values()) {

  if (
    item.parent_id !== null &&
    menuMap.has(item.parent_id)
  ) {

    menuMap
      .get(item.parent_id)
      .children
      .push(item);

  } else {

    menuTree.push(item);

  }

}


/*
|--------------------------------------------------------------------------
| SORT REKURSIF
|--------------------------------------------------------------------------
*/

const sortMenu = (items) => {

  items.sort(
    (a, b) => {

      const urutanA =
        Number(a.urutan || 0);

      const urutanB =
        Number(b.urutan || 0);


      if (
        urutanA !== urutanB
      ) {

        return (
          urutanA -
          urutanB
        );

      }


      return (
        Number(a.id || 0) -
        Number(b.id || 0)
      );

    }
  );


  for (
    const item of items
  ) {

    if (
      item.children &&
      item.children.length
    ) {

      sortMenu(
        item.children
      );

    }

  }

};


sortMenu(menuTree);


/*
|--------------------------------------------------------------------------
| PISAHKAN NAVIGATION DAN KONTAK
|--------------------------------------------------------------------------
*/

const contactMenus =
  menuTree.filter(
    (menu) =>
      Number(
        menu.tombol_kontak
      ) === 1
  );


const navigationMenus =
  menuTree.filter(
    (menu) =>
      Number(
        menu.tombol_kontak
      ) !== 1
  );

---


<!-- =========================================================
     HEADER
========================================================== -->

<header
  id="site-header"

  class="
    fixed
    top-0
    left-0

    w-full

    z-[9999]

    bg-[#F7F7F7]

    animate-slide-in-left
  "
>


  <!-- =======================================================
       CONTAINER
  ======================================================== -->

  <div
    class="
      container
      mx-auto

      px-4
      sm:px-6
      md:px-5
      lg:px-8
    "
  >


    <!-- =====================================================
         HEADER WRAPPER
    ====================================================== -->

    <div
      class="
        header-wrapper

        flex
        items-center
        justify-between

        relative
      "
    >


      <!-- ===================================================
           LOGO
      ==================================================== -->

      <div
        class="
          header-logo

          flex
          items-center

          z-20

          shrink-0
        "
      >

        <a
          href="/"

          class="
            flex
            items-center

            ripple
          "
        >

          <img
            src="https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"

            alt="DPM-PTSP Kota Surabaya"

            class="
              logo-image

              w-auto

              object-contain

              transition
              duration-300

              hover:scale-105
            "
          />

        </a>

      </div>


      <!-- ===================================================
           DESKTOP / TABLET NAV

           MULAI DARI 768PX

           Jadi:
           iPad Air 820  = DESKTOP
           iPad Pro 1024 = DESKTOP
      ==================================================== -->

      <nav
        class="
          desktop-nav

          hidden

          md:block

          absolute

          left-1/2

          -translate-x-1/2
        "
      >

        <ul
          class="
            nav-list

            flex
            items-center
          "
        >


          {

            navigationMenus.map(
              (menu) => {

                const hasChildren =
                  menu.children &&
                  menu.children.length > 0;


                /*
                |--------------------------------------------------------------------------
                | MENU DENGAN CHILD
                |--------------------------------------------------------------------------
                */

                if (hasChildren) {

                  return (

                    <li
                      class="
                        nav-item

                        relative

                        group
                      "

                      key={
                        menu.id
                      }
                    >


                      <!-- MENU UTAMA -->

                      <a
                        href={
                          menu.url &&
                          menu.url !== "#"
                            ? menu.url
                            : "#"
                        }

                        class="
                          nav-link

                          text-gray-700

                          font-semibold

                          hover:text-yellow-400

                          transition-all
                          duration-300

                          flex
                          items-center

                          whitespace-nowrap
                        "
                      >

                        {
                          menu.nama
                        }


                        <i
                          class="
                            fas
                            fa-chevron-down

                            nav-chevron
                          "
                        ></i>

                      </a>


                      <!-- =================================
                           DROPDOWN
                      ================================== -->

                      <div
                        class="
                          dropdown-menu

                          absolute

                          left-0

                          mt-2

                          w-64

                          bg-white

                          rounded-b-lg

                          shadow-xl

                          opacity-0
                          invisible

                          translate-y-3

                          group-hover:opacity-100
                          group-hover:visible
                          group-hover:translate-y-0

                          transition-all
                          duration-200

                          z-[99999]

                          overflow-hidden
                        "
                      >


                        {

                          menu.children.map(
                            (
                              child,
                              childIndex
                            ) => {

                              const childHasChildren =
                                child.children &&
                                child.children.length > 0;


                              /*
                              |--------------------------------------------------------------------------
                              | CHILD NESTED
                              |--------------------------------------------------------------------------
                              */

                              if (
                                childHasChildren
                              ) {

                                return (

                                  <div
                                    class="
                                      nested-parent

                                      relative

                                      group/artikel

                                      border-t
                                      border-gray-100
                                    "

                                    key={
                                      child.id
                                    }
                                  >

                                    <div
                                      class="
                                        dropdown-child

                                        flex
                                        items-center
                                        justify-between

                                        cursor-pointer

                                        hover:bg-[#FFD41D]

                                        transition
                                      "
                                    >

                                      <span>
                                        {
                                          child.nama
                                        }
                                      </span>


                                      <i
                                        class="
                                          fas
                                          fa-chevron-down

                                          text-xs
                                        "
                                      ></i>

                                    </div>


                                    <!-- NESTED -->

                                    <div
                                      class="
                                        nested-dropdown

                                        opacity-0
                                        invisible

                                        max-h-0

                                        group-hover/artikel:opacity-100
                                        group-hover/artikel:visible
                                        group-hover/artikel:max-h-96

                                        overflow-hidden

                                        bg-white

                                        transition-all
                                        duration-300
                                      "
                                    >

                                      {

                                        child.children.map(
                                          (
                                            grandchild
                                          ) => (

                                            <a
                                              href={
                                                grandchild.url ||
                                                "#"
                                              }

                                              class="
                                                block

                                                px-4
                                                py-2
                                                pl-8

                                                text-[#001BB7]

                                                hover:bg-gray-50

                                                transition
                                              "

                                              key={
                                                grandchild.id
                                              }
                                            >

                                              {
                                                grandchild.nama
                                              }

                                            </a>

                                          )
                                        )

                                      }

                                    </div>

                                  </div>

                                );

                              }


                              /*
                              |--------------------------------------------------------------------------
                              | CHILD BIASA
                              |--------------------------------------------------------------------------
                              */

                              return (

                                <a
                                  href={
                                    child.url ||
                                    "#"
                                  }

                                  class={`
                                    dropdown-link

                                    block

                                    font-medium

                                    text-gray-700

                                    hover:bg-[#FFD41D]

                                    transition

                                    ${
                                      childIndex ===
                                      menu.children.length - 1
                                        ? "rounded-b-lg"
                                        : ""
                                    }
                                  `}

                                  key={
                                    child.id
                                  }
                                >

                                  {
                                    child.nama
                                  }

                                </a>

                              );

                            }
                          )

                        }

                      </div>

                    </li>

                  );

                }


                /*
                |--------------------------------------------------------------------------
                | MENU BIASA
                |--------------------------------------------------------------------------
                */

                return (

                  <li
                    class="nav-item"

                    key={
                      menu.id
                    }
                  >

                    <a
                      href={
                        menu.url ||
                        "#"
                      }

                      class="
                        nav-link

                        text-gray-700

                        font-semibold

                        hover:text-yellow-400

                        transition-all
                        duration-300

                        whitespace-nowrap
                      "
                    >

                      {
                        menu.nama
                      }

                    </a>

                  </li>

                );

              }
            )

          }

        </ul>

      </nav>


      <!-- ===================================================
           CONTACT DESKTOP / IPAD
      ==================================================== -->

      <div
        class="
          desktop-contact-wrapper

          hidden

          md:flex

          items-center

          z-20

          shrink-0
        "
      >

        {

          contactMenus.map(
            (menu) => (

              <a
                href={
                  menu.url ||
                  "#"
                }

                class="
                  desktop-contact

                  bg-[#FFD41D]

                  text-[#0900C3]

                  font-bold

                  rounded-lg

                  whitespace-nowrap

                  transition-all
                  duration-300

                  hover:shadow-lg

                  hover:-translate-y-0.5
                "

                key={
                  menu.id
                }
              >

                {
                  menu.nama
                }

              </a>

            )
          )

        }

      </div>


      <!-- ===================================================
           MOBILE BUTTON

           HANYA < 768PX
      ==================================================== -->

      <button
        id="mobile-menu-button"

        type="button"

        class="
          mobile-menu-button

          md:hidden

          text-blue-600

          shrink-0
        "

        aria-label="Buka menu"

        aria-expanded="false"
      >

        <i
          class="
            fas
            fa-bars
          "
        ></i>

      </button>


    </div>


  </div>

</header>


<!-- =========================================================
     MOBILE OVERLAY
========================================================== -->

<div
  id="mobile-overlay"

  class="
    fixed

    inset-0

    z-[10000]

    bg-black/30

    opacity-0

    invisible

    transition-all
    duration-300

    md:hidden
  "
></div>


<!-- =========================================================
     MOBILE DRAWER
     
     PENTING:
     top mengikuti tinggi header.
     
     TIDAK ADA LOGO KEDUA.
========================================================== -->

<aside
  id="mobile-menu"

  class="
    mobile-menu

    fixed

    right-0

    z-[10001]

    bg-white

    shadow-2xl

    translate-x-full

    transition-transform
    duration-300
    ease-out

    md:hidden

    overflow-y-auto
  "
>


  <!-- =======================================================
       DRAWER TOP
  ======================================================== -->

  <div
    class="
      mobile-drawer-header

      flex
      items-center
      justify-end

      border-b
      border-gray-200
    "
  >

    <button
      id="mobile-menu-close"

      type="button"

      class="
        mobile-close-button

        text-blue-600

        hover:text-blue-800

        transition
      "

      aria-label="Tutup menu"
    >

      <i
        class="
          fas
          fa-xmark
        "
      ></i>

    </button>

  </div>


  <!-- =======================================================
       MOBILE CONTENT
  ======================================================== -->

  <div
    class="
      mobile-menu-content

      space-y-1
    "
  >


    {

      navigationMenus.map(
        (menu) => {

          const hasChildren =
            menu.children &&
            menu.children.length > 0;


          /*
          |--------------------------------------------------------------------------
          | MOBILE MENU DENGAN CHILD
          |--------------------------------------------------------------------------
          */

          if (hasChildren) {

            return (

              <div
                class="mobile-menu-item"

                key={
                  menu.id
                }
              >

                <button
                  type="button"

                  class="
                    mobile-dropdown-btn

                    w-full

                    flex
                    items-center
                    justify-between

                    font-semibold

                    text-gray-700

                    hover:text-blue-600

                    transition
                  "
                >

                  <span>
                    {
                      menu.nama
                    }
                  </span>


                  <i
                    class="
                      fas
                      fa-chevron-down

                      text-xs

                      transition-transform
                      duration-200
                    "
                  ></i>

                </button>


                <!-- CHILD -->

                <div
                  class="
                    mobile-dropdown-content

                    hidden

                    pl-4

                    border-l
                    border-gray-200

                    space-y-1
                  "
                >

                  {

                    menu.children.map(
                      (child) => {

                        const childHasChildren =
                          child.children &&
                          child.children.length > 0;


                        /*
                        |--------------------------------------------------------------------------
                        | MOBILE NESTED
                        |--------------------------------------------------------------------------
                        */

                        if (
                          childHasChildren
                        ) {

                          return (

                            <div
                              key={
                                child.id
                              }
                            >

                              <button
                                type="button"

                                class="
                                  mobile-dropdown-btn

                                  w-full

                                  flex
                                  items-center
                                  justify-between

                                  text-gray-700
                                "
                              >

                                <span>
                                  {
                                    child.nama
                                  }
                                </span>


                                <i
                                  class="
                                    fas
                                    fa-chevron-down

                                    text-xs

                                    transition-transform
                                    duration-200
                                  "
                                ></i>

                              </button>


                              <div
                                class="
                                  hidden

                                  pl-4

                                  space-y-1
                                "
                              >

                                {

                                  child.children.map(
                                    (
                                      grandchild
                                    ) => (

                                      <a
                                        href={
                                          grandchild.url ||
                                          "#"
                                        }

                                        class="
                                          block

                                          text-[#001BB7]

                                          hover:text-blue-600
                                        "

                                        key={
                                          grandchild.id
                                        }
                                      >

                                        {
                                          grandchild.nama
                                        }

                                      </a>

                                    )
                                  )

                                }

                              </div>

                            </div>

                          );

                        }


                        /*
                        |--------------------------------------------------------------------------
                        | MOBILE CHILD BIASA
                        |--------------------------------------------------------------------------
                        */

                        return (

                          <a
                            href={
                              child.url ||
                              "#"
                            }

                            class="
                              mobile-child-link

                              block

                              text-gray-700

                              hover:text-blue-600

                              transition
                            "

                            key={
                              child.id
                            }
                          >

                            {
                              child.nama
                            }

                          </a>

                        );

                      }
                    )

                  }

                </div>

              </div>

            );

          }


          /*
          |--------------------------------------------------------------------------
          | MOBILE MENU BIASA
          |--------------------------------------------------------------------------
          */

          return (

            <a
              href={
                menu.url ||
                "#"
              }

              class="
                mobile-main-link

                block

                font-semibold

                text-gray-700

                hover:text-blue-600

                transition
              "

              key={
                menu.id
              }
            >

              {
                menu.nama
              }

            </a>

          );

        }
      )

    }


    <!-- =====================================================
         MOBILE CONTACT
    ====================================================== -->

    {

      contactMenus.map(
        (menu) => (

          <a
            href={
              menu.url ||
              "#"
            }

            class="
              mobile-contact

              block

              font-bold

              text-[#0900C3]

              bg-[#FFD41D]

              rounded-lg

              text-center

              transition-all

              hover:shadow-lg
            "

            key={
              menu.id
            }
          >

            {
              menu.nama
            }

          </a>

        )
      )

    }

  </div>

</aside>


<!-- =========================================================
     HEADER SPACER
========================================================== -->

<div
  id="header-spacer"

  aria-hidden="true"
></div>


