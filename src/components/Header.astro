---
// =========================================================
// HEADER DPM-PTSP SURABAYA
// API MENU:
// https://dpm-ptsp.surabaya.go.id/sso/apiheader.php
// =========================================================

let allMenuRows = [];

try {
  const response = await fetch(
    "https://dpm-ptsp.surabaya.go.id/sso/apiheader.php",
    {
      method: "POST",
      headers: {
        username: import.meta.env.API_BERITA_USERNAME,
        password: import.meta.env.API_BERITA_PASSWORD,
        Accept: "application/json"
      }
    }
  );

  const responseText = await response.text();

  if (!response.ok) {
    throw new Error(
      `API Header HTTP ${response.status}: ${responseText}`
    );
  }

  let payload;

  try {
    payload = JSON.parse(responseText);
  } catch {
    throw new Error(
      `Response API Header bukan JSON: ${responseText.substring(0, 500)}`
    );
  }

  allMenuRows =
    Array.isArray(payload)
      ? payload
      : Array.isArray(payload?.data)
        ? payload.data
        : Array.isArray(payload?.results)
          ? payload.results
          : [];

  allMenuRows = allMenuRows
    .map((item) => ({
      id: Number(item.id) || 0,

      parent_id:
        item.parent_id === null ||
        Number(item.parent_id) === 0
          ? null
          : Number(item.parent_id),

      nama: item.nama ?? "",

      url: item.url ?? "#",

      urutan: Number(item.urutan) || 0,

      aktif:
        Number(item.aktif) === 1
          ? 1
          : 0,

      tipe: item.tipe ?? "link",

      tombol_kontak:
        Number(item.tombol_kontak) === 1
          ? 1
          : 0
    }))
    .filter((item) => item.aktif === 1);

} catch (error) {
  console.error("[API HEADER ERROR]", error);
  allMenuRows = [];
}


// =========================================================
// BENTUK TREE MENU
// =========================================================

const menuMap = new Map();

for (const item of allMenuRows) {
  menuMap.set(Number(item.id), {
    ...item,

    id: Number(item.id),

    parent_id:
      item.parent_id === null ||
      Number(item.parent_id) === 0
        ? null
        : Number(item.parent_id),

    children: []
  });
}


// =========================================================
// MASUKKAN CHILD KE PARENT
// =========================================================

const menuTree = [];

for (const item of menuMap.values()) {
  if (
    item.parent_id !== null &&
    menuMap.has(item.parent_id)
  ) {
    menuMap
      .get(item.parent_id)
      .children
      .push(item);
  } else {
    menuTree.push(item);
  }
}


// =========================================================
// SORT MENU
// =========================================================

const sortMenu = (items) => {
  items.sort((a, b) => {
    const urutanA = Number(a.urutan || 0);
    const urutanB = Number(b.urutan || 0);

    if (urutanA !== urutanB) {
      return urutanA - urutanB;
    }

    return Number(a.id || 0) - Number(b.id || 0);
  });

  for (const item of items) {
    if (
      item.children &&
      item.children.length
    ) {
      sortMenu(item.children);
    }
  }
};

sortMenu(menuTree);


// =========================================================
// PISAHKAN NAVIGASI DAN KONTAK
// =========================================================

const contactMenus =
  menuTree.filter(
    (menu) =>
      Number(menu.tombol_kontak) === 1
  );

const navigationMenus =
  menuTree.filter(
    (menu) =>
      Number(menu.tombol_kontak) !== 1
  );
---


<header
  id="site-header"
  class="site-header"
>

  <div class="header-container">

    <!-- =====================================================
         HEADER GRID
    ====================================================== -->

    <div class="header-grid">

      <!-- ===================================================
           LOGO
      ==================================================== -->

      <div class="header-logo">

        <a
          href="/"
          aria-label="DPM-PTSP Surabaya"
        >

          <img
            src="https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"
            alt="DPM-PTSP Surabaya"
            class="logo-image"
          />

        </a>

      </div>


      <!-- ===================================================
           DESKTOP / TABLET NAV
      ==================================================== -->

      <nav
        id="desktop-navigation"
        class="desktop-navigation"
        aria-label="Navigasi utama"
      >

        <ul class="desktop-menu">

          {
            navigationMenus.map((menu) => {

              const hasChildren =
                menu.children &&
                menu.children.length > 0;

              if (hasChildren) {
                return (
                  <li class="desktop-menu-item has-dropdown">

                    <a
                      href={
                        menu.url &&
                        menu.url !== "#"
                          ? menu.url
                          : "#"
                      }
                      class="desktop-menu-link"
                    >

                      <span>
                        {menu.nama}
                      </span>

                      <i
                        class="fas fa-chevron-down menu-chevron"
                        aria-hidden="true"
                      ></i>

                    </a>


                    <!-- DROPDOWN LEVEL 1 -->

                    <div class="desktop-dropdown">

                      {
                        menu.children.map(
                          (child, childIndex) => {

                            const childHasChildren =
                              child.children &&
                              child.children.length > 0;

                            if (childHasChildren) {
                              return (
                                <div class="dropdown-item nested-parent">

                                  <a
                                    href={
                                      child.url &&
                                      child.url !== "#"
                                        ? child.url
                                        : "#"
                                    }
                                    class="dropdown-link nested-trigger"
                                  >

                                    <span>
                                      {child.nama}
                                    </span>

                                    <i
                                      class="fas fa-chevron-right nested-chevron"
                                      aria-hidden="true"
                                    ></i>

                                  </a>


                                  <!-- DROPDOWN LEVEL 2 -->

                                  <div class="nested-dropdown">

                                    {
                                      child.children.map(
                                        (grandchild) => (
                                          <a
                                            href={
                                              grandchild.url ||
                                              "#"
                                            }
                                            class="nested-dropdown-link"
                                          >
                                            {grandchild.nama}
                                          </a>
                                        )
                                      )
                                    }

                                  </div>

                                </div>
                              );
                            }

                            return (
                              <a
                                href={
                                  child.url ||
                                  "#"
                                }
                                class:list={[
                                  "dropdown-link",
                                  {
                                    "dropdown-last":
                                      childIndex ===
                                      menu.children.length - 1
                                  }
                                ]}
                              >
                                {child.nama}
                              </a>
                            );
                          }
                        )
                      }

                    </div>

                  </li>
                );
              }

              return (
                <li class="desktop-menu-item">

                  <a
                    href={
                      menu.url ||
                      "#"
                    }
                    class="desktop-menu-link"
                  >
                    {menu.nama}
                  </a>

                </li>
              );
            })
          }

        </ul>

      </nav>


      <!-- ===================================================
           KONTAK DESKTOP / TABLET
      ==================================================== -->

      <div class="header-contact">

        {
          contactMenus.map(
            (menu) => (
              <a
                href={
                  menu.url ||
                  "#"
                }
                class="contact-button"
              >
                {menu.nama}
              </a>
            )
          )
        }

      </div>


      <!-- ===================================================
           MOBILE BUTTON
      ==================================================== -->

      <button
        id="mobile-menu-button"
        type="button"
        class="mobile-menu-button"
        aria-label="Buka menu"
        aria-controls="mobile-drawer"
        aria-expanded="false"
      >

        <i
          class="fas fa-bars"
          aria-hidden="true"
        ></i>

      </button>

    </div>

  </div>

</header>


<!-- =========================================================
     MOBILE OVERLAY
========================================================== -->

<div
  id="mobile-overlay"
  class="mobile-overlay"
  aria-hidden="true"
></div>


<!-- =========================================================
     MOBILE DRAWER
     
     TIDAK ADA LOGO DI SINI
========================================================== -->

<aside
  id="mobile-drawer"
  class="mobile-drawer"
  aria-label="Menu mobile"
>

  <div class="mobile-drawer-header">

    <button
      id="mobile-close-button"
      type="button"
      class="mobile-close-button"
      aria-label="Tutup menu"
    >

      <i
        class="fas fa-xmark"
        aria-hidden="true"
      ></i>

    </button>

  </div>


  <div class="mobile-drawer-content">

    <nav aria-label="Navigasi mobile">

      <ul class="mobile-menu-list">

        {
          navigationMenus.map((menu) => {

            const hasChildren =
              menu.children &&
              menu.children.length > 0;

            if (hasChildren) {
              return (
                <li class="mobile-menu-item">

                  <button
                    type="button"
                    class="mobile-parent-button"
                    aria-expanded="false"
                  >

                    <span>
                      {menu.nama}
                    </span>

                    <i
                      class="fas fa-chevron-down"
                      aria-hidden="true"
                    ></i>

                  </button>


                  <div class="mobile-submenu">

                    {
                      menu.children.map((child) => {

                        const childHasChildren =
                          child.children &&
                          child.children.length > 0;

                        if (childHasChildren) {
                          return (
                            <div class="mobile-nested-item">

                              <button
                                type="button"
                                class="mobile-child-button"
                                aria-expanded="false"
                              >

                                <span>
                                  {child.nama}
                                </span>

                                <i
                                  class="fas fa-chevron-down"
                                  aria-hidden="true"
                                ></i>

                              </button>


                              <div class="mobile-nested-submenu">

                                {
                                  child.children.map(
                                    (grandchild) => (
                                      <a
                                        href={
                                          grandchild.url ||
                                          "#"
                                        }
                                        class="mobile-grandchild-link"
                                      >
                                        {grandchild.nama}
                                      </a>
                                    )
                                  )
                                }

                              </div>

                            </div>
                          );
                        }

                        return (
                          <a
                            href={
                              child.url ||
                              "#"
                            }
                            class="mobile-child-link"
                          >
                            {child.nama}
                          </a>
                        );
                      })
                    }

                  </div>

                </li>
              );
            }

            return (
              <li class="mobile-menu-item">

                <a
                  href={
                    menu.url ||
                    "#"
                  }
                  class="mobile-normal-link"
                >
                  {menu.nama}
                </a>

              </li>
            );
          })
        }

      </ul>


      <!-- ===================================================
           KONTAK MOBILE
      ==================================================== -->

      {
        contactMenus.length > 0 && (
          <div class="mobile-contact-area">

            {
              contactMenus.map(
                (menu) => (
                  <a
                    href={
                      menu.url ||
                      "#"
                    }
                    class="mobile-contact-button"
                  >
                    {menu.nama}
                  </a>
                )
              )
            }

          </div>
        )
      }

    </nav>

  </div>

</aside>


<!-- =========================================================
     SPACER
========================================================== -->

<div
  id="header-spacer"
  aria-hidden="true"
></div>


<style>

  /* ========================================================
     RESET / BASE
  ======================================================== */

  #site-header,
  #site-header *,
  #mobile-drawer,
  #mobile-drawer * {
    box-sizing: border-box;
  }


  /* ========================================================
     HEADER
  ======================================================== */

  .site-header {
    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    width: 100%;

    z-index: 9999;

    background: #f7f7f7;

    border-bottom: 1px solid rgba(0, 0, 0, 0.04);

    transition:
      box-shadow 0.25s ease;
  }


  .header-container {
    width: 100%;

    max-width: 1600px;

    margin: 0 auto;

    padding-left: 24px;
    padding-right: 24px;
  }


  /*
   * 3 kolom:
   *
   * kiri  = logo
   * tengah = navbar
   * kanan = kontak
   *
   * Navbar TIDAK menggunakan absolute.
   */

  .header-grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto
      minmax(0, 1fr);

    align-items: center;

    min-height: 80px;

    position: relative;
  }


  /* ========================================================
     LOGO
  ======================================================== */

  .header-logo {
    justify-self: start;

    display: flex;

    align-items: center;

    min-width: 0;

    z-index: 2;
  }


  .header-logo a {
    display: flex;

    align-items: center;
  }


  .logo-image {
    display: block;

    width: auto;

    height: 48px;

    max-width: 190px;

    object-fit: contain;

    transition:
      transform 0.25s ease;
  }


  .logo-image:hover {
    transform: scale(1.025);
  }


  /* ========================================================
     DESKTOP NAV
  ======================================================== */

  .desktop-navigation {
    grid-column: 2;

    justify-self: center;

    display: block;

    position: relative;

    z-index: 10;
  }


  .desktop-menu {
    display: flex;

    align-items: center;

    justify-content: center;

    gap: 28px;

    margin: 0;
    padding: 0;

    list-style: none;

    white-space: nowrap;
  }


  .desktop-menu-item {
    position: relative;

    display: flex;

    align-items: center;

    height: 80px;
  }


  .desktop-menu-link {
    position: relative;

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 6px;

    height: 100%;

    padding: 0;

    color: #374151;

    font-size: 14px;

    font-weight: 600;

    line-height: 1;

    text-decoration: none;

    white-space: nowrap;

    transition:
      color 0.2s ease;
  }


  .desktop-menu-link:hover {
    color: #d4a900;
  }


  .menu-chevron {
    font-size: 9px;

    transition:
      transform 0.2s ease;
  }


  .has-dropdown:hover
  > .desktop-menu-link
  .menu-chevron {
    transform: rotate(180deg);
  }


  /* ========================================================
     DROPDOWN LEVEL 1
     
     PENTING:
     left: 0 = lurus dengan sisi kiri menu induk.
  ======================================================== */

  .desktop-dropdown {
    position: absolute;

    top: 100%;

    left: 0;

    margin: 0;

    width: 250px;

    padding: 6px 0;

    background: #ffffff;

    border: 1px solid rgba(0, 0, 0, 0.06);

    border-radius: 0 0 10px 10px;

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.12);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
      translateY(8px);

    transform-origin:
      top left;

    transition:
      opacity 0.18s ease,
      visibility 0.18s ease,
      transform 0.18s ease;

    z-index: 10000;
  }


  .has-dropdown:hover
  > .desktop-dropdown {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
      translateY(0);
  }


  /* ========================================================
     DROPDOWN ITEM
  ======================================================== */

  .dropdown-item {
    position: relative;

    width: 100%;
  }


  .dropdown-link {
    position: relative;

    display: flex;

    align-items: center;

    justify-content: space-between;

    width: 100%;

    min-height: 46px;

    padding: 11px 16px;

    color: #374151;

    font-size: 13px;

    font-weight: 500;

    line-height: 1.35;

    text-decoration: none;

    background: #ffffff;

    transition:
      background 0.18s ease,
      color 0.18s ease;
  }


  .dropdown-link:hover {
    color: #111827;

    background: #ffd41d;
  }


  .dropdown-last {
    border-radius:
      0 0 10px 10px;
  }


  /* ========================================================
     NESTED DESKTOP
  ======================================================== */

  .nested-trigger {
    padding-right: 13px;
  }


  .nested-chevron {
    font-size: 9px;

    margin-left: 12px;
  }


  .nested-dropdown {
    position: absolute;

    top: 0;

    left: 100%;

    width: 240px;

    padding: 6px 0;

    background: #ffffff;

    border: 1px solid rgba(0, 0, 0, 0.06);

    border-radius: 0 8px 8px 8px;

    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.12);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
      translateX(8px);

    transition:
      opacity 0.18s ease,
      visibility 0.18s ease,
      transform 0.18s ease;

    z-index: 10001;
  }


  .nested-parent:hover
  > .nested-dropdown {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
      translateX(0);
  }


  .nested-dropdown-link {
    display: block;

    width: 100%;

    padding: 11px 15px;

    color: #374151;

    font-size: 13px;

    font-weight: 500;

    line-height: 1.35;

    text-decoration: none;

    transition:
      background 0.18s ease,
      color 0.18s ease;
  }


  .nested-dropdown-link:hover {
    color: #111827;

    background: #ffd41d;
  }


  /* ========================================================
     KONTAK
  ======================================================== */

  .header-contact {
    grid-column: 3;

    justify-self: end;

    display: flex;

    align-items: center;

    gap: 8px;

    min-width: 0;

    z-index: 2;
  }


  .contact-button {
    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 42px;

    padding:
      0 16px;

    color: #0900c3;

    background: #ffd41d;

    border-radius: 9px;

    font-size: 14px;

    font-weight: 700;

    line-height: 1;

    text-decoration: none;

    white-space: nowrap;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }


  .contact-button:hover {
    transform:
      translateY(-1px);

    box-shadow:
      0 7px 18px rgba(0, 0, 0, 0.12);
  }


  /* ========================================================
     MOBILE BUTTON
  ======================================================== */

  .mobile-menu-button {
    display: none;

    width: 42px;
    height: 42px;

    align-items: center;
    justify-content: center;

    margin-left: auto;

    padding: 0;

    color: #001bb7;

    background: transparent;

    border: 0;

    cursor: pointer;

    font-size: 22px;
  }


  /* ========================================================
     MOBILE OVERLAY
  ======================================================== */

  .mobile-overlay {
    position: fixed;

    inset: 0;

    z-index: 10000;

    background:
      rgba(0, 0, 0, 0.42);

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease;
  }


  .mobile-overlay.is-open {
    opacity: 1;

    visibility: visible;

    pointer-events: auto;
  }


  /* ========================================================
     MOBILE DRAWER
     
     Tidak ada logo.
  ======================================================== */

  .mobile-drawer {
    position: fixed;

    top: 0;
    right: 0;
    bottom: 0;

    z-index: 10001;

    width: min(340px, 88vw);

    background: #ffffff;

    box-shadow:
      -10px 0 35px rgba(0, 0, 0, 0.16);

    transform:
      translateX(100%);

    visibility: hidden;

    transition:
      transform 0.28s ease,
      visibility 0.28s ease;

    overflow-y: auto;

    overscroll-behavior:
      contain;
  }


  .mobile-drawer.is-open {
    transform:
      translateX(0);

    visibility: visible;
  }


  .mobile-drawer-header {
    display: flex;

    align-items: center;

    justify-content: flex-end;

    min-height: 64px;

    padding:
      0 18px;

    border-bottom:
      1px solid #eeeeee;
  }


  .mobile-close-button {
    display: flex;

    align-items: center;
    justify-content: center;

    width: 40px;
    height: 40px;

    padding: 0;

    color: #001bb7;

    background: transparent;

    border: 0;

    border-radius: 8px;

    cursor: pointer;

    font-size: 22px;

    transition:
      background 0.2s ease;
  }


  .mobile-close-button:hover {
    background:
      #f3f4f6;
  }


  .mobile-drawer-content {
    padding:
      12px 18px 28px;
  }


  .mobile-menu-list {
    margin: 0;

    padding: 0;

    list-style: none;
  }


  .mobile-menu-item {
    border-bottom:
      1px solid #eeeeee;
  }


  .mobile-normal-link,
  .mobile-parent-button {
    width: 100%;

    min-height: 50px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
      13px 4px;

    color: #374151;

    background: transparent;

    border: 0;

    font-family: inherit;

    font-size: 15px;

    font-weight: 600;

    line-height: 1.35;

    text-decoration: none;

    text-align: left;

    cursor: pointer;
  }


  .mobile-normal-link:hover,
  .mobile-parent-button:hover {
    color: #001bb7;
  }


  .mobile-parent-button i,
  .mobile-child-button i {
    font-size: 10px;

    transition:
      transform 0.2s ease;
  }


  .mobile-parent-button.is-open
  i,
  .mobile-child-button.is-open
  i {
    transform:
      rotate(180deg);
  }


  /* ========================================================
     MOBILE SUBMENU
  ======================================================== */

  .mobile-submenu {
    display: none;

    padding:
      0 0 9px 14px;
  }


  .mobile-submenu.is-open {
    display: block;
  }


  .mobile-child-link,
  .mobile-child-button {
    width: 100%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    min-height: 42px;

    padding:
      9px 4px;

    color: #4b5563;

    background: transparent;

    border: 0;

    font-family: inherit;

    font-size: 14px;

    font-weight: 500;

    line-height: 1.35;

    text-decoration: none;

    text-align: left;

    cursor: pointer;
  }


  .mobile-child-link:hover,
  .mobile-child-button:hover {
    color: #001bb7;
  }


  .mobile-nested-submenu {
    display: none;

    padding:
      0 0 6px 14px;
  }


  .mobile-nested-submenu.is-open {
    display: block;
  }


  .mobile-grandchild-link {
    display: block;

    padding:
      8px 4px;

    color: #001bb7;

    font-size: 13px;

    line-height: 1.4;

    text-decoration: none;
  }


  .mobile-grandchild-link:hover {
    color: #d4a900;
  }


  /* ========================================================
     MOBILE CONTACT
  ======================================================== */

  .mobile-contact-area {
    display: flex;

    flex-direction: column;

    gap: 8px;

    margin-top: 18px;

    padding-top: 18px;

    border-top:
      2px solid #f1f1f1;
  }


  .mobile-contact-button {
    display: flex;

    align-items: center;

    justify-content: center;

    min-height: 46px;

    padding:
      0 15px;

    color: #0900c3;

    background: #ffd41d;

    border-radius: 8px;

    font-size: 14px;

    font-weight: 700;

    text-decoration: none;
  }


  /* ========================================================
     TABLET / IPAD
     
