/* =========================================================
   SIDEBAR
========================================================= */

.sidebar {

  width: 100%;
  height: 100%;

  display: flex;
  flex-direction: column;

  box-sizing: border-box;

  padding: 15px 12px;

  background:
    radial-gradient(
      circle at 15% 0%,
