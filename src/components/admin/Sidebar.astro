---
export const prerender = false;

/* =========================================================
   CURRENT PATH
========================================================= */

const pathname =
  Astro.url.pathname.replace(/\/$/, "");

/* =========================================================
   API
========================================================= */

const API_URL =
  "https://dpm-ptsp.surabaya.go.id/sso/apisidebar.php";

const API_USERNAME =
  import.meta.env.API_BERITA_USERNAME;

const API_PASSWORD =
  import.meta.env.API_BERITA_PASSWORD;

/* =========================================================
   TYPE SESUAI API
========================================================= */

interface ApiMenu {
  id: number | string;
  name?: string;
  nama?: string;
  title?: string;

  slug?: string;
  url?: string;
  icon?: string;

  parent_id?: number | string | null;

  urutan?: number | string;
}

interface MenuItem {
  id: string;
  name: string;
  slug: string;
  url: string;
  icon: string;
  parent_id: string | null;
  order: number;
  children: MenuItem[];
}

