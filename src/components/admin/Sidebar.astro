    visibility: hidden;

  }

  .sidebar-wrapper.open {

    transform:
      translate3d(0,0,0);

    pointer-events: auto;

    visibility: visible;

  }

  .sidebar-wrapper.collapsed {

    width: min(300px,86vw);

    min-width: 0;

