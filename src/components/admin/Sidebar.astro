</style>

<script is:inline>
(() => {

  /* =======================================================
     ELEMENT
  ======================================================== */

  const sidebar =
    document.getElementById(
      "admin-sidebar"
    );

  const overlay =
    document.getElementById(
      "sidebar-overlay"
    );

  const mobileTrigger =
    document.getElementById(
      "mobile-sidebar-trigger"
    );

  const closeButton =
    document.getElementById(
      "sidebar-close"
    );

  const collapseButton =
    document.getElementById(
      "sidebar-collapse"
    );

  const logoutTrigger =
    document.getElementById(
      "logout-trigger"
    );

  const logoutModal =
    document.getElementById(
      "logout-modal"
    );

  const logoutCancel =
    document.getElementById(
      "logout-cancel"
    );

  if (!sidebar) {
    return;
  }

  const MOBILE_BREAKPOINT =
    900;

  const isMobile = () =>
    window.innerWidth <=
    MOBILE_BREAKPOINT;

  /* =======================================================
     MOBILE OPEN
  ======================================================== */

  function openSidebar() {

    if (!isMobile()) {
      return;
    }

    sidebar.classList.add(
      "open"
    );

    overlay?.classList.add(
      "show"
    );

    overlay?.setAttribute(
      "aria-hidden",
      "false"
    );

    mobileTrigger?.setAttribute(
      "aria-expanded",
      "true"
    );

    document.body.classList.add(
      "admin-sidebar-open"
    );

  }

  /* =======================================================
     MOBILE CLOSE
  ======================================================== */

  function closeSidebar() {

    sidebar.classList.remove(
      "open"
    );

    overlay?.classList.remove(
      "show"
    );

    overlay?.setAttribute(
      "aria-hidden",
      "true"
    );

    mobileTrigger?.setAttribute(
      "aria-expanded",
      "false"
    );

    document.body.classList.remove(
      "admin-sidebar-open"
    );

  }

  /* =======================================================
     MOBILE TRIGGER
  ======================================================== */

  mobileTrigger?.addEventListener(
    "click",
    () => {

      if (
        sidebar.classList.contains(
          "open"
        )
      ) {

        closeSidebar();

      } else {

        openSidebar();

      }

    }
  );

  closeButton?.addEventListener(
    "click",
    closeSidebar
  );

  overlay?.addEventListener(
    "click",
    closeSidebar
  );

  /* =======================================================
     NAVBAR SUPPORT
  ======================================================== */

  window.addEventListener(
    "admin-sidebar-open",
    openSidebar
  );

  window.addEventListener(
    "admin-sidebar-close",
    closeSidebar
  );

  document.addEventListener(
    "click",
    (event) => {

      const target =
        event.target instanceof Element
          ? event.target.closest(
              "[data-admin-sidebar-open]"
            )
          : null;

      if (!target) {
        return;
      }

      event.preventDefault();

      openSidebar();

    }
  );

  /* =======================================================
     DESKTOP COLLAPSE
  ======================================================== */

  function applyCollapsedState(
    collapsed,
    save = true
  ) {

    if (isMobile()) {

      sidebar.classList.remove(
        "collapsed"
      );

      return;

    }

    sidebar.classList.toggle(
      "collapsed",
      collapsed
    );

    collapseButton?.setAttribute(
      "aria-expanded",
      String(!collapsed)
    );

    collapseButton?.setAttribute(
      "aria-label",
      collapsed
        ? "Buka sidebar"
        : "Ciutkan sidebar"
    );

    collapseButton?.setAttribute(
      "title",
      collapsed
        ? "Buka sidebar"
        : "Ciutkan sidebar"
    );

    if (save) {

      localStorage.setItem(
        "admin-sidebar-collapsed",
        collapsed
          ? "true"
          : "false"
      );

    }

    window.dispatchEvent(
      new CustomEvent(
        "admin-sidebar-change",
        {
          detail: {
            collapsed
          }
        }
      )
    );

  }

  collapseButton?.addEventListener(
    "click",
    () => {

      const collapsed =
        sidebar.classList.contains(
          "collapsed"
        );

      applyCollapsedState(
        !collapsed,
        true
      );

    }
  );

  /* =======================================================
     RESTORE COLLAPSED
  ======================================================== */

  const savedCollapsed =
    localStorage.getItem(
      "admin-sidebar-collapsed"
    );

  if (
    savedCollapsed === "true" &&
    !isMobile()
  ) {

    applyCollapsedState(
      true,
      false
    );

  }

  /* =======================================================
     MENU CLICK
  ======================================================== */

  sidebar
    .querySelectorAll(
      ".menu a"
    )
    .forEach(
      (link) => {

        link.addEventListener(
          "click",
          () => {

            if (isMobile()) {
              closeSidebar();
            }

          }
        );

      }
    );

  /* =======================================================
     RESIZE
  ======================================================== */

  let resizeTimer;

  window.addEventListener(
    "resize",
    () => {

      clearTimeout(
        resizeTimer
      );

      resizeTimer =
        setTimeout(
          () => {

            if (isMobile()) {

              sidebar.classList.remove(
                "collapsed"
              );

            } else {

              closeSidebar();

              const saved =
                localStorage.getItem(
                  "admin-sidebar-collapsed"
                );

              applyCollapsedState(
                saved === "true",
                false
              );

            }

          },
          100
        );

    }
  );

  /* =======================================================
     THEME
  ======================================================== */

  const themeButtons =
    document.querySelectorAll(
      ".theme-color"
    );

  const themes = {

    blue: {
      bg: "#0b4387",
      dark: "#062d61",
      text: "#eaf3ff",
      muted: "#a9c4e5",
      accent: "#ffd21f",
      strong: "#e5b900",
      soft: "rgba(255,210,31,.14)"
    },

    black: {
      bg: "#17191f",
      dark: "#0b0d11",
      text: "#f5f7fa",
      muted: "#aeb5c0",
      accent: "#ffffff",
      strong: "#e5e7eb",
      soft: "rgba(255,255,255,.10)"
    },

    purple: {
      bg: "#51258a",
      dark: "#2d1155",
      text: "#f7efff",
      muted: "#d1b9ee",
      accent: "#b58cff",
      strong: "#9b6df0",
      soft: "rgba(181,140,255,.15)"
    },

    green: {
      bg: "#075f49",
      dark: "#03382c",
      text: "#e7fff6",
      muted: "#9fe1c9",
      accent: "#35d39b",
      strong: "#20b982",
      soft: "rgba(53,211,155,.15)"
    },

    red: {
      bg: "#8d2228",
      dark: "#4e1015",
      text: "#fff0f1",
      muted: "#f0b0b4",
      accent: "#ff777d",
      strong: "#eb565e",
      soft: "rgba(255,119,125,.15)"
    },

    orange: {
      bg: "#8b3b14",
      dark: "#4c1b08",
      text: "#fff2e8",
      muted: "#f2c29e",
      accent: "#ff9b54",
      strong: "#f17c2e",
      soft: "rgba(255,155,84,.15)"
    },

    cyan: {
      bg: "#155d73",
      dark: "#093747",
      text: "#e9fbff",
      muted: "#9fd9e5",
      accent: "#39d5e9",
      strong: "#18b8cf",
      soft: "rgba(57,213,233,.15)"
    }

  };

  function applyTheme(
    themeName
  ) {

    const theme =
      themes[themeName] ||
      themes.blue;

    sidebar.dataset.theme =
      themeName;

    sidebar.style.setProperty(
      "--sidebar-bg",
      theme.bg
    );

    sidebar.style.setProperty(
      "--sidebar-dark",
      theme.dark
    );

    sidebar.style.setProperty(
      "--sidebar-text",
      theme.text
    );

    sidebar.style.setProperty(
      "--sidebar-muted",
      theme.muted
    );

    sidebar.style.setProperty(
      "--accent",
      theme.accent
    );

    sidebar.style.setProperty(
      "--accent-strong",
      theme.strong
    );

    sidebar.style.setProperty(
      "--accent-soft",
      theme.soft
    );

    themeButtons.forEach(
      (button) => {

        const active =
          button.dataset.theme ===
          themeName;

        button.classList.toggle(
          "active",
          active
        );

        button.setAttribute(
          "aria-pressed",
          String(active)
        );

      }
    );

    localStorage.setItem(
      "admin-theme",
      themeName
    );

    window.dispatchEvent(
      new CustomEvent(
        "admin-theme-change",
        {
          detail: {
            theme:
              themeName,

            colors:
              theme
          }
        }
      )
    );

  }

  themeButtons.forEach(
    (button) => {

      button.addEventListener(
        "click",
        () => {

          applyTheme(
            button.dataset.theme ||
            "blue"
          );

        }
      );

    }
  );

  /* =======================================================
     RESTORE THEME
  ======================================================== */

  const savedTheme =
    localStorage.getItem(
      "admin-theme"
    );

  applyTheme(
    themes[savedTheme]
      ? savedTheme
      : "blue"
  );

  /* =======================================================
     LOGOUT MODAL
  ======================================================== */

  function openLogoutModal() {

    logoutModal?.classList.add(
      "show"
    );

    logoutModal?.setAttribute(
      "aria-hidden",
      "false"
    );

  }

  function closeLogoutModal() {

    logoutModal?.classList.remove(
      "show"
    );

    logoutModal?.setAttribute(
      "aria-hidden",
      "true"
    );

  }

  logoutTrigger?.addEventListener(
    "click",
    openLogoutModal
  );

  logoutCancel?.addEventListener(
    "click",
    closeLogoutModal
  );

  logoutModal?.addEventListener(
    "click",
    (event) => {

      if (
        event.target ===
        logoutModal
      ) {

        closeLogoutModal();

      }

    }
  );

  /* =======================================================
     ESC
  ======================================================== */

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key !== "Escape"
      ) {
        return;
      }

      closeSidebar();

      closeLogoutModal();

    }
  );

})();
</script>
