/* =========================================================
   GET ICON
========================================================= */

function getIcon(
  icon?: string,
  slug?: string
): string {

  const key =
    String(icon || slug || "")
      .toLowerCase()
      .trim()
      .replace(/^fa[srlb]?\s+fa-/, "")
      .replace(/^fa-/, "");

  return (
    iconMap[key] ||
    defaultIcon
  );
}

/* =========================================================
   NORMALIZE MENU
========================================================= */

function normalizeMenu(
  item: ApiMenu,
  index: number
): MenuItem {

  const id =
    String(item.id);

  const name =
    String(
      item.name ??
      item.nama ??
      item.title ??
      "Menu"
    ).trim();

  const slug =
    String(
      item.slug ?? ""
    ).trim();

  let url =
    String(
      item.url ?? ""
    ).trim();

  /*
   * Kalau API tidak mengirim URL,
   * tetapi mengirim slug,
   * otomatis membuat URL admin.
   */

  if (!url && slug) {
    url =
      `/admin/${slug.replace(/^\/+/, "")}`;
  }

  /*
   * Pastikan URL relatif diawali /
   */

  if (
    url &&
    !url.startsWith("/") &&
    !url.startsWith("http://") &&
    !url.startsWith("https://")
  ) {
    url = `/${url}`;
  }

  /*
   * Parent
   */

  const rawParent =
    item.parent_id;

  const parent_id =
    rawParent === null ||
    rawParent === undefined ||
    rawParent === "" ||
    rawParent === 0 ||
    rawParent === "0"
      ? null
      : String(rawParent);

  /*
   * Urutan
   */

  const order =
    Number(
      item.urutan
    ) || index;

  return {
    id,
    name,
    slug,
    url: url || "#",
    icon: getIcon(
      item.icon,
      slug
    ),
    parent_id,
    order,
    children: []
  };
}

/* =========================================================
   FETCH MENU API
========================================================= */

let menus: MenuItem[] = [];
let menuError = false;
let menuErrorMessage = "";

try {

  /*
   * Credential wajib tersedia.
   */

  if (
    !API_USERNAME ||
    !API_PASSWORD
  ) {
    throw new Error(
      "API_BERITA_USERNAME atau API_BERITA_PASSWORD belum tersedia."
    );
  }

  /*
   * REQUEST API
   */

  const response =
    await fetch(
      API_URL,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json",

          Accept:
            "application/json",

          username:
            API_USERNAME,

          password:
            API_PASSWORD
        },

        body:
          JSON.stringify({
            username:
              API_USERNAME,

            password:
              API_PASSWORD
          }),

        signal:
          AbortSignal.timeout(10000)
      }
    );

  /*
   * HTTP ERROR
   */

  if (!response.ok) {
    throw new Error(
      `HTTP ${response.status}`
    );
  }

  /*
   * PARSE JSON
   */

  const result =
    await response.json();

  /*
   * API harus mengembalikan
   * status true.
   */

  if (
    result?.status === false
  ) {
    throw new Error(
      result?.message ||
      "API mengembalikan status false."
    );
  }

  /*
   * DATA MENU
   *
   * Sumber utama menu:
   * result.data
   */

  const rawData =
    Array.isArray(
      result?.data
    )
      ? result.data
      : Array.isArray(result)
        ? result
        : [];

  /*
   * Jika API berhasil tetapi
   * data kosong, jangan membuat
   * menu manual.
   */

  if (!rawData.length) {
    throw new Error(
      "API berhasil tetapi data menu kosong."
    );
  }

  /* =======================================================
     NORMALIZE
  ======================================================== */

  const normalizedMenus =
    rawData.map(
      (
        item: ApiMenu,
        index: number
      ) =>
        normalizeMenu(
          item,
          index
        )
    );

  /* =======================================================
     MAP MENU
  ======================================================== */

  const menuMap =
    new Map<
      string,
      MenuItem
    >();

  normalizedMenus.forEach(
    (menu) => {
      menuMap.set(
        menu.id,
        menu
      );
    }
  );

  /* =======================================================
     BUILD TREE
  ======================================================== */

  const rootMenus:
    MenuItem[] = [];

  normalizedMenus.forEach(
    (menu) => {

      /*
       * Punya parent
       */

      if (
        menu.parent_id &&
        menuMap.has(
          menu.parent_id
        )
      ) {

        const parent =
          menuMap.get(
            menu.parent_id
          );

        parent?.children.push(
          menu
        );

      }

      /*
       * Root menu
       */

      else {

        rootMenus.push(
          menu
        );

      }

    }
  );

  /* =======================================================
     SORT
  ======================================================== */

  function sortMenus(
    list: MenuItem[]
  ): void {

    list.sort(
      (a, b) =>
        a.order - b.order
    );

    list.forEach(
      (item) => {

        if (
          item.children.length
        ) {
          sortMenus(
            item.children
          );
        }

      }
    );
  }

  sortMenus(
    rootMenus
  );

  /*
   * HASIL AKHIR
   */

  menus =
    rootMenus;

} catch (error) {

  console.error(
    "[ADMIN SIDEBAR]",
    error
  );

  menuError = true;

  menuErrorMessage =
    error instanceof Error
      ? error.message
      : "Menu API tidak tersedia.";

  /*
   * PENTING:
   *
   * TIDAK ADA FALLBACK MENU.
   *
   * Tidak ada Dashboard manual.
   * Tidak ada Artikel manual.
   * Tidak ada Kinerja manual.
   */

  menus = [];
}

/* =========================================================
   ACTIVE MENU
========================================================= */

function isActive(
  menu: MenuItem
): boolean {

  /*
   * URL menu sendiri
   */

  if (
    menu.url !== "#" &&
    (
      pathname === menu.url ||
      pathname.startsWith(
        `${menu.url}/`
      )
    )
  ) {
    return true;
  }

  /*
   * Child
   */

  return menu.children.some(
    (child) =>
      isActive(child)
  );
}
