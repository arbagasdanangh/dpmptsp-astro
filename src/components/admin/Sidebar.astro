    flex: 0 0 36px;

    display: flex;

    align-items: center;
    justify-content: center;

    margin-left: auto;

    border:
      1px solid rgba(255,255,255,.12);

    border-radius: 10px;

    background:
      rgba(255,255,255,.08);

    color:
      var(--sidebar-text);

    cursor: pointer;

  }

  .sidebar-wrapper.collapsed .brand {

