========================================================= -->

<div
  class="sidebar-overlay"
  id="sidebar-overlay"
  aria-hidden="true"
></div>

<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside
  class="sidebar-wrapper"
  id="admin-sidebar"
  data-theme="blue"
  aria-label="Menu Admin"
>

  <nav class="sidebar">

    <!-- =====================================================
         BRAND
    ====================================================== -->

    <div class="brand">

      <a
        href="/admin/dashboard"
        class="brand-link"
        aria-label="Dashboard Admin DPMPTSP"
      >

        <div class="brand-logo">

          <img
            src="https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"
            alt="Logo DPMPTSP"
          />

        </div>

        <div class="brand-text">

          <strong>
            DPMPTSP
          </strong>

          <span>
            ADMIN PANEL
          </span>

        </div>

      </a>

      <!-- DESKTOP COLLAPSE -->

      <button
        type="button"
        class="collapse-button"
        id="sidebar-collapse"
        aria-label="Ciutkan sidebar"
        title="Ciutkan sidebar"
        aria-expanded="true"
      >

        <svg
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          />
        </svg>

      </button>

      <!-- MOBILE CLOSE -->

      <button
        type="button"
        class="mobile-close"
        id="sidebar-close"
        aria-label="Tutup menu"
        title="Tutup menu"
      >

        <svg
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>

      </button>

    </div>

    <!-- =====================================================
         API ERROR
    ====================================================== -->

    {menuError && (
      <div
        class="api-warning"
        title={menuErrorMessage}
      >

        <span>
          !
        </span>

        <span>
          Menu API tidak tersedia
        </span>

      </div>
    )}

    <!-- =====================================================
         MENU DARI API
    ====================================================== -->

    <ul class="menu">

      {menus.map(
        (menu) => (

          <li>

            <!-- =================================================
                 PARENT MENU
            ================================================== -->

            <a
              href={menu.url}
              class:list={{
                active:
                  isActive(menu)
              }}
              aria-label={menu.name}
              title={menu.name}
              data-label={menu.name}
            >

              <span
                class="icon"
                set:html={menu.icon}
              />

              <span class="label">
                {menu.name}
              </span>

              {menu.children.length > 0 && (

                <span class="submenu-arrow">

                  <svg
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>

                </span>

              )}

            </a>

            <!-- =================================================
                 CHILDREN
            ================================================== -->

            {menu.children.length > 0 && (

              <ul class="submenu">

                {menu.children.map(
                  (child) => (

                    <li>

                      <a
                        href={child.url}
                        class:list={{
                          active:
                            isActive(child)
                        }}
                        title={child.name}
                        data-label={child.name}
                      >

                        <span
                          class="icon"
                          set:html={child.icon}
                        />

                        <span class="label">
                          {child.name}
                        </span>

                      </a>

                    </li>

                  )
                )}

              </ul>

            )}

          </li>

        )
      )}

      <!-- API KOSONG -->

      {menus.length === 0 &&
        !menuError && (

          <li class="menu-empty">

            <span>
              Tidak ada menu
            </span>

          </li>

        )
      }

    </ul>

    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <div class="sidebar-footer">

      <!-- THEME -->

      <div class="theme-section">

        <div class="theme-header">

          <span>
            WARNA TEMA
          </span>

        </div>

        <div class="theme-colors">

          <button
            type="button"
            class="theme-color theme-blue"
            data-theme="blue"
            aria-label="Tema Biru"
            title="Biru"
          ></button>

          <button
            type="button"
            class="theme-color theme-black"
            data-theme="black"
            aria-label="Tema Hitam"
            title="Hitam"
          ></button>

          <button
            type="button"
            class="theme-color theme-purple"
            data-theme="purple"
            aria-label="Tema Ungu"
            title="Ungu"
          ></button>

          <button
            type="button"
            class="theme-color theme-green"
            data-theme="green"
            aria-label="Tema Hijau"
            title="Hijau"
          ></button>

          <button
            type="button"
            class="theme-color theme-red"
            data-theme="red"
            aria-label="Tema Merah"
            title="Merah"
          ></button>

          <button
            type="button"
            class="theme-color theme-orange"
            data-theme="orange"
            aria-label="Tema Orange"
            title="Orange"
          ></button>

          <button
            type="button"
            class="theme-color theme-cyan"
            data-theme="cyan"
            aria-label="Tema Cyan"
            title="Cyan"
          ></button>

        </div>

      </div>

      <!-- LOGOUT -->

      <button
        type="button"
        class="logout"
        id="logout-trigger"
        title="Logout"
        aria-label="Logout"
      >

        <span class="icon">

          <svg
