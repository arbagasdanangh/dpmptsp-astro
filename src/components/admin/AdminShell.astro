---
export const prerender = false;

const {
  title = "Admin",
  subtitle = "",
  actionLabel = "",
  actionHref = ""
} = Astro.props;


/* =========================================================
   API SIDEBAR
========================================================= */

const API_SIDEBAR_URL =
  "https://dpm-ptsp.surabaya.go.id/sso/apisidebar.php";

const API_USERNAME =
  import.meta.env.API_BERITA_USERNAME;

const API_PASSWORD =
  import.meta.env.API_BERITA_PASSWORD;


/* =========================================================
   LOAD SIDEBAR DARI API
========================================================= */

let sidebarMenus: any[] = [];
let sidebarApiSuccess = false;
let sidebarApiError = "";

try {

  if (!API_USERNAME || !API_PASSWORD) {

    sidebarApiError =
      "Konfigurasi API username/password belum tersedia.";

  } else {

    const response =
      await fetch(
        API_SIDEBAR_URL,
        {
          method: "POST",

          headers: {
            username: API_USERNAME,
            password: API_PASSWORD,
            Accept: "application/json"
          },

          cache: "no-store"
        }
      );


    if (!response.ok) {

      throw new Error(
        `HTTP ${response.status}`
      );

    }


    const result =
      await response.json();


    if (
      result?.status !== true ||
      !Array.isArray(result?.data)
    ) {

      throw new Error(
        "Format response API sidebar tidak valid."
      );

    }


    /* =====================================================
       NORMALISASI MENU API

       Struktur DB:
       id
       nama
       url
       icon
       parent_id
       urutan
       aktif
       created_at
       updated_at

       Tidak menggunakan slug.
    ===================================================== */

    sidebarMenus =
      result.data

        /* Hanya item valid */
        .filter(
          (item: any) =>
            item &&
            typeof item === "object"
        )

        /* Hanya menu aktif */
        .filter(
          (item: any) =>
            Number(item.aktif ?? 1) === 1
        )

        /* Hanya menu level utama */
        .filter(
          (item: any) => {

            const parentId =
              item.parent_id;

            return (
              parentId === null ||
              parentId === undefined ||
              parentId === "" ||
              Number(parentId) === 0
            );

          }
        )

        /* Normalisasi object */
        .map(
          (item: any) => ({

            id:
              item.id,

            name:
              item.nama ??
              item.name ??
              "Menu",

            url:
              item.url ||
              "#",

            icon:
              item.icon ||
              "circle",

            parent_id:
              item.parent_id,

            urutan:
              Number(
                item.urutan ?? 0
              )

          })
        )

        /* Urutan dari DB */
        .sort(
          (a: any, b: any) =>
            a.urutan -
            b.urutan
        );


    sidebarApiSuccess =
      true;

  }

} catch (error: any) {

  console.error(
    "Sidebar API error:",
    error
  );

  sidebarApiError =
    error?.message ||
    "Gagal mengambil menu dari API.";

}


/* =========================================================
   PATH
========================================================= */

const pathname =
  Astro.url.pathname.replace(
    /\/$/,
    ""
  );


/* =========================================================
   ACTIVE MENU
========================================================= */

function isMenuActive(menu: any) {

  const url =
    String(
      menu?.url || ""
    ).replace(
      /\/$/,
      ""
    );


  if (
    !url ||
    url === "#"
  ) {

    return false;

  }


  return (
    pathname === url ||
    pathname.startsWith(
      `${url}/`
    )
  );

}


/* =========================================================
   ACTIVE MENU
========================================================= */

const activeMenu =
  sidebarMenus.find(
    (menu) =>
      isMenuActive(menu)
  );


/* =========================================================
   PAGE INFO
========================================================= */

const pageInfo =
  activeMenu
    ? {

        title:
          activeMenu.name,

        icon:
          activeMenu.icon ||
          "circle"

      }

    : {

        title:
          title || "Admin",

        icon:
          "grid-2"

      };


/* =========================================================
   DATE
========================================================= */

const now =
  new Date();

const formattedDate =
  now.toLocaleDateString(
    "id-ID",
    {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric"
    }
  );
---

<html lang="id">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

  <title>
    {pageInfo.title} - Admin DPMPTSP
  </title>

</head>


<body>

<div
  class="admin-app"
  id="adminApp"
>


  <!-- =====================================================
       MOBILE OVERLAY
  ====================================================== -->

  <div
    class="sidebar-overlay"
    id="sidebarOverlay"
  ></div>


  <!-- =====================================================
       SIDEBAR
  ====================================================== -->

  <aside
    class="sidebar-wrapper"
    id="adminSidebar"
    aria-label="Navigasi Admin"
  >


    <!-- ===================================================
         BRAND
    ==================================================== -->

    <div class="sidebar-brand">

      <div class="brand-logo">

        <img
          src="https://github.com/arbagasdanangh/pps/blob/main/logo.png?raw=true"
          alt="Logo DPMPTSP"
        />

      </div>


      <div class="brand-text">

        <strong>
          DPMPTSP
        </strong>

        <span>
          ADMIN PANEL
        </span>

      </div>

    </div>


    <!-- ===================================================
         NAVIGATION
    ==================================================== -->

    <nav class="sidebar-nav">

      <div class="nav-label">
        MENU UTAMA
      </div>


      <!-- =================================================
           API ERROR
      ================================================== -->

      {
        !sidebarApiSuccess && (

          <div class="sidebar-api-status">

            <i
              class="fa-solid fa-triangle-exclamation"
            ></i>

            <span>
              {sidebarApiError}
            </span>

          </div>

        )
      }


      <!-- =================================================
           MENU DARI API

           SEMUA MENU DIAMBIL DARI DB/API.

           TERMASUK:
           - Dashboard
           - Artikel / Berita
           - Kinerja Investasi
           - Tempat Layanan
           - Konten
           - Inovasi
           - Carousel
           - Pemberitahuan

           Tidak ada menu manual.
      ================================================== -->

      {
        sidebarMenus.map(
          (menu) => {

            const isNotification =
              String(
                menu?.url || ""
              ).replace(
                /\/$/,
                ""
              ) ===
              "/admin/pemberitahuan";

            return (

              <a
                href={menu.url}
                class:list={[
                  "nav-link",
                  {
                    active:
                      isMenuActive(menu)
                  }
                ]}
                data-tooltip={menu.name}
              >

                <span
                  class:list={[
                    "nav-icon",
                    {
                      "notification-nav-icon":
                        isNotification
                    }
                  ]}
                >

                  <i
                    class={`fa-solid fa-${menu.icon || "circle"}`}
                  ></i>


                  {
                    isNotification && (

                      <span
                        class="nav-notification-dot"
                        id="sidebarNotificationDot"
                      ></span>

                    )
                  }

                </span>


                <span class="nav-text">

                  {menu.name}

                </span>


                {
                  isNotification && (

                    <span
                      class="sidebar-notification-count"
                      id="sidebarNotificationCount"
                    ></span>

                  )
                }

              </a>

            );

          }
        )
      }


      <!-- =================================================
           EMPTY
      ================================================== -->

      {
        sidebarApiSuccess &&
        sidebarMenus.length === 0 && (

          <div class="sidebar-api-status">

            <i
              class="fa-regular fa-folder-open"
            ></i>

            <span>
              Tidak ada menu dari API.
            </span>

          </div>

        )
      }

    </nav>


    <!-- ===================================================
         THEME
    ==================================================== -->

    <div class="theme-section">

      <div class="theme-title">
        WARNA TEMA
      </div>


      <div class="theme-colors">

        <button
          type="button"
          class="theme-color theme-blue"
          data-theme="blue"
          title="Biru / Kuning"
        ></button>

        <button
          type="button"
          class="theme-color theme-black"
          data-theme="black"
          title="Hitam / Putih"
        ></button>

        <button
          type="button"
          class="theme-color theme-purple"
          data-theme="purple"
          title="Ungu"
        ></button>

        <button
          type="button"
          class="theme-color theme-green"
          data-theme="green"
          title="Hijau"
        ></button>

        <button
          type="button"
          class="theme-color theme-red"
          data-theme="red"
          title="Merah"
        ></button>

        <button
          type="button"
          class="theme-color theme-orange"
          data-theme="orange"
          title="Orange"
        ></button>

        <button
          type="button"
          class="theme-color theme-cyan"
          data-theme="cyan"
          title="Cyan"
        ></button>

      </div>

    </div>


    <!-- ===================================================
         COLLAPSE
    ==================================================== -->

    <button
      type="button"
      class="sidebar-collapse"
      id="sidebarCollapse"
      aria-label="Ciutkan sidebar"
      aria-expanded="true"
    >

      <i class="fa-solid fa-angles-left"></i>

      <span class="collapse-text">
        Ciutkan Sidebar
      </span>

    </button>

  </aside>


  <!-- =====================================================
       MAIN
  ====================================================== -->

  <div class="admin-main">


    <!-- =================================================
         NAVBAR
    ================================================== -->

    <header class="admin-navbar">


      <button
        type="button"
        class="mobile-menu-button"
        id="mobileMenuButton"
        aria-label="Buka menu"
        aria-expanded="false"
      >

        <i class="fa-solid fa-bars"></i>

      </button>


      <!-- PAGE TITLE -->

      <div class="navbar-page">

        <div class="navbar-page-icon">

          <i
            class={`fa-solid fa-${pageInfo.icon}`}
          ></i>

        </div>


        <div class="navbar-page-text">

          <h1>
            {pageInfo.title}
          </h1>

          <span>

            <i class="fa-solid fa-house"></i>

            Admin DPMPTSP

          </span>

        </div>

      </div>


      <!-- =================================================
           NAVBAR RIGHT
      ================================================== -->

      <div class="navbar-right">


        <!-- DATE -->

        <div class="navbar-date">

          <i
            class="fa-regular fa-calendar"
          ></i>

          <span>
            {formattedDate}
          </span>

        </div>


        <!-- =================================================
             NOTIFICATION
        ================================================== -->

        <div
          class="notification-wrapper"
          id="notificationWrapper"
        >

          <button
            type="button"
            class="navbar-icon-button notification-button"
            id="notificationButton"
            aria-label="Pemberitahuan"
            aria-expanded="false"
            title="Pemberitahuan"
          >

            <i class="fa-regular fa-bell"></i>


            <span
              class="navbar-notification-dot"
              id="navbarNotificationDot"
            ></span>


            <span
              class="navbar-notification-badge"
              id="navbarNotificationBadge"
            ></span>

          </button>


          <!-- =================================================
               DROPDOWN
          ================================================== -->

          <div
            class="notification-dropdown"
            id="notificationDropdown"
          >

            <div class="notification-header">

              <div>

                <strong>
                  Pemberitahuan
                </strong>

                <span
                  id="notificationCountText"
                >
                  Memuat...
                </span>

              </div>


              <button
                type="button"
                id="notificationReadAll"
              >
                Tandai dibaca
              </button>

            </div>


            <div
              class="notification-list"
              id="notificationList"
            >

              <div class="notification-loading">

                <i
                  class="fa-solid fa-spinner fa-spin"
                ></i>

                Memuat pemberitahuan...

              </div>

            </div>


            <a
              href="/admin/pemberitahuan"
              class="notification-footer"
            >

              Lihat semua pemberitahuan

              <i
                class="fa-solid fa-arrow-right"
              ></i>

            </a>

          </div>

        </div>


        <!-- =================================================
             USER
        ================================================== -->

        <div class="navbar-user">

          <div class="navbar-user-avatar">

            <i
              class="fa-solid fa-user"
            ></i>

          </div>


          <div class="navbar-user-info">

            <strong>
              Administrator
            </strong>

            <span>
              Admin DPMPTSP
            </span>

            <span>

              <i
                class="fa-solid fa-circle"
              ></i>

              Online

            </span>

          </div>

        </div>


        <!-- =================================================
             LOGOUT
        ================================================== -->

        <button
          type="button"
          class="navbar-logout"
          id="logoutButton"
          aria-label="Keluar"
          title="Keluar"
        >

          <i
            class="fa-solid fa-right-from-bracket"
          ></i>

        </button>

      </div>

    </header>


    <!-- =================================================
         CONTENT
    ================================================== -->

    <main class="admin-content">

      <div class="admin-page-shell">


        <div class="admin-page-header">

          <div class="admin-page-heading">

            <h2>
              {title}
            </h2>


            {
              subtitle && (

                <p>
                  {subtitle}
                </p>

              )
            }

          </div>


          {
            actionLabel &&
            actionHref && (

              <a
                href={actionHref}
                class="admin-action-button"
              >

                <i
                  class="fa-solid fa-plus"
                ></i>

                <span>
                  {actionLabel}
                </span>

              </a>

            )
          }

        </div>


        <div class="admin-slot-content">

          <slot />

        </div>

      </div>

    </main>

  </div>


  <!-- =====================================================
       LOGOUT MODAL
  ====================================================== -->

  <div
    class="logout-modal"
    id="logoutModal"
    aria-hidden="true"
  >

    <div class="logout-backdrop"></div>


    <div class="logout-box">

      <div class="logout-icon">

        <i
          class="fa-solid fa-right-from-bracket"
        ></i>

      </div>


      <h2>
        Keluar dari Admin?
      </h2>


      <p>
        Anda akan keluar dari sesi administrator.
      </p>


      <div class="logout-actions">

        <button
          type="button"
          class="logout-cancel"
          id="logoutCancel"
        >
          Batal
        </button>


        <a
          href="/admin/logout"
          class="logout-confirm"
        >

          <i
            class="fa-solid fa-right-from-bracket"
          ></i>

          Ya, Keluar

        </a>

      </div>

    </div>

  </div>


</div>

</body>

</html>


<style>

/* =========================================================
   BASE
========================================================= */

:root {
  color-scheme: light;
}

html,
body {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100%;
}

html {
  overflow-x: hidden;
  background: #f3f6fb;
}

body {
  overflow-x: hidden;

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  background: #f3f6fb;
  color: #18243a;

  -webkit-font-smoothing: antialiased;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

button,
input,
select,
textarea {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}


/* =========================================================
   APP
========================================================= */

.admin-app {
  --sidebar-width: 244px;
  --sidebar-collapsed: 78px;

  --sidebar-bg: #0b4387;
  --sidebar-dark: #062d61;
  --sidebar-text: #eaf3ff;
  --sidebar-muted: #a9c4e5;

  --accent: #ffd21f;
  --accent-soft: rgba(255,210,31,.14);
  --accent-border: rgba(255,210,31,.38);

  --page-bg: #f3f6fb;
  --surface: #ffffff;
  --surface-muted: #f7f9fc;

  --text: #18243a;
  --text-muted: #748198;
  --border: #e4e9f1;

  min-height: 100vh;
  width: 100%;

  background: var(--page-bg);
  color: var(--text);
}


/* =========================================================
   SIDEBAR
========================================================= */

.sidebar-wrapper {
  position: fixed;
  inset: 0 auto 0 0;

  width: var(--sidebar-width);
  height: 100vh;

  display: flex;
  flex-direction: column;

  background:
    linear-gradient(
      180deg,
      var(--sidebar-bg),
      var(--sidebar-dark)
    );

  color: var(--sidebar-text);

  z-index: 1000;

  box-shadow:
    8px 0 28px rgba(15,23,42,.10);

  transition:
    width .25s ease,
    transform .25s ease;

  overflow: hidden;
}


/* =========================================================
   BRAND
========================================================= */

.sidebar-brand {
  height: 84px;
  min-height: 84px;

  display: flex;
  align-items: center;

  padding: 14px 18px;

  border-bottom:
    1px solid rgba(255,255,255,.09);
}

.brand-logo {
  width: 48px;
  height: 48px;
  min-width: 48px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 6px;

  border-radius: 14px;

  background: #fff;

  box-shadow:
    0 8px 22px rgba(0,0,0,.18);
}

.brand-logo img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.brand-text {
  margin-left: 12px;

  display: flex;
  flex-direction: column;

  white-space: nowrap;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.brand-text strong {
  color: #fff;
  font-size: 16px;
  font-weight: 800;
}

.brand-text span {
  margin-top: 3px;

  color: var(--sidebar-muted);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.5px;
}


/* =========================================================
   NAV
========================================================= */

.sidebar-nav {
  flex: 1;
  min-height: 0;

  padding: 18px 12px;

  overflow-y: auto;
}

.nav-label {
  padding: 0 12px 9px;

  color: var(--sidebar-muted);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.45px;
}

.nav-link {
  position: relative;

  width: 100%;
  height: 48px;
  min-height: 48px;

  display: flex;
  align-items: center;

  padding: 0 12px;
  margin-bottom: 5px;

  border-radius: 12px;

  color: var(--sidebar-text);

  text-decoration: none;

  transition:
    background .18s ease,
    color .18s ease;
}

.nav-link:hover {
  background: rgba(255,255,255,.09);
  color: #fff;
}

.nav-link.active {
  background:
    linear-gradient(
      90deg,
      var(--accent-soft),
      rgba(255,255,255,.07)
    );

  color: var(--accent);

  box-shadow:
    inset 3px 0 0 var(--accent);
}

.nav-icon {
  width: 24px;
  min-width: 24px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 16px;
}

.nav-text {
  margin-left: 12px;

  overflow: hidden;
  text-overflow: ellipsis;

  font-size: 13px;
  font-weight: 650;

  white-space: nowrap;

  transition:
    opacity .2s ease,
    transform .2s ease;
}

.nav-divider {
  height: 1px;

  margin: 15px 8px;

  background:
    rgba(255,255,255,.09);
}


/* =========================================================
   API STATUS
========================================================= */

.sidebar-api-status {
  min-height: 55px;

  margin: 4px 4px 12px;

  padding: 10px 12px;

  display: flex;
  align-items: center;

  gap: 10px;

  border:
    1px solid rgba(255,255,255,.10);

  border-radius: 10px;

  background:
    rgba(255,255,255,.06);

  color:
    var(--sidebar-muted);

  font-size: 10px;
  line-height: 1.4;
}

.sidebar-api-status i {
  flex-shrink: 0;
}


/* =========================================================
   NOTIFICATION SIDEBAR
========================================================= */

.notification-nav-icon {
  position: relative;
}

.nav-notification-dot {
  position: absolute;

  top: 0;
  right: 0;

  width: 7px;
  height: 7px;

  border: 2px solid var(--sidebar-bg);
  border-radius: 50%;

  background: #ef4444;

  display: none;
}

.nav-notification-dot.show {
  display: block;
}

.sidebar-notification-count {
  margin-left: auto;

  min-width: 20px;
  height: 20px;

  padding: 0 6px;

  display: none;

  align-items: center;
  justify-content: center;

  border-radius: 999px;

  background: #ef4444;
  color: #fff;

  font-size: 9px;
  font-weight: 800;
}

.sidebar-notification-count.show {
  display: flex;
}


/* =========================================================
   THEME
========================================================= */

.theme-section {
  flex-shrink: 0;

  padding: 11px 16px 14px;

  border-top:
    1px solid rgba(255,255,255,.09);
}

.theme-title {
  margin-bottom: 9px;

  color: var(--sidebar-muted);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 1.25px;
}

.theme-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.theme-color {
  width: 24px;
  height: 24px;
  min-width: 24px;

  padding: 0;

  border: 2px solid transparent;
  border-radius: 50%;

  cursor: pointer;
}

.theme-color.active {
  border-color: #fff;

  box-shadow:
    0 0 0 2px rgba(255,255,255,.18);
}

.theme-blue {
  background: linear-gradient(
    135deg,
    #0b63ba 0 50%,
    #ffd21f 50%
  );
}

.theme-black {
  background: linear-gradient(
    135deg,
    #17191f 0 50%,
    #fff 50%
  );
}

.theme-purple {
  background: linear-gradient(
    135deg,
    #8b5cf6,
    #4c1d95
  );
}

.theme-green {
  background: linear-gradient(
    135deg,
    #34d399,
    #047857
  );
}

.theme-red {
  background: linear-gradient(
    135deg,
    #fb7185,
    #991b1b
  );
}

.theme-orange {
  background: linear-gradient(
    135deg,
    #fb923c,
    #c2410c
  );
}

.theme-cyan {
  background: linear-gradient(
    135deg,
    #22d3ee,
    #155e75
  );
}


/* =========================================================
   COLLAPSE
========================================================= */

.sidebar-collapse {
  height: 44px;
  min-height: 44px;

  margin: 0 12px 14px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  border:
    1px solid rgba(255,255,255,.05);

  border-radius: 11px;

  background:
    rgba(255,255,255,.065);

  color: var(--sidebar-muted);

  cursor: pointer;

  font-size: 12px;
  font-weight: 650;
}

