        theme.bg,

      "--sidebar-dark":
        theme.dark,

      "--sidebar-text":
        theme.text,

      "--sidebar-muted":
        theme.muted,

      "--accent":
        theme.accent,

      "--accent-soft":
        theme.soft,

      "--accent-border":
        theme.border,

      "--page-bg":
        theme.page,

      "--surface":
        theme.surface,

      "--surface-muted":
        theme.surfaceMuted,

      "--text":
        theme.textMain,

      "--text-muted":
        theme.textMuted,

      "--border":
        theme.borderLight

    };


    app.dataset.theme =
      selected;


    Object.entries(
      tokens
    ).forEach(
      ([property, value]) => {

        app.style.setProperty(
          property,
          value
        );

      }
    );


    document
      .querySelectorAll(
        ".theme-color"
      )
      .forEach(
        (button) => {

          button.classList.toggle(
            "active",
            button.dataset.theme ===
              selected
          );

        }
      );


    if (persist) {

      localStorage.setItem(
        "admin-theme",
        selected
      );

    }

  }


  applyTheme(
    localStorage.getItem(
      "admin-theme"
    ) || "blue",
    false
  );


  document
    .querySelectorAll(
      ".theme-color"
    )
    .forEach(
      (button) => {

        button.addEventListener(
          "click",
          () => {

            applyTheme(
              button.dataset.theme ||
                "blue"
            );

          }
        );

      }
    );


  /* =======================================================
     SIDEBAR COLLAPSE
  ======================================================= */

  if (
    localStorage.getItem(
      "admin-sidebar-collapsed"
    ) === "true"
  ) {

    app.classList.add(
      "sidebar-collapsed"
    );

  }


  function updateCollapseButton() {

    if (!collapseButton) {
      return;
    }


    const collapsed =
      app.classList.contains(
        "sidebar-collapsed"
      );


    collapseButton.setAttribute(
      "aria-expanded",
      String(!collapsed)
    );

  }


  updateCollapseButton();


  collapseButton?.addEventListener(
    "click",
    () => {

      if (
        window.innerWidth <= 900
      ) {

        return;

      }


      const collapsed =
        app.classList.toggle(
          "sidebar-collapsed"
        );


      localStorage.setItem(
        "admin-sidebar-collapsed",
        String(collapsed)
      );


      updateCollapseButton();

    }
  );


  /* =======================================================
     MOBILE SIDEBAR
  ======================================================= */

  function openMobileSidebar() {

    sidebar?.classList.add(
      "mobile-open"
    );

    overlay?.classList.add(
      "mobile-open"
    );

    mobileButton?.setAttribute(
      "aria-expanded",
      "true"
    );

    document.body.style.overflow =
      "hidden";

  }


  function closeMobileSidebar() {

    sidebar?.classList.remove(
      "mobile-open"
    );

    overlay?.classList.remove(
      "mobile-open"
    );

    mobileButton?.setAttribute(
      "aria-expanded",
      "false"
    );

    document.body.style.overflow =
      "";

  }


  mobileButton?.addEventListener(
    "click",
    () => {

      if (
        sidebar?.classList.contains(
          "mobile-open"
        )
      ) {

        closeMobileSidebar();

      } else {

        openMobileSidebar();

      }

    }
  );


  overlay?.addEventListener(
    "click",
    closeMobileSidebar
  );


  document
    .querySelectorAll(
      ".nav-link"
    )
    .forEach(
      (link) => {

        link.addEventListener(
          "click",
          () => {

            if (
              window.innerWidth <= 900
            ) {

              closeMobileSidebar();

            }

          }
        );

      }
    );


  /* =======================================================
     NOTIFICATION
  ======================================================= */

  let notificationItems = [];


  const seenKey =
    "dpmptsp-admin-notification-seen-v2";


  function getSeenId() {

    return Number(
      localStorage.getItem(
        seenKey
      ) || 0
    );

  }


  function setSeenId(
    id
  ) {

    localStorage.setItem(
      seenKey,
      String(id)
    );

  }


  function formatDate(
    dateValue
  ) {

    if (!dateValue) {
      return "";
    }


    const date =
      new Date(
        dateValue
      );


    if (
      Number.isNaN(
        date.getTime()
      )
    ) {

      return "";

    }


    return date.toLocaleString(
      "id-ID",
      {
        day: "numeric",
        month: "short",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }
    );

  }


  function updateNotificationBadge() {

    const seenId =
      getSeenId();


    const unread =
      notificationItems.filter(
        (item) =>
          Number(item.id) >
          seenId
      ).length;


    /* =====================================================
       NAVBAR
    ===================================================== */

    if (unread > 0) {

      navbarNotificationDot
        ?.classList.add(
          "show"
        );

      if (
        navbarNotificationBadge
      ) {

        navbarNotificationBadge.textContent =
          unread > 99
            ? "99+"
            : String(unread);

        navbarNotificationBadge
          .classList.add(
            "show"
          );

      }

    } else {

      navbarNotificationDot
        ?.classList.remove(
          "show"
        );

      navbarNotificationBadge
        ?.classList.remove(
          "show"
        );

    }


    /* =====================================================
       SIDEBAR

       Hanya ada satu elemen Pemberitahuan
       sehingga ID tidak lagi duplikat.
    ===================================================== */

    if (unread > 0) {

      sidebarNotificationDot
        ?.classList.add(
          "show"
        );


      if (
        sidebarNotificationCount
      ) {

        sidebarNotificationCount.textContent =
          unread > 99
            ? "99+"
            : String(unread);

        sidebarNotificationCount
          .classList.add(
            "show"
          );

      }

    } else {

      sidebarNotificationDot
        ?.classList.remove(
          "show"
        );

      sidebarNotificationCount
        ?.classList.remove(
          "show"
        );

    }


    /* =====================================================
       TEXT COUNT
    ===================================================== */

    if (
      notificationCountText
    ) {

      notificationCountText.textContent =
        notificationItems.length
          ? `${notificationItems.length} pemberitahuan`
          : "Belum ada pemberitahuan";

    }

  }


  /* =======================================================
     ESCAPE HTML

     Mencegah HTML dari data API masuk mentah
     ke innerHTML.
  ======================================================= */

  function escapeHtml(
    value
  ) {

    return String(
      value ?? ""
    )
      .replace(
        /&/g,
        "&amp;"
      )
      .replace(
        /</g,
        "&lt;"
      )
      .replace(
        />/g,
        "&gt;"
      )
      .replace(
        /"/g,
        "&quot;"
      )
      .replace(
        /'/g,
        "&#039;"
      );

  }


  function safeUrl(
    value
  ) {

    const url =
      String(
        value ||
        "/admin/pemberitahuan"
      ).trim();


    if (
      url.startsWith("/") &&
      !url.startsWith("//")
    ) {

      return url;

    }


    if (
      url.startsWith(
        "https://"
      ) ||
      url.startsWith(
        "http://"
      )
    ) {

      return url;

    }


    return "/admin/pemberitahuan";

  }


  /* =======================================================
     RENDER NOTIFICATIONS
  ======================================================= */

  function renderNotifications() {

    if (!notificationList) {
      return;
    }


    if (
      !notificationItems.length
    ) {

      notificationList.innerHTML = `
        <div class="notification-empty">
          <i class="fa-regular fa-bell-slash"></i>
          <br><br>
          Belum ada data pemberitahuan.
        </div>
      `;

      return;

    }


    notificationList.innerHTML =
      notificationItems
        .map(
          (item) => {

            const type =
              escapeHtml(
                item.type ||
                "Informasi"
              );

            const title =
              escapeHtml(
                item.title ||
                "Pemberitahuan baru"
              );

            const message =
              escapeHtml(
                item.message ||
                "Data baru telah ditambahkan."
              );

            const icon =
              escapeHtml(
                item.icon ||
                "🔔"
              );

            const url =
              escapeHtml(
                safeUrl(
                  item.url
                )
              );

            const date =
              escapeHtml(
                formatDate(
                  item.created_at
                )
              );


            return `
              <a
                class="notification-item"
                href="${url}"
              >

                <span
                  class="notification-item-icon"
                >
                  ${icon}
                </span>

                <span
                  class="notification-item-content"
                >

                  <span
                    class="notification-item-title"
                  >
                    ${type} · ${title}
                  </span>

                  <span
                    class="notification-item-message"
                  >
                    ${message}
                  </span>

                  <span
                    class="notification-item-date"
                  >
                    ${date}
                  </span>

                </span>

              </a>
            `;

          }
        )
        .join("");

  }


  /* =======================================================
     LOAD NOTIFICATIONS
  ======================================================= */

  let notificationLoading =
    false;


  async function loadNotifications() {

    if (
      notificationLoading
    ) {

      return;

    }


    notificationLoading =
      true;


    try {

      const response =
        await fetch(
          "/api/notifications",
          {
            method: "GET",

            credentials:
              "same-origin",

            cache:
              "no-store",

            headers: {
              Accept:
                "application/json"
            }

          }
        );


      if (!response.ok) {

        throw new Error(
          `HTTP ${response.status}`
        );

      }


      const data =
        await response.json();


      if (
        !data.success ||
        !Array.isArray(
          data.notifications
        )
      ) {

        throw new Error(
          data.message ||
          "Format pemberitahuan tidak valid"
        );

      }


      notificationItems =
        data.notifications
          .filter(
            (item: any) =>
              item &&
              typeof item === "object"
          )
          .sort(
            (a: any, b: any) =>
              (
                Number(b.id) || 0
              ) -
              (
                Number(a.id) || 0
              )
          );


      renderNotifications();

      updateNotificationBadge();

    } catch (error) {

      console.error(
        "Notification error:",
        error
      );


      if (
        notificationList
      ) {

        notificationList.innerHTML = `
          <div class="notification-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <br><br>
            Gagal memuat pemberitahuan.
          </div>
        `;

      }


      if (
        notificationCountText
      ) {

        notificationCountText.textContent =
          "Gagal memuat";

      }

    } finally {

      notificationLoading =
        false;

    }

  }


  /* =======================================================
     NOTIFICATION OPEN
  ======================================================= */

  notificationButton?.addEventListener(
    "click",
    (event) => {

      event.stopPropagation();


      const open =
        notificationWrapper
          ?.classList.toggle(
            "open"
          );


      notificationButton.setAttribute(
        "aria-expanded",
        String(
          !!open
        )
      );


      if (open) {

        loadNotifications();

      }

    }
  );


  /* =======================================================
     CLICK OUTSIDE
  ======================================================= */

  document.addEventListener(
    "click",
    (event) => {

      const target =
        event.target;


      if (
        notificationWrapper &&
        target instanceof Node &&
        !notificationWrapper.contains(
          target
        )
      ) {

        notificationWrapper
          .classList.remove(
            "open"
          );

        notificationButton
          ?.setAttribute(
            "aria-expanded",
            "false"
          );

      }

    }
  );


  /* =======================================================
     MARK ALL READ
  ======================================================= */

  notificationReadAll?.addEventListener(
    "click",
    (event) => {

      event.preventDefault();

      event.stopPropagation();


      if (
        !notificationItems.length
      ) {

        return;

      }


      const latestId =
        Math.max(
          ...notificationItems.map(
            (item) =>
              Number(
                item.id
              ) || 0
          )
        );


      setSeenId(
        latestId
      );


      updateNotificationBadge();

    }
  );


  /* =======================================================
     INITIAL NOTIFICATION
  ======================================================= */

  loadNotifications();


  /* Refresh setiap 10 detik */
  setInterval(
    loadNotifications,
    10000
  );


  /* =======================================================
     LOGOUT
  ======================================================= */

  function openLogoutModal() {

    logoutModal?.classList.add(
      "show"
    );

    logoutModal?.setAttribute(
      "aria-hidden",
      "false"
    );

    document.body.style.overflow =
      "hidden";

  }


  function closeLogoutModal() {

    logoutModal?.classList.remove(
      "show"
    );

    logoutModal?.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.style.overflow =
      "";

  }


  logoutButton?.addEventListener(
    "click",
    openLogoutModal
  );


  logoutCancel?.addEventListener(
    "click",
    closeLogoutModal
  );


  logoutModal
    ?.querySelector(
      ".logout-backdrop"
    )
    ?.addEventListener(
      "click",
      closeLogoutModal
    );


  /* =======================================================
     ESC
  ======================================================= */

  document.addEventListener(
    "keydown",
    (event) => {

      if (
        event.key === "Escape"
      ) {

        closeMobileSidebar();

        closeLogoutModal();

        notificationWrapper
          ?.classList.remove(
            "open"
          );

        notificationButton
          ?.setAttribute(
            "aria-expanded",
            "false"
          );

      }

    }
  );


  /* =======================================================
     RESIZE
  ======================================================= */

  window.addEventListener(
    "resize",
    () => {

      if (
        window.innerWidth > 900
      ) {

        closeMobileSidebar();

      }

    }
  );

})();
</script>


<script is:inline>
(() => {

  const path =
    window.location.pathname;


  if (
    !path.startsWith(
      "/admin"
    )
  ) {

    return;

  }


  if (
    path ===
    "/admin/login"
  ) {

    return;

  }


  window.addEventListener(
    "pageshow",
    (event) => {

      if (
        event.persisted
      ) {

        window.location.reload();

      }

    }
  );

})();
</script>
 